@charset "utf-8";

.layout-compact [class*="-compact-foot"], .layout-mobile [class*="-compact-foot"], .layout-compact [class*="-compact-cta"], .layout-mobile [class*="-compact-cta"] { display: flex !important; justify-content: center !important; align-items: center !important; width: 100% !important; }

.layout-compact .coo-btn, .layout-mobile .coo-btn { white-space: nowrap; width: auto !important; max-width: 100% !important; align-self: center !important; margin-left: auto !important; margin-right: auto !important; display: inline-flex !important; }
