.visual-reminder[class*="theme-"] { background: linear-gradient(145deg, rgb(15, 10, 20) 0%, rgb(26, 16, 36) 45%, rgb(18, 8, 26) 100%) !important; color: rgb(250, 250, 250) !important; border: 1px solid rgba(255, 255, 255, 0.08) !important; }

.visual-reminder[class*="theme-"] .coo-hook { background: rgba(239, 68, 68, 0.2) !important; color: rgb(254, 202, 202) !important; animation: auto ease 0s 1 normal none running none !important; }

