}

.img { margin: 0px auto; display: flex; justify-content: center; align-items: flex-end; }

.img img { height: 96%; display: block; border-radius: 7px; }

.title { line-height: 1.3; font-weight: 700; margin: 0px; }

.title a { color: inherit; }

.dropdown-btn { transition: opacity 0.5s; }

.open > .dropdown-menu { display: block !important; }

.open > .dropdown-btn { opacity: 0.5; }

.dropdown { position: relative; }

.dropdown-menu { display: none; position: absolute; z-index: 101; left: 0px; border-radius: 0.75rem; font-size: 0.875rem; background-color: var(--modal-bg); font-weight: 400; }

.dropdown-menu-right { right: 0px; left: auto; }

.dropdown-form { min-width: 240px; padding: 1.25rem; }

.collapse { display: none; }

.collapse.in { display: block; }

tr.collapse.in { display: table-row; }

tbody.collapse.in { display: table-row-group; }

.collapsing { position: relative; height: 0px; overflow: hidden; transition-duration: 0.35s; transition-timing-function: ease; }

.fade { opacity: 0; transition: opacity 0.15s linear; }

.fade.in { opacity: 1; }

.modal-open { overflow: hidden !important; }

.modal { position: fixed; inset: 0px; z-index: 1050; display: none; overflow: hidden; outline: 0px; }

.modal-dialog { position: relative; width: auto; min-height: 100%; }

.modal-open .modal { overflow: hidden auto; }

.modal-footer { padding: 1.5rem; text-align: right; border-top: 1px solid var(--line); }

.modal-title { font-size: 1.25rem; margin-bottom: 2rem; }

.modal-head { border-top-left-radius: inherit; border-top-right-radius: inherit; border-bottom-right-radius: 0px; border-bottom-left-radius: 0px; border-bottom: 1px solid var(--line); }

.modal-head .modal-title { margin: 0px; }

.modal-header .modal-title { margin-bottom: 0px; }

.modal-header + .modal-body { padding-top: 0px !important; }

.modal-content { position: relative; background-color: var(--modal-bg); width: 100%; outline: 0px; }

.modal-body, .modal-head, .modal-header { padding: 1.5rem; }

.modal-backdrop { position: fixed; inset: 0px; z-index: 1040; background-color: rgba(0, 0, 0, 0.3); }

.modal-backdrop.fade { opacity: 0; }

.modal-backdrop.in { opacity: 1; }

.modal-dialog .close, .modal-close { position: absolute; right: 0px; top: 0px; color: inherit; padding: 0.5rem; width: 2.5rem; height: 2.5rem; border: 0px; pointer-events: auto; background: 0px 0px; transition: color 0.15s ease-out; outline: none !important; }

.modal .modal-dialog > .close, .modal-close { width: 4rem; height: 4rem; padding: 1rem; z-index: 1; }

.modal-dialog .close { opacity: 0.5; }

.closes i { display: block; }

.modal-title { margin-bottom: 1rem; }

.modal-close { color: rgb(255, 255, 255); transition: opacity 0.15s ease-out; }

@media (min-width: 992px) {
  .modal-close:hover { opacity: 0.8; }
  .modal-dialog .close:hover { opacity: 0.8; }
  .modal { }
}

@media (min-width: 576px) {
  .modal.fade .modal-dialog { transform: scale(0.85); transition: transform 0.2s, opacity 0.2s; }
  .modal.in .modal-dialog { transform: scale(1); }
  .modal-content { pointer-events: auto; background-clip: padding-box; max-width: 56rem; min-height: 0px; border-radius: 1.125rem; }
  .container .modal-content { }
  .modal-dialog { display: flex; align-items: center; justify-content: center; pointer-events: none; margin: 1rem auto; min-height: calc(100% - 2rem); padding-left: 0.5rem; padding-right: 0.5rem; }
  .modal-body, .modal-head, .modal-header { padding: 2rem; }
}

@media (max-width: 575px) {
  .modal-dialog { display: flex; }
  .modal-body { padding-top: 3.5rem; }
}

html.ovb { overflow: hidden; width: 100%; height: 100%; }

html.ovb .videobox.open { opacity: 1; }

.videobox { opacity: 0; transition: opacity 0.15s linear; overflow-y: auto; background-color: rgba(0, 0, 0, 0.3); }

.videobox.open { display: block !important; }

.videobox .video-content { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; padding: 2rem; max-width: none !important; }

.videobox .video-wrap { width: 100%; max-width: 60rem; pointer-events: auto; }

.videobox .video-body { position: relative; padding: 0px; background-color: rgb(0, 0, 0); box-shadow: rgba(0, 0, 0, 0.6) 0px 1rem 2rem 0px; border-radius: 1.125rem; }

.videobox .video-body .close { position: absolute; right: 0px; top: 0px; margin: -1.25rem -1.25rem 0px 0px; z-index: 1; background-color: var(--lcolor); box-shadow: 0 0 2rem 0 var(--lcolor); color: rgb(255, 255, 255); width: 2.5rem; height: 2.5rem; padding: 0.5rem; border-radius: 50%; border: 0px; }

.videobox .video-body .close i { display: block; }

.video_block { position: relative; border-radius: 1.125rem; overflow: hidden; }

.video_block img { display: block; max-height: 80vh; }

.video_wrap { position: absolute; left: 0px; top: 0px; bottom: 0px; width: 100%; }

.video_wrap iframe { overflow: hidden; width: 100%; height: 100%; }

.btn-group .btn-block { width: 100%; }

.btn-reset { vertical-align: top; padding: 0px; margin: 0px; background: 0px 0px; border: 0px; cursor: pointer; }

.btn, .bbcodes, .ui-button { height: 2.5rem; line-height: 1.5rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.875rem; white-space: nowrap; text-align: center; display: inline-block; vertical-align: top; border: 0px; font-weight: 700; cursor: pointer; outline: none; transition: box-shadow 0.15s, background-color 0.15s, transform 0.1s, opacity 0.1s; text-decoration: none !important; color: rgb(255, 255, 255) !important; }

.btn-icon { display: flex; align-items: center; justify-content: center; }

.btn-icon i { margin-right: 0.25rem; }

.btn-border { box-shadow: rgba(76, 203, 112, 0.5) 0px 0px 0px 1px inset; background: 0px 0px; color: inherit !important; }

.btn-border:hover { box-shadow: rgba(76, 203, 112, 0.3) 0px 0px 0px 3px inset; }

.btn-complaint { position: relative; }

.btn-complaint a { color: inherit !important; }

.btn-complaint a::after { content: ""; position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; }

.btn-telegram { color: rgb(49, 168, 219) !important; }

