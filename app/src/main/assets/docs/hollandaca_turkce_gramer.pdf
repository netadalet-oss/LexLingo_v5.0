.visual-gift .coo-btn { box-shadow: rgba(225, 29, 72, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(190, 18, 60) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-gift-glow { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 30% 50%, rgba(251, 191, 36, 0.15) 0%, transparent 48%), radial-gradient(circle at 75% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 42%); animation: coo-gift-glow-spin var(--gf-dur, 8s) ease-in-out infinite; }

@keyframes coo-gift-glow-spin { 
  0%, 100% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(8deg) scale(1.05); }
}

.coo-gift-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-gift-stage { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.25) 0%, rgba(76, 5, 25, 0.4) 100%); border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: rgba(0, 0, 0, 0.35) 0px 8px 24px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset; }

.coo-gift-confetti { position: absolute; width: 3px; height: 3px; border-radius: 1px; z-index: 6; pointer-events: none; opacity: 0; }

.coo-gift-confetti:nth-child(1) { left: 20%; top: 30%; background: rgb(253, 230, 138); animation: coo-gift-confetti-fly var(--gf-dur, 8s) ease-out infinite; }

.coo-gift-confetti:nth-child(2) { left: 35%; top: 25%; background: rgb(255, 255, 255); animation: coo-gift-confetti-fly var(--gf-dur, 8s) ease-out 0.1s infinite; }

.coo-gift-confetti:nth-child(3) { left: 55%; top: 28%; background: rgb(251, 207, 232); animation: coo-gift-confetti-fly var(--gf-dur, 8s) ease-out 0.15s infinite; }

.coo-gift-confetti:nth-child(4) { left: 70%; top: 32%; background: rgb(253, 230, 138); animation: coo-gift-confetti-fly var(--gf-dur, 8s) ease-out 0.2s infinite; }

.coo-gift-confetti:nth-child(5) { left: 45%; top: 20%; background: rgb(255, 255, 255); animation: coo-gift-confetti-fly var(--gf-dur, 8s) ease-out 0.25s infinite; }

@keyframes coo-gift-confetti-fly { 
  0%, 38% { opacity: 0; transform: translateY(0px) rotate(0deg); }
  45%, 65% { opacity: 1; transform: translateY(-12px) rotate(180deg); }
  75%, 100% { opacity: 0; transform: translateY(-20px) rotate(360deg); }
}

.coo-gift-box-wrap { position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); width: 46%; height: 42%; z-index: 3; }

.coo-gift-box { position: absolute; inset: 0px; border-radius: 4px; background: linear-gradient(rgb(26, 77, 46), rgb(20, 83, 45)); border: 1px solid rgba(0, 0, 0, 0.2); box-shadow: rgba(255, 255, 255, 0.1) 0px 1px 0px inset; }

.coo-gift-ribbon-v { position: absolute; top: 0px; bottom: 0px; left: 50%; width: 4px; margin-left: -2px; background: rgb(120, 53, 15); }

.coo-gift-ribbon-h { position: absolute; top: 45%; left: 0px; right: 0px; height: 4px; background: rgb(120, 53, 15); }

.coo-gift-lid { position: absolute; bottom: 100%; left: -4%; width: 108%; height: 22%; background: linear-gradient(rgb(34, 84, 61), rgb(26, 77, 46)); border-radius: 4px 4px 2px 2px; border: 1px solid rgba(0, 0, 0, 0.15); transform-origin: left bottom; animation: coo-gift-lid-open var(--gf-dur, 8s) ease-in-out infinite; }

@keyframes coo-gift-lid-open { 
  0%, 30% { transform: rotate(0deg) translateY(0px); }
  42%, 58% { transform: rotate(-38deg) translateY(-3px); }
  68%, 100% { transform: rotate(0deg) translateY(0px); }
}

.coo-gift-reveal { position: absolute; left: 50%; top: 22%; transform: translateX(-50%); text-align: center; z-index: 5; width: 80%; animation: coo-gift-reveal-pop var(--gf-dur, 8s) cubic-bezier(0.22, 1, 0.36, 1) infinite; }

@keyframes coo-gift-reveal-pop { 
  0%, 36% { opacity: 0; transform: translateX(-50%) translateY(8px) scale(0.85); }
  44%, 72% { opacity: 1; transform: translateX(-50%) translateY(0px) scale(1); }
  82%, 100% { opacity: 0.9; transform: translateX(-50%) translateY(-2px) scale(1); }
}

.coo-gift-days { font-size: 18px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.04em; line-height: 1; text-shadow: rgba(0, 0, 0, 0.3) 0px 2px 12px; }

.coo-gift-days-sub { font-size: 5px; font-weight: 800; color: rgba(255, 255, 255, 0.75); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 1px; }

.coo-gift-nocard { position: absolute; top: 6px; right: 5px; z-index: 4; display: inline-flex; align-items: center; gap: 2px; padding: 2px 4px; border-radius: 99px; background: rgba(255, 255, 255, 0.92); color: rgb(22, 101, 52); font-size: 3px; font-weight: 800; animation: coo-gift-nocard-in var(--gf-dur, 8s) ease-out infinite; }

@keyframes coo-gift-nocard-in { 
  0%, 46% { opacity: 0; transform: scale(0.8); }
  52%, 78% { opacity: 1; transform: scale(1); }
  88%, 100% { opacity: 0.95; }
}

.coo-gift-nocard-x { font-size: 5px; line-height: 1; color: rgb(239, 68, 68); }

.coo-gift-perks { position: absolute; bottom: 3px; left: 4px; right: 4px; display: flex; justify-content: center; gap: 2px; z-index: 4; }

.coo-gift-perk { font-size: 3px; font-weight: 800; padding: 1px 3px; border-radius: 99px; background: rgba(255, 255, 255, 0.15); color: rgba(255, 255, 255, 0.7); opacity: 0; animation: coo-gift-perk-in var(--gf-dur, 8s) ease-out infinite; }

.coo-gift-perk:nth-child(1) { animation-delay: 0.1s; }

.coo-gift-perk:nth-child(2) { animation-delay: 0.2s; }

.coo-gift-perk:nth-child(3) { animation-delay: 0.3s; }

@keyframes coo-gift-perk-in { 
  0%, 50% { opacity: 0; transform: translateY(3px); }
  58%, 80% { opacity: 1; transform: translateY(0px); background: rgba(255, 255, 255, 0.22); color: rgb(255, 255, 255); }
  90%, 100% { opacity: 0.8; }
}

.coo-gift-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-gift-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-gift-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-gift-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-gift-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-gift.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-gift.layout-banner-wide .coo-gift-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-gift.layout-banner-wide .coo-gift-stage { width: 96px; height: 72px; border-radius: 8px; }

.visual-gift.layout-banner-wide .coo-gift-days { font-size: 14px; }

.visual-gift.layout-banner-wide .coo-gift-perks { display: none; }

.visual-gift.layout-banner-wide .coo-gift-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-gift.layout-banner-wide .coo-gift-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-gift.layout-banner-wide .coo-gift-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-gift.layout-banner-wide .coo-gift-btn { padding: 6px 12px; font-size: 10px; }

.visual-gift.layout-banner-wide .coo-gift-btn .coo-arrow { display: none; }

.visual-gift.layout-banner-wide .coo-brand { display: none; }

.visual-gift.layout-square, .visual-gift.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-gift.layout-square .coo-gift-square, .visual-gift.layout-desktop-square .coo-gift-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-gift.layout-square .coo-gift-square-top, .visual-gift.layout-desktop-square .coo-gift-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-gift.layout-square .coo-gift-stage, .visual-gift.layout-desktop-square .coo-gift-stage { width: 130px; height: 118px; border-radius: 12px; }

.visual-gift.layout-square .coo-gift-days, .visual-gift.layout-desktop-square .coo-gift-days { font-size: 22px; }

.visual-gift.layout-square .coo-gift-copy .coo-hook, .visual-gift.layout-desktop-square .coo-gift-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-gift.layout-square .coo-gift-title, .visual-gift.layout-desktop-square .coo-gift-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-gift.layout-square .coo-gift-desc, .visual-gift.layout-desktop-square .coo-gift-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-gift.layout-square .coo-gift-btn, .visual-gift.layout-desktop-square .coo-gift-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-gift.layout-square .coo-brand, .visual-gift.layout-desktop-square .coo-brand { display: none; }

.visual-gift.layout-compact, .visual-gift.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-gift.layout-compact .coo-gift-compact, .visual-gift.layout-mobile .coo-gift-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-gift.layout-compact .coo-gift-compact-top, .visual-gift.layout-mobile .coo-gift-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-gift.layout-compact .coo-gift-stage, .visual-gift.layout-mobile .coo-gift-stage { width: 72px; height: 62px; border-radius: 8px; }

.visual-gift.layout-compact .coo-gift-days, .visual-gift.layout-mobile .coo-gift-days { font-size: 12px; }

.visual-gift.layout-compact .coo-gift-box-wrap, .visual-gift.layout-mobile .coo-gift-box-wrap { height: 36%; bottom: 14px; }

.visual-gift.layout-compact .coo-gift-perks, .visual-gift.layout-mobile .coo-gift-perks { display: none; }

.visual-gift.layout-compact .coo-gift-copy .coo-hook, .visual-gift.layout-mobile .coo-gift-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-gift.layout-compact .coo-gift-title, .visual-gift.layout-mobile .coo-gift-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-gift.layout-compact .coo-gift-desc, .visual-gift.layout-mobile .coo-gift-desc { display: none; }

.visual-gift.layout-compact .coo-gift-compact-foot, .visual-gift.layout-mobile .coo-gift-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-gift.layout-compact .coo-gift-btn, .visual-gift.layout-mobile .coo-gift-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-gift.layout-compact .coo-gift-btn .coo-arrow, .visual-gift.layout-mobile .coo-gift-btn .coo-arrow { display: none; }

.visual-gift.layout-compact .coo-brand, .visual-gift.layout-mobile .coo-brand { display: none; }

.visual-bridge { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-bridge[class*="theme-"] { background: linear-gradient(155deg, rgb(2, 44, 34) 0%, rgb(4, 120, 87) 38%, rgb(5, 150, 105) 58%, rgb(16, 185, 129) 100%) !important; color: rgb(236, 253, 245) !important; border: 1px solid rgba(255, 255, 255, 0.18) !important; }

.visual-bridge .coo-bg-orb { display: none !important; }

.visual-bridge .coo-hook { background: rgba(255, 255, 255, 0.16) !important; color: rgb(209, 250, 229) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-bridge .coo-btn { box-shadow: rgba(16, 185, 129, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(4, 120, 87) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-bridge-glow { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 25% 60%, rgba(52, 211, 153, 0.14) 0%, transparent 48%), radial-gradient(circle at 78% 35%, rgba(59, 130, 246, 0.1) 0%, transparent 42%); animation: coo-bridge-glow-shift var(--br-dur, 8s) ease-in-out infinite; }

@keyframes coo-bridge-glow-shift { 
  0%, 100% { opacity: 0.75; }
  50% { opacity: 1; }
}

.coo-bridge-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-bridge-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.28) 0%, rgba(4, 120, 87, 0.35) 100%); border: 1px solid rgba(255, 255, 255, 0.14); box-shadow: rgba(0, 0, 0, 0.35) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-bridge-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 5; }

.coo-bridge-head-label { font-size: 3px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-bridge-head-pct { font-size: 4px; font-weight: 800; color: rgb(110, 231, 183); animation: coo-bridge-pct var(--br-dur, 8s) ease-out infinite; }

@keyframes coo-bridge-pct { 
  0%, 18% { content: "0%"; opacity: 0.5; }
  35%, 70% { opacity: 1; }
  88%, 100% { opacity: 0.9; }
}

.coo-bridge-lane { position: absolute; inset: 22px 6px; display: flex; align-items: center; justify-content: space-between; z-index: 2; }

.coo-bridge-tile { width: 28%; height: 52%; border-radius: 4px; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; }

.coo-bridge-tile-xls { background: linear-gradient(rgb(33, 115, 70), rgb(24, 92, 55)); border: 1px solid rgba(0, 0, 0, 0.2); box-shadow: rgba(255, 255, 255, 0.1) 0px 1px 0px inset; }

.coo-bridge-xls-icon { font-size: 7px; font-weight: 900; color: rgb(255, 255, 255); letter-spacing: -0.02em; }

.coo-bridge-xls-grid { margin-top: 2px; width: 70%; display: flex; flex-direction: column; gap: 1px; }

.coo-bridge-xls-row { height: 2px; background: rgba(255, 255, 255, 0.25); border-radius: 1px; }

.coo-bridge-xls-row:nth-child(2) { width: 80%; }

.coo-bridge-xls-row:nth-child(3) { width: 65%; }

.coo-bridge-file-name { position: absolute; bottom: 2px; left: 2px; right: 2px; font-size: 2px; font-weight: 700; color: rgba(255, 255, 255, 0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }

.coo-bridge-tile-coo { background: linear-gradient(rgb(6, 95, 70), rgb(4, 120, 87)); border: 1px solid rgba(110, 231, 183, 0.35); box-shadow: rgba(16, 185, 129, 0.25) 0px 0px 10px; }

.coo-bridge-coo-logo { font-size: 5px; font-weight: 900; color: rgb(255, 255, 255); letter-spacing: -0.03em; }

.coo-bridge-coo-grid { margin-top: 2px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; width: 72%; }

.coo-bridge-coo-item { height: 6px; border-radius: 2px; background: rgba(255, 255, 255, 0.12); opacity: 0; animation: coo-bridge-item-in var(--br-dur, 8s) ease-out infinite; }

.coo-bridge-coo-item:nth-child(1) { animation-delay: 0.2s; }

.coo-bridge-coo-item:nth-child(2) { animation-delay: 0.35s; }

.coo-bridge-coo-item:nth-child(3) { animation-delay: 0.5s; }

.coo-bridge-coo-item:nth-child(4) { animation-delay: 0.65s; }

@keyframes coo-bridge-item-in { 
  0%, 48% { opacity: 0; transform: scale(0.7); background: rgba(255, 255, 255, 0.08); }
  58%, 82% { opacity: 1; transform: scale(1); background: rgba(110, 231, 183, 0.35); }
  92%, 100% { opacity: 0.85; }
}

.coo-bridge-path { flex: 1 1 0%; height: 100%; position: relative; margin: 0px 2px; min-width: 0px; }

.coo-bridge-path-line { position: absolute; top: 50%; left: 0px; right: 0px; height: 2px; margin-top: -1px; background: rgba(255, 255, 255, 0.12); border-radius: 1px; overflow: hidden; }

.coo-bridge-path-fill { position: absolute; top: 0px; left: 0px; height: 100%; width: 0px; background: linear-gradient(90deg, rgb(52, 211, 153), rgb(110, 231, 183)); border-radius: 1px; animation: coo-bridge-fill var(--br-dur, 8s) ease-in-out infinite; }

@keyframes coo-bridge-fill { 
  0%, 22% { width: 0px; }
  55%, 78% { width: 100%; }
  90%, 100% { width: 100%; opacity: 0.85; }
}

.coo-bridge-packet { position: absolute; top: 50%; left: 0px; width: 8px; height: 10px; margin-top: -5px; margin-left: -4px; border-radius: 2px; background: rgb(255, 255, 255); border: 1px solid rgba(4, 120, 87, 0.3); box-shadow: rgba(0, 0, 0, 0.25) 0px 2px 6px; z-index: 3; animation: coo-bridge-packet-fly var(--br-dur, 8s) cubic-bezier(0.45, 0, 0.55, 1) infinite; }

.coo-bridge-packet::before { content: ""; position: absolute; top: 2px; left: 2px; right: 2px; height: 1px; background: rgb(33, 115, 70); border-radius: 1px; }

.coo-bridge-packet::after { content: ""; position: absolute; top: 4px; left: 2px; width: 60%; height: 1px; background: rgba(33, 115, 70, 0.5); border-radius: 1px; }

@keyframes coo-bridge-packet-fly { 
  0%, 20% { left: 0px; opacity: 0; transform: scale(0.6); }
  28%, 32% { opacity: 1; transform: scale(1); }
  62%, 68% { left: calc(100% - 4px); opacity: 1; }
  78%, 100% { left: calc(100% - 4px); opacity: 0; transform: scale(0.8); }
}

.coo-bridge-arrow-icon { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 8px; font-weight: 800; color: rgba(110, 231, 183, 0.5); animation: coo-bridge-arrow-pulse var(--br-dur, 8s) ease-in-out infinite; }

@keyframes coo-bridge-arrow-pulse { 
  0%, 30% { opacity: 0.2; transform: translate(-50%, -50%) scale(0.9); }
  45%, 72% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); color: rgb(110, 231, 183); }
  85%, 100% { opacity: 0.3; }
}

.coo-bridge-steps { position: absolute; bottom: 3px; left: 4px; right: 4px; display: flex; justify-content: center; gap: 2px; z-index: 4; }

.coo-bridge-step { font-size: 2px; font-weight: 800; padding: 1px 3px; border-radius: 99px; background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.45); animation: coo-bridge-step-active var(--br-dur, 8s) ease-out infinite; }

.coo-bridge-step:nth-child(1) { animation-delay: 0s; }

.coo-bridge-step:nth-child(2) { animation-delay: 0.4s; }

.coo-bridge-step:nth-child(3) { animation-delay: 0.8s; }

@keyframes coo-bridge-step-active { 
  0%, 15% { background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.45); }
  25%, 55% { background: rgba(255, 255, 255, 0.22); color: rgb(255, 255, 255); }
  65%, 100% { background: rgba(110, 231, 183, 0.35); color: rgb(236, 253, 245); }
}

.coo-bridge-counter { position: absolute; top: 5px; left: 50%; transform: translateX(-50%); display: flex; align-items: baseline; gap: 2px; z-index: 4; opacity: 0; animation: coo-bridge-counter-in var(--br-dur, 8s) ease-out infinite; }

@keyframes coo-bridge-counter-in { 
  0%, 52% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  60%, 82% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  92%, 100% { opacity: 0.9; }
}

.coo-bridge-count-val { font-size: 7px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.03em; }

.coo-bridge-count-sub { font-size: 3px; font-weight: 800; color: rgba(255, 255, 255, 0.65); text-transform: uppercase; }

.coo-bridge-toast { position: absolute; top: 14px; left: 50%; transform: translateX(-50%) translateY(-6px); padding: 2px 5px; border-radius: 99px; z-index: 6; background: rgba(255, 255, 255, 0.95); color: rgb(4, 120, 87); font-size: 3px; font-weight: 800; white-space: nowrap; box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px; opacity: 0; animation: coo-bridge-toast-in var(--br-dur, 8s) ease-out infinite; }

@keyframes coo-bridge-toast-in { 
  0%, 68% { opacity: 0; transform: translateX(-50%) translateY(-6px); }
  74%, 88% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  96%, 100% { opacity: 0; transform: translateX(-50%) translateY(-3px); }
}

.coo-bridge-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-bridge-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-bridge-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-bridge-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-bridge-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

