.visual-gauge { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-gauge[class*="theme-"] { background: linear-gradient(155deg, rgb(30, 16, 51) 0%, rgb(76, 29, 149) 42%, rgb(49, 46, 129) 100%) !important; color: rgb(245, 243, 255) !important; border: 1px solid rgba(167, 139, 250, 0.22) !important; }

.visual-gauge .coo-bg-orb { display: none !important; }

.visual-gauge .coo-hook { background: rgba(167, 139, 250, 0.2) !important; color: rgb(221, 214, 254) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-gauge .coo-btn { box-shadow: rgba(139, 92, 246, 0.35) 0px 4px 18px; background: rgb(248, 250, 252) !important; color: rgb(76, 29, 149) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-gauge-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 55% 45%, rgba(139, 92, 246, 0.18) 0%, transparent 50%), radial-gradient(circle at 20% 80%, rgba(251, 191, 36, 0.08) 0%, transparent 42%); }

.coo-gauge-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-gauge-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.35) 0%, rgba(76, 29, 149, 0.45) 100%); border: 1px solid rgba(167, 139, 250, 0.25); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-gauge-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 4; }

.coo-gauge-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 58%; }

.coo-gauge-warn-pill { display: inline-flex; align-items: center; gap: 2px; font-size: 4px; font-weight: 800; color: rgb(253, 230, 138); padding: 1px 4px; border-radius: 99px; background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(251, 191, 36, 0.35); animation: coo-gauge-warn-pulse var(--g-dur, 8s) ease-in-out infinite; }

.coo-gauge-warn-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(251, 191, 36); }

@keyframes coo-gauge-warn-pulse { 
  0%, 35% { opacity: 0.45; transform: scale(0.96); }
  45%, 70% { opacity: 1; transform: scale(1); box-shadow: rgba(251, 191, 36, 0.5) 0px 0px 8px; }
  80%, 100% { opacity: 0.55; }
}

.coo-gauge-dial-wrap { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); width: 78%; aspect-ratio: 2 / 1.05; z-index: 2; }

.coo-gauge-arc-track { position: absolute; inset: 0px; border-radius: 100% 100% 0px 0px; background: conic-gradient(from 270deg at 50% 100%, rgb(239, 68, 68) 0deg, rgb(239, 68, 68) 32deg, rgb(245, 158, 11) 32deg, rgb(245, 158, 11) 72deg, rgb(34, 197, 94) 72deg, rgb(34, 197, 94) 180deg); mask: radial-gradient(farthest-side at 50% 100%, transparent calc(100% - 5px), rgb(0, 0, 0) calc(100% - 4px)); opacity: 0.85; }

.coo-gauge-arc-glow { position: absolute; inset: -2px 0px 0px; border-radius: 100% 100% 0px 0px; box-shadow: rgba(139, 92, 246, 0.35) 0px 0px 12px; pointer-events: none; }

.coo-gauge-ticks { position: absolute; inset: 0px; pointer-events: none; }

.coo-gauge-tick { position: absolute; bottom: 0px; left: 50%; width: 1px; height: 18%; background: rgba(255, 255, 255, 0.25); transform-origin: center bottom; }

.coo-gauge-tick:nth-child(1) { transform: translateX(-50%) rotate(-80deg); }

.coo-gauge-tick:nth-child(2) { transform: translateX(-50%) rotate(-40deg); }

.coo-gauge-tick:nth-child(3) { transform: translateX(-50%) rotate(0deg); height: 22%; background: rgba(255, 255, 255, 0.45); }

.coo-gauge-tick:nth-child(4) { transform: translateX(-50%) rotate(40deg); }

.coo-gauge-tick:nth-child(5) { transform: translateX(-50%) rotate(80deg); }

.coo-gauge-needle-hub { position: absolute; bottom: 0px; left: 50%; transform: translateX(-50%); width: 8px; height: 8px; border-radius: 50%; z-index: 5; background: linear-gradient(145deg, rgb(233, 213, 255), rgb(124, 58, 237)); border: 1px solid rgba(255, 255, 255, 0.35); box-shadow: rgba(139, 92, 246, 0.6) 0px 0px 6px; }

.coo-gauge-needle { position: absolute; bottom: 3px; left: 50%; width: 2px; height: 42%; margin-left: -1px; transform-origin: center bottom; background: linear-gradient(rgb(255, 255, 255), rgb(196, 181, 253)); border-radius: 2px; z-index: 4; box-shadow: rgba(255, 255, 255, 0.4) 0px 0px 4px; animation: coo-gauge-needle-sweep var(--g-dur, 8s) cubic-bezier(0.34, 1.2, 0.64, 1) infinite; }

@keyframes coo-gauge-needle-sweep { 
  0%, 12% { transform: rotate(62deg); }
  28%, 75% { transform: rotate(calc(-90deg + (180deg * var(--g-pct, 18) / 100))); }
  88%, 100% { transform: rotate(62deg); }
}

.coo-gauge-readout { position: absolute; bottom: 2px; left: 4px; right: 4px; display: flex; align-items: baseline; justify-content: center; gap: 3px; z-index: 4; }

.coo-gauge-readout-val { font-size: 9px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.03em; animation: coo-gauge-readout-flash var(--g-dur, 8s) ease-in-out infinite; }

.coo-gauge-readout-sub { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.05em; }

@keyframes coo-gauge-readout-flash { 
  0%, 30% { color: rgb(255, 255, 255); }
  40%, 72% { color: rgb(253, 230, 138); text-shadow: rgba(251, 191, 36, 0.5) 0px 0px 8px; }
  82%, 100% { color: rgb(255, 255, 255); }
}

.coo-gauge-zone-labels { position: absolute; bottom: 22%; left: 8%; right: 8%; display: flex; justify-content: space-between; z-index: 3; font-size: 3px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: rgba(255, 255, 255, 0.35); }

.coo-gauge-zone-low { color: rgba(248, 113, 113, 0.7); }

.coo-gauge-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-gauge-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-gauge-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-gauge-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-gauge-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-gauge.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-gauge.layout-banner-wide .coo-gauge-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-gauge.layout-banner-wide .coo-gauge-panel { width: 96px; height: 72px; border-radius: 8px; }

.visual-gauge.layout-banner-wide .coo-gauge-zone-labels { display: none; }

.visual-gauge.layout-banner-wide .coo-gauge-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-gauge.layout-banner-wide .coo-gauge-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-gauge.layout-banner-wide .coo-gauge-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-gauge.layout-banner-wide .coo-gauge-btn { padding: 6px 12px; font-size: 10px; }

.visual-gauge.layout-banner-wide .coo-gauge-btn .coo-arrow { display: none; }

.visual-gauge.layout-banner-wide .coo-brand { display: none; }

.visual-gauge.layout-square, .visual-gauge.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-gauge.layout-square .coo-gauge-square, .visual-gauge.layout-desktop-square .coo-gauge-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-gauge.layout-square .coo-gauge-square-top, .visual-gauge.layout-desktop-square .coo-gauge-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-gauge.layout-square .coo-gauge-panel, .visual-gauge.layout-desktop-square .coo-gauge-panel { width: 140px; height: 108px; border-radius: 12px; }

.visual-gauge.layout-square .coo-gauge-readout-val, .visual-gauge.layout-desktop-square .coo-gauge-readout-val { font-size: 11px; }

.visual-gauge.layout-square .coo-gauge-copy .coo-hook, .visual-gauge.layout-desktop-square .coo-gauge-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-gauge.layout-square .coo-gauge-title, .visual-gauge.layout-desktop-square .coo-gauge-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-gauge.layout-square .coo-gauge-desc, .visual-gauge.layout-desktop-square .coo-gauge-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-gauge.layout-square .coo-gauge-btn, .visual-gauge.layout-desktop-square .coo-gauge-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-gauge.layout-square .coo-brand, .visual-gauge.layout-desktop-square .coo-brand { display: none; }

.visual-gauge.layout-compact, .visual-gauge.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-gauge.layout-compact .coo-gauge-compact, .visual-gauge.layout-mobile .coo-gauge-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-gauge.layout-compact .coo-gauge-compact-top, .visual-gauge.layout-mobile .coo-gauge-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-gauge.layout-compact .coo-gauge-panel, .visual-gauge.layout-mobile .coo-gauge-panel { width: 72px; height: 62px; border-radius: 8px; }

.visual-gauge.layout-compact .coo-gauge-zone-labels, .visual-gauge.layout-mobile .coo-gauge-zone-labels { display: none; }

.visual-gauge.layout-compact .coo-gauge-warn-pill, .visual-gauge.layout-mobile .coo-gauge-warn-pill { font-size: 3px; padding: 1px 3px; }

.visual-gauge.layout-compact .coo-gauge-copy .coo-hook, .visual-gauge.layout-mobile .coo-gauge-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-gauge.layout-compact .coo-gauge-title, .visual-gauge.layout-mobile .coo-gauge-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-gauge.layout-compact .coo-gauge-desc, .visual-gauge.layout-mobile .coo-gauge-desc { display: none; }

.visual-gauge.layout-compact .coo-gauge-compact-foot, .visual-gauge.layout-mobile .coo-gauge-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-gauge.layout-compact .coo-gauge-btn, .visual-gauge.layout-mobile .coo-gauge-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-gauge.layout-compact .coo-gauge-btn .coo-arrow, .visual-gauge.layout-mobile .coo-gauge-btn .coo-arrow { display: none; }

.visual-gauge.layout-compact .coo-brand, .visual-gauge.layout-mobile .coo-brand { display: none; }

.visual-scan { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-scan[class*="theme-"] { background: linear-gradient(155deg, rgb(2, 44, 34) 0%, rgb(6, 95, 70) 45%, rgb(6, 78, 59) 100%) !important; color: rgb(236, 253, 245) !important; border: 1px solid rgba(16, 185, 129, 0.22) !important; }

.visual-scan .coo-bg-orb { display: none !important; }

.visual-scan .coo-hook { background: rgba(16, 185, 129, 0.22) !important; color: rgb(110, 231, 183) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-scan .coo-btn { box-shadow: rgba(16, 185, 129, 0.35) 0px 4px 18px; background: rgb(248, 250, 252) !important; color: rgb(6, 95, 70) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-scan-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 45% 55%, rgba(52, 211, 153, 0.14) 0%, transparent 50%), radial-gradient(circle at 85% 25%, rgba(239, 68, 68, 0.06) 0%, transparent 42%); }

.coo-scan-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-scan-phone { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgb(15, 23, 42) 0%, rgb(30, 41, 59) 100%); border: 2px solid rgba(255, 255, 255, 0.12); box-shadow: rgba(0, 0, 0, 0.45) 0px 8px 24px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset; }

.coo-scan-notch { position: absolute; top: 0px; left: 50%; transform: translateX(-50%); width: 28%; height: 3px; border-radius: 0px 0px 4px 4px; background: rgb(2, 6, 23); z-index: 6; }

.coo-scan-head { display: flex; align-items: center; justify-content: space-between; padding: 5px 5px 2px; z-index: 4; }

.coo-scan-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-scan-live { display: inline-flex; align-items: center; gap: 2px; font-size: 4px; font-weight: 800; color: rgb(110, 231, 183); padding: 1px 4px; border-radius: 99px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.28); }

.coo-scan-live-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: 1.2s ease-in-out 0s infinite normal none running coo-scan-live-blink; }

@keyframes coo-scan-live-blink { 
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

.coo-scan-viewport { position: absolute; inset: 14px 6px 22px; border-radius: 6px; background: rgba(0, 0, 0, 0.55); overflow: hidden; z-index: 2; }

.coo-scan-corner { position: absolute; width: 8px; height: 8px; z-index: 4; border-color: rgba(52, 211, 153, 0.85); border-style: solid; border-width: 0px; }

.coo-scan-corner-tl { top: 3px; left: 3px; border-top-width: 2px; border-left-width: 2px; border-radius: 2px 0px 0px; }

.coo-scan-corner-tr { top: 3px; right: 3px; border-top-width: 2px; border-right-width: 2px; border-radius: 0px 2px 0px 0px; }

.coo-scan-corner-bl { bottom: 3px; left: 3px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0px 0px 0px 2px; }

.coo-scan-corner-br { bottom: 3px; right: 3px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0px 0px 2px; }

.coo-scan-bars-wrap { position: absolute; left: 8%; right: 8%; top: 50%; transform: translateY(-50%); height: 28%; display: flex; align-items: stretch; gap: 1px; padding: 3px 4px; background: rgb(255, 255, 255); border-radius: 2px; box-shadow: rgba(0, 0, 0, 0.3) 0px 2px 8px; }

.coo-scan-bar { min-width: 1px; background: rgb(15, 23, 42); border-radius: 0.5px; animation: coo-scan-bar-glow var(--sc-dur, 7s) ease-out infinite; }

@keyframes coo-scan-bar-glow { 
  0%, 22% { opacity: 0.55; }
  32%, 58% { opacity: 1; box-shadow: rgba(52, 211, 153, 0.4) 0px 0px 4px; }
  68%, 100% { opacity: 0.7; }
}

.coo-scan-laser { position: absolute; left: 4px; right: 4px; height: 2px; z-index: 5; background: linear-gradient(90deg, transparent, rgb(239, 68, 68), rgb(252, 165, 165), rgb(239, 68, 68), transparent); box-shadow: rgb(239, 68, 68) 0px 0px 8px, rgba(239, 68, 68, 0.4) 0px 0px 16px; top: 12%; opacity: 0; animation: coo-scan-laser-sweep var(--sc-dur, 7s) ease-in-out infinite; }

@keyframes coo-scan-laser-sweep { 
  0%, 8% { top: 10%; opacity: 0; }
  12%, 14% { opacity: 1; }
  38%, 42% { top: 78%; opacity: 1; }
  48%, 100% { top: 78%; opacity: 0; }
}

.coo-scan-flash { position: absolute; inset: 0px; z-index: 6; pointer-events: none; background: rgba(52, 211, 153, 0.25); opacity: 0; animation: coo-scan-flash-hit var(--sc-dur, 7s) ease-out infinite; }

@keyframes coo-scan-flash-hit { 
  0%, 40% { opacity: 0; }
  44%, 48% { opacity: 1; }
  54%, 100% { opacity: 0; }
}

.coo-scan-toast { position: absolute; left: 4px; right: 4px; bottom: -100%; z-index: 7; display: flex; align-items: center; gap: 4px; padding: 3px 5px; border-radius: 5px; background: rgba(255, 255, 255, 0.96); border: 1px solid rgba(16, 185, 129, 0.35); box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 12px; animation: coo-scan-toast-in var(--sc-dur, 7s) cubic-bezier(0.22, 1, 0.36, 1) infinite; }

@keyframes coo-scan-toast-in { 
  0%, 42% { bottom: -100%; opacity: 0; }
  50%, 72% { bottom: 4px; opacity: 1; }
  82%, 100% { bottom: 4px; opacity: 0.85; }
}

.coo-scan-toast-check { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; background: rgb(34, 197, 94); color: rgb(255, 255, 255); font-size: 6px; font-weight: 800; display: flex; align-items: center; justify-content: center; line-height: 1; }

.coo-scan-toast-body { min-width: 0px; flex: 1 1 0%; }

.coo-scan-toast-name { font-size: 4px; font-weight: 800; color: rgb(15, 23, 42); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-scan-toast-code { font-size: 3px; font-weight: 600; color: rgb(100, 116, 139); font-family: ui-monospace, monospace; letter-spacing: 0.04em; }

.coo-scan-toast-delta { font-size: 5px; font-weight: 800; color: rgb(5, 150, 105); flex-shrink: 0; }

.coo-scan-footer { position: absolute; bottom: 2px; left: 4px; right: 4px; display: flex; align-items: center; justify-content: space-between; padding: 2px 5px; border-radius: 5px; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(16, 185, 129, 0.2); z-index: 4; }

.coo-scan-count-val { font-size: 8px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.03em; animation: coo-scan-count-pop var(--sc-dur, 7s) ease-out infinite; }

@keyframes coo-scan-count-pop { 
  0%, 43% { transform: scale(1); color: rgb(255, 255, 255); }
  48%, 58% { transform: scale(1.12); color: rgb(110, 231, 183); }
  65%, 100% { transform: scale(1); }
}

.coo-scan-count-sub { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.05em; }

.coo-scan-beep { font-size: 6px; line-height: 1; opacity: 0; animation: coo-scan-beep-flash var(--sc-dur, 7s) ease-out infinite; }

@keyframes coo-scan-beep-flash { 
  0%, 43% { opacity: 0; transform: scale(0.8); }
  46%, 52% { opacity: 1; transform: scale(1.1); }
  58%, 100% { opacity: 0; }
}

