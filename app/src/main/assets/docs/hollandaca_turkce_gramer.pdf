.visual-inbox.layout-square .coo-inbox-b1, .visual-inbox.layout-desktop-square .coo-inbox-b1 { left: 8px; top: 12px; }

.visual-inbox.layout-square .coo-inbox-b2, .visual-inbox.layout-desktop-square .coo-inbox-b2 { left: 6px; top: 38px; }

