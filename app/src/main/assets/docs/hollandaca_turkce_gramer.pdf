.visual-vault[class*="theme-"] { background: linear-gradient(155deg, rgb(5, 8, 16) 0%, rgb(12, 18, 34) 50%, rgb(8, 13, 24) 100%) !important; color: rgb(241, 245, 249) !important; border: 1px solid rgba(56, 189, 248, 0.12) !important; }

.visual-vault[class*="theme-"] .coo-hook { background: rgba(56, 189, 248, 0.15) !important; color: rgb(125, 211, 252) !important; animation: auto ease 0s 1 normal none running none !important; }

