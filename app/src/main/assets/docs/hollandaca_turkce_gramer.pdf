.visual-bridge.layout-banner-wide .coo-bridge-btn { padding: 6px 12px; font-size: 10px; }

.visual-bridge.layout-banner-wide .coo-bridge-btn .coo-arrow { display: none; }

.visual-bridge.layout-banner-wide .coo-brand { display: none; }

