.hmenu-order { display: block; position: relative; padding: 0px 1.25rem; }

.hmenu-order > a { display: block; line-height: 32px; height: 38px; font-weight: 700; }

.hmenu-order > a::after { content: ""; position: absolute; left: 0px; top: 0px; bottom: 0px; width: 100%; z-index: 1; }

.hmenu-order > i { position: absolute; right: 8px; top: 50%; margin-top: -13px; }

@media (max-width: 991px) {
  .header-panel .logotype { margin: 0px auto; }
  .menu-butter { order: -1; padding: 0.625rem; border: 0px; background: 0px 0px; color: rgb(76, 203, 112); transition: transform 0.2s; display: block !important; }
  .menu-butter:active { transform: scale(0.95); }
  .butterbrod { width: 1.25rem; height: 1rem; display: flex; justify-content: space-between; flex-direction: column; position: relative; flex-shrink: 0; }
  .butterbrod > i { width: 100%; height: 3px; background-color: currentcolor; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 2px; transition: 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); transform-origin: center center; display: block; flex-shrink: 0; }
  .butterbrod > i:nth-child(1) { transition-delay: 0s; align-self: flex-start; }
  .butterbrod > i:nth-child(2) { transition-delay: 0.05s; align-self: center; }
  .butterbrod > i:nth-child(3) { transition-delay: 0.1s; align-self: flex-end; }
  html.mm .menu-butter .butterbrod > i:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  html.mm .menu-butter .butterbrod > i:nth-child(2) { opacity: 0; transform: scaleX(0); }
  html.mm .menu-butter .butterbrod > i:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .head-tools { position: fixed; left: 0px; top: 0px; bottom: 0px; z-index: 9999; width: 100%; min-height: 100%; overflow: hidden auto; opacity: 0; transition: opacity 0.2s; background-color: rgba(0, 0, 0, 0.3); backdrop-filter: blur(5px); }
  .mm-overlay { position: absolute; inset: 0px; z-index: -1; }
  .head-tools.open, .head-tools.open .mm-overlay, .q-search, .hmenu-sub, .menu-close { display: block !important; }
  .head-tools-panel { width: 100%; padding: 2rem; position: relative; display: flex; flex-direction: column; background-color: var(--modal-bg); box-shadow: rgba(0, 0, 0, 0.1) 0px 0.5rem 1.5rem -0.25rem; border-radius: 1.75rem; transition: transform 0.4s; }
  .head-tools-panel::before { content: ""; display: block; height: 2.5rem; order: -1; }
  .menu-close { position: absolute; top: 0px; right: 0px; margin: 1rem; width: 2.5rem; height: 2.5rem; padding: 0.5rem; }
  .menu-close i { display: block; }
  .q-search { order: -1; margin-bottom: 2rem; padding-top: 1.5rem; }
  .q-search-label { position: absolute; bottom: 100%; width: 100%; text-align: center; opacity: 0.5; text-transform: uppercase; font-size: 0.75rem; }
  .hmenu { display: flex; flex-wrap: wrap; margin: -0.5rem; }
  .hmenu > a { width: 100%; max-width: 50%; flex: 0 0 50%; padding: 0.5rem; font-weight: 700; color: inherit !important; }
  .hmenu > a span { display: block; text-align: center; padding: 0.75rem; border-radius: 1.125rem; }
  .hmenu > a .c-icon { display: block; margin: 0px auto 0.5rem; color: rgb(255, 255, 255); }
  a.hm-games > span { background-color: rgba(254, 216, 74, 0.1); }
  a.hm-apps > span { background-color: rgba(151, 79, 229, 0.1); }
  a.hm-top > span { background-color: rgba(251, 96, 72, 0.1); }
  a.hm-news > span { background-color: rgba(55, 164, 227, 0.1); }
  .hmenu-more { width: 100%; margin-top: 1rem; padding: 0.5rem; }
  .hmenu-more .dropdown-menu { position: static; border: 0px !important; background: 0px 0px !important; box-shadow: none !important; }
  .hmenu-order { background-color: rgba(76, 203, 112, 0.1); border-radius: 8px; margin-top: 5px; }
  .hmenu-more-btn { display: none !important; }
  .hmenu-sub { margin-top: 1rem; }
  .hmenu-sub a { display: block; text-align: center; padding: 0.25rem; color: inherit; font-size: 0.875rem; opacity: 0.5; }
  .toolbar { transition: transform 0.4s; }
  html.mm body { overflow: hidden; }
  html.mm .head-tools.open { opacity: 1; }
  html.mm .head-tools.open .head-tools-panel { transform: translateY(0%); }
  html.mm .toolbar { transform: translateY(100%); }
}

@media (min-width: 640px) and (max-width: 991px) {
  .head-tools { padding: 2rem; }
  .head-tools-panel { max-width: 30rem; margin: 0px auto; transform: translateY(2rem); }
}

@media (max-width: 639px) {
  .head-tools { padding-right: 2rem; }
  .head-tools-panel { min-height: 100%; max-width: 24rem; border-top-left-radius: 0px; border-bottom-left-radius: 0px; transform: translateX(-2rem); }
  .hmenu { margin: -0.25rem; }
  .hmenu > a, .hmenu-more { padding: 0.25rem; }
}

.q-search-box { position: relative; }

.q-search-btn { position: absolute; right: 0px; top: 0px; border: 0px; transition: color 0.2s; width: 2.5rem; height: 2.5rem; padding: 0.5rem; background: 0px 0px; color: inherit !important; }

.q-search-btn:hover { color: rgb(76, 203, 112) !important; }

.q-search-btn i { display: block; line-height: normal; }

.q-search-text { border-radius: 8px !important; padding-left: 1rem !important; }

@media (min-width: 992px) {
  .q-search.open { display: block !important; }
  .q-search { margin-top: -2.5rem; opacity: 0; transform: translateY(1rem); }
  .hmenu, .q-search, .q-search-call > i { transition: transform 0.2s, opacity 0.2s; }
  .hmenu { transform: translateY(0px); opacity: 1; display: flex; justify-content: space-around; }
  .q-search-label { display: none; }
  .q-search-call { color: inherit; position: relative; display: block !important; }
  .q-search-call:hover { opacity: 0.8; }
  .q-search-call > i.qs-2 { opacity: 0; transform: scale(0.8); position: absolute; top: 12px; left: 0px; right: 0px; }
  .qs .q-search { transform: translateY(0px); opacity: 1; }
  .qs .hmenu { transform: translateY(-1rem); opacity: 0; pointer-events: none; }
  .qs .q-search-call { background-color: rgba(23, 43, 61, 0.05); }
  .qs .q-search-call > i.qs-1 { opacity: 0; transform: scale(0.8); }
  .qs .q-search-call > i.qs-2 { opacity: 1; transform: scale(1); }
}

#searchsuggestions { z-index: 102; border-radius: 0.75rem; background: var(--searchsug); padding: 0.5rem; width: 17.5rem; font-size: 0.875rem; overflow: hidden auto; max-height: 20rem; }

@media (min-width: 992px) {
  #searchsuggestions { width: 37rem; position: fixed !important; left: 50% !important; top: 3.5rem !important; transform: translateX(-50%) !important; }
}

@media (max-width: 767px) {
  #searchsuggestions { width: 300px; }
}

@media (min-width: 768px) and (max-width: 1024px) {
  #searchsuggestions { width: 410px; }
}

#searchsuggestions:hover { display: block !important; }

#searchsuggestions a, #searchsuggestions span.notfound { padding: 0.75rem 1.25rem; display: block; text-decoration: none; border-radius: 0.5rem; }

#searchsuggestions a + a { margin-top: 0.125rem; }

#searchsuggestions a { color: inherit; background-color: var(--searchsug-item); }

#searchsuggestions a .searchheading { transition: color 0.2s; }

#searchsuggestions a:hover .searchheading { color: rgb(76, 203, 112); }

#searchsuggestions a span { display: flex; align-items: center; gap: 6px; cursor: pointer; }

#searchsuggestions span.searchheading { display: flex; align-items: center; gap: 6px; font-weight: 700; margin-bottom: 0.2em; }

.searchheading .img-container { width: 40px; height: 60px; overflow: hidden; flex-shrink: 0; }

.searchheading .img-container img { width: 100%; height: 100%; object-fit: cover; }

#searchsuggestions span.seperator a { padding: 10px 0px; text-align: center; border: 0px; background-color: transparent; color: rgb(145, 145, 145); }

#searchsuggestions .break, #searchsuggestions span.seperator { display: none !important; }

.speedbar-panel { background-color: rgb(40, 155, 127); z-index: 1; position: relative; background-image: linear-gradient(90deg, rgb(76, 203, 112) 0%, rgb(48, 164, 120) 100%); box-shadow: rgba(0, 0, 0, 0.15) 0px 0.25rem 1.5rem 0px; margin-top: -2.5rem; padding-top: 2.5rem; padding-left: 1.5rem; padding-right: 1.5rem; font-weight: 700; color: rgba(255, 255, 255, 0.5); font-size: 0.75rem; border-bottom-left-radius: 1.75rem; border-bottom-right-radius: 1.75rem; }

.speedbar-panel > span { display: block; line-height: 1.25rem; padding: 0.375rem 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.speedbar-panel a { color: rgb(255, 255, 255); }

.speedbar-panel a:hover { color: rgba(255, 255, 255, 0.8); }

@media (max-width: 991px) {
  .wrp-min.speedbar { padding: 0px !important; }
}

@media (min-width: 768px) {
  .speedbar-panel { float: left; max-width: calc(100% - 2.5rem); padding-left: 1.5rem; padding-right: 1rem; border-bottom-left-radius: 2.25rem; border-bottom-right-radius: 1.125rem; }
}

.anchor-line { overflow: hidden; height: 0px; }

.anchor-line > span { margin-top: -4.5rem; display: block; }

.page-head-main { text-align: center; margin-top: -4.5rem; padding-top: 4.5rem; position: relative; overflow: hidden; pointer-events: none; }

.page-head-main > .title { font-size: 1.5rem; line-height: 1.3; max-width: 14rem; margin: 2rem auto; color: var(--main-heading); pointer-events: auto; }

.page-head-main > img { position: absolute; left: 50%; bottom: 0px; transform: translate(-50%, -7%); width: 50rem; height: auto; pointer-events: none; }

.section { margin-bottom: 2rem; }

.section-title, .section-head, .static-page .title { margin-bottom: 1rem; }

.section-head { display: flex; align-items: center; }

.section-head .section-title { margin-bottom: 0px; margin-right: auto; }

.section-title { font-size: 1rem; line-height: 1.3; display: flex; align-items: center; }

.static-page .title { font-size: 1.25rem; line-height: 1.3; }

.section-title > .c-icon { margin-right: 1rem; color: rgb(255, 255, 255); }

.btn-all + .btn-all { display: none !important; }

@media (min-width: 500px) {
  .page-head-main > .title { font-size: 2rem; max-width: 22rem; margin: 3rem auto; }
  .page-head-main > img { width: 70rem; }
}

@media (max-width: 639px) {
  .btn-all { padding: 0.25rem; width: 2rem; height: 2rem; display: flex; justify-content: center; align-items: center; }
  .btn-all > span { display: none; }
  .btn-all > i { display: block; }
}

@media (min-width: 640px) {
  .section-title { font-size: 1.25rem; }
  .btn-all i { display: none !important; }
}

@media (min-width: 768px) {
  .page-head-main + .section { margin-top: -2rem; }
}

@media (min-width: 992px) {
  .section-title, .static-page .title { font-size: 1.5rem; }
}

@media (min-width: 1040px) {
  .page-head-main > .title { font-size: 2.5rem; max-width: 28rem; margin: 4rem auto; }
  .page-head-main > img { width: 88rem; }
  .section { margin-bottom: 3.5rem; }
  .section-title, .section-head, .static-page .title { margin-bottom: 1.5rem; }
}

.dark-section { color: rgb(255, 255, 255); background-color: var(--dark-section-bg); position: relative; margin-top: auto; z-index: 0; }

.dark-foot { padding-top: 2rem; }

@media (max-width: 767px) {
  .dark-foot { border-radius: 1.75rem 1.75rem 0px 0px; }
}

@media (min-width: 1040px) {
  .dark-foot { padding-top: 3.5rem; }
  .dark-foot .background { margin-top: -1.5rem; display: block !important; }
  .dark-foot .bg-clouds i { max-width: 2550px; min-width: 2550px; height: auto; }
  .dark-foot .bg-circle-green { top: 1.5rem; left: 50%; transform: translate(0%, 0%); }
}

.dark-head { padding-top: 5.5rem; margin-top: -5.5rem; }

@media (min-width: 768px) {
  .dark-head { padding-top: 6.5rem; margin-top: -6.5rem; }
}

@media (min-width: 992px) {
  .dark-head .background { display: block !important; margin-bottom: -1.5rem; }
  .dark-head .bg-clouds { bottom: 0px; z-index: 1; }
  .dark-head .bg-clouds i { max-width: 2550px; min-width: 2550px; height: auto; }
  .dark-head .bg-circle-green { bottom: 5%; left: 50%; transform: translate(0%, -30%); z-index: 1; }
}

.block { background-color: var(--block-bg); border-radius: 1.125rem; margin-top: 1rem; }

.block-list > .block:first-child { margin-top: 0px; }

.dark-section .block { background-color: var(--block-dark-bg); }

.block img { max-width: 100%; }

.b-cont, .b-head, .b-icon-title { padding: 1.5rem; }

.b-title { font-size: 1rem; line-height: 1.3; font-weight: 700; }

.b-cont video, .b-cont iframe { max-width: 100%; vertical-align: top; }

.b-head { display: flex; align-items: center; }

.b-head .section-title { margin-bottom: 0px; margin-right: auto; }

.b-head .btn { margin-left: 0.5rem; }

@media (max-width: 639px) {
  .wrp-min.block-list { padding-left: 0px; padding-right: 0px; }
  .b-add-info { border-top-left-radius: 0px !important; border-top-right-radius: 0px !important; }
  .b-comments .b-head .btn-all i { transform: rotate(90deg); }
  .b-comments .b-cont { padding-left: 0px; padding-right: 0px; }
}

@media (min-width: 640px) {
  .b-cont, .b-head, .b-icon-title { padding: 2rem; }
  .b-title { font-size: 1.25rem; }
  .b-head .btn { margin-left: 1rem; }
}

@media (min-width: 992px) {
  .b-title { font-size: 1.5rem; }
}

@media (min-width: 1040px) {
  .block { margin-top: 2rem; }
}

.b-icon-title { padding-bottom: 0px; margin-bottom: 1.5rem; position: relative; text-align: center; }

.b-icon-title .c-icon { position: absolute; left: 50%; top: 0px; transform: translate(-50%, -50%); }

.b-icon-title .b-title { text-transform: uppercase; margin-top: 0.5rem; margin-bottom: 0px; }

.b-icon-title .c-icon + .b-title { margin-top: 0.25rem !important; }

.b-icon-title + .b-cont { padding-top: 0px; }

.b-tabs { padding: 0px 0.5rem; overflow: hidden; display: flex; font-weight: 700; }

@media (min-width: 640px) {
  .b-tabs { padding: 0px 1rem; }
}

.b-tabs + .b-cont, .b-head + .b-cont { padding-top: 0px; }

.b-tabs > a { height: 4.5rem; line-height: 1.5rem; padding: 1.5rem 1rem; position: relative; }

.b-tabs > a:not(.active) { color: inherit !important; }

.b-tabs > a::after { content: ""; height: 0px; border-top: 0.5rem solid; border-radius: 0.25rem; position: absolute; left: 1rem; right: 1rem; top: 0px; margin-top: -0.25rem; opacity: 0; transform: translateY(-0.5rem); background-color: rgb(76, 203, 112); transition: opacity 0.2s, transform 0.2s; }

.b-tabs > a.active::after { opacity: 1; transform: translateY(0px); }

.navigation { display: flex; width: 100%; margin-top: 2rem; position: relative; text-align: center; }

@media (min-width: 992px) {
  .entry-listpage #dle-content > .wrp-min { padding-left: 1rem; padding-right: 1rem; padding-bottom: 1rem; max-width: 61rem; }
  .entry-listpage #dle-content > .wrp-min > .navigation { margin-top: 1rem; }
}

@media (min-width: 640px) {
  .entry-listpage #dle-content > .wrp-min { padding-left: 0.5rem; padding-right: 0.5rem; padding-bottom: 0.5rem; }
  .entry-listpage #dle-content > .wrp-min > .navigation { margin-top: 1.5rem; }
}

@media (max-width: 639px) {
  .entry-listpage #dle-content > .wrp-min { padding-left: 0.25rem; padding-right: 0.25rem; padding-bottom: 0.25rem; }
  .entry-listpage #dle-content > .wrp-min > .navigation { margin-top: 1.75rem; }
  .b-comments .b-cont .navigation { margin-top: 1.5rem; padding-left: 1.5rem; padding-right: 1.5rem; }
}

.navigation a { color: inherit; }

.pages, .navigation i { display: block; }

.pages { border-radius: 1.25rem; min-width: 0px; flex: 1 1 auto; display: flex; justify-content: center; }

.pages-list { display: flex; margin: 0px auto; }

.pages-list > *, .page_prev > *, .page_next > * { display: block; line-height: 1.5rem; height: 2.5rem; font-weight: 700; padding: 0.5rem; border-radius: 2rem; transition: background-color 0.2s, color 0.2s; }

.page_prev { margin-right: 0.5rem; }

.page_next { margin-left: 0.5rem; }

.page_prev > a, .page_next > a { background-color: rgb(69, 195, 104); color: rgb(255, 255, 255); background-image: linear-gradient(rgb(76, 203, 112) 0%, rgb(61, 186, 96) 100%); box-shadow: rgba(69, 195, 104, 0.3) 0px 0.25rem 0.5rem 0px; }

.page_prev > span, .page_next > span { opacity: 0.5; color: rgb(255, 255, 255); background-color: rgba(23, 43, 61, 0.2); }

@media (max-width: 767px) {
  .pages-list { margin: -1.5rem 0px; padding: 1.5rem 0px; overflow: auto hidden; }
  .pages-list span:not(.nav_ext) { color: rgb(76, 203, 112); }
  .pages-list::after, .pages-list::before { content: ""; max-width: 1rem; min-width: 1rem; height: 1rem; }
  .pages-list > * { padding-left: 0.75rem; padding-right: 0.75rem; }
  .pages { overflow: hidden; background-color: var(--block-bg); position: relative; }
  .pages::after, .pages::before { content: ""; position: absolute; z-index: 1; top: 0px; width: 2rem; height: 100%; pointer-events: none; border-radius: 1.25rem; }
  .pages::before { border-bottom-right-radius: 0px; border-top-right-radius: 0px; left: 0px; background-image: linear-gradient(90deg,var(--block-bg) 0%,var(--block-bg-transp) 100%); }
  .pages::after { border-bottom-left-radius: 0px; border-top-left-radius: 0px; right: 0px; background-image: linear-gradient(-90deg,var(--block-bg) 0%,var(--block-bg-transp) 100%); }
}

@media (min-width: 768px) {
  .pages-list > * { margin: 0px 0.125rem; }
  .pages-list > *, .page_prev > *, .page_next > * { font-size: 1.125rem; min-width: 2.5rem; }
  .pages-list span:not(.nav_ext) { background-color: rgb(249, 189, 59); color: rgb(255, 255, 255); background-image: linear-gradient(rgb(254, 222, 74) 0%, rgb(248, 176, 53) 100%); box-shadow: rgba(251, 205, 66, 0.3) 0px 0.25rem 0.5rem 0px; }
}

@media (min-width: 992px) {
  .pages-list a:hover { background-color: rgba(76, 203, 112, 0.1); color: rgb(76, 203, 112); }
}

.page-orders { margin-top: 0px !important; }

.order-form { background-color: var(--spoiler); padding: 1rem; border-radius: 0.5rem; margin: 1.5rem 0px; }

.order-form .form-submit { margin-top: 1rem; }

.fullblog ul { list-style: none; }

.fullblog li { position: relative; }

.fullblog li::before { left: -10px; position: absolute; top: 8px; margin: 2px 0px 0px; vertical-align: middle; display: inline-block; width: 5px; height: 5px; background: var(--tcolor); content: ""; border-radius: 50%; }

.skitab { margin-top: 9px; }

.skitab img { margin-right: 7px; width: 15px; height: 15px; }

.groups ol, .groups ul, .groups dl { list-style: disc; padding: 0px; margin: 0px; }

.groups h2, .groups h3, .groups h4, .groups h5 { margin-top: -3px; margin-bottom: 0px; font-size: 1.2rem; }

textarea#comments { height: 90px; }

@media (max-width: 700px) {
  .actions { display: none !important; }
}

.install-app-container { display: none; }

.install-app-container button { height: 37px; padding: 0px 10px; border-radius: 9px; background: rgb(66, 192, 101); color: rgb(255, 255, 255); cursor: pointer; }

.f-icons { padding: 2px; border-radius: 50%; margin: 0px 2px; }

.msosial { margin: 0px auto; max-width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; padding: 12px 0px; flex-wrap: wrap; }

.f-icons { position: relative; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 50%; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 8px; backdrop-filter: blur(10px); }

.f-icons a { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; text-decoration: none; position: relative; border-radius: 50%; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); background: linear-gradient(45deg, rgba(255, 255, 255, 0.1), rgba(0, 0, 0, 0.05)); border: 1px solid rgba(255, 255, 255, 0.2); }

.f-icons a i { font-size: 14px; color: rgb(255, 255, 255); transition: 0.3s; z-index: 2; }

.f-icons a[href*="threads"] { background: linear-gradient(45deg, rgb(0, 0, 0), rgb(51, 51, 51)); }

.f-icons a[href*="threads"]:hover { background: linear-gradient(45deg, rgb(26, 26, 26), rgb(0, 0, 0)); transform: translateY(-3px) scale(1.1); box-shadow: rgba(0, 0, 0, 0.3) 0px 8px 25px; }

.f-icons a[href*="facebook"] { background: linear-gradient(45deg, rgb(24, 119, 242), rgb(13, 71, 161)); }

.f-icons a[href*="facebook"]:hover { background: linear-gradient(45deg, rgb(13, 71, 161), rgb(24, 119, 242)); transform: translateY(-3px) scale(1.1); box-shadow: rgba(24, 119, 242, 0.4) 0px 8px 25px; }

.f-icons a[href*="instagram"] { background: linear-gradient(45deg, rgb(228, 64, 95), rgb(131, 58, 180), rgb(252, 204, 99)); }

.f-icons a[href*="instagram"]:hover { background: linear-gradient(45deg, rgb(252, 204, 99), rgb(228, 64, 95), rgb(131, 58, 180)); transform: translateY(-3px) scale(1.1); box-shadow: rgba(228, 64, 95, 0.4) 0px 8px 25px; }

.f-icons a[href*="youtube"] { background: linear-gradient(45deg, red, rgb(204, 0, 0)); }

.f-icons a[href*="youtube"]:hover { background: linear-gradient(45deg, rgb(204, 0, 0), red); transform: translateY(-3px) scale(1.1); box-shadow: rgba(255, 0, 0, 0.4) 0px 8px 25px; }

.f-icons a[href*="twitter"] { background: linear-gradient(45deg, rgb(29, 161, 242), rgb(13, 139, 217)); }

.f-icons a[href*="twitter"]:hover { background: linear-gradient(45deg, rgb(13, 139, 217), rgb(29, 161, 242)); transform: translateY(-3px) scale(1.1); box-shadow: rgba(29, 161, 242, 0.4) 0px 8px 25px; }

.f-icons a[href*="whatsapp"] { background: linear-gradient(45deg, rgb(37, 211, 102), rgb(18, 140, 126)); }

.f-icons a[href*="whatsapp"]:hover { background: linear-gradient(45deg, rgb(18, 140, 126), rgb(37, 211, 102)); transform: translateY(-3px) scale(1.1); box-shadow: rgba(37, 211, 102, 0.4) 0px 8px 25px; }

.f-icons a[href*="telegram"], .f-icons a[href*="t.me"] { background: linear-gradient(45deg, rgb(0, 136, 204), rgb(0, 107, 179)); }

.f-icons a[href*="telegram"]:hover, .f-icons a[href*="t.me"]:hover { background: linear-gradient(45deg, rgb(0, 107, 179), rgb(0, 136, 204)); transform: translateY(-3px) scale(1.1); box-shadow: rgba(0, 136, 204, 0.4) 0px 8px 25px; }

.f-icons:hover { transform: translateY(-2px); }

.f-icons a:hover i { transform: scale(1.1); text-shadow: rgba(255, 255, 255, 0.5) 0px 0px 10px; }

.f-icons a::before { content: ""; position: absolute; inset: -3px; border-radius: 50%; background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.3), transparent); opacity: 0; transform: rotate(0deg); transition: 0.3s; z-index: 1; }

.f-icons a:hover::before { opacity: 1; transform: rotate(180deg); }

@media (max-width: 768px) {
  .msosial { gap: 6px; padding: 10px 0px; }
  .f-icons a { width: 28px; height: 28px; }
  .f-icons a i { font-size: 12px; }
}

@media (max-width: 480px) {
  .msosial { gap: 5px; padding: 8px 0px; }
  .f-icons a { width: 26px; height: 26px; }
  .f-icons a i { font-size: 11px; }
}

html.darktheme .f-icons a { border: 1px solid rgba(255, 255, 255, 0.1); background: linear-gradient(45deg, rgba(255, 255, 255, 0.05), rgba(0, 0, 0, 0.1)); }

html.darktheme .f-icons:hover { box-shadow: rgba(255, 255, 255, 0.1) 0px 4px 15px; }

.f-icons a:focus { outline: rgba(255, 255, 255, 0.8) solid 2px; outline-offset: 2px; }

.f-icons a:focus:not(:focus-visible) { outline: none; }

@keyframes pulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.f-icons.loading a { animation: 1.5s ease-in-out 0s infinite normal none running pulse; }

.msosial img { display: none; }

.group-icon img { padding: 2px; width: 28px; height: 28px; }

.group-icon-userinfo img { padding: 2px; width: 40px; height: 40px; }

.popup_userinfo_top .group-icon { display: flex; margin-top: -3px; }

.user-sosial { float: right; }

.user-sosial .f-icons { float: left; padding: 0px; margin: 0px; }

.user-sosial img { width: 28px; height: 28px; }

.beebanner { width: 100%; display: grid; background: var(--entry-bg); border-radius: 18px; align-content: center; align-items: center; }

a.whatsapp { background-color: rgb(37, 211, 102); color: rgb(255, 255, 255); font-variant: full-width; padding: 17px; width: 32%; margin-left: 1%; border-radius: 10px; text-align: center; }

a.mavi { background-color: rgb(55, 169, 228); background-image: linear-gradient(rgb(56, 185, 230) 0%, rgb(54, 139, 225) 100%); color: rgb(255, 255, 255); font-variant: full-width; padding: 16px; width: 32%; border-radius: 10px; text-align: center; }

.destekle { display: flex; flex-flow: row; }

a.qirmizi { background-color: rgb(203, 32, 39); background-image: linear-gradient(rgb(222, 65, 42) 0%, rgb(203, 32, 39) 100%); color: rgb(255, 255, 255); font-variant: full-width; padding: 17px; width: 49%; margin-left: 1%; border-radius: 10px; text-align: center; }

a.instagram { background-color: rgb(203, 32, 39); background-image: radial-gradient(circle at 0% 150%, rgb(255, 225, 125) 0%, rgb(255, 205, 105) 12%, rgb(250, 145, 55) 25%, rgb(235, 65, 65) 41%, transparent 95%), linear-gradient(-15deg, rgb(35, 75, 215) -10%, rgb(195, 60, 190) 65%); color: rgb(255, 255, 255); font-variant: full-width; padding: 17px; width: 32%; margin-left: 1%; border-radius: 10px; text-align: center; }

a.emir { background-color: rgb(203, 32, 39); background-image: linear-gradient(rgb(222, 65, 42) 0%, rgb(203, 32, 39) 100%); color: rgb(255, 255, 255); font-variant: full-width; padding: 16px; width: 32%; border-radius: 10px; text-align: center; margin-left: 1%; }

.destek a:hover { color: rgb(255, 255, 255); }

.vip-zone span { float: right; background: rgb(52, 153, 81); border-radius: 10px; padding: 3px 14px; }

h1.title.titlenew { text-transform: capitalize; }

@media (max-width: 780px) {
  .footer__download-links { margin-bottom: 36px; }
  .footer__download-links h3, .footer__download-links img { display: none; }
  .footer__download-links .mobile-store { margin-top: 0px; }
  .footer__download-links .mobile-store li a { width: 196px; padding: 8px 20px; }
  .footer__download-links .mobile-store li a p { font-size: 14px; line-height: 16px; }
  .footer__download-links .mobile-store li a img { display: block; margin-right: 12px; width: 24px; height: 24px; }
  .Article__GwHlZ .Article_bottom_info { width: 85%; }
}

.footer__download-links { text-align: center; }

.footer__download-links h3 { font-weight: 700; font-size: 14px; line-height: 18px; color: rgb(250, 250, 250); margin-bottom: 24px; }

.footer__download-links .mobile-store { display: flex; flex-direction: column; align-items: center; margin-top: 24px; }

.footer__download-links .mobile-store li { margin-bottom: 16px; }

.footer__download-links .mobile-store li:last-child { margin-bottom: 0px; }

.footer__download-links .mobile-store li a { display: flex; align-items: center; background: rgb(255, 255, 255); border-radius: 6px; padding: 6px 10px; color: rgb(46, 49, 49); min-width: 130px; width: 170px; font-size: 12px; }

.footer__download-links .mobile-store li a p { display: flex; flex-direction: column; font-size: 14px; line-height: 18px; text-align: start; margin: 0px !important; }

.footer__download-links .mobile-store li a img { margin-right: 8px; width: 24px; height: 24px; }

@media (max-width: 780px) {
  .footer__download-links { margin-bottom: 36px; }
  .footer__download-links h3, .footer__download-links img { display: none; }
  .footer__download-links .mobile-store { margin-top: 0px; }
  .footer__download-links .mobile-store li a { width: 130px; padding: 7px 11px; }
  .footer__download-links .mobile-store li a p { font-size: 12px; line-height: 16px; }
  .footer__download-links .mobile-store li a img { display: block; margin-right: 5px; width: 24px; height: 24px; }
}

figure, .comments-image-gallery { margin: 0px; padding: 0px; }

.comments-image-gallery, .comments-image-gallery li { list-style: none; }

figure.align-left { float: left; }

figure.align-right { float: right; }

figure.image.align-center { display: table; margin: 0px auto; }

figure.image figcaption, .comments-image-uploader .plupload_container { padding: 1rem; background-color: rgb(250, 250, 250); }

figure.image figcaption { font-size: 0.8rem; caption-side: bottom; word-break: break-word; text-align: center; }

figure.image.align-center figcaption { display: table-caption; }

.comments-image-gallery li img { float: left; margin-right: 5px; border: 5px solid rgb(255, 255, 255); width: 100px; height: 100px; transition: box-shadow 0.5s; }

.image-bordered { border: 1px solid rgb(221, 221, 221); }

.image-shadows { box-shadow: rgb(23, 0, 0) 0px 4px 8px -2px, rgb(23, 0, 0) 0px 0px 0px 1px; }

.image-padded { padding: 0.5rem; }

.comments-user-profile { font-weight: 700; cursor: pointer; color: rgb(51, 148, 230); }

.clrfix { display: flex; }

.comments-image-uploader .plupload_container { margin-top: 0px; padding-left: 5px; background: var(--form-control-bg); }

.popular, .populars { position: absolute; color: rgb(255, 253, 252); font-weight: 700; background-image: linear-gradient(rgb(255, 195, 0), rgb(255, 87, 51), rgb(199, 0, 57)); border-radius: 36%; display: flex; place-content: center; align-items: center; }

@media (max-width: 767px) {
  .popular, .populars { font-size: 11px; padding: 3px; width: 25px; height: 25px; }
  .popular { top: 1px; right: 20px; }
  .populars { top: -3px; right: -7px; }
}

@media (min-width: 768px) and (max-width: 991px) {
  .popular, .populars { font-size: 14px; padding: 5px; width: 30px; height: 30px; }
  .popular { top: 1px; right: 23px; }
  .populars { top: -3px; right: -7px; }
  .popular svg, .populars i { width: 17px; height: 17px; }
}

@media (min-width: 992px) {
  .popular, .populars { font-size: 14px; padding: 5px; }
  .popular { top: 3px; right: 39px; width: 35px; height: 35px; }
  .populars { top: -3px; right: -7px; width: 30px; height: 30px; }
  .popular i { width: 25px; height: 25px; }
  .populars i { width: 20px; height: 20px; }
}

.nav-load a { padding: 0px 60px; display: inline-block; height: 60px; line-height: 58px; border-radius: 12px; font-weight: 600; font-size: 15px; background-color: var(--entry-bg); color: var(--tcolor); width: 100%; align-items: center; text-align: center; }

.nav-load a:hover { background-color: var(--tcolor); color: var(--bgcolor); }

div#nav-load { display: flex; width: 80%; justify-content: center; }

div#bottom-nav { display: flex; justify-content: space-around; width: 100%; padding: 9px 3px; }

.billing-content h4 { margin-bottom: 1rem; }

.rl-reading-list-row, .read { display: flex; align-items: flex-start; background: var(--entry-bg); border-radius: 12px; padding: 16px; margin: 0px 0px 12px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.06); min-height: 88px; gap: 16px; }

.rl-reading-list-row:hover, .read:hover { transform: translateY(-1px); background: var(--entry-bg); }

.readimge { flex-shrink: 0; width: 90px; height: 135px; border-radius: 1rem; overflow: hidden; margin-right: 1.25rem; position: relative; background: linear-gradient(135deg,var(--spoiler),#ffffff1a); z-index: 2; }

.readimge::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(135deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.05) 50%, rgba(255, 255, 255, 0.1) 100%); z-index: 1; opacity: 0; transition: opacity 0.3s; }

.readimge img { width: 100%; height: 100%; object-fit: cover; transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94); position: relative; z-index: 0; }

.read:hover .readimge::before { opacity: 1; }

.read:hover .readimge img { transform: scale(1.08); filter: brightness(1.1) contrast(1.05); }

.readdata { flex: 1 1 0%; display: flex; flex-direction: column; justify-content: space-between; min-height: 120px; }

.readnamer { margin-bottom: 0.75rem; }

.readnamer a { text-decoration: none; color: var(--tcolor); font-weight: 600; font-size: 1rem; line-height: 1.4; display: block; transition: color 0.2s; }

.readnamer a:hover { color: var(--lcolor); }

.readnamer span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }

.readdetail { display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto; }

.readdetail > span { color: var(--entry-info); font-size: 0.875rem; font-weight: 500; }

.readdetail > span:first-child { color: var(--lcolor); font-weight: 600; }

.view-app-tools { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--entry-info-sep); }

.view-app-tools a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background-color: var(--spoiler); color: var(--entry-info); text-decoration: none; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 500; transition: 0.2s; }

.view-app-tools a:hover { background-color: var(--lcolor); color: rgb(255, 255, 255); transform: translateY(-1px); }

.view-app-tools a i { font-size: 0.875rem; transition: transform 0.2s; }

.view-app-tools a:hover i { transform: scale(1.1); }

.rl-thumbnail, .readimge { width: 64px; height: 80px; border-radius: 8px; overflow: hidden; flex-shrink: 0; position: relative; background: var(--spoiler); transition: 0.25s; }

.rl-thumbnail img, .readimge img { width: 100%; height: 100%; object-fit: cover; transition: 0.3s; }

.rl-reading-list-row:hover .rl-thumbnail, .read:hover .readimge { transform: scale(1.02); }

.rl-reading-list-row:hover .rl-thumbnail img, .read:hover .readimge img { transform: scale(1.03); filter: brightness(1.05); }

.reading-list-bookmark-actions { position: absolute; top: -8px; right: -8px; z-index: 3; }

.reading-list-bookmark-btn { width: 32px; height: 32px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 50%; background: rgba(255, 255, 255, 0.98); color: var(--entry-info); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1); backdrop-filter: blur(12px); }

.reading-list-bookmark-btn i { font-size: 0.75rem; transition: 0.2s; }

.reading-list-bookmark-btn:hover { transform: scale(1.1); background: var(--lcolor); color: rgb(255, 255, 255); }

.reading-list-bookmark-btn.reading-list-bookmarked { background: var(--lcolor); color: rgb(255, 255, 255); }

.reading-list-bookmark-btn.reading-list-bookmarked:hover { background: rgb(220, 53, 69); }

.rl-details, .readdata { flex: 1 1 0%; display: flex; flex-direction: column; justify-content: flex-start; min-height: 80px; padding: 2px 0px; gap: 6px; }

.rl-title-section, .readnamer { margin-bottom: 0px; flex: 1 1 0%; }

.rl-title, .readnamer { margin: 0px 0px 4px; font-size: 0.9rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }

.rl-title-link, .readnamer a { color: var(--tcolor); text-decoration: none; transition: color 0.2s; word-break: break-word; hyphens: auto; overflow-wrap: break-word; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }

.rl-title-link:hover, .readnamer a:hover { color: var(--lcolor); }

.rl-author { margin: 0px; color: var(--entry-info); font-size: 0.75rem; font-weight: 500; opacity: 0.9; text-transform: capitalize; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }

.rl-meta, .readdetail { margin-top: auto; display: flex; align-items: center; gap: 1rem; }

.rl-views { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--entry-info); font-size: 0.7rem; font-weight: 500; opacity: 0.8; }

.rl-views i { color: var(--lcolor); font-size: 0.7rem; opacity: 0.7; }

.rl-actions { display: flex; align-items: center; align-self: flex-start; margin-top: 4px; }

.rl-action-btn { width: 32px; height: 32px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 50%; background: rgba(255, 255, 255, 0.08); color: var(--entry-info); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; backdrop-filter: blur(8px); }

.rl-action-btn i { font-size: 0.8rem; transition: 0.2s; }

.rl-action-btn:hover { background: var(--lcolor); color: rgb(255, 255, 255); transform: scale(1.05); }

.rl-action-btn.rl-saved { background: var(--lcolor); color: rgb(255, 255, 255); }

.rl-action-btn.rl-saved:hover { background: rgb(220, 53, 69); }

@media (max-width: 768px) {
  .rl-reading-list-row, .read { padding: 12px; margin: 0px 0px 10px; border-radius: 10px; gap: 12px; min-height: 76px; }
  .rl-thumbnail, .readimge { width: 56px; height: 72px; border-radius: 6px; }
  .rl-details, .readdata { min-height: 72px; gap: 4px; }
  .rl-title, .readnamer { font-size: 0.85rem; line-height: 1.25; }
  .rl-author { font-size: 0.7rem; }
  .rl-views { font-size: 0.65rem; gap: 0.25rem; }
  .rl-views i { font-size: 0.65rem; }
  .rl-action-btn { width: 28px; height: 28px; }
  .rl-action-btn i { font-size: 0.7rem; }
}

@media (max-width: 480px) {
  .rl-reading-list-row, .read { padding: 10px; margin: 0px 0px 8px; gap: 10px; min-height: 68px; }
  .rl-thumbnail, .readimge { width: 48px; height: 64px; border-radius: 5px; }
  .rl-details, .readdata { min-height: 64px; gap: 3px; }
  .rl-title, .readnamer { font-size: 0.8rem; line-height: 1.2; }
  .rl-author { font-size: 0.65rem; }
  .rl-views { font-size: 0.6rem; gap: 0.2rem; }
  .rl-views i { font-size: 0.6rem; }
  .rl-action-btn { width: 24px; height: 24px; }
  .rl-action-btn i { font-size: 0.65rem; }
}

html.darktheme .read { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px; }

html.darktheme .read:hover { box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 16px; }

a.kytol.s-green { padding: 20px; color: var(--tcolor); display: flex; margin: 16px 0px 0px; border-radius: 8px; place-content: center space-around; align-items: center; font-size: 15px; }

#app_description ul { list-style-type: disc; margin-left: 20px; }

ul.dlepl__playlist { margin-left: 0px !important; }

.mirtech-developer { display: inline-flex; align-items: center; gap: 4px; padding: 2px 4px; text-decoration: none; color: rgb(102, 102, 102); font-weight: 500; font-size: 0.875rem; margin-left: 8px; transition: 0.2s; }

.mirtech-developer:hover { color: rgb(51, 51, 51); text-decoration: none; }

.mirtech-developer i { color: rgb(102, 126, 234); font-size: 16px; transition: 0.2s; }

.mirtech-developer:hover i { color: rgb(90, 103, 216); transform: scale(1.1); }

@media (max-width: 768px) {
  .mirtech-developer { font-size: 0.8rem; margin-left: 4px; }
  .mirtech-developer i { font-size: 14px; }
}

html.darktheme .mirtech-developer { color: rgb(153, 153, 153); }

html.darktheme .mirtech-developer:hover { color: rgb(204, 204, 204); }

html.darktheme .mirtech-developer i { color: rgb(102, 126, 234); }

html.darktheme .mirtech-developer:hover i { color: rgb(124, 138, 255); }

.uc-article-card { display: flex; background: var(--entry-bg); border-radius: 12px; padding: 16px; margin: 0px 0px 16px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.06); gap: 16px; }

.uc-article-card:hover { transform: translateY(-2px); }

.uc-article-thumbnail { width: 120px; height: 90px; border-radius: 8px; overflow: hidden; flex-shrink: 0; position: relative; background: var(--spoiler); }

.uc-article-thumbnail img { width: 100%; height: 100%; object-fit: cover; transition: 0.3s; }

.uc-article-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg,var(--spoiler),#4ccb701a); color: var(--entry-info); }

.uc-popular-badge { position: absolute; top: 8px; right: 8px; background: rgba(255, 107, 107, 0.9); color: rgb(255, 255, 255); border-radius: 6px; padding: 4px 6px; font-size: 0.7rem; font-weight: 600; backdrop-filter: blur(8px); z-index: 2; }

.uc-popular-badge i { font-size: 0.7rem; }

.uc-article-content { flex: 1 1 0%; display: flex; flex-direction: column; gap: 12px; }

.uc-article-header { display: flex; flex-direction: column; gap: 8px; }

.uc-article-title { margin: 0px; font-size: 1.1rem; font-weight: 700; line-height: 1.4; letter-spacing: -0.01em; }

.uc-article-link { color: var(--tcolor); text-decoration: none; transition: color 0.2s; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; word-break: break-word; hyphens: auto; overflow-wrap: break-word; }

.uc-article-link:hover { color: var(--lcolor); }

.uc-article-category { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(76, 203, 112, 0.1); color: var(--lcolor); border-radius: 20px; font-size: 0.75rem; font-weight: 600; width: fit-content; text-transform: capitalize; }

.uc-article-category i { font-size: 0.7rem; }

.uc-article-excerpt { flex: 1 1 0%; }

.uc-article-excerpt p { margin: 0px; color: var(--entry-info); font-size: 0.875rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }

.uc-article-meta { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, 0.08); }

.uc-article-stats { display: flex; align-items: center; gap: 16px; }

.uc-stat-item { display: inline-flex; align-items: center; gap: 4px; color: var(--entry-info); font-size: 0.75rem; font-weight: 500; opacity: 0.8; }

.uc-stat-item i { color: var(--lcolor); font-size: 0.75rem; opacity: 0.7; }

.uc-article-actions { display: flex; align-items: center; gap: 8px; }

.uc-book-card { display: flex; background: var(--entry-bg); border-radius: 12px; padding: 16px; margin: 0px 0px 16px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.06); gap: 16px; }

.uc-book-card:hover { transform: translateY(-2px); }

.uc-book-thumbnail { width: 80px; height: 110px; border-radius: 8px; overflow: hidden; flex-shrink: 0; position: relative; background: var(--spoiler); }

.uc-book-thumbnail img { width: 100%; height: 100%; object-fit: cover; transition: 0.3s; }

.uc-book-badge { position: absolute; top: 8px; right: 8px; z-index: 2; }

.uc-book-price-badge { position: absolute; top: 8px; right: 8px; background: rgba(76, 203, 112, 0.9); color: rgb(255, 255, 255); border-radius: 6px; padding: 4px 6px; font-size: 0.7rem; font-weight: 600; backdrop-filter: blur(8px); z-index: 2; }

.uc-book-content { flex: 1 1 0%; display: flex; flex-direction: column; gap: 12px; }

.uc-book-header { display: flex; flex-direction: column; gap: 8px; }

.uc-book-title { margin: 0px; font-size: 1.1rem; font-weight: 700; line-height: 1.4; letter-spacing: -0.01em; }

.uc-book-link { color: var(--tcolor); text-decoration: none; transition: color 0.2s; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; word-break: break-word; hyphens: auto; overflow-wrap: break-word; }

.uc-book-link:hover { color: var(--lcolor); }

.uc-book-author { display: inline-flex; align-items: center; gap: 6px; color: var(--lcolor); font-size: 0.8rem; font-weight: 600; opacity: 0.9; }

.uc-book-author i { font-size: 0.75rem; opacity: 0.8; }

.uc-book-info { display: flex; flex-wrap: wrap; gap: 12px; padding: 8px 0px; }

.uc-book-genre { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; background: rgba(76, 203, 112, 0.1); color: var(--lcolor); border-radius: 6px; font-size: 0.75rem; font-weight: 500; }

.uc-book-genre i { font-size: 0.7rem; opacity: 0.8; }

.uc-book-meta { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, 0.08); }

.uc-book-stats { display: flex; align-items: center; gap: 16px; }

.uc-book-actions { display: flex; align-items: center; gap: 8px; }

.uc-action-btn { width: 32px; height: 32px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 50%; background: rgba(255, 255, 255, 0.08); color: var(--entry-info); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; backdrop-filter: blur(8px); }

.uc-action-btn i { font-size: 0.8rem; transition: 0.2s; }

.uc-action-btn:hover { background: var(--lcolor); color: rgb(255, 255, 255); transform: scale(1.05); }

.uc-action-btn.uc-saved { background: var(--lcolor); color: rgb(255, 255, 255); }

.uc-action-btn.uc-saved:hover { background: rgb(220, 53, 69); }

@media (max-width: 768px) {
  .uc-article-card, .uc-book-card { padding: 12px; margin: 0px 0px 12px; gap: 12px; }
  .uc-article-thumbnail { width: 100px; height: 75px; }
  .uc-book-thumbnail { width: 70px; height: 95px; }
  .uc-article-title, .uc-book-title { font-size: 1rem; }
  .uc-article-excerpt p { font-size: 0.8rem; -webkit-line-clamp: 1; }
  .uc-article-stats, .uc-book-stats { gap: 12px; }
  .uc-stat-item { font-size: 0.7rem; }
  .uc-action-btn { width: 28px; height: 28px; }
  .uc-action-btn i { font-size: 0.75rem; }
}

@media (max-width: 480px) {
  .uc-article-card, .uc-book-card { padding: 10px; margin: 0px 0px 10px; gap: 10px; }
  .uc-article-thumbnail { width: 80px; height: 60px; }
  .uc-book-thumbnail { width: 60px; height: 80px; }
  .uc-article-title, .uc-book-title { font-size: 0.9rem; line-height: 1.3; }
  .uc-article-meta, .uc-book-meta { flex-direction: column; align-items: flex-start; gap: 8px; }
  .uc-article-stats, .uc-book-stats { gap: 8px; }
  .uc-stat-item { font-size: 0.65rem; gap: 3px; }
  .uc-action-btn { width: 26px; height: 26px; }
  .uc-action-btn i { font-size: 0.7rem; }
  .uc-article-category { font-size: 0.7rem; padding: 3px 8px; }
  .uc-book-info { gap: 8px; }
  .uc-book-genre { font-size: 0.7rem; padding: 3px 6px; }
}

html.darktheme .uc-article-card, html.darktheme .uc-book-card { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px; }

html.darktheme .uc-article-card:hover, html.darktheme .uc-book-card:hover { box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 16px; }

.user-group-info { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: var(--entry-bg); border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.08); transition: 0.2s; max-width: 200px; }

.user-group-info:hover { background: rgba(76, 203, 112, 0.05); border-color: rgba(76, 203, 112, 0.2); transform: translateY(-1px); }

.user-group-info img { border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--spoiler); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 2px; transition: 0.2s; width: 20px !important; height: 20px !important; }

.user-group-info:hover img { transform: scale(1.05); box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 4px; }

.user-group-info .group-name { font-size: 0.8rem; font-weight: 600; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1 1 0%; min-width: 0px; }

.user-group-info .group-name b { font-weight: 700; }

@media (max-width: 768px) {
  .user-group-info { padding: 4px 8px; gap: 6px; max-width: 150px; border-radius: 16px; }
  .user-group-info img { width: 16px !important; height: 16px !important; }
  .user-group-info .group-name { font-size: 0.75rem; }
}

@media (max-width: 480px) {
  .user-group-info { padding: 3px 6px; gap: 4px; max-width: 120px; border-radius: 12px; }
  .user-group-info img { width: 14px !important; height: 14px !important; }
  .user-group-info .group-name { font-size: 0.7rem; }
}

html.darktheme .user-group-info { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.06); }

html.darktheme .user-group-info:hover { background: rgba(76, 203, 112, 0.08); border-color: rgba(76, 203, 112, 0.3); }

@media (max-width: 767px) {
  .cat-menu-list { overflow: scroll hidden; scrollbar-width: thin; scrollbar-color: rgb(85, 190, 95) transparent; }
  .cat-menu-list::-webkit-scrollbar { height: 6px; }
  .cat-menu-list::-webkit-scrollbar-thumb { background: rgb(85, 190, 95); border-radius: 10px; }
  .cat-menu-list ul { gap: 8px; padding: 10px 15px 15px; list-style: none; width: max-content; display: flex !important; flex-wrap: nowrap !important; justify-content: flex-start !important; margin: 0px !important; }
  .cat-menu-list .catalog-genres-item { flex-shrink: 0; display: inline-block; }
  .cat-menu-list .catalog-genres-item a { display: block; white-space: nowrap; padding: 8px 16px; border-radius: 8px; text-decoration: none; }
}

.native-menu, .native-user-panel, .native-bottom-sheet, .menu-butter { display: none; }

.desktop-menu, .dropdown.userpanel { display: none; }

.header-panel { display: flex; align-items: center; position: relative; width: 100%; justify-content: space-between; }

.header-left { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; z-index: 10; }

.header-left .menu-butter { order: 1; flex-shrink: 0; }

.logotype { position: absolute; left: 50%; transform: translateX(-50%); z-index: 5; }

.logotype.header-logo { position: absolute; left: 50%; transform: translateX(-50%); z-index: 5; }

.logotype.footer-logo { position: static; transform: none; }

@media (max-width: 575px) {
  .footer-panel .logotype.footer-logo { position: static; transform: none; }
}

@media (min-width: 576px) {
  .footer-panel .logotype.footer-logo { position: absolute; top: 50%; transform: translateY(-50%); left: 0px; padding: 0.375rem; margin-right: 1rem; display: block !important; }
}

.logotype.page-logo { position: static !important; transform: none !important; }

.head-right { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; z-index: 10; flex-shrink: 0; }

@media (max-width: 1199px) {
  .dropdown.userpanel, .q-search-call, .q-search { display: none !important; }
  .native-user-panel, .native-menu, .menu-butter { display: block !important; }
  .head-right { align-items: center; gap: 0.5rem; margin-left: auto; flex-shrink: 0; display: flex !important; }
}

@media (min-width: 1200px) {
  .native-user-panel, .native-menu, .native-bottom-sheet, .menu-butter { display: none !important; }
  .dropdown.userpanel { display: block !important; }
  .logotype, .logotype.header-logo { position: static; transform: none; flex-shrink: 0; }
  .logotype.page-logo { position: static !important; transform: none !important; }
  .footer-panel .logotype.footer-logo { position: absolute; top: 50%; transform: translateY(-50%); left: 0px; }
  .header-left { flex-shrink: 0; }
  .hmenu.desktop-menu { flex: 1 1 auto; justify-content: space-around; align-items: center; padding: 0px 1rem; max-width: 100%; display: flex !important; }
  .hmenu.desktop-menu > a { flex: 0 1 auto; }
  .header-panel { display: flex; align-items: center; gap: 1rem; }
  .head-right { flex-shrink: 0; margin-left: auto; align-items: center; gap: 0.5rem; display: flex !important; }
  .q-search-call { display: block !important; }
  .q-search { position: fixed; top: 2.5rem; left: 50%; transform: translate(-50%, 1rem); width: 90%; max-width: 600px; opacity: 0; transition: transform 0.2s, opacity 0.2s; pointer-events: none; z-index: 100; }
  .q-search.open { opacity: 1; transform: translate(-50%, 0px); pointer-events: auto; display: block !important; }
  .header.qs .q-search { transform: translate(-50%, 0px); opacity: 1; pointer-events: auto; }
  .header.qs .hmenu { transform: translateY(-1rem); opacity: 0; pointer-events: none; }
  .header.qs .q-search-call { background-color: rgba(23, 43, 61, 0.05); }
  .header.qs .q-search-call > i.qs-1 { opacity: 0; transform: scale(0.8); }
  .header.qs .q-search-call > i.qs-2 { opacity: 1; transform: scale(1); }
  .q-search { padding: 1rem; border-radius: 12px; }
  .q-search-box { position: relative; width: 100%; }
  .q-search-btn { position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); border: 0px; transition: 0.2s; width: 2.5rem; height: 2.5rem; padding: 0.5rem; background: transparent; cursor: pointer; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--tcolor) !important; }
  .q-search-btn:hover { color: rgb(255, 255, 255) !important; background: rgb(76, 203, 112) !important; }
  .q-search-btn i { display: block; line-height: normal; font-size: 1rem; }
  .q-search-text { width: 100%; height: 3rem; border-radius: 8px !important; font-size: 1rem !important; border: 1px solid var(--line) !important; background: var(--bgcolor) !important; color: var(--tcolor) !important; }
  .q-search-text:focus { outline: none; border-color: var(--lcolor) !important; box-shadow: rgba(76, 203, 112, 0.1) 0px 0px 0px 3px !important; }
  .q-search-label { display: none; }
  .hmenu, .q-search, .q-search-call > i { transition: transform 0.2s, opacity 0.2s; }
  .q-search-call { color: inherit; position: relative; display: block !important; }
  .q-search-call:hover { opacity: 0.8; }
  .q-search-call > i.qs-2 { opacity: 0; transform: scale(0.8); position: absolute; top: 12px; left: 0px; right: 0px; }
}

.dropdown.userpanel .dropdown-btn { width: 40px; height: 40px; border-radius: 50%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px; cursor: pointer; background: transparent; position: relative; transition: transform 0.2s; }

.dropdown.userpanel .dropdown-btn:active { transform: scale(0.95); }

.dropdown.userpanel .dropdown-btn .avatar { border: 2px solid var(--lcolor); box-shadow: rgba(76, 203, 112, 0.3) 0px 2px 8px; position: relative; width: 40px !important; height: 40px !important; min-width: 40px !important; min-height: 40px !important; max-width: 40px !important; max-height: 40px !important; border-radius: 50% !important; overflow: hidden !important; display: block !important; line-height: 0 !important; }

.dropdown.userpanel .dropdown-btn .avatar img { width: 100% !important; height: 100% !important; min-width: 100% !important; min-height: 100% !important; max-width: 100% !important; max-height: 100% !important; object-fit: cover !important; object-position: center center !important; border-radius: 50% !important; display: block !important; position: absolute !important; top: 0px !important; }

.login-pane__info { display: flex; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(135deg, rgba(76, 203, 112, 0.08) 0%, rgba(76, 203, 112, 0.02) 100%); }

.login-pane__info .avatar { border: 2px solid var(--lcolor); margin-right: 12px; flex-shrink: 0; position: relative; width: 48px !important; height: 48px !important; min-width: 48px !important; min-height: 48px !important; max-width: 48px !important; max-height: 48px !important; border-radius: 50% !important; overflow: hidden !important; display: block !important; }

.login-pane__info .avatar img { width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center center !important; border-radius: 50% !important; display: block !important; position: absolute !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; }

.login-pane__info .title { font-size: 16px; font-weight: 700; }

.login-pane__info .title a { color: var(--tcolor); text-decoration: none; }

.login-pane__menu { list-style: none; padding: 0px; margin: 0px; }

.login-pane__menu li { border-bottom: 1px solid var(--line); }

.login-pane__menu li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.login-pane__menu li a { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; color: var(--tcolor); text-decoration: none; font-size: 14px; font-weight: 500; transition: background 0.2s; }

.login-pane__menu li a:hover { background: var(--spoiler); }

.category-grid-section { overflow: visible; z-index: 0; }

.category-grid-container { position: relative; }

.category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; max-height: 136px; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1); position: relative; list-style: none; padding: 0px; margin: 0px; }

.category-grid.expanded { max-height: 5000px; }

.category-grid::after { content: ""; position: absolute; bottom: 0px; left: 0px; right: 0px; height: 50px; background: linear-gradient(to top, var(--bgcolor) 0%, transparent 100%); pointer-events: none; opacity: 1; transition: opacity 0.35s; }

.category-grid.expanded::after { opacity: 0; }

.catalog-genres-item { background: var(--block-bg); border-radius: 12px; overflow: hidden; transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: rgba(0, 0, 0, 0.08) 0px 1px 3px, rgba(0, 0, 0, 0.06) 0px 1px 2px; position: relative; border: 1px solid var(--line); }

.catalog-genres-item::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(135deg, rgba(76, 203, 112, 0.06) 0%, rgba(56, 185, 230, 0.04) 100%); opacity: 0; transition: opacity 0.25s; pointer-events: none; }

.catalog-genres-item:active { transform: scale(0.96); box-shadow: rgba(0, 0, 0, 0.08) 0px 1px 2px; }

.catalog-genres-item:active::before { opacity: 1; }

.catalog-genres-item a { display: flex; align-items: center; justify-content: center; padding: 10px 6px; min-height: 60px; text-decoration: none; color: var(--tcolor); font-weight: 600; font-size: 12px; line-height: 1.3; text-align: center; letter-spacing: -0.01em; position: relative; z-index: 1; }

.catalog-genres-item span { display: -webkit-box; position: relative; max-width: 100%; overflow: hidden; text-overflow: ellipsis; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.catalog-genres-item meta { display: none; }

.category-expand-btn { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin-top: 12px; padding: 12px 20px; background: var(--block-bg); border: 1.5px solid var(--line); border-radius: 12px; color: var(--tcolor); font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: rgba(0, 0, 0, 0.06) 0px 1px 3px; letter-spacing: -0.02em; }

.category-expand-btn:hover { background: var(--spoiler); border-color: rgba(76, 203, 112, 0.25); box-shadow: rgba(0, 0, 0, 0.08) 0px 2px 6px; }

.category-expand-btn:active { transform: scale(0.97); box-shadow: rgba(0, 0, 0, 0.08) 0px 1px 2px; }

.category-expand-btn .expand-icon { font-size: 14px; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1); }

.category-expand-btn.expanded .expand-icon { transform: rotate(180deg); }

.category-expand-btn .expand-text { font-weight: 600; }

@media (min-width: 640px) {
  .category-grid { grid-template-columns: repeat(4, 1fr); gap: 10px; max-height: 144px; }
  .catalog-genres-item a { padding: 12px 10px; min-height: 62px; font-size: 13px; }
}

@media (min-width: 1024px) {
  .category-grid { grid-template-columns: repeat(5, 1fr); gap: 10px; max-height: 148px; }
  .catalog-genres-item a { padding: 12px 10px; min-height: 64px; font-size: 13.5px; }
  .catalog-genres-item:hover { transform: translateY(-1px); box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 8px, rgba(0, 0, 0, 0.08) 0px 1px 3px; border-color: rgba(76, 203, 112, 0.2); }
  .catalog-genres-item:hover::before { opacity: 0.8; }
}

.darktheme .catalog-genres-item { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px, rgba(0, 0, 0, 0.3) 0px 1px 2px; }

.darktheme .catalog-genres-item:active { box-shadow: rgba(0, 0, 0, 0.3) 0px 1px 4px; }

.darktheme .category-expand-btn { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px; }

@media (min-width: 1024px) {
  .darktheme .catalog-genres-item:hover { box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 16px, rgba(0, 0, 0, 0.4) 0px 2px 4px; }
}

#pwa-install-banner { position: fixed; bottom: 0px; left: 0px; right: 0px; z-index: 99999; opacity: 0; transform: translateY(100%); transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1); pointer-events: none; }

#pwa-install-banner.show { opacity: 1; transform: translateY(0px); pointer-events: all; }

.pwa-banner-backdrop { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(2px); opacity: 0; animation: 0.3s ease 0s 1 normal forwards running fadeIn; }

@keyframes fadeIn { 
  100% { opacity: 1; }
}

.pwa-banner-content { position: relative; background: var(--block-bg); border-radius: 24px 24px 0px 0px; padding: 20px; box-shadow: rgba(0, 0, 0, 0.2) 0px -4px 24px; animation: 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0s 1 normal none running slideUp; }

@keyframes slideUp { 
  0% { transform: translateY(100%); }
  100% { transform: translateY(0px); }
}

.darktheme .pwa-banner-content { box-shadow: rgba(0, 0, 0, 0.5) 0px -4px 24px; }

.pwa-banner-header { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; }

.pwa-banner-icon { flex-shrink: 0; width: 56px; height: 56px; border-radius: 14px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px; }

.pwa-banner-icon img { width: 100%; height: 100%; object-fit: cover; }

.pwa-banner-info { flex: 1 1 0%; min-width: 0px; }

.pwa-banner-title { font-size: 17px; font-weight: 700; color: var(--tcolor); margin: 0px 0px 4px; letter-spacing: -0.02em; }

.pwa-banner-desc { font-size: 14px; color: var(--entry-info); margin: 0px; opacity: 0.8; }

.pwa-banner-close { flex-shrink: 0; width: 32px; height: 32px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: var(--spoiler); border-radius: 50%; color: var(--tcolor); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; font-size: 14px; }

.pwa-banner-close:hover { background: var(--line); transform: scale(1.05); }

.pwa-banner-close:active { transform: scale(0.95); }

.pwa-banner-actions { display: flex; gap: 10px; }

.pwa-banner-btn { flex: 1 1 0%; padding: 14px 20px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; justify-content: center; gap: 8px; letter-spacing: -0.01em; }

.pwa-btn-dismiss { background: var(--spoiler); color: var(--tcolor); border: 1.5px solid var(--line); }

.pwa-btn-dismiss:hover { background: var(--line); transform: translateY(-1px); box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 8px; }

.pwa-btn-install { background: linear-gradient(135deg, rgb(76, 203, 112) 0%, rgb(61, 186, 96) 100%); color: white; box-shadow: rgba(76, 203, 112, 0.3) 0px 2px 8px; }

.pwa-btn-install:hover { background: linear-gradient(135deg, rgb(61, 186, 96) 0%, rgb(54, 168, 85) 100%); transform: translateY(-2px); box-shadow: rgba(76, 203, 112, 0.4) 0px 4px 16px; }

.pwa-btn-install:active, .pwa-btn-dismiss:active { transform: scale(0.96); }

.pwa-btn-install i { font-size: 16px; }

@media (min-width: 768px) {
  .pwa-banner-content { max-width: 480px; margin: 0px auto; border-radius: 20px; bottom: 20px; left: 50%; transform: translateX(-50%); position: fixed; }
  #pwa-install-banner { bottom: 20px; }
  .pwa-banner-backdrop { background: rgba(0, 0, 0, 0.2); }
}

@media (hover: none) and (pointer: coarse) {
  .pwa-banner-btn:active { transform: scale(0.96); }
}

#premium-banner { position: fixed; bottom: 0px; left: 0px; right: 0px; z-index: 999999; opacity: 0; transform: translateY(100%); transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1); pointer-events: none; }

#premium-banner.show { opacity: 1; transform: translateY(0px); pointer-events: all; }

.premium-banner-backdrop { position: fixed; inset: 0px; z-index: 999998; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(2px); opacity: 0; animation: 0.3s ease 0s 1 normal forwards running fadeIn; }

.premium-banner-content { position: relative; z-index: 999999; background: var(--block-bg); border-radius: 24px 24px 0px 0px; padding: 20px 24px 64px 20px; box-shadow: rgba(0, 0, 0, 0.2) 0px -4px 24px; animation: 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0s 1 normal none running slideUp; }

.darktheme .premium-banner-content { box-shadow: rgba(0, 0, 0, 0.5) 0px -4px 24px; }

.premium-banner-header { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; }

.premium-banner-icon { flex-shrink: 0; width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, var(--lcolor) 0%, #3DBA60 100%); display: flex; align-items: center; justify-content: center; box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px; }

.premium-banner-icon i { font-size: 28px; color: white; }

.premium-banner-info { flex: 1 1 0%; min-width: 0px; }

.premium-banner-title { font-size: 17px; font-weight: 700; color: var(--tcolor); margin: 0px 0px 4px; letter-spacing: -0.02em; }

.premium-banner-desc { font-size: 14px; color: var(--entry-info); margin: 0px; opacity: 0.8; }

.premium-banner-close { flex-shrink: 0; width: 32px; height: 32px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: var(--spoiler); border-radius: 50%; color: var(--tcolor); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; font-size: 14px; }

.premium-banner-close:hover { background: var(--line); transform: scale(1.05); }

.premium-banner-close:active { transform: scale(0.95); }

.premium-banner-actions { display: flex; gap: 8px; }

.premium-banner-btn { padding: 14px 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; justify-content: center; gap: 6px; }

.premium-btn-close { flex: 0 0 auto; min-width: 80px; background: var(--spoiler); color: var(--tcolor); }

.premium-btn-close:hover { background: var(--line); }

.premium-btn-close:active { transform: scale(0.96); }

.premium-btn-later { flex: 1 1 0%; background: var(--spoiler); color: var(--tcolor); }

.premium-btn-later:hover { background: var(--line); }

.premium-btn-later:active { transform: scale(0.96); }

.premium-btn-upgrade { flex: 2 1 0%; background: linear-gradient(135deg, var(--lcolor) 0%, #3DBA60 100%); color: white; box-shadow: rgba(76, 203, 112, 0.25) 0px 2px 8px; }

.premium-btn-upgrade:hover { box-shadow: rgba(76, 203, 112, 0.35) 0px 4px 12px; transform: translateY(-1px); }

.premium-btn-upgrade:active { transform: scale(0.96) translateY(0px); }

.premium-btn-upgrade i { font-size: 16px; }

@media (min-width: 768px) {
  .premium-banner-content { max-width: 480px; margin: 0px auto; border-radius: 20px; bottom: 92px; left: 50%; transform: translateX(-50%); position: fixed; padding: 20px; }
  #premium-banner { bottom: 92px; }
  .premium-banner-backdrop { background: rgba(0, 0, 0, 0.2); }
}

@media (hover: none) and (pointer: coarse) {
  .premium-banner-btn:active { transform: scale(0.96); }
}

.native-login-sheet { display: block !important; }

.native-login-icon { width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.8) 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 32px; flex-shrink: 0; box-shadow: rgba(76, 203, 112, 0.3) 0px 4px 12px; }

.native-login-content { flex: 1 1 0%; overflow-y: auto; padding: 20px; }

.native-login-form { display: flex; flex-direction: column; gap: 20px; }

.native-login-input-group { display: flex; align-items: stretch; gap: 16px; padding: 16px; background: var(--modal-bg); border: 1px solid var(--line); border-radius: 16px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; }

.native-login-input-group:focus-within { border-color: var(--lcolor); background: var(--block-bg); box-shadow: rgba(76, 203, 112, 0.1) 0px 0px 0px 4px; }

.native-login-input-icon { width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, rgba(76, 203, 112, 0.15) 0%, rgba(76, 203, 112, 0.05) 100%); display: flex; align-items: center; justify-content: center; color: var(--lcolor); font-size: 18px; flex-shrink: 0; align-self: center; }

.native-login-input-wrapper { flex: 1 1 0%; min-width: 0px; display: flex; flex-direction: column; justify-content: center; }

.native-login-label { display: block; font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.02em; }

.native-login-input { width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: transparent; padding: 0px; font-size: 16px; font-weight: 500; color: var(--tcolor); outline: none; font-family: inherit; }

.native-login-input::placeholder { color: var(--muted); opacity: 0.5; }

.native-login-toggle-password { width: 40px; height: 40px; border-radius: 10px; background: rgba(76, 203, 112, 0.1); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--lcolor); font-size: 16px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; flex-shrink: 0; align-self: center; }

.native-login-toggle-password:hover { background: rgba(76, 203, 112, 0.2); }

.native-login-toggle-password:active { transform: scale(0.95); }

.native-login-forgot { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--lcolor); text-decoration: none; padding: 8px 0px; transition: opacity 0.2s; }

.native-login-forgot:hover { opacity: 0.8; }

.native-login-forgot i { font-size: 13px; }

.native-login-btn { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 56px; padding: 0px 24px; font-size: 16px; font-weight: 700; border-radius: 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); text-decoration: none; letter-spacing: -0.01em; }

.native-login-btn i { font-size: 18px; }

.native-login-btn-primary { background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.9) 100%); color: white; box-shadow: rgba(76, 203, 112, 0.3) 0px 4px 12px; }

.native-login-btn-primary:hover { transform: translateY(-2px); box-shadow: rgba(76, 203, 112, 0.4) 0px 6px 16px; }

.native-login-btn-primary:active { transform: translateY(0px); }

.native-login-btn-secondary { background: var(--modal-bg); color: var(--tcolor); border: 2px solid var(--line); }

.native-login-btn-secondary:hover { border-color: var(--lcolor); color: var(--lcolor); background: rgba(76, 203, 112, 0.05); }

.native-login-btn-secondary:active { transform: scale(0.98); }

.native-social-section { margin-top: 24px; }

.native-section-title { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted); margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.02em; }

.native-section-title i { font-size: 16px; color: var(--lcolor); }

.native-social-grid { display: flex; flex-direction: column; gap: 8px; }

html.darktheme .native-login-input-group { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.1); }

html.darktheme .native-login-input-group:focus-within { background: rgba(255, 255, 255, 0.05); }

html.darktheme .native-login-btn-secondary { background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1); }

html.darktheme .native-login-btn-secondary:hover { background: rgba(255, 255, 255, 0.08); }

@media (min-width: 992px) and (max-width: 1199px) {
  .menu-butter { order: -1; padding: 0.625rem; border: 0px; background: 0px 0px; color: rgb(76, 203, 112); transition: transform 0.2s; display: block !important; }
  .menu-butter:active { transform: scale(0.95); }
  .butterbrod { width: 1.25rem; height: 1rem; display: flex; justify-content: space-between; flex-direction: column; position: relative; flex-shrink: 0; }
  .butterbrod > i { width: 100%; height: 3px; background-color: currentcolor; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 2px; transition: 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); transform-origin: center center; display: block; flex-shrink: 0; }
  .butterbrod > i:nth-child(1) { transition-delay: 0s; align-self: flex-start; }
  .butterbrod > i:nth-child(2) { transition-delay: 0.05s; align-self: center; }
  .butterbrod > i:nth-child(3) { transition-delay: 0.1s; align-self: flex-end; }
  html.mm .menu-butter .butterbrod > i:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  html.mm .menu-butter .butterbrod > i:nth-child(2) { opacity: 0; transform: scaleX(0); }
  html.mm .menu-butter .butterbrod > i:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .header-panel { width: 100%; justify-content: space-between; }
  .head-right { margin-left: auto; flex-shrink: 0; }
}

@media (min-width: 768px) and (max-width: 1199px) {
  .native-login-content { padding: 24px; }
}

@media (min-width: 1200px) {
  .native-login-sheet { display: block !important; }
  .native-login-sheet .native-sheet-container { inset: 50% auto auto 50%; transform: translate(-50%, -50%) translateY(100%); max-width: 520px; max-height: 85vh; border-radius: 24px; box-shadow: rgba(0, 0, 0, 0.3) 0px 20px 60px; }
  .native-login-sheet.open .native-sheet-container { transform: translate(-50%, -50%) translateY(0px); }
  .native-login-content { padding: 32px; max-height: calc(-200px + 85vh); }
  .native-login-sheet .native-sheet-handle { display: none; }
}

@media (hover: none) and (pointer: coarse) {
  .native-login-btn:active { transform: scale(0.98); }
  .native-login-toggle-password:active { transform: scale(0.92); }
}

.native-registration-page { min-height: 100vh; background: var(--fon); padding: 0px; }

.native-registration-container { margin: 0px auto; background: var(--block-bg); }

.native-registration-header { padding: 40px 24px 32px; background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.8) 100%); color: white; text-align: center; }

.native-registration-icon { width: 80px; height: 80px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; color: white; font-size: 40px; margin: 0px auto 20px; box-shadow: rgba(0, 0, 0, 0.2) 0px 8px 24px; }

.native-registration-title { font-size: 32px; font-weight: 700; margin: 0px 0px 12px; letter-spacing: -0.02em; color: white; }

.native-registration-subtitle { font-size: 16px; font-weight: 400; margin: 0px; opacity: 0.9; color: white; }

.native-registration-content { padding: 32px 24px 40px; }

.native-registration-content form { display: flex; flex-direction: column; gap: 20px; }

.native-social-registration { margin-bottom: 8px; }

.native-reg-input-group { display: flex; align-items: stretch; gap: 12px; padding: 16px; background: var(--modal-bg); border: 1px solid var(--line); border-radius: 16px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin-bottom: 16px; }

.native-reg-input-group:focus-within { border-color: var(--lcolor); background: var(--block-bg); box-shadow: rgba(76, 203, 112, 0.1) 0px 0px 0px 4px; }

.native-reg-input-icon { width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, rgba(76, 203, 112, 0.15) 0%, rgba(76, 203, 112, 0.05) 100%); display: flex; align-items: center; justify-content: center; color: var(--lcolor); font-size: 18px; flex-shrink: 0; align-self: center; }

.native-reg-input-wrapper { flex: 1 1 0%; min-width: 0px; display: flex; flex-direction: column; justify-content: center; }

.native-reg-label { display: block; font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.02em; }

.native-reg-input { width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: transparent; padding: 0px; font-size: 16px; font-weight: 500; color: var(--tcolor); outline: none; font-family: inherit; }

.native-reg-input::placeholder { color: var(--muted); opacity: 0.5; }

.native-reg-check-btn { width: 40px; height: 40px; border-radius: 10px; background: rgba(76, 203, 112, 0.1); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--lcolor); font-size: 18px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; flex-shrink: 0; align-self: center; }

.native-reg-check-btn:hover { background: rgba(76, 203, 112, 0.2); transform: scale(1.05); }

.native-reg-check-btn:active { transform: scale(0.95); }

.native-reg-toggle-password { width: 40px; height: 40px; border-radius: 10px; background: rgba(76, 203, 112, 0.1); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--lcolor); font-size: 16px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; flex-shrink: 0; align-self: center; }

.native-reg-toggle-password:hover { background: rgba(76, 203, 112, 0.2); }

.native-reg-toggle-password:active { transform: scale(0.95); }

.native-reg-result { padding: 12px 16px; border-radius: 12px; font-size: 14px; font-weight: 600; margin-top: -8px; margin-bottom: 4px; }

.native-reg-result:not(:empty) { background: rgba(76, 203, 112, 0.1); border: 1px solid rgba(76, 203, 112, 0.3); color: var(--lcolor); margin-bottom: 12px; }

.native-reg-textarea-group { display: flex; gap: 12px; padding: 16px; background: var(--modal-bg); border: 1px solid var(--line); border-radius: 16px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin-bottom: 16px; }

.native-reg-textarea-group:focus-within { border-color: var(--lcolor); background: var(--block-bg); box-shadow: rgba(76, 203, 112, 0.1) 0px 0px 0px 4px; }

.native-reg-textarea { width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: transparent; padding: 0px; font-size: 16px; font-weight: 500; color: var(--tcolor); outline: none; font-family: inherit; resize: vertical; min-height: 80px; }

.native-reg-textarea::placeholder { color: var(--muted); opacity: 0.5; }

.native-reg-file-group { display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--modal-bg); border: 1px solid var(--line); border-radius: 16px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; margin-bottom: 16px; }

.native-reg-file-group:hover { border-color: var(--lcolor); background: var(--block-bg); }

.native-reg-file-input { width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: transparent; padding: 0px; font-size: 14px; font-weight: 500; color: var(--tcolor); outline: none; font-family: inherit; cursor: pointer; }

.native-reg-file-input::file-selector-button { display: none; }

.native-reg-captcha { display: flex; flex-direction: column; gap: 16px; margin-bottom: 16px; }

.native-reg-captcha-image { display: flex; justify-content: center; padding: 16px; background: var(--modal-bg); border: 1px solid var(--line); border-radius: 16px; }

.native-reg-captcha-image img { max-width: 100%; height: auto; border-radius: 8px; }

.native-reg-recaptcha { display: flex; justify-content: center; padding: 16px; background: var(--modal-bg); border: 1px solid var(--line); border-radius: 16px; }

.native-reg-xfields { display: flex; flex-direction: column; gap: 16px; }

.native-reg-xfields table { width: 100%; }

.native-reg-xfields td { padding: 8px 0px; }

.native-reg-xfields input, .native-reg-xfields textarea, .native-reg-xfields select { width: 100%; padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--modal-bg); color: var(--tcolor); font-size: 16px; font-family: inherit; transition: 0.2s; }

.native-reg-xfields input:focus, .native-reg-xfields textarea:focus, .native-reg-xfields select:focus { outline: none; border-color: var(--lcolor); box-shadow: rgba(76, 203, 112, 0.1) 0px 0px 0px 4px; }

.native-reg-btn { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 56px; padding: 0px 24px; font-size: 16px; font-weight: 700; border-radius: 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); letter-spacing: -0.01em; margin-top: 12px; }

.native-reg-btn i { font-size: 18px; }

.native-reg-btn-primary { background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.9) 100%); color: white; box-shadow: rgba(76, 203, 112, 0.3) 0px 4px 12px; }

.native-reg-btn-primary:hover { transform: translateY(-2px); box-shadow: rgba(76, 203, 112, 0.4) 0px 6px 16px; }

.native-reg-btn-primary:active { transform: translateY(0px); }

.native-reg-login-link { text-align: center; font-size: 14px; font-weight: 500; color: var(--muted); margin-top: 8px; display: flex; align-items: center; justify-content: center; gap: 8px; }

.native-reg-login-link i { color: var(--lcolor); }

.native-reg-login-link a { color: var(--lcolor); font-weight: 700; text-decoration: none; transition: opacity 0.2s; }

.native-reg-login-link a:hover { opacity: 0.8; }

html.darktheme .native-reg-input-group, html.darktheme .native-reg-textarea-group, html.darktheme .native-reg-file-group, html.darktheme .native-reg-captcha-image, html.darktheme .native-reg-recaptcha { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.1); }

html.darktheme .native-reg-input-group:focus-within, html.darktheme .native-reg-textarea-group:focus-within { background: rgba(255, 255, 255, 0.05); }

html.darktheme .native-registration-container { background: var(--block-bg); }

@media (max-width: 768px) {
  .native-registration-header { padding: 32px 20px 28px; }
  .native-registration-icon { width: 70px; height: 70px; font-size: 35px; }
  .native-registration-title { font-size: 28px; }
  .native-registration-content { padding: 24px 20px 32px; }
}

@media (hover: none) and (pointer: coarse) {
  .native-reg-btn:active { transform: scale(0.98); }
  .native-reg-check-btn:active, .native-reg-toggle-password:active { transform: scale(0.92); }
}

.native-reg-info-box { display: flex; align-items: center; gap: 16px; padding: 16px; background: linear-gradient(135deg, rgba(76, 203, 112, 0.1) 0%, rgba(76, 203, 112, 0.05) 100%); border: 1px solid rgba(76, 203, 112, 0.2); border-radius: 16px; margin-bottom: 16px; }

.native-reg-info-icon { width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.9) 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 24px; flex-shrink: 0; box-shadow: rgba(76, 203, 112, 0.3) 0px 4px 12px; }

.native-reg-info-text { flex: 1 1 0%; }

.native-reg-info-text strong { display: block; font-size: 16px; font-weight: 700; color: var(--tcolor); margin-bottom: 4px; }

.native-reg-info-text p { font-size: 14px; color: var(--muted); margin: 0px; line-height: 1.4; }

.native-reg-alert { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); border-radius: 12px; margin-top: 8px; }

.native-reg-alert-icon { width: 32px; height: 32px; border-radius: 8px; background: rgba(255, 193, 7, 0.2); display: flex; align-items: center; justify-content: center; color: rgb(245, 158, 11); font-size: 16px; flex-shrink: 0; }

.native-reg-alert-text { flex: 1 1 0%; font-size: 14px; color: var(--tcolor); line-height: 1.4; }

.native-reg-alert-text strong { font-weight: 700; color: rgb(245, 158, 11); }

html.darktheme .native-reg-info-box { background: linear-gradient(135deg, rgba(76, 203, 112, 0.15) 0%, rgba(76, 203, 112, 0.08) 100%); border-color: rgba(76, 203, 112, 0.3); }

html.darktheme .native-reg-alert { background: rgba(255, 193, 7, 0.15); border-color: rgba(255, 193, 7, 0.4); }

html.darktheme .native-reg-alert-icon { background: rgba(255, 193, 7, 0.25); }

.native-feedback-page { min-height: 100vh; background: var(--fon); padding: 0px; }

.native-feedback-container { margin: 0px auto; background: var(--block-bg); }

.native-feedback-header { padding: 40px 24px 32px; background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.8) 100%); color: white; text-align: center; }

.native-feedback-icon { width: 80px; height: 80px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; color: white; font-size: 40px; margin: 0px auto 20px; box-shadow: rgba(0, 0, 0, 0.2) 0px 8px 24px; }

.native-feedback-icon.premium { background: linear-gradient(135deg, rgb(255, 215, 0) 0%, rgb(255, 165, 0) 100%); color: rgb(26, 29, 46); }

.native-feedback-title { font-size: 32px; font-weight: 700; margin: 0px 0px 12px; letter-spacing: -0.02em; color: white; }

.native-feedback-subtitle { font-size: 16px; font-weight: 400; margin: 0px; opacity: 0.9; color: white; }

.native-feedback-content { padding: 32px 24px 40px; }

.native-qr-card { background: linear-gradient(135deg, rgba(76, 203, 112, 0.08) 0%, rgba(76, 203, 112, 0.03) 100%); border: 2px dashed rgba(76, 203, 112, 0.3); border-radius: 24px; padding: 32px; text-align: center; margin-bottom: 32px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.native-qr-card:hover { border-color: var(--lcolor); background: linear-gradient(135deg, rgba(76, 203, 112, 0.12) 0%, rgba(76, 203, 112, 0.06) 100%); transform: translateY(-4px); box-shadow: rgba(76, 203, 112, 0.15) 0px 12px 32px; }

.native-qr-header { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; font-weight: 700; color: var(--lcolor); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 20px; }

.native-qr-header i { font-size: 18px; }

.native-qr-image { width: 200px; height: 200px; margin: 0px auto 20px; padding: 16px; background: white; border-radius: 20px; box-shadow: rgba(0, 0, 0, 0.12) 0px 8px 24px; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.native-qr-card:hover .native-qr-image { transform: scale(1.05); }

.native-qr-image img { width: 100%; height: 100%; object-fit: contain; display: block; }

.native-qr-text { font-size: 14px; color: var(--muted); font-weight: 500; margin: 0px; line-height: 1.5; }

.native-contact-cards { display: grid; grid-template-columns: 1fr; gap: 16px; }

.native-contact-card { display: flex; align-items: center; gap: 16px; padding: 20px; background: var(--modal-bg); border: 1px solid var(--line); border-radius: 20px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden; }

.native-contact-card::before { content: ""; position: absolute; top: 0px; left: 0px; width: 4px; height: 100%; background: linear-gradient(180deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.5) 100%); transform: scaleY(0); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.native-contact-card:hover::before { transform: scaleY(1); }

.native-contact-card-icon { width: 64px; height: 64px; border-radius: 16px; background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.85) 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 28px; flex-shrink: 0; box-shadow: rgba(76, 203, 112, 0.25) 0px 4px 16px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.native-contact-card:hover .native-contact-card-icon { transform: rotate(5deg) scale(1.1); box-shadow: rgba(76, 203, 112, 0.35) 0px 6px 20px; }

.native-contact-card-content { flex: 1 1 0%; min-width: 0px; }

.native-contact-label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.02em; }

.native-contact-value { display: block; font-size: 18px; font-weight: 700; color: var(--tcolor); word-break: break-word; transition: color 0.2s; }

.native-contact-arrow { font-size: 18px; color: var(--muted); flex-shrink: 0; opacity: 0.5; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.native-contact-clickable:hover .native-contact-value { color: var(--lcolor); }

.native-contact-clickable { cursor: pointer; text-decoration: none; }

.native-contact-clickable:hover { border-color: var(--lcolor); transform: translateX(8px); box-shadow: rgba(76, 203, 112, 0.15) 0px 8px 24px; }

.native-contact-clickable:hover .native-contact-arrow { opacity: 1; transform: translateX(6px); color: var(--lcolor); }

.native-contact-clickable:active { transform: scale(0.97) translateX(4px); }

.native-premium-section { margin-top: 32px; }

.native-premium-header { display: flex; align-items: center; gap: 16px; padding: 24px; background: linear-gradient(135deg, rgb(255, 215, 0) 0%, rgb(255, 165, 0) 100%); border-radius: 20px 20px 0px 0px; margin: -32px -24px 0px; }

.native-premium-icon { width: 56px; height: 56px; border-radius: 14px; background: rgba(0, 0, 0, 0.1); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; color: rgb(26, 29, 46); font-size: 28px; flex-shrink: 0; }

.native-premium-info { flex: 1 1 0%; }

.native-premium-title { font-size: 20px; font-weight: 700; color: rgb(26, 29, 46); margin: 0px 0px 4px; }

.native-premium-subtitle { font-size: 14px; color: rgba(26, 29, 46, 0.8); margin: 0px; font-weight: 500; }

.native-premium-alert, .native-feedback-alert { display: flex; gap: 12px; padding: 20px; background: linear-gradient(135deg, rgba(76, 203, 112, 0.1) 0%, rgba(76, 203, 112, 0.05) 100%); border: 1px solid rgba(76, 203, 112, 0.25); border-radius: 16px; margin-bottom: 24px; position: relative; overflow: hidden; }

.native-premium-alert::before, .native-feedback-alert::before { content: ""; position: absolute; top: 0px; left: 0px; width: 4px; height: 100%; background: var(--lcolor); }

.native-premium-alert-icon, .native-feedback-alert-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--lcolor); display: flex; align-items: center; justify-content: center; color: white; font-size: 20px; flex-shrink: 0; }

.native-premium-alert-text, .native-feedback-alert-text { flex: 1 1 0%; font-size: 14px; color: var(--tcolor); line-height: 1.7; }

.native-premium-alert-text a, .native-feedback-alert-text a { color: var(--lcolor); font-weight: 700; text-decoration: none; padding: 2px 6px; background: rgba(76, 203, 112, 0.1); border-radius: 6px; transition: 0.2s; }

.native-premium-alert-text a:hover, .native-feedback-alert-text a:hover { background: rgba(76, 203, 112, 0.2); transform: translateY(-1px); }

.native-feedback-form { display: flex; flex-direction: column; gap: 20px; }

.native-feedback-textarea-group { display: flex; gap: 16px; padding: 20px; background: var(--modal-bg); border: 2px solid var(--line); border-radius: 20px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; }

.native-feedback-textarea-group::after { content: ""; position: absolute; bottom: -2px; left: 0px; width: 0px; height: 2px; background: var(--lcolor); transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.native-feedback-textarea-group:focus-within { border-color: var(--lcolor); background: var(--block-bg); box-shadow: rgba(76, 203, 112, 0.12) 0px 4px 20px; }

.native-feedback-textarea-group:focus-within::after { width: 100%; }

.native-feedback-input-icon { width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, rgba(76, 203, 112, 0.15) 0%, rgba(76, 203, 112, 0.08) 100%); display: flex; align-items: center; justify-content: center; color: var(--lcolor); font-size: 20px; flex-shrink: 0; align-self: flex-start; margin-top: 28px; transition: 0.3s; }

.native-feedback-textarea-group:focus-within .native-feedback-input-icon { background: var(--lcolor); color: white; transform: scale(1.05); }

.native-feedback-input-wrapper { flex: 1 1 0%; min-width: 0px; display: flex; flex-direction: column; }

.native-feedback-label { display: block; font-size: 13px; font-weight: 700; color: var(--muted); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.04em; }

.native-feedback-textarea { width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: transparent; padding: 0px; font-size: 16px; font-weight: 500; color: var(--tcolor); outline: none; font-family: inherit; resize: vertical; min-height: 140px; line-height: 1.7; }

.native-feedback-textarea::placeholder { color: var(--muted); opacity: 0.6; font-style: italic; }

.native-feedback-btn { display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; height: 56px; padding: 0px 24px; font-size: 16px; font-weight: 700; border-radius: 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); letter-spacing: -0.01em; position: relative; overflow: hidden; }

.native-feedback-btn::before { content: ""; position: absolute; top: 50%; left: 50%; width: 0px; height: 0px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); transform: translate(-50%, -50%); transition: width 0.6s, height 0.6s; }

.native-feedback-btn:hover::before { width: 300px; height: 300px; }

.native-feedback-btn i { font-size: 18px; position: relative; z-index: 1; }

.native-feedback-btn span { position: relative; z-index: 1; }

.native-feedback-btn-primary { background: linear-gradient(135deg, var(--lcolor) 0%, rgba(76, 203, 112, 0.9) 100%); color: white; box-shadow: rgba(76, 203, 112, 0.25) 0px 4px 16px; }

.native-feedback-btn-primary:hover { transform: translateY(-3px); box-shadow: rgba(76, 203, 112, 0.35) 0px 8px 24px; }

.native-feedback-btn-primary:active { transform: translateY(-1px); }

.native-feedback-btn-secondary { background: linear-gradient(135deg, rgb(0, 136, 204) 0%, rgb(0, 107, 166) 100%); color: white; box-shadow: rgba(0, 136, 204, 0.25) 0px 4px 16px; margin-top: 12px; }

.native-feedback-btn-secondary:hover { transform: translateY(-3px); box-shadow: rgba(0, 136, 204, 0.35) 0px 8px 24px; }

.native-feedback-btn-secondary:active { transform: translateY(-1px); }

.native-feedback-telegram-link { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 16px; background: rgba(0, 136, 204, 0.1); border: 1px solid rgba(0, 136, 204, 0.2); border-radius: 12px; color: rgb(0, 136, 204); font-size: 14px; font-weight: 600; text-decoration: none; transition: 0.2s; }

.native-feedback-telegram-link i { font-size: 18px; }

.native-feedback-telegram-link:hover { background: rgba(0, 136, 204, 0.15); transform: translateY(-1px); }

html.darktheme .native-feedback-textarea-group, html.darktheme .native-contact-card { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.1); }

html.darktheme .native-feedback-textarea-group:focus-within { background: rgba(255, 255, 255, 0.05); }

html.darktheme .native-contact-clickable:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(76, 203, 112, 0.4); }

html.darktheme .native-feedback-alert { background: linear-gradient(135deg, rgba(76, 203, 112, 0.15) 0%, rgba(76, 203, 112, 0.08) 100%); border-color: rgba(76, 203, 112, 0.3); }

html.darktheme .native-qr-card { background: linear-gradient(135deg, rgba(76, 203, 112, 0.12) 0%, rgba(76, 203, 112, 0.05) 100%); border-color: rgba(76, 203, 112, 0.35); }

html.darktheme .native-qr-card:hover { background: linear-gradient(135deg, rgba(76, 203, 112, 0.18) 0%, rgba(76, 203, 112, 0.08) 100%); border-color: var(--lcolor); }

@media (min-width: 768px) {
  .native-contact-cards { grid-template-columns: repeat(2, 1fr); gap: 20px; }
}

@media (max-width: 768px) {
  .native-feedback-header { padding: 32px 20px 28px; }
  .native-feedback-icon { width: 70px; height: 70px; font-size: 35px; }
  .native-feedback-title { font-size: 28px; }
  .native-feedback-content { padding: 24px 20px 32px; }
  .native-premium-header { margin: -24px -20px 0px; padding: 20px; }
  .native-premium-icon { width: 48px; height: 48px; font-size: 24px; }
  .native-premium-title { font-size: 18px; }
  .native-premium-subtitle { font-size: 13px; }
  .native-qr-card { padding: 24px 20px; margin-bottom: 24px; }
  .native-qr-image { width: 180px; height: 180px; }
  .native-contact-card { padding: 16px; }
  .native-contact-card-icon { width: 56px; height: 56px; font-size: 24px; }
  .native-contact-value { font-size: 16px; }
}

@media (max-width: 480px) {
  .native-qr-image { width: 160px; height: 160px; }
}

@media (hover: none) and (pointer: coarse) {
  .native-feedback-btn:active { transform: scale(0.97); }
  .native-contact-clickable:active { transform: scale(0.97) translateX(4px); }
  .native-qr-card:active { transform: scale(0.98); }
  .native-contact-card:active { transform: scale(0.98); }
}

.page-head-cat .cat-menu-list ul > li a { padding: 5px; min-height: auto; margin: 5px; background: none !important; }

.page-head-cat .cat-menu-list ul > li { margin: 2px; }
