.visual-sunset { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-sunset[class*="theme-"] { background: linear-gradient(160deg, rgb(46, 16, 101) 0%, rgb(76, 29, 149) 35%, rgb(49, 46, 129) 100%) !important; color: rgb(255, 255, 255) !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; }

.visual-sunset .coo-bg-orb { display: none !important; }

.visual-sunset .coo-hook { background: rgba(255, 255, 255, 0.18) !important; color: rgb(253, 230, 138) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-sunset .coo-btn { box-shadow: rgba(255, 255, 255, 0.2) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(91, 33, 182) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-sunset-glow { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(at 30% 80%, rgba(255, 126, 95, 0.35) 0%, transparent 50%), radial-gradient(at 70% 20%, rgba(134, 168, 231, 0.2) 0%, transparent 45%), radial-gradient(rgba(127, 127, 213, 0.15) 0%, transparent 55%); animation: 10s ease-in-out 0s infinite normal none running coo-sunset-glow-shift; }

@keyframes coo-sunset-glow-shift { 
  0%, 100% { opacity: 0.75; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.04); }
}

.coo-sunset-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-sunset-scene { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: rgba(0, 0, 0, 0.35) 0px 8px 24px; }

.coo-sunset-sky { position: absolute; inset: 0px; background: linear-gradient(rgb(30, 27, 75) 0%, rgb(76, 29, 149) 25%, rgb(124, 58, 237) 45%, rgb(255, 126, 95) 72%, rgb(254, 180, 123) 88%, rgb(134, 168, 231) 100%); animation: coo-sunset-sky-shift var(--sun-dur, 8s) ease-in-out infinite; }

@keyframes coo-sunset-sky-shift { 
  0%, 15% { filter: brightness(0.85); }
  40%, 75% { filter: brightness(1); }
  90%, 100% { filter: brightness(0.85); }
}

.coo-sunset-sun { position: absolute; left: 50%; width: 22px; height: 22px; margin-left: -11px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgb(255, 249, 196), rgb(251, 191, 36) 40%, rgb(249, 115, 22)); box-shadow: rgba(251, 191, 36, 0.7) 0px 0px 16px, rgba(249, 115, 22, 0.4) 0px 0px 32px; animation: coo-sunset-sun-set var(--sun-dur, 8s) ease-in-out infinite; z-index: 1; }

@keyframes coo-sunset-sun-set { 
  0%, 12% { top: 18%; opacity: 0.6; transform: scale(0.85); }
  35%, 70% { top: 48%; opacity: 1; transform: scale(1); }
  88%, 100% { top: 62%; opacity: 0.4; transform: scale(0.75); }
}

.coo-sunset-horizon { position: absolute; bottom: 28%; left: 0px; right: 0px; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent); z-index: 2; }

.coo-sunset-hill { position: absolute; bottom: 0px; left: -10%; right: -10%; height: 32%; background: linear-gradient(transparent, rgba(15, 23, 42, 0.85)); border-radius: 50% 50% 0px 0px; z-index: 2; }

.coo-sunset-report { position: absolute; bottom: 4px; left: 4px; right: 4px; padding: 4px 5px 5px; border-radius: 8px; background: rgba(255, 255, 255, 0.16); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.22); z-index: 4; opacity: 0; transform: translateY(12px); animation: coo-sunset-report-in var(--sun-dur, 8s) ease-out infinite; }

@keyframes coo-sunset-report-in { 
  0%, 22% { opacity: 0; transform: translateY(14px); }
  32%, 78% { opacity: 1; transform: translateY(0px); }
  88%, 100% { opacity: 0; transform: translateY(8px); }
}

.coo-sunset-report-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 3px; }

.coo-sunset-report-val { font-size: 11px; font-weight: 800; letter-spacing: -0.04em; color: rgb(255, 255, 255); line-height: 1; }

.coo-sunset-report-sub { font-size: 5px; font-weight: 700; color: rgba(255, 255, 255, 0.55); text-transform: uppercase; letter-spacing: 0.06em; }

.coo-sunset-report-label { font-size: 4px; font-weight: 800; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.05em; }

.coo-sunset-bars { display: flex; align-items: flex-end; gap: 2px; height: 18px; margin-bottom: 3px; }

.coo-sunset-bar { flex: 1 1 0%; min-width: 0px; border-radius: 2px 2px 0px 0px; background: linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.35)); transform-origin: center bottom; transform: scaleY(0); animation: coo-sunset-bar-grow var(--sun-dur, 8s) ease-out infinite; }

.coo-sunset-bar:nth-child(1) { animation-delay: 0.35s; }

.coo-sunset-bar:nth-child(2) { animation-delay: 0.42s; }

.coo-sunset-bar:nth-child(3) { animation-delay: 0.49s; }

.coo-sunset-bar:nth-child(4) { animation-delay: 0.56s; }

.coo-sunset-bar:nth-child(5) { animation-delay: 0.63s; }

.coo-sunset-bar:nth-child(6) { animation-delay: 0.7s; }

.coo-sunset-bar:nth-child(7) { animation-delay: 0.77s; }

.coo-sunset-bar:nth-child(8) { animation-delay: 0.84s; }

@keyframes coo-sunset-bar-grow { 
  0%, 28% { transform: scaleY(0); opacity: 0.4; }
  38%, 75% { transform: scaleY(1); opacity: 1; }
  85%, 100% { transform: scaleY(0.3); opacity: 0.3; }
}

.coo-sunset-stats { display: flex; gap: 4px; justify-content: space-between; }

.coo-sunset-stat { flex: 1 1 0%; text-align: center; min-width: 0px; opacity: 0; animation: coo-sunset-stat-in var(--sun-dur, 8s) ease-out infinite; }

.coo-sunset-stat:nth-child(1) { animation-delay: 0.5s; }

.coo-sunset-stat:nth-child(2) { animation-delay: 0.65s; }

.coo-sunset-stat:nth-child(3) { animation-delay: 0.8s; }

@keyframes coo-sunset-stat-in { 
  0%, 32% { opacity: 0; transform: translateY(4px); }
  42%, 75% { opacity: 1; transform: translateY(0px); }
  85%, 100% { opacity: 0; }
}

.coo-sunset-stat-val { font-size: 6px; font-weight: 800; color: rgb(253, 230, 138); line-height: 1; }

.coo-sunset-stat-lbl { font-size: 4px; font-weight: 600; color: rgba(255, 255, 255, 0.5); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-sunset-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-sunset-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-sunset-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-sunset-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

