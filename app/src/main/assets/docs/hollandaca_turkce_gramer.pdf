html { margin: 0px; padding: 0px; width: 100%; height: 100%; overflow: hidden; }

body, .main-wrapper { margin: 0px; border-radius: 2px; padding: 0px; width: 100%; height: 100%; overflow: hidden; color: rgb(10, 10, 10); font-family: -apple-system, system-ui, blinkmacsystemfont, "Segoe UI", roboto, oxygen, ubuntu, "Helvetica Neue", arial, sans-serif; font-size: 14px; font-weight: 400; -webkit-font-smoothing: antialiased; font-style: normal; }

h1 { margin: 16px 0px; text-align: center; line-height: 1.25; color: rgb(10, 10, 10); font-size: 16px; font-weight: 700; }

p { margin: 8px 0px; text-align: center; color: rgb(10, 10, 10); font-size: 20px; font-weight: 400; }

a { color: rgb(10, 10, 10); display: inline-block; text-decoration: underline; font-weight: 400; font-style: normal; }

a:link { color: rgb(10, 10, 10); }

a:hover { color: rgb(0, 54, 129); }

a:visited { color: rgb(8, 111, 255); }

a:focus, a:active { outline: rgb(70, 147, 255) solid 2px; outline-offset: 2px; border-radius: 2px; }

#nfIqS9 { box-sizing: border-box; display: flex; gap: 4px; align-items: center; justify-content: space-between; border: 1px solid rgb(217, 217, 217); border-radius: 2px; background-color: rgb(248, 248, 248); padding: 0px 8px; height: 65px; user-select: none; }

#ljmqo9, #Dqbv2, #DhMA1 { margin-right: 0.25em; margin-left: 0px; }

#CEbmZ8, #JZnEm8 { display: inline-block; }

#bnQg6 { position: absolute; top: 0px; z-index: 9999; background-color: rgb(248, 248, 248); line-height: 10px; color: rgb(178, 15, 3); font-size: 9px; }

#bnQg6 a { color: rgb(10, 10, 10); }

#bnQg6 a:visited, #bnQg6 a:link { color: rgb(10, 10, 10); }

#bnQg6 a:active, #bnQg6 a:hover, #bnQg6 a:focus { color: rgb(0, 54, 129); }

.DJYvk3 { display: flex; align-items: center; text-align: left; cursor: pointer; }

.qOVGb6 { display: grid; place-items: center; }

.qOVGb6 input { grid-area: 1 / 1; opacity: 0; z-index: 9999; margin: 0px; width: 24px; height: 24px; cursor: pointer; }

.qOVGb6 input:focus ~ .CDDrW6, .qOVGb6 input:active ~ .CDDrW6 { outline: rgb(70, 147, 255) solid 2px; outline-offset: 2px; border-radius: 2px; }

.qOVGb6 input:checked ~ .CDDrW6 { transform: rotate(0deg) scale(1); opacity: 1; border-radius: 5px; background-color: rgb(255, 255, 255); }

.qOVGb6 input:checked ~ .CDDrW6::after { top: 0px; left: 5px; transform: rotate(45deg) scale(1); border-style: solid; border-color: rgb(196, 77, 14); border-image: initial; border-width: 0px 4px 4px 0px; border-radius: 0px; width: 6px; height: 12px; }

.qOVGb6 .CDDrW6 { box-sizing: border-box; grid-area: 1 / 1; transition: 0.1s ease-in; animation: 0.4s cubic-bezier(0.55, 0.085, 0.68, 0.53) 0s 1 normal both running scale-up-center; z-index: 9998; border: 2px solid rgb(74, 74, 74); border-radius: 3px; background: rgb(255, 255, 255); width: 24px; height: 24px; }

.qOVGb6 .CDDrW6::after { position: absolute; border-radius: 5px; content: ""; }

.qOVGb6 .HfTQ0 { grid-column: 2; margin-left: 8px; }

