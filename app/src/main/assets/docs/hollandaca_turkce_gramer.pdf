.coo-banner-slot { position: relative; overflow: hidden; border-radius: 12px; line-height: normal; box-sizing: border-box; padding: 0px; }

.coo-banner-slot > a, .coo-banner-slot > a.coo-smart-wrap, #coo-ad.coo-banner-slot > a, #coo-ad.coo-banner-slot > a.coo-smart-wrap { display: block; width: 100%; height: 100%; min-height: inherit; line-height: normal; outline: none; text-decoration: none !important; border-bottom-width: medium !important; border-bottom-style: none !important; border-bottom-color: currentcolor !important; }

.coo-banner-slot > a:hover, .coo-banner-slot > a:focus, .coo-banner-slot > a:active, .coo-banner-slot > a:visited, #coo-ad.coo-banner-slot > a:hover, #coo-ad.coo-banner-slot > a:focus, #coo-ad.coo-banner-slot > a:active, #coo-ad.coo-banner-slot > a:visited { text-decoration: none !important; border-bottom-width: medium !important; border-bottom-style: none !important; border-bottom-color: currentcolor !important; }

.coo-banner-slot .coo-smart-wrap, .coo-banner-slot .coo-smart-wrap * { text-decoration: none !important; border-bottom-width: medium !important; border-bottom-style: none !important; border-bottom-color: currentcolor !important; }

.coo-smart-wrap { line-height: 1.25; box-sizing: border-box; display: flex; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; text-rendering: optimizelegibility; overflow: hidden; position: relative; height: 100%; min-height: 100%; transition: transform 0.3s, box-shadow 0.3s; border-radius: inherit; cursor: pointer; width: 100%; container-type: inline-size; animation: 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0s 1 normal both running coo-enter; text-decoration: none !important; }

@keyframes coo-enter { 
  0% { opacity: 0; transform: translateY(6px) scale(0.98); }
  100% { opacity: 1; transform: translateY(0px) scale(1); }
}

.coo-smart-wrap:active { transform: scale(0.985); }

@media (hover: hover) {
  .coo-smart-wrap:hover { transform: translateY(-1px); box-shadow: rgba(0, 0, 0, 0.12) 0px 12px 32px; }
  .coo-smart-wrap:hover .coo-btn { transform: scale(1.04); }
  .coo-smart-wrap:hover .coo-icon-tile { transform: scale(1.06); }
}

.coo-inner { display: flex; flex: 1 1 auto; flex-direction: inherit; align-items: inherit; justify-content: inherit; gap: inherit; padding: inherit; min-height: 0px; min-width: 0px; width: 100%; height: 100%; box-sizing: border-box; }

.coo-bg-orb { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(48px); }

.coo-bg-orb-1 { width: 100px; height: 100px; top: -24px; right: -16px; opacity: 0.4; animation: 8s ease-in-out 0s infinite normal none running coo-float; }

.coo-bg-orb-2 { width: 70px; height: 70px; bottom: -16px; left: 8%; opacity: 0.25; animation: 10s ease-in-out 0s infinite reverse none running coo-float; }

@keyframes coo-float { 
  0%, 100% { transform: translate(0px, 0px); }
  50% { transform: translate(8px, -6px); }
}

.coo-icon-tile { display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; transition: transform 0.3s; }

.coo-icon-svg { display: block; }

.coo-main { position: relative; z-index: 2; display: flex; flex: 1 1 0%; min-width: 0px; gap: 12px; align-items: center; overflow: hidden; }

.coo-text { flex: 1 1 0%; min-width: 0px; overflow: hidden; }

.coo-eyebrow { font-size: clamp(8px, 2.2cqw, 10px); font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 3px; opacity: 0.6; display: flex; align-items: center; gap: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-eyebrow-dot { width: 4px; height: 4px; border-radius: 50%; background: currentcolor; opacity: 0.45; flex-shrink: 0; }

.coo-hook { display: inline-block; font-size: clamp(8px, 2.2cqw, 10px); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 3px; padding: 2px 7px; border-radius: 5px; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; animation: 3s ease-in-out 0s infinite normal none running coo-hook-pulse; }

@keyframes coo-hook-pulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.82; }
}

.coo-title { font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; font-size: clamp(11px, 3.8cqw, 19px); margin: 0px 0px 2px; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.coo-desc { font-size: clamp(9px, 2.4cqw, 12px); font-weight: 450; line-height: 1.35; opacity: 0.78; margin: 0px; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.coo-btn { display: inline-flex; align-items: center; justify-content: center; gap: 5px; font-weight: 600; font-size: clamp(9px, 2.4cqw, 12px); letter-spacing: -0.01em; border-radius: 999px; padding: clamp(6px, 1.8cqw, 10px) clamp(10px, 2.8cqw, 16px); white-space: nowrap; transition: transform 0.25s, box-shadow 0.25s; z-index: 2; flex-shrink: 0; max-width: 100%; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.15) 0px 3px 12px; animation: 2.8s ease-in-out 0s infinite normal none running coo-btn-glow; }

.coo-btn span { overflow: hidden; text-overflow: ellipsis; }

@keyframes coo-btn-glow { 
  0%, 100% { box-shadow: rgba(0, 0, 0, 0.15) 0px 3px 12px; }
  50% { box-shadow: rgba(0, 0, 0, 0.22) 0px 4px 18px; }
}

.coo-arrow { flex-shrink: 0; width: 12px; height: 12px; }

.coo-brand { position: absolute; bottom: 4px; right: 10px; z-index: 3; font-size: 8px; font-weight: 600; letter-spacing: 0.03em; opacity: 0; pointer-events: none; transition: opacity 0.2s; }

@media (hover: hover) {
  .coo-smart-wrap:hover .coo-brand { opacity: 0.45; }
}

.layout-micro { flex-direction: row; padding: 8px 10px; gap: 8px; align-items: center; }

.layout-micro .coo-title { -webkit-line-clamp: 2; font-size: clamp(10px, 3.2cqw, 12px); }

.layout-micro .coo-desc, .layout-micro .coo-eyebrow, .layout-micro .coo-hook { display: none; }

.layout-micro .coo-icon-tile { width: 32px; height: 32px; }

