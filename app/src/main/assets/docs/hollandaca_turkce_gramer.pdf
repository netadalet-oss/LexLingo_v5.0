Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://mir.az/templates/mirtechv3/css/user.css?v=j6wwx

@charset "utf-8";

@media (min-width: 992px) {
  .post__edit { display: block !important; position: relative; }
  .post__edit a { background-color: rgba(0, 0, 0, 0.4); display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: 50%; position: relative; box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 0.75rem 0px; color: rgb(255, 255, 255) !important; }
  .icon_dots { height: 4px; display: block; }
  .icon_dots > i { display: inline-block; vertical-align: top; width: 4px; height: 4px; margin: 0px 1px; background-color: rgb(255, 255, 255); border-radius: 50%; }
  .post__edit a:hover { background-color: rgba(0, 0, 0, 0.8); }
}

.userpanel > button { width: 2.5rem; height: 2.5rem; border: 0px; background: 0px 0px; padding: 0px; vertical-align: top; }

.userpanel .avatar.fit-cover { width: 100%; height: 100%; }

.userpanel .avatar.fit-cover::after { content: ""; position: absolute; left: 0px; top: 0px; width: inherit; height: inherit; box-shadow: rgba(0, 0, 0, 0.05) 0px 0px 0.25rem 0px inset; border-radius: inherit; }

.userpanel .avatar.fit-cover img { background-color: rgb(234, 234, 234); }

.login-pane__info { text-align: center; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }

.login-pane__info .avatar.fit-cover { width: 3.5rem; height: 3.5rem; margin: 0px auto 0.5rem; }

.login-pane__admin { opacity: 0.5; text-transform: lowercase; }

.login-pane__admin:hover { opacity: 0.8; }

.login-pane__menu { margin-top: 1rem; }

.login-pane__menu li a { color: inherit; padding: 0.25rem 0px; display: block; }

.login-pane__menu li a:hover { color: rgb(76, 203, 112); }

.login-pane__menu li:first-child a { border-top-width: 0px; }

table.xfields { width: 100%; }

.xfields textarea, .xprofile textarea { width: 100%; height: 186px; margin-top: 5px; }

.xfields input[type="text"] { width: 100%; }

.xfieldsdescr { width: 200px; }

.xfields .bb-pane + textarea { margin-top: 0px; }

.xfieldsnote { color: rgb(131, 131, 131); font-size: 0.75rem; }

.xfields_table td { vertical-align: top; }

.xfieldsrow { margin-top: 1.5rem; clear: both; }

.xfieldscolleft { font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.5rem; opacity: 0.6; }

.xfieldscolright { width: 100%; }

.file-box { width: 95%; max-width: 437px; border: 1px solid rgb(179, 179, 179); border-radius: 3px; background-color: rgb(245, 245, 245); padding: 10px; margin-top: 10px; }

.xfieldimagegallery { margin: 0px; padding: 0px; list-style: none; clear: both; }

.xfieldimagegallery li { list-style: none; margin: 0px; padding: 0px; }

.xfieldimagegallery li img { float: left; margin-right: 5px; border: 5px solid rgb(255, 255, 255); width: 100px; height: 100px; transition: box-shadow 0.5s; }

.xfieldimagegallery li img:hover { box-shadow: rgba(0, 0, 0, 0.4) 0px 0px 0.5rem 0px; }

.qq-uploader { position: relative; width: 100%; }

.qq-upload-button { display: inline-block; margin-top: 5px; margin-bottom: 5px; cursor: pointer; }

.qq-upload-drop-area { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; z-index: 2; max-width: 437px; background: rgb(255, 151, 151); text-align: center; }

.qq-upload-drop-area span { display: block; position: absolute; top: 50%; width: 100%; margin-top: -8px; font-size: 1rem; }

.qq-upload-drop-area-active { background: rgb(255, 113, 113); }

.uploadedfile { display: inline-block; width: 115px; height: 160px; margin: 10px 5px 5px; border: 1px solid rgb(179, 179, 179); box-shadow: rgba(0, 0, 0, 0.3) 0px 1px 4px; text-align: center; background: rgb(255, 255, 255); }

.uploadedfile .uploadimage { margin-top: 5px; width: 115px; height: 90px; display: flex; align-items: center; justify-content: center; cursor: -webkit-grabbing; }

.sortable-ghost { opacity: 0.4; }

.uploadedfile .info { text-align: left; white-space: nowrap; margin: 0px 5px; overflow: hidden; }

table.xfields input { width: 100%; }

table.xfields tr > td:first-child { padding-right: 10px; }

.progress { overflow: hidden; margin-top: 10px; margin-bottom: 10px; height: 10px; border-radius: 8px; background: rgb(238, 238, 238); box-shadow: rgb(255, 255, 255) 0px 1px 0px, rgba(0, 0, 0, 0.1) 0px 0px 0px 1px inset, rgba(0, 0, 0, 0.2) 0px 1px 4px inset; }

.progress .progress-bar { float: left; width: 0%; font-size: 12px; line-height: 20px; color: rgb(255, 255, 255); text-align: center; background-color: rgb(66, 139, 202); transition: width 0.6s; border-radius: 8px; box-shadow: none; height: 8px; }

.progress-bar span { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); border: 0px; }

.progress-blue { background-image: linear-gradient(rgb(155, 207, 245) 0%, rgb(109, 185, 240) 100%); background-repeat: repeat-x; border: 1px solid rgb(85, 174, 238); }

#dropmenudiv { padding: 0.5rem; min-width: 140px; display: none; font-size: 0.75rem; border-radius: 1rem; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.5) 0px 0.5rem 2.5rem -625rem; background-color: rgba(0, 0, 0, 0.6); backdrop-filter: blur(5px); width: auto !important; z-index: 9999 !important; opacity: 1 !important; }

#dropmenudiv a { display: block; padding: 0.375rem 0.75rem; border-radius: 0.5rem; border: 0px; white-space: nowrap; color: rgb(255, 255, 255) !important; }

#dropmenudiv a:hover { background-color: rgb(76, 203, 112); }
