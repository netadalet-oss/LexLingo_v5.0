.layout-micro .coo-brand { display: none; }

.layout-micro .coo-hook { animation: auto ease 0s 1 normal none running none; }

.layout-compact { flex-direction: column; padding: 6px 10px 5px; gap: 5px; justify-content: space-between; align-items: stretch; }

.layout-compact .coo-main { flex-direction: row; align-items: flex-start; gap: 8px; flex: 1 1 auto; min-width: 0px; width: 100%; }

