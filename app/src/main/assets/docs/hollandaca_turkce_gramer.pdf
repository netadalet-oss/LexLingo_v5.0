.visual-showcase.layout-compact .coo-brand, .visual-showcase.layout-mobile .coo-brand { display: none; }

.visual-showcase.layout-micro { flex-direction: row !important; align-items: center !important; padding: 6px 8px !important; gap: 6px !important; }

.visual-showcase.layout-micro .coo-showcase-window { width: 44px; }

.visual-showcase.layout-micro .coo-showcase-glass { height: 36px; }

.visual-showcase.layout-micro .coo-showcase-desc, .visual-showcase.layout-micro .coo-showcase-trust { display: none; }

.visual-showcase.layout-micro .coo-showcase-title { font-size: 10px; -webkit-line-clamp: 2; }

.visual-showcase.layout-micro .coo-showcase-btn { font-size: 8px; padding: 5px 8px; }

.visual-ticket { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-ticket[class*="theme-"] { background: linear-gradient(160deg, rgb(26, 35, 50) 0%, rgb(36, 48, 68) 55%, rgb(30, 41, 59) 100%) !important; color: rgb(248, 250, 252) !important; border: 1px solid rgba(255, 255, 255, 0.07) !important; }

.visual-ticket .coo-bg-orb { display: none !important; }

.visual-ticket .coo-hook { background: rgba(244, 63, 94, 0.18) !important; color: rgb(253, 164, 175) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-ticket .coo-btn { background: rgb(248, 250, 252) !important; color: rgb(30, 41, 59) !important; border-radius: 8px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

@media (hover: hover) {
  .visual-ticket:hover .coo-btn { background: rgb(255, 255, 255) !important; }
}

.coo-ticket-glow { position: absolute; inset: -20%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 25% 60%, rgba(16, 185, 129, 0.1) 0%, transparent 45%); }

.coo-ticket-printer { position: relative; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; overflow: hidden; max-height: 100%; }

.coo-ticket-printer-body { width: 100%; background: linear-gradient(rgb(55, 65, 81) 0%, rgb(31, 41, 55) 100%); border-radius: 6px 6px 2px 2px; padding: 4px 5px 2px; box-shadow: rgba(0, 0, 0, 0.35) 0px 3px 10px, rgba(255, 255, 255, 0.1) 0px 1px 0px inset; position: relative; z-index: 2; }

.coo-ticket-slot { height: 4px; border-radius: 2px; background: rgb(15, 23, 42); box-shadow: rgba(0, 0, 0, 0.8) 0px 2px 4px inset; }

.coo-ticket-led { position: absolute; top: 5px; right: 6px; width: 4px; height: 4px; border-radius: 50%; background: rgb(239, 68, 68); animation: coo-ticket-led var(--ticket-dur, 8s) ease-in-out infinite; }

@keyframes coo-ticket-led { 
  0%, 38% { background: rgb(239, 68, 68); box-shadow: rgb(239, 68, 68) 0px 0px 4px; }
  42%, 88% { background: rgb(34, 197, 94); box-shadow: rgb(34, 197, 94) 0px 0px 6px; }
  92%, 100% { background: rgb(239, 68, 68); box-shadow: rgb(239, 68, 68) 0px 0px 4px; }
}

.coo-ticket-print-flash { position: absolute; inset: 0px; z-index: 4; pointer-events: none; border-radius: 6px; background: rgba(255, 255, 255, 0.35); opacity: 0; animation: coo-ticket-flash var(--ticket-dur, 8s) ease-out infinite; }

@keyframes coo-ticket-flash { 
  0%, 38% { opacity: 0; }
  40% { opacity: 1; }
  43%, 100% { opacity: 0; }
}

.coo-ticket-paper-wrap { position: relative; width: 100%; overflow: hidden; margin-top: -1px; z-index: 1; flex-shrink: 1; min-height: 0px; }

.coo-ticket-paper { width: 100%; background: rgb(250, 248, 245); color: rgb(55, 65, 81); font-family: "Courier New", Courier, monospace; box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 6px; position: relative; overflow: hidden; }

.coo-ticket-paper-edge { height: 4px; width: 100%; background: linear-gradient(135deg, rgb(250, 248, 245) 33.33%, transparent 33.33%, transparent 50%, rgb(250, 248, 245) 50%, rgb(250, 248, 245) 83.33%, transparent 83.33%) 0% 0% / 8px 4px; }

.coo-ticket-paper-edge-top { transform: rotate(180deg); margin-bottom: -1px; }

.coo-ticket-receipt { position: absolute; left: 0px; right: 0px; top: 0px; padding: 3px 4px 4px; transition: none; overflow: hidden; }

.coo-ticket-lost { animation: coo-ticket-lost-show var(--ticket-dur, 8s) ease-in-out infinite; }

.coo-ticket-digital { animation: coo-ticket-digital-show var(--ticket-dur, 8s) ease-in-out infinite; }

@keyframes coo-ticket-lost-show { 
  0%, 38% { opacity: 1; transform: translateY(0px); }
  42%, 100% { opacity: 0; transform: translateY(-8px); }
}

@keyframes coo-ticket-digital-show { 
  0%, 40% { opacity: 0; transform: translateY(12px); }
  44%, 90% { opacity: 1; transform: translateY(0px); }
  94%, 100% { opacity: 0; transform: translateY(-4px); }
}

.coo-ticket-line { font-size: 5px; font-weight: 600; line-height: 1.45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0.55; }

.coo-ticket-line-faded { text-decoration: line-through; color: rgb(156, 163, 175); }

.coo-ticket-line-err { color: rgb(220, 38, 38); font-weight: 800; opacity: 1; }

.coo-ticket-line-ok { color: rgb(5, 150, 105); font-weight: 700; opacity: 0; animation: 0.3s ease 0s 1 normal forwards running coo-ticket-line-in; }

.coo-ticket-digital .coo-ticket-line-ok:nth-child(1) { animation-delay: 3.6s; }

.coo-ticket-digital .coo-ticket-line-ok:nth-child(2) { animation-delay: 3.75s; }

.coo-ticket-digital .coo-ticket-line-ok:nth-child(3) { animation-delay: 3.9s; }

.coo-ticket-digital .coo-ticket-line-ok:nth-child(4) { animation-delay: 4.05s; }

.coo-ticket-digital .coo-ticket-line-ok:nth-child(5) { animation-delay: 4.2s; }

@keyframes coo-ticket-line-in { 
  100% { opacity: 1; }
}

.coo-ticket-divider { border-width: 1px medium medium; border-style: dashed none none; border-color: rgb(209, 213, 219) currentcolor currentcolor; border-image: initial; margin: 3px 0px; }

.coo-ticket-stamp { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-12deg) scale(0); font-size: 9px; font-weight: 900; letter-spacing: 0.06em; color: rgba(220, 38, 38, 0.75); border: 2px solid rgba(220, 38, 38, 0.65); border-radius: 4px; padding: 2px 5px; text-transform: uppercase; pointer-events: none; z-index: 2; animation: coo-ticket-stamp var(--ticket-dur, 8s) ease-out infinite; }

@keyframes coo-ticket-stamp { 
  0%, 8% { transform: translate(-50%, -50%) rotate(-12deg) scale(0); opacity: 0; }
  12%, 36% { transform: translate(-50%, -50%) rotate(-12deg) scale(1); opacity: 1; }
  40%, 100% { transform: translate(-50%, -50%) rotate(-12deg) scale(1.1); opacity: 0; }
}

.coo-ticket-check { text-align: center; font-size: 10px; font-weight: 800; color: rgb(5, 150, 105); margin-top: 2px; opacity: 0; animation: coo-ticket-check-in var(--ticket-dur, 8s) ease-out infinite; }

.coo-ticket-mode-strip .coo-ticket-check, .coo-ticket-mode-strip .coo-ticket-line-hide-strip { display: none !important; }

.coo-ticket-mode-strip .coo-ticket-divider { margin: 2px 0px; }

.coo-ticket-mode-strip .coo-ticket-stamp { padding: 1px 4px; font-size: 7px !important; }

@keyframes coo-ticket-check-in { 
  0%, 68% { opacity: 0; transform: scale(0.8); }
  72%, 88% { opacity: 1; transform: scale(1); }
  92%, 100% { opacity: 0; }
}

.coo-ticket-scroll { animation: coo-ticket-scroll var(--ticket-dur, 8s) linear infinite; }

@keyframes coo-ticket-scroll { 
  0%, 38% { transform: translateY(0px); }
  40%, 100% { transform: translateY(-3px); }
}

.coo-ticket-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.coo-ticket-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-ticket-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-ticket-desc { font-size: 10px; opacity: 0.78; margin: 0px; line-height: 1.3; }

.coo-ticket-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.visual-ticket.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-ticket.layout-banner-wide .coo-ticket-wide { display: grid; grid-template-columns: 76px minmax(0px, 1fr) auto; grid-template-rows: minmax(0px, 1fr); align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-ticket.layout-banner-wide .coo-ticket-printer { width: 76px; max-height: 72px; align-self: center; }

.visual-ticket.layout-banner-wide .coo-ticket-printer-body { padding: 3px 4px 2px; }

.visual-ticket.layout-banner-wide .coo-ticket-paper-wrap { height: 34px; max-height: 34px; }

.visual-ticket.layout-banner-wide .coo-ticket-paper { min-height: 0px; height: 100%; }

.visual-ticket.layout-banner-wide .coo-ticket-paper-edge { height: 3px; background-size: 6px 3px; }

.visual-ticket.layout-banner-wide .coo-ticket-line { font-size: 4px; line-height: 1.35; }

.visual-ticket.layout-banner-wide .coo-ticket-stamp { font-size: 6px; }

.visual-ticket.layout-banner-wide .coo-ticket-copy { align-self: center; min-width: 0px; }

.visual-ticket.layout-banner-wide .coo-ticket-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-ticket.layout-banner-wide .coo-ticket-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-ticket.layout-banner-wide .coo-ticket-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-ticket.layout-banner-wide .coo-ticket-btn { padding: 6px 11px; font-size: 10px; }

.visual-ticket.layout-banner-wide .coo-ticket-btn .coo-arrow { display: none; }

.visual-ticket.layout-banner-wide .coo-brand { display: none; }

.visual-ticket.layout-square, .visual-ticket.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-ticket.layout-square .coo-ticket-square, .visual-ticket.layout-desktop-square .coo-ticket-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-ticket.layout-square .coo-ticket-printer-stage, .visual-ticket.layout-desktop-square .coo-ticket-printer-stage { display: flex; gap: 12px; align-items: flex-start; flex-shrink: 0; }

.visual-ticket.layout-square .coo-ticket-printer, .visual-ticket.layout-desktop-square .coo-ticket-printer { width: 100px; flex-shrink: 0; }

.visual-ticket.layout-square .coo-ticket-paper-wrap, .visual-ticket.layout-desktop-square .coo-ticket-paper-wrap { height: 88px; }

.visual-ticket.layout-square .coo-ticket-paper, .visual-ticket.layout-desktop-square .coo-ticket-paper { min-height: 88px; }

.visual-ticket.layout-square .coo-ticket-line, .visual-ticket.layout-desktop-square .coo-ticket-line { font-size: 6px; }

.visual-ticket.layout-square .coo-ticket-stamp, .visual-ticket.layout-desktop-square .coo-ticket-stamp { font-size: 11px; }

.visual-ticket.layout-square .coo-ticket-stage-copy, .visual-ticket.layout-desktop-square .coo-ticket-stage-copy { flex: 1 1 0%; min-width: 0px; padding-top: 4px; }

.visual-ticket.layout-square .coo-ticket-stage-copy .coo-eyebrow, .visual-ticket.layout-desktop-square .coo-ticket-stage-copy .coo-eyebrow { color: rgb(148, 163, 184); font-size: 9px; margin-bottom: 4px; }

.visual-ticket.layout-square .coo-ticket-stage-copy .coo-hook, .visual-ticket.layout-desktop-square .coo-ticket-stage-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-ticket.layout-square .coo-ticket-title, .visual-ticket.layout-desktop-square .coo-ticket-title { font-size: 17px; margin-bottom: 4px; }

.visual-ticket.layout-square .coo-ticket-desc, .visual-ticket.layout-desktop-square .coo-ticket-desc { font-size: 11px; -webkit-line-clamp: 3; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-ticket.layout-square .coo-ticket-btn, .visual-ticket.layout-desktop-square .coo-ticket-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-ticket.layout-square .coo-brand, .visual-ticket.layout-desktop-square .coo-brand { display: none; }

.visual-ticket.layout-compact, .visual-ticket.layout-mobile { flex-direction: column !important; padding: 5px 8px 6px !important; justify-content: center !important; box-sizing: border-box !important; }

.visual-ticket.layout-compact .coo-ticket-compact, .visual-ticket.layout-mobile .coo-ticket-compact { display: flex; flex-direction: column; width: 100%; height: 100%; z-index: 2; min-height: 0px; }

.visual-ticket.layout-compact .coo-ticket-compact-main, .visual-ticket.layout-mobile .coo-ticket-compact-main { display: flex; flex-direction: row; align-items: center; gap: 7px; flex: 1 1 0%; min-height: 0px; overflow: hidden; }

.visual-ticket.layout-compact .coo-ticket-printer, .visual-ticket.layout-mobile .coo-ticket-printer { width: 56px; flex-shrink: 0; max-height: 100%; align-self: center; }

.visual-ticket.layout-compact .coo-ticket-printer-body, .visual-ticket.layout-mobile .coo-ticket-printer-body { padding: 3px 4px 2px; }

.visual-ticket.layout-compact .coo-ticket-paper-wrap, .visual-ticket.layout-mobile .coo-ticket-paper-wrap { height: 52px; max-height: 52px; }

.visual-ticket.layout-compact .coo-ticket-paper, .visual-ticket.layout-mobile .coo-ticket-paper { min-height: 0px; height: 100%; }

.visual-ticket.layout-compact .coo-ticket-paper-edge, .visual-ticket.layout-mobile .coo-ticket-paper-edge { height: 3px; background-size: 6px 3px; }

.visual-ticket.layout-compact .coo-ticket-line, .visual-ticket.layout-mobile .coo-ticket-line { font-size: 4.5px; line-height: 1.35; }

.visual-ticket.layout-compact .coo-ticket-stamp, .visual-ticket.layout-mobile .coo-ticket-stamp { font-size: 6px; padding: 1px 3px; }

.visual-ticket.layout-compact .coo-ticket-copy, .visual-ticket.layout-mobile .coo-ticket-copy { flex: 1 1 0%; min-width: 0px; display: flex; flex-direction: column; justify-content: center; gap: 2px; text-align: left; padding: 0px; }

.visual-ticket.layout-compact .coo-ticket-copy .coo-hook, .visual-ticket.layout-mobile .coo-ticket-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin: 0px; display: inline-block; align-self: flex-start; }

.visual-ticket.layout-compact .coo-ticket-title, .visual-ticket.layout-mobile .coo-ticket-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; margin: 0px; }

.visual-ticket.layout-compact .coo-ticket-desc, .visual-ticket.layout-mobile .coo-ticket-desc { display: none; }

.visual-ticket.layout-compact .coo-ticket-desc-mobile, .visual-ticket.layout-mobile .coo-ticket-desc-mobile { font-size: 8px; opacity: 0.78; line-height: 1.25; margin: 0px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; }

.visual-ticket.layout-compact .coo-ticket-compact-foot, .visual-ticket.layout-mobile .coo-ticket-compact-foot { display: flex; justify-content: center; align-items: center; width: 100%; flex-shrink: 0; padding-top: 2px; }

.visual-ticket.layout-compact .coo-ticket-compact-cta, .visual-ticket.layout-mobile .coo-ticket-compact-cta { display: none; }

.visual-ticket.layout-compact .coo-ticket-btn, .visual-ticket.layout-mobile .coo-ticket-btn { max-width: 100%; display: inline-flex; justify-content: center; padding: 5px 11px; font-size: 9px; white-space: nowrap; width: auto !important; }

.visual-ticket.layout-compact .coo-brand, .visual-ticket.layout-mobile .coo-brand { display: none; }

.visual-inbox { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-inbox[class*="theme-"] { background: linear-gradient(145deg, rgb(15, 10, 20) 0%, rgb(26, 16, 36) 40%, rgb(18, 8, 26) 100%) !important; color: rgb(250, 250, 250) !important; border: 1px solid rgba(255, 255, 255, 0.08) !important; }

.visual-inbox .coo-bg-orb { display: none !important; }

.visual-inbox .coo-hook { background: rgba(236, 72, 153, 0.2) !important; color: rgb(251, 207, 232) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-inbox .coo-btn { box-shadow: rgba(131, 58, 180, 0.35) 0px 4px 16px; background: linear-gradient(135deg, rgb(247, 119, 55), rgb(253, 29, 29), rgb(131, 58, 180)) !important; color: rgb(255, 255, 255) !important; border-width: medium !important; border-style: none !important; border-color: currentcolor !important; border-image: initial !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

@media (hover: hover) {
  .visual-inbox:hover .coo-btn { filter: brightness(1.08); }
}

.coo-inbox-aurora { position: absolute; inset: -30%; z-index: 0; pointer-events: none; background: radial-gradient(at 20% 30%, rgba(131, 58, 180, 0.35) 0%, transparent 50%), radial-gradient(at 80% 60%, rgba(253, 29, 29, 0.2) 0%, transparent 45%), radial-gradient(at 50% 90%, rgba(247, 119, 55, 0.15) 0%, transparent 40%); animation: 8s ease-in-out 0s infinite normal none running coo-inbox-aurora; }

@keyframes coo-inbox-aurora { 
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05) rotate(1deg); }
}

.coo-inbox-stage { position: relative; flex-shrink: 0; overflow: hidden; border-radius: 12px; background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); }

.coo-inbox-bubble { position: absolute; display: flex; align-items: flex-start; gap: 4px; max-width: 88%; opacity: 0; z-index: 2; }

.coo-inbox-avatar { width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; background: linear-gradient(135deg, rgb(247, 119, 55), rgb(253, 29, 29), rgb(131, 58, 180)); padding: 1px; box-sizing: border-box; }

.coo-inbox-avatar-inner { width: 100%; height: 100%; border-radius: 50%; background: rgb(26, 16, 36); display: flex; align-items: center; justify-content: center; font-size: 5px; font-weight: 800; color: rgb(255, 255, 255); }

.coo-inbox-bubble-body { background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(4px); border-radius: 10px 10px 10px 2px; padding: 3px 6px; border: 1px solid rgba(255, 255, 255, 0.08); }

.coo-inbox-bubble-user { font-size: 5px; font-weight: 800; color: rgb(232, 121, 249); line-height: 1; margin-bottom: 1px; }

.coo-inbox-bubble-msg { font-size: 6px; font-weight: 500; color: rgba(255, 255, 255, 0.9); line-height: 1.2; white-space: nowrap; }

.coo-inbox-badge { position: absolute; top: -4px; right: -4px; min-width: 10px; height: 10px; padding: 0px 2px; border-radius: 99px; background: rgb(239, 68, 68); color: rgb(255, 255, 255); font-size: 5px; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 1px solid rgb(15, 10, 20); line-height: 1; }

.coo-inbox-b1 { animation: coo-inbox-b1 var(--inbox-dur, 10s) ease-out infinite; }

.coo-inbox-b2 { animation: coo-inbox-b2 var(--inbox-dur, 10s) ease-out infinite; }

.coo-inbox-b3 { animation: coo-inbox-b3 var(--inbox-dur, 10s) ease-out infinite; }

.coo-inbox-b4 { animation: coo-inbox-b4 var(--inbox-dur, 10s) ease-out infinite; }

@keyframes coo-inbox-b1 { 
  0%, 4% { opacity: 0; transform: translate(20px, 10px) scale(0.8); }
  8%, 32% { opacity: 1; transform: translate(0px, 0px) scale(1); }
  38%, 100% { opacity: 0; transform: translate(-8px, -12px) scale(0.6); }
}

@keyframes coo-inbox-b2 { 
  0%, 10% { opacity: 0; transform: translate(24px, 0px) scale(0.8); }
  14%, 34% { opacity: 1; transform: translate(4px, 8px) scale(1); }
  40%, 100% { opacity: 0; transform: translate(-12px, -8px) scale(0.55); }
}

@keyframes coo-inbox-b3 { 
  0%, 16% { opacity: 0; transform: translate(18px, -6px) scale(0.8); }
  20%, 36% { opacity: 1; transform: translate(8px, 18px) scale(1); }
  42%, 100% { opacity: 0; transform: translate(-10px, -6px) scale(0.5); }
}

@keyframes coo-inbox-b4 { 
  0%, 22% { opacity: 0; transform: translate(22px, 4px) scale(0.8); }
  26%, 38% { opacity: 1; transform: translate(2px, 24px) scale(1); }
  44%, 100% { opacity: 0; transform: translate(-14px, -4px) scale(0.45); }
}

.coo-inbox-notif-stack { position: absolute; top: 4px; right: 4px; z-index: 3; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; animation: coo-inbox-notif var(--inbox-dur, 10s) ease-in-out infinite; }

@keyframes coo-inbox-notif { 
  0%, 28% { opacity: 1; transform: scale(1); }
  36%, 100% { opacity: 0; transform: scale(0.8); }
}

.coo-inbox-notif-pill { font-size: 5px; font-weight: 800; padding: 2px 5px; border-radius: 99px; background: rgba(239, 68, 68, 0.9); color: rgb(255, 255, 255); white-space: nowrap; box-shadow: rgba(239, 68, 68, 0.4) 0px 2px 8px; }

.coo-inbox-panel { position: absolute; inset: 6px; z-index: 4; background: linear-gradient(160deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.06) 100%); backdrop-filter: blur(8px); border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); display: flex; flex-direction: column; align-items: stretch; justify-content: center; padding: 6px 8px; gap: 4px; opacity: 0; transform: scale(0.88) translateY(8px); animation: coo-inbox-panel-in var(--inbox-dur, 10s) cubic-bezier(0.22, 1, 0.36, 1) infinite; }

@keyframes coo-inbox-panel-in { 
  0%, 42% { opacity: 0; transform: scale(0.88) translateY(8px); }
  48%, 92% { opacity: 1; transform: scale(1) translateY(0px); }
  98%, 100% { opacity: 0; transform: scale(0.95) translateY(4px); }
}

.coo-inbox-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 4px; }

.coo-inbox-panel-title { font-size: 7px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.02em; }

.coo-inbox-panel-count { font-size: 6px; font-weight: 800; padding: 2px 5px; border-radius: 99px; background: rgb(16, 185, 129); color: rgb(255, 255, 255); }

.coo-inbox-channels { display: flex; gap: 3px; flex-wrap: wrap; }

.coo-inbox-ch { font-size: 5px; font-weight: 700; padding: 2px 5px; border-radius: 99px; background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.85); border: 1px solid rgba(255, 255, 255, 0.12); }

.coo-inbox-ch-ig { border-color: rgba(225, 48, 108, 0.4); color: rgb(249, 168, 212); }

.coo-inbox-ch-wa { border-color: rgba(37, 211, 102, 0.4); color: rgb(134, 239, 172); }

.coo-inbox-ch-web { border-color: rgba(96, 165, 250, 0.4); color: rgb(147, 197, 253); }

.coo-inbox-panel-rows { display: flex; flex-direction: column; gap: 2px; margin-top: 2px; }

.coo-inbox-row { display: flex; align-items: center; gap: 4px; padding: 2px 4px; border-radius: 4px; background: rgba(255, 255, 255, 0.06); opacity: 0; animation: coo-inbox-row-in var(--inbox-dur, 10s) ease-out infinite; }

.coo-inbox-row:nth-child(1) { animation-delay: 0s; }

.coo-inbox-row:nth-child(2) { animation-delay: 0s; }

.coo-inbox-row:nth-child(3) { animation-delay: 0s; }

@keyframes coo-inbox-row-in { 
  0%, 50% { opacity: 0; transform: translateX(-6px); }
  54%, 90% { opacity: 1; transform: translateX(0px); }
  96%, 100% { opacity: 0; }
}

.coo-inbox-row-dot { width: 4px; height: 4px; border-radius: 50%; flex-shrink: 0; }

.coo-inbox-row-dot-ig { background: rgb(225, 48, 108); }

.coo-inbox-row-dot-wa { background: rgb(37, 211, 102); }

.coo-inbox-row-dot-web { background: rgb(59, 130, 246); }

.coo-inbox-row-text { font-size: 5px; font-weight: 600; color: rgba(255, 255, 255, 0.88); flex: 1 1 0%; min-width: 0px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-inbox-row-amt { font-size: 5px; font-weight: 800; color: rgb(110, 231, 183); flex-shrink: 0; }

.coo-inbox-sweep { position: absolute; inset: 0px; z-index: 5; pointer-events: none; background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.12) 50%, transparent 60%); animation: coo-inbox-sweep var(--inbox-dur, 10s) ease-in-out infinite; }

@keyframes coo-inbox-sweep { 
  0%, 44% { transform: translateX(-120%); opacity: 0; }
  48% { opacity: 1; }
  54%, 100% { transform: translateX(120%); opacity: 0; }
}

.coo-inbox-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-inbox-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-inbox-desc { font-size: 10px; opacity: 0.78; margin: 0px; line-height: 1.3; }

.coo-inbox-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-inbox-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-inbox.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-inbox.layout-banner-wide .coo-inbox-wide { display: grid; grid-template-columns: 118px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-inbox.layout-banner-wide .coo-inbox-stage { width: 118px; height: 72px; max-height: 72px; }

.visual-inbox.layout-banner-wide .coo-inbox-b1 { left: 4px; top: 8px; }

.visual-inbox.layout-banner-wide .coo-inbox-b2 { left: 2px; top: 26px; }

