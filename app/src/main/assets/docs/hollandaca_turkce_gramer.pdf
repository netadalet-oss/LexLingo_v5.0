.layout-mobile .coo-stat-text .coo-desc { display: -webkit-box; -webkit-line-clamp: 1; font-size: 9px; }

.layout-mobile .coo-brand { display: none; }

.layout-square { flex-direction: column; padding: 12px 14px; gap: 8px; justify-content: space-between; min-height: 0px; }

