.layout-compact .coo-title { -webkit-line-clamp: 2; font-size: 11px; margin: 0px; line-height: 1.2; }

.layout-compact .coo-desc { -webkit-line-clamp: 1; font-size: 9px; margin: 0px; opacity: 0.8; }

.layout-compact .coo-btn { width: auto; max-width: 100%; padding: 6px 10px; font-size: 9px; flex-shrink: 0; display: inline-flex; justify-content: center; align-self: center; margin-left: auto; margin-right: auto; white-space: nowrap; animation: auto ease 0s 1 normal none running none; }

.layout-compact .coo-btn .coo-arrow { width: 10px; height: 10px; }

.layout-banner-wide { flex-direction: row; padding: 3px 10px; gap: 10px; align-items: center; min-height: 100%; border-radius: 12px; }

.layout-banner-wide .coo-main { flex: 1 1 0%; align-items: center; gap: 8px; min-width: 0px; }

.layout-banner-wide .coo-icon-tile { width: 36px; height: 36px; border-radius: 8px; }

.layout-banner-wide .coo-eyebrow { display: none; }

.layout-banner-wide .coo-text > .coo-hook { display: none; }

.layout-banner-wide .coo-hook { font-size: 9px; margin-bottom: 1px; animation: auto ease 0s 1 normal none running none; }

.layout-banner-wide .coo-title { -webkit-line-clamp: 1; font-size: 16px; line-height: 1.15; margin: 0px; font-weight: 700; }

.layout-banner-wide .coo-desc { -webkit-line-clamp: 1; font-size: 12px; line-height: 1.2; opacity: 0.85; margin: 0px; }

.layout-banner-wide .coo-btn { padding: 6px 14px; font-size: 12px; animation: auto ease 0s 1 normal none running none; flex-shrink: 0; }

.layout-banner-wide .coo-brand { display: none; }

.layout-mobile { flex-direction: column; padding: 6px 10px 5px; gap: 5px; justify-content: space-between; align-items: stretch; min-height: 0px; }

.layout-mobile .coo-main { width: 100%; flex: 1 1 auto; min-width: 0px; align-items: flex-start; gap: 8px; }

.layout-mobile .coo-icon-tile { width: 36px; height: 36px; flex-shrink: 0; border-radius: 9px; }

.layout-mobile .coo-title { -webkit-line-clamp: 2; font-size: 12px; line-height: 1.2; margin: 0px; }

.layout-mobile .coo-desc { -webkit-line-clamp: 1; font-size: 9px; line-height: 1.25; opacity: 0.82; margin: 0px; }

.layout-mobile .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; animation: auto ease 0s 1 normal none running none; align-self: flex-start; }

.layout-mobile .coo-btn { width: auto; max-width: 100%; padding: 6px 10px; font-size: 9px; flex-shrink: 0; align-self: center; margin-left: auto; margin-right: auto; animation: auto ease 0s 1 normal none running none; display: inline-flex; justify-content: center; white-space: nowrap; }

.layout-mobile .coo-btn .coo-arrow { width: 10px; height: 10px; }

.layout-mobile .coo-stat-wrap { flex: 1 1 auto; min-width: 0px; display: flex; align-items: center; gap: 8px; width: 100%; }

