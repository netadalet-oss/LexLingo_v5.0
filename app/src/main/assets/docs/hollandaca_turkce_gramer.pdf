.visual-bridge.layout-compact .coo-bridge-title, .visual-bridge.layout-mobile .coo-bridge-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

