.visual-hot-booking[class*="theme-"], .visual-hot-flash[class*="theme-"], .visual-hot-drive[class*="theme-"], .visual-hot-boutique[class*="theme-"], .visual-hot-sparkle[class*="theme-"], .visual-hot-pipeline[class*="theme-"] { background: linear-gradient(135deg, rgb(30, 27, 75) 0%, rgb(124, 58, 237) 45%, rgb(225, 29, 72) 100%) 0% 0% / 200% 200% !important; animation: 6s ease 0s infinite normal none running coo-hot-bg-shift !important; color: rgb(255, 255, 255) !important; border: 1px solid rgba(255, 255, 255, 0.12) !important; }

