.coo-slv-glow { position: absolute; inset: -30%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 50% 40%, rgba(0, 113, 227, 0.06) 0%, transparent 55%); }

.coo-slv-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-slv-stage { position: relative; width: 100%; height: 100%; border-radius: 12px; overflow: hidden; background: rgba(255, 255, 255, 0.72); border: 1px solid rgba(255, 255, 255, 0.95); box-shadow: rgba(0, 0, 0, 0.08) 0px 8px 28px, rgb(255, 255, 255) 0px 1px 0px inset; }

.coo-slv-glass { position: absolute; inset: 0px; z-index: 1; pointer-events: none; background: linear-gradient(135deg, rgba(255, 255, 255, 0.35) 0%, transparent 45%, rgba(255, 255, 255, 0.08) 100%); }

.coo-slv-board { position: absolute; left: 8%; right: 8%; height: 2px; z-index: 2; background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.06) 15%, rgba(0, 0, 0, 0.06) 85%, transparent); box-shadow: rgba(0, 0, 0, 0.04) 0px 2px 8px; }

.coo-slv-board-top { bottom: 42%; }

.coo-slv-board-bot { bottom: 18%; }

.coo-slv-row { position: absolute; left: 10%; right: 10%; display: flex; justify-content: space-between; align-items: flex-end; z-index: 3; }

.coo-slv-row-top { bottom: 44%; height: 22%; }

.coo-slv-row-bot { bottom: 20%; height: 18%; }

.coo-slv-pod { width: 18%; height: 100%; border-radius: 4px; position: relative; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 8px; transition: transform 0.3s; }

.slv-c-silver { background: linear-gradient(145deg, rgb(227, 228, 230), rgb(210, 210, 215)); }

.slv-c-blue { background: linear-gradient(145deg, rgb(167, 199, 255), rgb(0, 113, 227)); }

.slv-c-gold { background: linear-gradient(145deg, rgb(245, 230, 200), rgb(232, 197, 71)); }

.slv-c-rose { background: linear-gradient(145deg, rgb(255, 200, 208), rgb(255, 100, 130)); }

.slv-c-green { background: linear-gradient(145deg, rgb(184, 240, 200), rgb(52, 199, 89)); }

.coo-slv-pod-hero { animation: coo-slv-hero-lift var(--slv-dur, 8s) cubic-bezier(0.22, 1, 0.36, 1) infinite; z-index: 5; }

@keyframes coo-slv-hero-lift { 
  0%, 25% { transform: translateY(0px) scale(1); box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 8px; }
  38%, 68% { transform: translateY(-5px) scale(1.06); box-shadow: rgba(0, 0, 0, 0.14) 0px 8px 20px; }
  82%, 100% { transform: translateY(0px) scale(1); }
}

.coo-slv-tap-ring { position: absolute; left: 50%; top: 50%; width: 14px; height: 14px; margin: -7px 0px 0px -7px; border-radius: 50%; border: 1px solid rgba(0, 113, 227, 0.45); z-index: 4; pointer-events: none; opacity: 0; animation: coo-slv-tap-ring var(--slv-dur, 8s) ease-out infinite; }

.coo-slv-tap-ring:nth-child(2) { animation-delay: 0.15s; }

@keyframes coo-slv-tap-ring { 
  0%, 32% { opacity: 0; transform: scale(0.5); }
  40%, 55% { opacity: 0.8; transform: scale(1); border-color: rgba(0, 113, 227, 0.5); }
  65%, 100% { opacity: 0; transform: scale(1.6); }
}

.coo-slv-price { position: absolute; top: 6px; left: 50%; transform: translateX(-50%); padding: 2px 5px; border-radius: 99px; z-index: 6; background: rgba(29, 29, 31, 0.88); color: rgb(255, 255, 255); font-size: 4px; font-weight: 700; letter-spacing: -0.02em; opacity: 0; animation: coo-slv-price-in var(--slv-dur, 8s) ease-out infinite; }

@keyframes coo-slv-price-in { 
  0%, 42% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  50%, 78% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  88%, 100% { opacity: 0.85; }
}

.coo-slv-sold { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 2px; padding: 2px 5px; border-radius: 99px; z-index: 7; background: rgb(255, 255, 255); color: rgb(29, 29, 31); font-size: 3px; font-weight: 700; box-shadow: rgba(0, 0, 0, 0.12) 0px 4px 14px; opacity: 0; animation: coo-slv-sold-in var(--slv-dur, 8s) ease-out infinite; }

.coo-slv-sold-check { width: 6px; height: 6px; border-radius: 50%; background: rgb(52, 199, 89); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 4px; font-weight: 900; line-height: 1; }

@keyframes coo-slv-sold-in { 
  0%, 58% { opacity: 0; transform: translateX(-50%) translateY(6px) scale(0.92); }
  66%, 88% { opacity: 1; transform: translateX(-50%) translateY(0px) scale(1); }
  96%, 100% { opacity: 0.9; }
}

.coo-slv-stat { position: absolute; top: 4px; right: 4px; z-index: 6; text-align: right; padding: 2px 4px; border-radius: 6px; background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(0, 0, 0, 0.05); }

.coo-slv-stat-val { display: block; font-size: 5px; font-weight: 800; color: rgb(29, 29, 31); letter-spacing: -0.03em; line-height: 1; }

.coo-slv-stat-sub { font-size: 2px; font-weight: 700; color: rgb(134, 134, 139); text-transform: uppercase; letter-spacing: 0.04em; }

.coo-slv-barcode { position: absolute; bottom: 4px; left: 4px; z-index: 5; display: flex; gap: 1px; align-items: flex-end; height: 8px; opacity: 0.35; }

.coo-slv-barcode span { width: 1px; background: rgb(29, 29, 31); border-radius: 1px; }

.coo-slv-barcode span:nth-child(1) { height: 6px; }

.coo-slv-barcode span:nth-child(2) { height: 8px; }

.coo-slv-barcode span:nth-child(3) { height: 4px; }

.coo-slv-barcode span:nth-child(4) { height: 7px; }

.coo-slv-barcode span:nth-child(5) { height: 5px; }

.coo-slv-scan-line { position: absolute; left: 8%; right: 8%; height: 1px; z-index: 8; background: linear-gradient(90deg, transparent, rgba(0, 113, 227, 0.6), transparent); opacity: 0; animation: coo-slv-scan var(--slv-dur, 8s) ease-in-out infinite; }

@keyframes coo-slv-scan { 
  0%, 20% { opacity: 0; top: 30%; }
  30%, 35% { opacity: 1; top: 55%; }
  45%, 100% { opacity: 0; top: 70%; }
}

.coo-slv-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-slv-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-slv-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-slv-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-slv-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-shelf.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-shelf.layout-banner-wide .coo-slv-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-shelf.layout-banner-wide .coo-slv-stage { width: 96px; height: 72px; border-radius: 10px; }

.visual-shelf.layout-banner-wide .coo-slv-row-bot { display: none; }

.visual-shelf.layout-banner-wide .coo-slv-board-bot { display: none; }

.visual-shelf.layout-banner-wide .coo-slv-sold { display: none; }

.visual-shelf.layout-banner-wide .coo-slv-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-shelf.layout-banner-wide .coo-slv-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-shelf.layout-banner-wide .coo-slv-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; color: rgb(134, 134, 139) !important; opacity: 1 !important; }

.visual-shelf.layout-banner-wide .coo-slv-btn { padding: 6px 12px; font-size: 10px; }

.visual-shelf.layout-banner-wide .coo-slv-btn .coo-arrow { display: none; }

.visual-shelf.layout-banner-wide .coo-brand { display: none; }

.visual-shelf.layout-square, .visual-shelf.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-shelf.layout-square .coo-slv-square, .visual-shelf.layout-desktop-square .coo-slv-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-shelf.layout-square .coo-slv-square-top, .visual-shelf.layout-desktop-square .coo-slv-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-shelf.layout-square .coo-slv-stage, .visual-shelf.layout-desktop-square .coo-slv-stage { width: 130px; height: 118px; border-radius: 14px; }

.visual-shelf.layout-square .coo-slv-copy .coo-hook, .visual-shelf.layout-desktop-square .coo-slv-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-shelf.layout-square .coo-slv-title, .visual-shelf.layout-desktop-square .coo-slv-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-shelf.layout-square .coo-slv-desc, .visual-shelf.layout-desktop-square .coo-slv-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; color: rgb(134, 134, 139) !important; opacity: 1 !important; }

.visual-shelf.layout-square .coo-slv-btn, .visual-shelf.layout-desktop-square .coo-slv-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-shelf.layout-square .coo-brand, .visual-shelf.layout-desktop-square .coo-brand { display: none; }

.visual-shelf.layout-compact, .visual-shelf.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-shelf.layout-compact .coo-slv-compact, .visual-shelf.layout-mobile .coo-slv-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-shelf.layout-compact .coo-slv-compact-top, .visual-shelf.layout-mobile .coo-slv-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-shelf.layout-compact .coo-slv-stage, .visual-shelf.layout-mobile .coo-slv-stage { width: 72px; height: 62px; border-radius: 10px; }

.visual-shelf.layout-compact .coo-slv-row-bot, .visual-shelf.layout-mobile .coo-slv-row-bot { display: none; }

.visual-shelf.layout-compact .coo-slv-board-bot, .visual-shelf.layout-mobile .coo-slv-board-bot { display: none; }

.visual-shelf.layout-compact .coo-slv-sold, .visual-shelf.layout-mobile .coo-slv-sold { display: none; }

.visual-shelf.layout-compact .coo-slv-price, .visual-shelf.layout-mobile .coo-slv-price { font-size: 3px; }

.visual-shelf.layout-compact .coo-slv-copy .coo-hook, .visual-shelf.layout-mobile .coo-slv-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-shelf.layout-compact .coo-slv-title, .visual-shelf.layout-mobile .coo-slv-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-shelf.layout-compact .coo-slv-desc, .visual-shelf.layout-mobile .coo-slv-desc { display: none; }

.visual-shelf.layout-compact .coo-slv-compact-foot, .visual-shelf.layout-mobile .coo-slv-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-shelf.layout-compact .coo-slv-btn, .visual-shelf.layout-mobile .coo-slv-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-shelf.layout-compact .coo-slv-btn .coo-arrow, .visual-shelf.layout-mobile .coo-slv-btn .coo-arrow { display: none; }

.visual-shelf.layout-compact .coo-brand, .visual-shelf.layout-mobile .coo-brand { display: none; }

.visual-plate { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-plate[class*="theme-"] { background: linear-gradient(155deg, rgb(28, 25, 23) 0%, rgb(41, 37, 36) 40%, rgb(194, 65, 12) 85%, rgb(245, 158, 11) 100%) !important; color: rgb(255, 255, 255) !important; border: 1px solid rgba(251, 191, 36, 0.25) !important; }

.visual-plate .coo-bg-orb { display: none !important; }

.visual-plate .coo-hook { background: rgba(0, 0, 0, 0.2) !important; color: rgb(253, 230, 138) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-plate .coo-btn { box-shadow: rgba(251, 191, 36, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(194, 65, 12) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-plt-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 35% 55%, rgba(251, 191, 36, 0.12) 0%, transparent 48%), radial-gradient(circle at 75% 35%, rgba(6, 193, 103, 0.08) 0%, transparent 42%); }

.coo-plt-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-plt-kds { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.35) 0%, rgba(28, 25, 23, 0.55) 100%); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-plt-ticket { position: absolute; top: 5px; left: 4px; width: 38%; bottom: 5px; background: rgb(250, 248, 245); color: rgb(28, 25, 23); border-radius: 4px; padding: 3px 4px; z-index: 3; box-shadow: rgba(0, 0, 0, 0.25) 0px 3px 10px; animation: coo-plt-ticket-in var(--plt-dur, 8s) ease-out infinite; }

@keyframes coo-plt-ticket-in { 
  0%, 8% { opacity: 0; transform: translateX(-6px); }
  14%, 100% { opacity: 1; transform: translateX(0px); }
}

.coo-plt-ticket-head { font-size: 3px; font-weight: 800; color: rgb(120, 113, 108); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px dashed rgb(214, 211, 209); padding-bottom: 2px; margin-bottom: 2px; }

.coo-plt-ticket-no { font-size: 4px; font-weight: 900; color: rgb(194, 65, 12); }

.coo-plt-ticket-item { font-size: 3px; font-weight: 700; color: rgb(68, 64, 60); padding: 1px 0px; border-bottom: 1px dotted rgb(231, 229, 228); opacity: 0; animation: coo-plt-item-in var(--plt-dur, 8s) ease-out infinite; }

.coo-plt-ticket-item:nth-child(3) { animation-delay: 0.15s; }

.coo-plt-ticket-item:nth-child(4) { animation-delay: 0.3s; }

@keyframes coo-plt-item-in { 
  0%, 18% { opacity: 0; transform: translateX(-3px); }
  24%, 100% { opacity: 1; transform: translateX(0px); }
}

.coo-plt-table { position: absolute; top: 6px; right: 4px; z-index: 5; text-align: center; padding: 2px 5px; border-radius: 6px; background: rgba(255, 255, 255, 0.95); color: rgb(28, 25, 23); box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px; }

.coo-plt-table-num { display: block; font-size: 7px; font-weight: 900; letter-spacing: -0.03em; line-height: 1; color: rgb(194, 65, 12); }

.coo-plt-table-sub { font-size: 2px; font-weight: 800; color: rgb(120, 113, 108); text-transform: uppercase; letter-spacing: 0.06em; }

.coo-plt-dish-wrap { position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); width: 36%; height: 28%; z-index: 2; }

.coo-plt-dish { position: absolute; inset: 0px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, rgb(255, 255, 255) 0%, rgb(245, 245, 244) 55%, rgb(231, 229, 228) 100%); border: 2px solid rgba(255, 255, 255, 0.5); box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px, rgba(0, 0, 0, 0.06) 0px 2px 4px inset; }

.coo-plt-food { position: absolute; top: 22%; left: 50%; transform: translateX(-50%); width: 55%; height: 35%; border-radius: 50% 50% 40% 40%; background: linear-gradient(rgb(253, 186, 116), rgb(234, 88, 12)); }

.coo-plt-steam { position: absolute; bottom: 100%; width: 3px; height: 10px; background: rgba(255, 255, 255, 0.45); border-radius: 99px; opacity: 0; animation: coo-plt-steam var(--plt-dur, 8s) ease-in-out infinite; }

.coo-plt-steam:nth-child(1) { left: 30%; }

.coo-plt-steam:nth-child(2) { left: 48%; animation-delay: 0.25s; }

.coo-plt-steam:nth-child(3) { left: 62%; animation-delay: 0.5s; }

@keyframes coo-plt-steam { 
  0%, 35% { opacity: 0; transform: translateY(4px) scaleY(0.5); }
  48%, 72% { opacity: 0.85; transform: translateY(-8px) scaleY(1); }
  85%, 100% { opacity: 0; }
}

.coo-plt-status { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 4; display: flex; flex-direction: column; align-items: center; gap: 2px; }

.coo-plt-pill { padding: 2px 6px; border-radius: 99px; font-size: 3px; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; white-space: nowrap; }

.coo-plt-pill-prep { background: rgba(251, 191, 36, 0.9); color: rgb(120, 53, 15); animation: coo-plt-prep-show var(--plt-dur, 8s) ease-in-out infinite; }

.coo-plt-pill-ready { background: rgb(6, 193, 103); color: rgb(255, 255, 255); box-shadow: rgba(6, 193, 103, 0.5) 0px 0px 12px; opacity: 0; position: absolute; animation: coo-plt-ready-show var(--plt-dur, 8s) ease-out infinite; }

@keyframes coo-plt-prep-show { 
  0%, 38% { opacity: 1; transform: scale(1); }
  48%, 100% { opacity: 0; transform: scale(0.9); }
}

@keyframes coo-plt-ready-show { 
  0%, 42% { opacity: 0; transform: scale(0.85); }
  52%, 82% { opacity: 1; transform: scale(1.05); }
  92%, 100% { opacity: 0.9; transform: scale(1); }
}

.coo-plt-timer { font-size: 4px; font-weight: 800; color: rgba(255, 255, 255, 0.7); font-variant-numeric: tabular-nums; animation: coo-plt-timer-fade var(--plt-dur, 8s) ease-in-out infinite; }

@keyframes coo-plt-timer-fade { 
  0%, 38% { opacity: 1; }
  48%, 100% { opacity: 0; }
}

.coo-plt-bell { position: absolute; bottom: 4px; right: 4px; z-index: 6; width: 12px; height: 12px; border-radius: 50%; background: rgb(6, 193, 103); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 6px; line-height: 1; opacity: 0; transform: scale(0.5); animation: coo-plt-bell-ring var(--plt-dur, 8s) ease-out infinite; }

@keyframes coo-plt-bell-ring { 
  0%, 50% { opacity: 0; transform: scale(0.5); }
  55%, 58% { opacity: 1; transform: scale(1.15); }
  60%, 63% { transform: scale(0.95); }
  65%, 78% { opacity: 1; transform: scale(1); box-shadow: rgba(6, 193, 103, 0.6) 0px 0px 10px; }
  88%, 100% { opacity: 0.85; }
}

