.visual-clock.layout-compact .coo-clock-title, .visual-clock.layout-mobile .coo-clock-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-clock.layout-compact .coo-clock-desc, .visual-clock.layout-mobile .coo-clock-desc { display: none; }

.visual-clock.layout-compact .coo-clock-compact-foot, .visual-clock.layout-mobile .coo-clock-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-clock.layout-compact .coo-clock-btn, .visual-clock.layout-mobile .coo-clock-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

