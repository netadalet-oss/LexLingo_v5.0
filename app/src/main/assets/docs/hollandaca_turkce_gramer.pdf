.visual-inbox.layout-compact .coo-inbox-title, .visual-inbox.layout-mobile .coo-inbox-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-inbox.layout-compact .coo-inbox-desc, .visual-inbox.layout-mobile .coo-inbox-desc { display: none; }

