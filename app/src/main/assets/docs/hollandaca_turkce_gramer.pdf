.visual-pipeline.layout-compact .coo-brand, .visual-pipeline.layout-mobile .coo-brand { display: none; }

.visual-winback { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-winback[class*="theme-"] { background: linear-gradient(155deg, rgb(76, 5, 25) 0%, rgb(225, 29, 72) 40%, rgb(251, 113, 133) 100%) !important; color: rgb(255, 241, 242) !important; border: 1px solid rgba(251, 113, 133, 0.28) !important; }

.visual-winback .coo-bg-orb { display: none !important; }

.visual-winback .coo-hook { background: rgba(255, 255, 255, 0.18) !important; color: rgb(255, 228, 230) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-winback .coo-btn { box-shadow: rgba(225, 29, 72, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(190, 18, 60) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-wb-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 35% 55%, rgba(251, 191, 36, 0.12) 0%, transparent 48%), radial-gradient(circle at 78% 28%, rgba(255, 255, 255, 0.08) 0%, transparent 42%); }

.coo-wb-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-wb-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.3) 0%, rgba(76, 5, 25, 0.5) 100%); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-wb-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 4; }

.coo-wb-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-wb-head-tag { font-size: 3px; font-weight: 800; color: rgb(254, 205, 211); padding: 1px 4px; border-radius: 99px; background: rgba(225, 29, 72, 0.35); border: 1px solid rgba(251, 113, 133, 0.35); }

.coo-wb-toast { position: absolute; top: -100%; left: 4px; right: 4px; z-index: 7; display: flex; align-items: center; gap: 4px; padding: 3px 5px; border-radius: 8px; background: rgba(255, 255, 255, 0.96); border: 1px solid rgba(225, 29, 72, 0.25); box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 14px; animation: coo-wb-toast-in var(--wb-dur, 8s) cubic-bezier(0.22, 1, 0.36, 1) infinite; }

@keyframes coo-wb-toast-in { 
  0%, 10% { top: -100%; opacity: 0; }
  18%, 55% { top: 16px; opacity: 1; }
  65%, 100% { top: 16px; opacity: 0.92; }
}

.coo-wb-toast-heart { font-size: 8px; line-height: 1; color: rgb(225, 29, 72); animation: coo-wb-heart-beat var(--wb-dur, 8s) ease-in-out infinite; }

@keyframes coo-wb-heart-beat { 
  0%, 20% { transform: scale(1); }
  28%, 36% { transform: scale(1.2); }
  44%, 100% { transform: scale(1); }
}

.coo-wb-toast-text { font-size: 4px; font-weight: 800; color: rgb(136, 19, 55); flex: 1 1 0%; min-width: 0px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-wb-list { position: absolute; inset: 14px 4px 20px; z-index: 3; display: flex; flex-direction: column; gap: 2px; }

.coo-wb-row { display: grid; grid-template-columns: 12px 1fr auto; align-items: center; gap: 3px; padding: 2px 4px; border-radius: 5px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08); opacity: 0.55; }

.coo-wb-av { width: 10px; height: 10px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 4px; font-weight: 800; color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.2); }

.coo-wb-row-lost .coo-wb-av { opacity: 0.5; }

.coo-wb-row-body { min-width: 0px; }

.coo-wb-row-name { font-size: 4px; font-weight: 800; color: rgba(255, 255, 255, 0.9); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-wb-row-meta { font-size: 3px; font-weight: 600; color: rgba(255, 255, 255, 0.4); }

.coo-wb-row-badge { font-size: 3px; font-weight: 800; padding: 1px 3px; border-radius: 99px; background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.45); }

.coo-wb-row-return { animation: coo-wb-row-win var(--wb-dur, 8s) ease-out infinite; z-index: 4; }

@keyframes coo-wb-row-win { 
  0%, 22% { opacity: 0.5; border-color: rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.06); transform: scale(1); }
  32%, 58% { opacity: 1; border-color: rgba(34, 197, 94, 0.6); background: rgba(34, 197, 94, 0.18); transform: scale(1.02); box-shadow: rgba(34, 197, 94, 0.25) 0px 0px 10px; }
  68%, 100% { opacity: 0.85; }
}

.coo-wb-row-return .coo-wb-av { background: linear-gradient(135deg, rgb(34, 197, 94), rgb(22, 163, 74)); opacity: 1; animation: coo-wb-av-pop var(--wb-dur, 8s) ease-out infinite; }

@keyframes coo-wb-av-pop { 
  0%, 28% { transform: scale(1); }
  36%, 48% { transform: scale(1.15); }
  55%, 100% { transform: scale(1); }
}

.coo-wb-row-return .coo-wb-row-badge { background: rgba(34, 197, 94, 0.3); color: rgb(187, 247, 208); animation: coo-wb-badge-flip var(--wb-dur, 8s) step-end infinite; }

@keyframes coo-wb-badge-flip { 
  0%, 30% { content: ""; }
  35%, 100% { background: rgba(34, 197, 94, 0.35); color: rgb(236, 253, 245); }
}

.coo-wb-sale-pop { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 4px; font-weight: 800; color: rgb(74, 222, 128); opacity: 0; white-space: nowrap; animation: coo-wb-sale-in var(--wb-dur, 8s) ease-out infinite; }

@keyframes coo-wb-sale-in { 
  0%, 38% { opacity: 0; transform: translateY(-50%) translateX(4px); }
  46%, 62% { opacity: 1; transform: translateY(-50%) translateX(0px); }
  72%, 100% { opacity: 0.7; }
}

.coo-wb-spark { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: rgb(253, 230, 138); pointer-events: none; z-index: 6; animation: coo-wb-spark-fly var(--wb-dur, 8s) ease-out infinite; }

.coo-wb-spark:nth-child(1) { top: 42%; left: 38%; animation-delay: 0.1s; }

.coo-wb-spark:nth-child(2) { top: 38%; right: 28%; animation-delay: 0.25s; }

@keyframes coo-wb-spark-fly { 
  0%, 32% { opacity: 0; transform: scale(0); }
  40%, 55% { opacity: 1; transform: scale(1.4); }
  65%, 100% { opacity: 0; transform: scale(0.5); }
}

.coo-wb-footer { position: absolute; bottom: 2px; left: 4px; right: 4px; display: flex; align-items: center; justify-content: space-between; padding: 2px 5px; border-radius: 5px; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(251, 113, 133, 0.2); z-index: 4; }

.coo-wb-stat { display: flex; align-items: baseline; gap: 2px; }

.coo-wb-stat-val { font-size: 7px; font-weight: 800; letter-spacing: -0.03em; }

.coo-wb-stat-lost .coo-wb-stat-val { color: rgba(255, 255, 255, 0.55); }

.coo-wb-stat-won .coo-wb-stat-val { color: rgb(74, 222, 128); animation: coo-wb-won-pop var(--wb-dur, 8s) ease-out infinite; }

@keyframes coo-wb-won-pop { 
  0%, 42% { transform: scale(1); }
  50%, 58% { transform: scale(1.15); }
  65%, 100% { transform: scale(1); }
}

.coo-wb-stat-sub { font-size: 3px; font-weight: 700; color: rgba(255, 255, 255, 0.4); text-transform: uppercase; letter-spacing: 0.04em; }

.coo-wb-divider { width: 1px; height: 10px; background: rgba(255, 255, 255, 0.15); }

.coo-wb-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-wb-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-wb-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-wb-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

