.visual-live { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-live .coo-live-glow { position: absolute; inset: -30%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 20% 50%, rgba(37, 99, 235, 0.25) 0%, transparent 55%); animation: 4s ease-in-out 0s infinite normal none running coo-live-glow; }

