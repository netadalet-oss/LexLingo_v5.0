.visual-garagelink { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-garagelink[class*="theme-"] { background: linear-gradient(155deg, rgb(6, 78, 59) 0%, rgb(4, 120, 87) 40%, rgb(15, 118, 110) 70%, rgb(19, 78, 74) 100%) !important; color: rgb(236, 253, 245) !important; border: 1px solid rgba(52, 211, 153, 0.22) !important; }

.visual-garagelink .coo-bg-orb { display: none !important; }

.visual-garagelink .coo-hook { background: rgba(255, 255, 255, 0.14) !important; color: rgb(167, 243, 208) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-garagelink .coo-btn { box-shadow: rgba(16, 185, 129, 0.3) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(4, 120, 87) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-gl-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 40% 50%, rgba(245, 158, 11, 0.1) 0%, transparent 45%), radial-gradient(circle at 70% 40%, rgba(52, 211, 153, 0.12) 0%, transparent 42%); }

.coo-gl-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-gl-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.3) 0%, rgba(4, 120, 87, 0.35) 100%); border: 1px solid rgba(52, 211, 153, 0.25); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px; }

.coo-gl-split { position: absolute; inset: 4px 4px 14px; display: flex; align-items: stretch; gap: 2px; z-index: 2; }

.coo-gl-side { flex: 1 1 0%; border-radius: 5px; padding: 3px 4px; position: relative; overflow: hidden; }

.coo-gl-pos { background: linear-gradient(rgba(245, 158, 11, 0.25), rgba(0, 0, 0, 0.2)); border: 1px solid rgba(245, 158, 11, 0.35); }

.coo-gl-wh { background: linear-gradient(rgba(59, 130, 246, 0.2), rgba(0, 0, 0, 0.2)); border: 1px solid rgba(96, 165, 250, 0.3); }

.coo-gl-side-label { font-size: 3px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: rgba(255, 255, 255, 0.5); margin-bottom: 2px; }

.coo-gl-pos-amt { font-size: 7px; font-weight: 900; color: rgb(251, 191, 36); letter-spacing: -0.03em; opacity: 0; animation: coo-gl-pos-sale var(--gl-dur, 8s) ease-out infinite; }

@keyframes coo-gl-pos-sale { 
  0%, 18% { opacity: 0; transform: scale(0.9); }
  26%, 55% { opacity: 1; transform: scale(1); }
  65%, 100% { opacity: 0.85; }
}

.coo-gl-pos-line { height: 2px; background: rgba(255, 255, 255, 0.15); border-radius: 1px; margin-top: 2px; width: 80%; }

.coo-gl-part-code { font-size: 4px; font-weight: 800; color: rgb(147, 197, 253); margin-top: 3px; }

.coo-gl-stock { display: flex; align-items: baseline; gap: 2px; margin-top: 2px; }

.coo-gl-stock-val { font-size: 8px; font-weight: 900; color: rgb(255, 255, 255); font-variant-numeric: tabular-nums; animation: coo-gl-stock-drop var(--gl-dur, 8s) ease-out infinite; }

@keyframes coo-gl-stock-drop { 
  0%, 32% { content: "12"; }
  40%, 78% { color: rgb(248, 113, 113); transform: scale(1.05); }
  82%, 100% { color: rgb(255, 255, 255); transform: scale(1); }
}

.coo-gl-stock-arrow { font-size: 5px; font-weight: 900; color: rgb(248, 113, 113); opacity: 0; animation: coo-gl-arrow-in var(--gl-dur, 8s) ease-out infinite; }

@keyframes coo-gl-arrow-in { 
  0%, 36% { opacity: 0; }
  44%, 78% { opacity: 1; }
  88%, 100% { opacity: 0.7; }
}

.coo-gl-bridge { width: 14px; flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center; }

.coo-gl-bridge-line { position: absolute; top: 20%; bottom: 20%; width: 2px; background: rgba(52, 211, 153, 0.2); border-radius: 1px; }

.coo-gl-packet { position: absolute; left: 50%; width: 6px; height: 6px; margin-left: -3px; border-radius: 2px; background: rgb(52, 211, 153); box-shadow: rgb(52, 211, 153) 0px 0px 6px; opacity: 0; animation: coo-gl-packet-flow var(--gl-dur, 8s) ease-in-out infinite; }

@keyframes coo-gl-packet-flow { 
  0%, 22% { opacity: 0; top: 30%; transform: scale(0.6); }
  30%, 35% { opacity: 1; top: 30%; }
  48%, 52% { opacity: 1; top: 70%; }
  60%, 100% { opacity: 0; top: 70%; }
}

.coo-gl-packet-back { animation-name: coo-gl-packet-back; background: rgb(96, 165, 250); box-shadow: rgb(96, 165, 250) 0px 0px 6px; }

@keyframes coo-gl-packet-back { 
  0%, 58% { opacity: 0; top: 70%; }
  66%, 70% { opacity: 0.6; top: 70%; }
  78%, 82% { opacity: 0.6; top: 30%; }
  90%, 100% { opacity: 0; top: 30%; }
}

.coo-gl-live { position: absolute; top: 3px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 2px; z-index: 5; font-size: 3px; font-weight: 800; color: rgb(110, 231, 183); padding: 1px 4px; border-radius: 99px; background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.35); }

.coo-gl-live-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: 1.2s ease-in-out 0s infinite normal none running coo-gl-live-blink; }

@keyframes coo-gl-live-blink { 
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.coo-gl-toast { position: absolute; bottom: 2px; left: 50%; transform: translateX(-50%); padding: 2px 5px; border-radius: 99px; z-index: 6; background: rgba(255, 255, 255, 0.95); color: rgb(4, 120, 87); font-size: 3px; font-weight: 800; white-space: nowrap; opacity: 0; animation: coo-gl-toast-in var(--gl-dur, 8s) ease-out infinite; }

@keyframes coo-gl-toast-in { 
  0%, 48% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  56%, 80% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  90%, 100% { opacity: 0.9; }
}

