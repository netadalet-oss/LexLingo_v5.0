.visual-launch.layout-banner-wide .coo-desc, .visual-contrast.layout-banner-wide .coo-contrast-wide-copy .coo-desc, .visual-live.layout-banner-wide .coo-desc, .visual-insight.layout-banner-wide .coo-insight-wide-copy .coo-desc, .layout-banner-wide [class$="-desc"], .layout-banner-wide .coo-hot-desc { font-size: 10px !important; line-height: 1.2 !important; opacity: 0.88 !important; margin: 1px 0px 0px !important; -webkit-line-clamp: 1 !important; display: -webkit-box !important; -webkit-box-orient: vertical !important; overflow: hidden !important; }

