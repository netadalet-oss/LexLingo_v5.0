.visual-doc { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-doc[class*="theme-"] { background: linear-gradient(155deg, rgb(15, 23, 42) 0%, rgb(30, 58, 138) 45%, rgb(30, 64, 175) 100%) !important; color: rgb(239, 246, 255) !important; border: 1px solid rgba(96, 165, 250, 0.22) !important; }

.visual-doc .coo-bg-orb { display: none !important; }

.visual-doc .coo-hook { background: rgba(59, 130, 246, 0.2) !important; color: rgb(191, 219, 254) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-doc .coo-btn { box-shadow: rgba(59, 130, 246, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(30, 64, 175) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-doc-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 45% 55%, rgba(59, 130, 246, 0.14) 0%, transparent 50%), radial-gradient(circle at 82% 28%, rgba(34, 197, 94, 0.08) 0%, transparent 42%); }

.coo-doc-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-doc-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.3) 0%, rgba(30, 58, 138, 0.45) 100%); border: 1px solid rgba(96, 165, 250, 0.25); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-doc-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 4; }

.coo-doc-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.04em; color: rgba(255, 255, 255, 0.5); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 55%; }

.coo-doc-head-amt { font-size: 5px; font-weight: 800; color: rgb(147, 197, 253); }

.coo-doc-paper { position: absolute; inset: 14px 5px 20px; z-index: 2; background: rgb(255, 255, 255); border-radius: 5px; padding: 4px 5px; color: rgb(30, 41, 59); box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px; }

.coo-doc-paper-title { font-size: 4px; font-weight: 800; color: rgb(30, 64, 175); margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-doc-paper-client { font-size: 3px; font-weight: 600; color: rgb(100, 116, 139); margin-bottom: 3px; }

.coo-doc-line { height: 2px; background: rgba(30, 41, 59, 0.1); border-radius: 1px; margin-bottom: 2px; }

.coo-doc-paper > .coo-doc-line:nth-child(3) { width: 85%; }

.coo-doc-paper > .coo-doc-line:nth-child(4) { width: 70%; }

.coo-doc-sig-block { margin-top: 3px; padding-top: 2px; border-top: 1px dashed rgba(30, 41, 59, 0.15); position: relative; height: 12px; }

.coo-doc-sig-label { font-size: 3px; font-weight: 700; color: rgb(148, 163, 184); text-transform: uppercase; letter-spacing: 0.04em; }

.coo-doc-sig-path { position: absolute; bottom: 1px; left: 0px; height: 8px; width: 0px; border-bottom: 2px solid rgb(37, 99, 235); animation: coo-doc-sign-draw var(--dc-dur, 7s) ease-out infinite; }

@keyframes coo-doc-sign-draw { 
  0%, 20% { width: 0px; opacity: 0.4; }
  35%, 55% { width: 72%; opacity: 1; }
  65%, 100% { width: 72%; opacity: 1; }
}

.coo-doc-sig-name { position: absolute; bottom: 0px; right: 0px; font-size: 3px; font-weight: 700; color: rgb(100, 116, 139); opacity: 0; animation: coo-doc-sig-name-in var(--dc-dur, 7s) ease-out infinite; }

@keyframes coo-doc-sig-name-in { 
  0%, 48% { opacity: 0; }
  55%, 100% { opacity: 1; color: rgb(30, 64, 175); }
}

.coo-doc-stamp { position: absolute; top: 50%; right: 6px; transform: translateY(-50%) rotate(-12deg); padding: 2px 4px; border-radius: 3px; border: 2px solid rgb(34, 197, 94); color: rgb(22, 163, 74); font-size: 4px; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0; z-index: 5; animation: coo-doc-stamp-in var(--dc-dur, 7s) cubic-bezier(0.22, 1, 0.36, 1) infinite; }

@keyframes coo-doc-stamp-in { 
  0%, 52% { opacity: 0; transform: translateY(-50%) rotate(-12deg) scale(1.4); }
  58%, 78% { opacity: 1; transform: translateY(-50%) rotate(-12deg) scale(1); }
  88%, 100% { opacity: 0.85; }
}

.coo-doc-steps { position: absolute; bottom: 22px; left: 5px; right: 5px; display: flex; gap: 2px; z-index: 3; }

.coo-doc-step { flex: 1 1 0%; text-align: center; padding: 1px 0px; border-radius: 3px; font-size: 3px; font-weight: 800; letter-spacing: 0.02em; background: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.35); animation: coo-doc-step-on var(--dc-dur, 7s) step-end infinite; }

.coo-doc-step:nth-child(1) { animation-delay: 0s; }

.coo-doc-step:nth-child(2) { animation-delay: 0s; }

.coo-doc-step:nth-child(3) { animation-name: coo-doc-step-final; }

@keyframes coo-doc-step-on { 
  0%, 25% { background: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.35); }
  30%, 100% { background: rgba(59, 130, 246, 0.25); color: rgb(191, 219, 254); }
}

@keyframes coo-doc-step-final { 
  0%, 50% { background: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.35); }
  55%, 100% { background: rgba(34, 197, 94, 0.3); color: rgb(187, 247, 208); }
}

.coo-doc-footer { position: absolute; bottom: 2px; left: 4px; right: 4px; display: flex; align-items: center; justify-content: space-between; padding: 2px 5px; border-radius: 5px; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(96, 165, 250, 0.2); z-index: 4; }

.coo-doc-time-val { font-size: 8px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.03em; animation: coo-doc-time-flash var(--dc-dur, 7s) ease-out infinite; }

@keyframes coo-doc-time-flash { 
  0%, 54% { color: rgb(255, 255, 255); }
  58%, 72% { color: rgb(74, 222, 128); text-shadow: rgba(74, 222, 128, 0.4) 0px 0px 8px; }
  78%, 100% { color: rgb(255, 255, 255); }
}

.coo-doc-time-sub { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.05em; }

.coo-doc-status { font-size: 4px; font-weight: 800; color: rgb(134, 239, 172); opacity: 0; animation: coo-doc-status-in var(--dc-dur, 7s) ease-out infinite; }

@keyframes coo-doc-status-in { 
  0%, 56% { opacity: 0; }
  62%, 100% { opacity: 1; }
}

.coo-doc-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-doc-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-doc-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-doc-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-doc-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-doc.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-doc.layout-banner-wide .coo-doc-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-doc.layout-banner-wide .coo-doc-panel { width: 96px; height: 72px; border-radius: 8px; }

.visual-doc.layout-banner-wide .coo-doc-steps { display: none; }

.visual-doc.layout-banner-wide .coo-doc-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-doc.layout-banner-wide .coo-doc-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-doc.layout-banner-wide .coo-doc-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-doc.layout-banner-wide .coo-doc-btn { padding: 6px 12px; font-size: 10px; }

.visual-doc.layout-banner-wide .coo-doc-btn .coo-arrow { display: none; }

.visual-doc.layout-banner-wide .coo-brand { display: none; }

.visual-doc.layout-square, .visual-doc.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-doc.layout-square .coo-doc-square, .visual-doc.layout-desktop-square .coo-doc-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-doc.layout-square .coo-doc-square-top, .visual-doc.layout-desktop-square .coo-doc-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-doc.layout-square .coo-doc-panel, .visual-doc.layout-desktop-square .coo-doc-panel { width: 140px; height: 118px; border-radius: 12px; }

.visual-doc.layout-square .coo-doc-time-val, .visual-doc.layout-desktop-square .coo-doc-time-val { font-size: 10px; }

.visual-doc.layout-square .coo-doc-copy .coo-hook, .visual-doc.layout-desktop-square .coo-doc-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-doc.layout-square .coo-doc-title, .visual-doc.layout-desktop-square .coo-doc-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-doc.layout-square .coo-doc-desc, .visual-doc.layout-desktop-square .coo-doc-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-doc.layout-square .coo-doc-btn, .visual-doc.layout-desktop-square .coo-doc-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-doc.layout-square .coo-brand, .visual-doc.layout-desktop-square .coo-brand { display: none; }

.visual-doc.layout-compact, .visual-doc.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-doc.layout-compact .coo-doc-compact, .visual-doc.layout-mobile .coo-doc-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-doc.layout-compact .coo-doc-compact-top, .visual-doc.layout-mobile .coo-doc-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-doc.layout-compact .coo-doc-panel, .visual-doc.layout-mobile .coo-doc-panel { width: 72px; height: 62px; border-radius: 8px; }

.visual-doc.layout-compact .coo-doc-steps, .visual-doc.layout-mobile .coo-doc-steps { display: none; }

.visual-doc.layout-compact .coo-doc-stamp, .visual-doc.layout-mobile .coo-doc-stamp { font-size: 3px; right: 4px; }

.visual-doc.layout-compact .coo-doc-copy .coo-hook, .visual-doc.layout-mobile .coo-doc-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-doc.layout-compact .coo-doc-title, .visual-doc.layout-mobile .coo-doc-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-doc.layout-compact .coo-doc-desc, .visual-doc.layout-mobile .coo-doc-desc { display: none; }

.visual-doc.layout-compact .coo-doc-compact-foot, .visual-doc.layout-mobile .coo-doc-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-doc.layout-compact .coo-doc-btn, .visual-doc.layout-mobile .coo-doc-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-doc.layout-compact .coo-doc-btn .coo-arrow, .visual-doc.layout-mobile .coo-doc-btn .coo-arrow { display: none; }

.visual-doc.layout-compact .coo-brand, .visual-doc.layout-mobile .coo-brand { display: none; }

.visual-roster { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-roster[class*="theme-"] { background: linear-gradient(155deg, rgb(15, 23, 42) 0%, rgb(30, 58, 138) 45%, rgb(30, 64, 175) 100%) !important; color: rgb(239, 246, 255) !important; border: 1px solid rgba(96, 165, 250, 0.22) !important; }

.visual-roster .coo-bg-orb { display: none !important; }

.visual-roster .coo-hook { background: rgba(59, 130, 246, 0.2) !important; color: rgb(191, 219, 254) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-roster .coo-btn { box-shadow: rgba(59, 130, 246, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(30, 64, 175) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-roster-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 40% 60%, rgba(99, 102, 241, 0.12) 0%, transparent 48%), radial-gradient(circle at 80% 25%, rgba(20, 184, 166, 0.1) 0%, transparent 42%); }

.coo-roster-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-roster-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.3) 0%, rgba(30, 58, 138, 0.45) 100%); border: 1px solid rgba(96, 165, 250, 0.25); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-roster-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 4; }

.coo-roster-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-roster-head-live { display: inline-flex; align-items: center; gap: 2px; font-size: 3px; font-weight: 800; color: rgb(110, 231, 183); }

.coo-roster-head-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: 1.4s ease-in-out 0s infinite normal none running coo-roster-dot-blink; }

@keyframes coo-roster-dot-blink { 
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.coo-roster-list { position: absolute; inset: 14px 4px 20px; z-index: 2; display: flex; flex-direction: column; gap: 2px; }

.coo-roster-row { display: grid; grid-template-columns: 12px 1fr auto; align-items: center; gap: 3px; padding: 2px 4px; border-radius: 5px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08); opacity: 0; transform: translateX(-4px); animation: coo-roster-row-in var(--rs-dur, 8s) ease-out infinite; }

.coo-roster-row:nth-child(1) { animation-delay: 0.1s; }

.coo-roster-row:nth-child(2) { animation-delay: 0.25s; }

.coo-roster-row:nth-child(3) { animation-delay: 0.4s; }

.coo-roster-row:nth-child(4) { animation-delay: 0.55s; }

@keyframes coo-roster-row-in { 
  0%, 8% { opacity: 0; transform: translateX(-6px); }
  14%, 75% { opacity: 1; transform: translateX(0px); }
  88%, 100% { opacity: 0.85; }
}

.coo-roster-row-active { animation-name: coo-roster-row-active; }

@keyframes coo-roster-row-active { 
  0%, 20% { border-color: rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.06); }
  28%, 55% { border-color: rgba(34, 197, 94, 0.5); background: rgba(34, 197, 94, 0.12); box-shadow: rgba(34, 197, 94, 0.2) 0px 0px 0px 1px inset; }
  65%, 100% { opacity: 1; }
}

.coo-roster-av { width: 10px; height: 10px; border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 4px; font-weight: 800; color: rgb(255, 255, 255); position: relative; }

.coo-roster-av-dot { position: absolute; bottom: -1px; right: -1px; width: 3px; height: 3px; border-radius: 50%; border: 1px solid rgba(15, 23, 42, 0.8); }

.coo-roster-av-dot-online { background: rgb(34, 197, 94); }

.coo-roster-av-dot-away { background: rgb(148, 163, 184); }

