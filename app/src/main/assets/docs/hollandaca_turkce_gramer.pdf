@charset "utf-8";

.visual-contrast { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.coo-contrast-bg-split { position: absolute; inset: 0px; z-index: 0; pointer-events: none; background: linear-gradient(105deg, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0.22) 48%, rgba(255, 255, 255, 0.08) 52%, rgba(255, 255, 255, 0.04) 100%); }

.coo-contrast-side { min-width: 0px; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: 2px; }

.coo-contrast-problem { background: rgba(0, 0, 0, 0.42); color: rgba(255, 255, 255, 0.88); }

.coo-contrast-solution { background: rgba(255, 255, 255, 0.16); color: rgb(255, 255, 255); animation: 2.8s ease-in-out 0s infinite normal none running coo-contrast-solution-glow; }

@keyframes coo-contrast-solution-glow { 
  0%, 100% { background: rgba(255, 255, 255, 0.14); box-shadow: rgba(255, 255, 255, 0) 0px 0px 0px 0px inset; }
  50% { background: rgba(255, 255, 255, 0.24); box-shadow: rgba(255, 255, 255, 0.12) 0px 0px 24px inset; }
}

.theme-clean-slate .coo-contrast-problem { background: rgb(55, 65, 81); color: rgb(249, 250, 251); }

.coo-contrast-label { font-size: 7px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.55; line-height: 1; }

.coo-contrast-text { font-weight: 600; line-height: 1.2; margin: 0px; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.coo-contrast-arrow-wrap { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

.coo-contrast-arrow { display: flex; align-items: center; justify-content: center; font-weight: 800; opacity: 0.85; line-height: 1; animation: 1.6s ease-in-out 0s infinite normal none running coo-contrast-arrow-flow; }

@keyframes coo-contrast-arrow-flow { 
  0%, 100% { transform: translateX(0px); opacity: 0.65; }
  50% { transform: translateX(4px); opacity: 1; }
}

.coo-contrast-beam { position: absolute; top: 0px; bottom: 0px; width: 40%; z-index: 1; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent); animation: 3.2s ease-in-out 0s infinite normal none running coo-contrast-beam; }

@keyframes coo-contrast-beam { 
  0% { left: -40%; opacity: 0; }
  20% { opacity: 0.7; }
  100% { left: 110%; opacity: 0; }
}

.coo-contrast-btn { position: relative; overflow: hidden; z-index: 2; }

.visual-contrast .coo-contrast-hook, .visual-contrast .coo-hook { animation: auto ease 0s 1 normal none running none; }

.visual-contrast.layout-banner-wide { display: flex; align-items: center; padding: 0px 12px; height: 100%; }

.visual-contrast.layout-banner-wide .coo-contrast-wide { display: grid; grid-template-columns: minmax(0px, 1.15fr) minmax(0px, 0.82fr) auto; grid-template-rows: 100%; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; z-index: 2; }

.visual-contrast.layout-banner-wide .coo-contrast-wide-copy { grid-column: 1; min-width: 0px; display: flex; flex-direction: column; justify-content: center; gap: 1px; overflow: hidden; }

.visual-contrast.layout-banner-wide .coo-contrast-wide-copy .coo-title { font-size: 14px; line-height: 1.15; margin: 0px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

.visual-contrast.layout-banner-wide .coo-contrast-wide-copy .coo-desc { font-size: 10px; line-height: 1.2; opacity: 0.85; margin: 0px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; }

.visual-contrast.layout-banner-wide .coo-contrast-wide-panels { grid-column: 2; min-width: 0px; display: grid; grid-template-columns: minmax(0px, 1fr) 18px minmax(0px, 1fr); align-items: center; column-gap: 4px; }

.visual-contrast.layout-banner-wide .coo-contrast-wide-panels .coo-contrast-side { padding: 4px 6px; border-radius: 8px; min-width: 0px; }

.visual-contrast.layout-banner-wide .coo-contrast-wide-panels .coo-contrast-arrow-wrap { display: flex; align-items: center; justify-content: center; }

.visual-contrast.layout-banner-wide .coo-contrast-label { display: none; }

.visual-contrast.layout-banner-wide .coo-contrast-text { -webkit-line-clamp: 2; font-size: 9px; line-height: 1.2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-contrast.layout-banner-wide .coo-contrast-arrow { font-size: 12px; }

.visual-contrast.layout-banner-wide .coo-contrast-wide-cta { grid-column: 3; display: flex; align-items: center; flex-shrink: 0; }

.visual-contrast.layout-banner-wide .coo-contrast-btn { padding: 6px 11px; font-size: 11px; white-space: nowrap; max-width: 120px; }

.visual-contrast.layout-banner-wide .coo-contrast-btn span { overflow: hidden; text-overflow: ellipsis; }

.visual-contrast.layout-banner-wide .coo-brand { display: none; }

.visual-contrast.layout-square, .visual-contrast.layout-desktop-square { flex-direction: column; padding: 14px 16px 12px; justify-content: flex-start; }

.visual-contrast.layout-square .coo-contrast-square, .visual-contrast.layout-desktop-square .coo-contrast-square { display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 0px; z-index: 2; gap: 0px; }

.visual-contrast.layout-square .coo-contrast-hook, .visual-contrast.layout-desktop-square .coo-contrast-hook { align-self: flex-start; font-size: 9px; padding: 3px 8px; margin-bottom: 10px; flex-shrink: 0; }

.visual-contrast.layout-square .coo-contrast-square-panel, .visual-contrast.layout-desktop-square .coo-contrast-square-panel { display: grid; grid-template-columns: 1fr 28px 1fr; align-items: stretch; flex-shrink: 0; height: 88px; border-radius: 14px; overflow: hidden; margin-bottom: 12px; position: relative; }

.visual-contrast.layout-square .coo-contrast-square-panel .coo-contrast-side, .visual-contrast.layout-desktop-square .coo-contrast-square-panel .coo-contrast-side { padding: 12px 10px; justify-content: center; }

.visual-contrast.layout-square .coo-contrast-square-panel .coo-contrast-label, .visual-contrast.layout-desktop-square .coo-contrast-square-panel .coo-contrast-label { font-size: 8px; margin-bottom: 4px; }

.visual-contrast.layout-square .coo-contrast-square-panel .coo-contrast-text, .visual-contrast.layout-desktop-square .coo-contrast-square-panel .coo-contrast-text { -webkit-line-clamp: 2; font-size: 13px; }

.visual-contrast.layout-square .coo-contrast-square-panel .coo-contrast-arrow-wrap, .visual-contrast.layout-desktop-square .coo-contrast-square-panel .coo-contrast-arrow-wrap { background: rgba(0, 0, 0, 0.2); z-index: 2; }

.visual-contrast.layout-square .coo-contrast-square-panel .coo-contrast-arrow, .visual-contrast.layout-desktop-square .coo-contrast-square-panel .coo-contrast-arrow { font-size: 18px; }

.visual-contrast.layout-square .coo-contrast-square-copy, .visual-contrast.layout-desktop-square .coo-contrast-square-copy { flex-shrink: 0; margin-bottom: 12px; }

