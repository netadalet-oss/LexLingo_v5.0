.visual-inbox.layout-square .coo-inbox-title, .visual-inbox.layout-desktop-square .coo-inbox-title { font-size: 17px; margin-bottom: 4px; }

.visual-inbox.layout-square .coo-inbox-desc, .visual-inbox.layout-desktop-square .coo-inbox-desc { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

