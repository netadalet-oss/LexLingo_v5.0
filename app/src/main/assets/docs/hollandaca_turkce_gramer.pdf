.visual-bridge.layout-square .coo-bridge-square, .visual-bridge.layout-desktop-square .coo-bridge-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-bridge.layout-square .coo-bridge-square-top, .visual-bridge.layout-desktop-square .coo-bridge-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-bridge.layout-square .coo-bridge-panel, .visual-bridge.layout-desktop-square .coo-bridge-panel { width: 130px; height: 118px; border-radius: 12px; }

.visual-bridge.layout-square .coo-bridge-count-val, .visual-bridge.layout-desktop-square .coo-bridge-count-val { font-size: 9px; }

