.visual-handshake { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-handshake[class*="theme-"] { background: linear-gradient(155deg, rgb(10, 22, 40) 0%, rgb(12, 25, 41) 42%, rgb(30, 58, 95) 72%, rgb(29, 78, 216) 100%) !important; color: rgb(240, 244, 248) !important; border: 1px solid rgba(96, 165, 250, 0.2) !important; }

.visual-handshake .coo-bg-orb { display: none !important; }

.visual-handshake .coo-hook { background: rgba(59, 130, 246, 0.22) !important; color: rgb(191, 219, 254) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-handshake .coo-btn { box-shadow: rgba(59, 130, 246, 0.3) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(12, 25, 41) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-hs-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 30% 55%, rgba(59, 130, 246, 0.12) 0%, transparent 48%), radial-gradient(circle at 80% 30%, rgba(16, 185, 129, 0.1) 0%, transparent 42%); }

.coo-hs-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-hs-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(255, 255, 255, 0.06) 0%, rgba(0, 0, 0, 0.32) 100%); border: 1px solid rgba(147, 197, 253, 0.2); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-hs-wizard { position: absolute; inset: 4px 4px 24px; z-index: 2; background: rgb(255, 255, 255); border-radius: 6px; padding: 4px 5px; color: rgb(15, 23, 42); box-shadow: rgba(0, 0, 0, 0.18) 0px 4px 14px; }

.coo-hs-wizard-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 3px; padding-bottom: 2px; border-bottom: 1px solid rgb(226, 232, 240); }

.coo-hs-wizard-title { font-size: 3px; font-weight: 800; color: rgb(100, 116, 139); text-transform: uppercase; letter-spacing: 0.06em; }

.coo-hs-ring-wrap { position: relative; width: 14px; height: 14px; flex-shrink: 0; }

.coo-hs-ring { width: 100%; height: 100%; transform: rotate(-90deg); }

.coo-hs-ring-bg { fill: none; stroke: rgb(226, 232, 240); stroke-width: 3; }

.coo-hs-ring-fill { fill: none; stroke: rgb(0, 128, 96); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 50; stroke-dashoffset: 50; animation: coo-hs-ring-fill var(--hs-dur, 8s) ease-in-out infinite; }

@keyframes coo-hs-ring-fill { 
  0%, 15% { stroke-dashoffset: 50; }
  45%, 75% { stroke-dashoffset: 8; }
  88%, 100% { stroke-dashoffset: 0; }
}

.coo-hs-ring-label { position: absolute; inset: 0px; display: flex; align-items: center; justify-content: center; font-size: 3px; font-weight: 800; color: rgb(0, 128, 96); }

.coo-hs-checklist { display: flex; flex-direction: column; gap: 2px; }

.coo-hs-check-item { display: flex; align-items: center; gap: 3px; font-size: 3px; font-weight: 700; color: rgb(148, 163, 184); }

.coo-hs-check-box { width: 7px; height: 7px; border-radius: 2px; flex-shrink: 0; border: 1px solid rgb(203, 213, 225); background: rgb(248, 250, 252); position: relative; }

.coo-hs-check-item:nth-child(1) .coo-hs-check-box { animation: coo-hs-check-1 var(--hs-dur, 8s) ease-out infinite; }

.coo-hs-check-item:nth-child(2) .coo-hs-check-box { animation: coo-hs-check-2 var(--hs-dur, 8s) ease-out infinite; }

.coo-hs-check-item:nth-child(3) .coo-hs-check-box { animation: coo-hs-check-3 var(--hs-dur, 8s) ease-out infinite; }

@keyframes coo-hs-check-1 { 
  0%, 12% { background: rgb(248, 250, 252); border-color: rgb(203, 213, 225); }
  18%, 88% { background: rgb(0, 128, 96); border-color: rgb(0, 128, 96); }
  18%, 88% { box-shadow: rgba(0, 128, 96, 0.2) 0px 0px 0px 1px; }
  92%, 100% { opacity: 0.9; }
}

@keyframes coo-hs-check-2 { 
  0%, 32% { background: rgb(248, 250, 252); border-color: rgb(203, 213, 225); }
  38%, 88% { background: rgb(0, 128, 96); border-color: rgb(0, 128, 96); }
  92%, 100% { opacity: 0.9; }
}

@keyframes coo-hs-check-3 { 
  0%, 52% { background: rgb(248, 250, 252); border-color: rgb(203, 213, 225); }
  58%, 88% { background: rgb(0, 128, 96); border-color: rgb(0, 128, 96); }
  92%, 100% { opacity: 0.9; }
}

.coo-hs-check-box::after { content: "âœ“"; position: absolute; inset: 0px; display: flex; align-items: center; justify-content: center; font-size: 4px; font-weight: 900; color: rgb(255, 255, 255); opacity: 0; }

.coo-hs-check-item:nth-child(1) .coo-hs-check-box::after { animation: coo-hs-tick-1 var(--hs-dur, 8s) ease-out infinite; }

.coo-hs-check-item:nth-child(2) .coo-hs-check-box::after { animation: coo-hs-tick-2 var(--hs-dur, 8s) ease-out infinite; }

.coo-hs-check-item:nth-child(3) .coo-hs-check-box::after { animation: coo-hs-tick-3 var(--hs-dur, 8s) ease-out infinite; }

@keyframes coo-hs-tick-1 { 
  0%, 16% { opacity: 0; }
  22%, 100% { opacity: 1; }
}

@keyframes coo-hs-tick-2 { 
  0%, 36% { opacity: 0; }
  42%, 100% { opacity: 1; }
}

@keyframes coo-hs-tick-3 { 
  0%, 56% { opacity: 0; }
  62%, 100% { opacity: 1; }
}

.coo-hs-check-item:nth-child(1) { animation: coo-hs-label-1 var(--hs-dur, 8s) ease-out infinite; }

.coo-hs-check-item:nth-child(2) { animation: coo-hs-label-2 var(--hs-dur, 8s) ease-out infinite; }

.coo-hs-check-item:nth-child(3) { animation: coo-hs-label-3 var(--hs-dur, 8s) ease-out infinite; }

@keyframes coo-hs-label-1 { 
  0%, 16% { color: rgb(148, 163, 184); }
  22%, 100% { color: rgb(15, 23, 42); }
}

@keyframes coo-hs-label-2 { 
  0%, 36% { color: rgb(148, 163, 184); }
  42%, 100% { color: rgb(15, 23, 42); }
}

@keyframes coo-hs-label-3 { 
  0%, 56% { color: rgb(148, 163, 184); }
  62%, 100% { color: rgb(15, 23, 42); }
}

.coo-hs-support { position: absolute; bottom: 2px; left: 3px; right: 3px; z-index: 4; display: flex; align-items: flex-end; gap: 3px; }

.coo-hs-avatar-wrap { position: relative; flex-shrink: 0; }

.coo-hs-avatar { width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg, rgb(37, 99, 235), rgb(29, 78, 216)); display: flex; align-items: center; justify-content: center; font-size: 4px; font-weight: 800; color: rgb(255, 255, 255); border: 1px solid rgba(255, 255, 255, 0.3); }

.coo-hs-online { position: absolute; bottom: 0px; right: 0px; width: 4px; height: 4px; border-radius: 50%; background: rgb(34, 197, 94); border: 1px solid rgb(12, 25, 41); animation: coo-hs-online-pulse var(--hs-dur, 8s) ease-in-out infinite; }

@keyframes coo-hs-online-pulse { 
  0%, 100% { box-shadow: rgba(34, 197, 94, 0.5) 0px 0px 0px 0px; }
  50% { box-shadow: rgba(34, 197, 94, 0) 0px 0px 0px 2px; }
}

.coo-hs-chat { flex: 1 1 0%; min-width: 0px; position: relative; }

.coo-hs-chat-bubble { background: rgb(37, 99, 235); color: rgb(255, 255, 255); border-radius: 6px 6px 6px 2px; padding: 2px 4px; font-size: 3px; font-weight: 700; line-height: 1.25; opacity: 0; transform: translateY(3px); animation: coo-hs-chat-in var(--hs-dur, 8s) ease-out infinite; }

@keyframes coo-hs-chat-in { 
  0%, 28% { opacity: 0; transform: translateY(3px); }
  35%, 82% { opacity: 1; transform: translateY(0px); }
  92%, 100% { opacity: 0.85; }
}

.coo-hs-chat-meta { font-size: 2px; font-weight: 700; color: rgba(255, 255, 255, 0.55); margin-bottom: 1px; }

.coo-hs-typing { display: inline-flex; gap: 1px; margin-right: 2px; vertical-align: middle; opacity: 0; animation: coo-hs-typing-show var(--hs-dur, 8s) ease-out infinite; }

@keyframes coo-hs-typing-show { 
  0%, 28% { opacity: 1; }
  34%, 100% { opacity: 0; }
}

.coo-hs-typing span { width: 2px; height: 2px; border-radius: 50%; background: rgba(255, 255, 255, 0.7); animation: 1s ease-in-out 0s infinite normal none running coo-hs-typing-dot; }

.coo-hs-typing span:nth-child(2) { animation-delay: 0.15s; }

.coo-hs-typing span:nth-child(3) { animation-delay: 0.3s; }

@keyframes coo-hs-typing-dot { 
  0%, 100% { opacity: 0.35; transform: translateY(0px); }
  50% { opacity: 1; transform: translateY(-1px); }
}

.coo-hs-badge { position: absolute; top: 4px; right: 4px; z-index: 5; text-align: center; padding: 2px 4px; border-radius: 5px; background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(147, 197, 253, 0.35); animation: coo-hs-badge-in var(--hs-dur, 8s) ease-out infinite; }

@keyframes coo-hs-badge-in { 
  0%, 8% { opacity: 0; transform: scale(0.9); }
  14%, 100% { opacity: 1; transform: scale(1); }
}

.coo-hs-badge-val { display: block; font-size: 5px; font-weight: 800; color: rgb(147, 197, 253); line-height: 1; }

.coo-hs-badge-sub { font-size: 2px; font-weight: 800; color: rgba(255, 255, 255, 0.5); text-transform: uppercase; letter-spacing: 0.05em; }

.coo-hs-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-hs-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

