.visual-sunset[class*="theme-"] { background: linear-gradient(160deg, rgb(255, 126, 95) 0%, rgb(254, 180, 123) 35%, rgb(134, 168, 231) 70%, rgb(127, 127, 213) 100%) !important; color: rgb(255, 255, 255) !important; border: 1px solid rgba(255, 255, 255, 0.15) !important; }

.visual-sunset[class*="theme-"] .coo-hook { background: rgba(255, 255, 255, 0.2) !important; color: rgb(255, 255, 255) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-sunset[class*="theme-"] .coo-btn { background: rgb(255, 255, 255) !important; color: rgb(127, 127, 213) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-radar[class*="theme-"], .visual-scan[class*="theme-"] { background: linear-gradient(145deg, rgb(12, 15, 20) 0%, rgb(21, 27, 36) 55%, rgb(15, 20, 25) 100%) !important; color: rgb(241, 245, 249) !important; border: 1px solid rgba(16, 185, 129, 0.15) !important; }

.visual-radar[class*="theme-"] .coo-hook, .visual-scan[class*="theme-"] .coo-hook { background: rgba(16, 185, 129, 0.2) !important; color: rgb(110, 231, 183) !important; animation: auto ease 0s 1 normal none running none !important; }

