.coo-clock-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-clock-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-clock-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-clock.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-clock.layout-banner-wide .coo-clock-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-clock.layout-banner-wide .coo-clock-panel { width: 96px; height: 72px; border-radius: 8px; }

.visual-clock.layout-banner-wide .coo-clock-face-wrap { width: 48%; top: 12px; }

.visual-clock.layout-banner-wide .coo-clock-digital { font-size: 6px; bottom: 24%; }

.visual-clock.layout-banner-wide .coo-clock-report-lbl { display: none; }

.visual-clock.layout-banner-wide .coo-clock-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-clock.layout-banner-wide .coo-clock-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-clock.layout-banner-wide .coo-clock-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-clock.layout-banner-wide .coo-clock-btn { padding: 6px 12px; font-size: 10px; }

.visual-clock.layout-banner-wide .coo-clock-btn .coo-arrow { display: none; }

.visual-clock.layout-banner-wide .coo-brand { display: none; }

.visual-clock.layout-square, .visual-clock.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-clock.layout-square .coo-clock-square, .visual-clock.layout-desktop-square .coo-clock-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-clock.layout-square .coo-clock-square-top, .visual-clock.layout-desktop-square .coo-clock-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-clock.layout-square .coo-clock-panel, .visual-clock.layout-desktop-square .coo-clock-panel { width: 130px; height: 118px; border-radius: 12px; }

.visual-clock.layout-square .coo-clock-face-wrap, .visual-clock.layout-desktop-square .coo-clock-face-wrap { width: 54%; top: 18px; }

.visual-clock.layout-square .coo-clock-digital, .visual-clock.layout-desktop-square .coo-clock-digital { font-size: 9px; }

.visual-clock.layout-square .coo-clock-copy .coo-hook, .visual-clock.layout-desktop-square .coo-clock-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-clock.layout-square .coo-clock-title, .visual-clock.layout-desktop-square .coo-clock-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-clock.layout-square .coo-clock-desc, .visual-clock.layout-desktop-square .coo-clock-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-clock.layout-square .coo-clock-btn, .visual-clock.layout-desktop-square .coo-clock-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-clock.layout-square .coo-brand, .visual-clock.layout-desktop-square .coo-brand { display: none; }

.visual-clock.layout-compact, .visual-clock.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

