.visual-sunset.layout-banner-wide .coo-sunset-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-sunset.layout-banner-wide .coo-sunset-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-sunset.layout-banner-wide .coo-sunset-btn { padding: 6px 12px; font-size: 10px; }

.visual-sunset.layout-banner-wide .coo-sunset-btn .coo-arrow { display: none; }

.visual-sunset.layout-banner-wide .coo-brand { display: none; }

