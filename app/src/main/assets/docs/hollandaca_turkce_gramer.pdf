.visual-clock.layout-compact .coo-brand, .visual-clock.layout-mobile .coo-brand { display: none; }

.visual-shelfpulse { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-shelfpulse[class*="theme-"] { background: linear-gradient(160deg, rgb(6, 78, 59) 0%, rgb(4, 120, 87) 45%, rgb(6, 95, 70) 100%) !important; color: rgb(236, 253, 245) !important; border: 1px solid rgba(16, 185, 129, 0.22) !important; }

.visual-shelfpulse .coo-bg-orb { display: none !important; }

.visual-shelfpulse .coo-hook { background: rgba(16, 185, 129, 0.22) !important; color: rgb(110, 231, 183) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-shelfpulse .coo-btn { box-shadow: rgba(16, 185, 129, 0.3) 0px 4px 18px; background: rgb(248, 250, 252) !important; color: rgb(6, 95, 70) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-shelf-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 40% 60%, rgba(52, 211, 153, 0.15) 0%, transparent 48%), radial-gradient(circle at 80% 30%, rgba(251, 191, 36, 0.08) 0%, transparent 42%); }

.coo-shelf-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-shelf-rack { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.25) 0%, rgba(6, 78, 59, 0.5) 100%); border: 1px solid rgba(16, 185, 129, 0.25); box-shadow: rgba(0, 0, 0, 0.35) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-shelf-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 4; }

.coo-shelf-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-shelf-live { display: inline-flex; align-items: center; gap: 2px; font-size: 4px; font-weight: 800; color: rgb(110, 231, 183); padding: 1px 4px; border-radius: 99px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.28); }

.coo-shelf-live-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: 1.4s ease-in-out 0s infinite normal none running coo-shelf-live-blink; }

@keyframes coo-shelf-live-blink { 
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

.coo-shelf-body { position: absolute; inset: 14px 5px 18px; display: flex; flex-direction: column; gap: 3px; z-index: 2; }

.coo-shelf-row { flex: 1 1 0%; position: relative; display: flex; align-items: flex-end; gap: 3px; padding-bottom: 3px; border-bottom: 2px solid rgba(255, 255, 255, 0.12); }

.coo-shelf-box { flex: 1 1 0%; min-width: 0px; height: 72%; border-radius: 2px; background: linear-gradient(rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06)); border: 1px solid rgba(255, 255, 255, 0.12); position: relative; overflow: hidden; }

.coo-shelf-box-pulse { animation: coo-shelf-box-scan var(--sh-dur, 8s) ease-out infinite; }

.coo-shelf-row:nth-child(1) .coo-shelf-box:nth-child(1) { animation-delay: 0.2s; }

.coo-shelf-row:nth-child(1) .coo-shelf-box:nth-child(2) { animation-delay: 0.5s; }

.coo-shelf-row:nth-child(1) .coo-shelf-box:nth-child(3) { animation-delay: 0.8s; }

.coo-shelf-row:nth-child(2) .coo-shelf-box:nth-child(1) { animation-delay: 1.1s; }

.coo-shelf-row:nth-child(2) .coo-shelf-box:nth-child(2) { animation-delay: 1.4s; }

.coo-shelf-row:nth-child(2) .coo-shelf-box:nth-child(3) { animation-delay: 1.7s; }

.coo-shelf-row:nth-child(3) .coo-shelf-box:nth-child(1) { animation-delay: 2s; }

.coo-shelf-row:nth-child(3) .coo-shelf-box:nth-child(2) { animation-delay: 2.3s; }

.coo-shelf-row:nth-child(3) .coo-shelf-box:nth-child(3) { animation-delay: 2.6s; }

@keyframes coo-shelf-box-scan { 
  0%, 8% { box-shadow: none; border-color: rgba(255, 255, 255, 0.12); background: linear-gradient(rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04)); }
  14%, 32% { box-shadow: rgba(52, 211, 153, 0.8) 0px 0px 10px, rgba(52, 211, 153, 0.3) 0px 0px 6px inset; border-color: rgb(52, 211, 153); background: linear-gradient(rgba(52, 211, 153, 0.35), rgba(16, 185, 129, 0.15)); }
  40%, 100% { box-shadow: none; opacity: 0.85; }
}

.coo-shelf-box-low.coo-shelf-box-pulse { animation-name: coo-shelf-box-low; }

@keyframes coo-shelf-box-low { 
  0%, 8% { border-color: rgba(255, 255, 255, 0.12); }
  14%, 32% { box-shadow: rgba(251, 191, 36, 0.7) 0px 0px 10px; border-color: rgb(251, 191, 36); background: linear-gradient(rgba(251, 191, 36, 0.3), rgba(245, 158, 11, 0.12)); }
  40%, 100% { opacity: 0.85; }
}

.coo-shelf-tag { position: absolute; bottom: 1px; left: 1px; right: 1px; font-size: 3px; font-weight: 700; color: rgba(255, 255, 255, 0.5); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0; animation: coo-shelf-tag-in var(--sh-dur, 8s) ease-out infinite; }

.coo-shelf-row:nth-child(1) .coo-shelf-box:nth-child(1) .coo-shelf-tag { animation-delay: 0.25s; }

.coo-shelf-row:nth-child(1) .coo-shelf-box:nth-child(2) .coo-shelf-tag { animation-delay: 0.55s; }

.coo-shelf-row:nth-child(2) .coo-shelf-box:nth-child(2) .coo-shelf-tag { animation-delay: 1.45s; }

@keyframes coo-shelf-tag-in { 
  0%, 12% { opacity: 0; transform: translateY(2px); }
  18%, 35% { opacity: 1; transform: translateY(0px); color: rgb(236, 253, 245); }
  42%, 100% { opacity: 0.4; }
}

.coo-shelf-scanner { position: absolute; top: 14px; bottom: 18px; left: -4px; width: 3px; background: linear-gradient(transparent, rgba(52, 211, 153, 0.9), transparent); box-shadow: rgba(52, 211, 153, 0.6) 0px 0px 8px; z-index: 5; opacity: 0; animation: coo-shelf-scanner-sweep var(--sh-dur, 8s) ease-in-out infinite; }

@keyframes coo-shelf-scanner-sweep { 
  0%, 5% { left: -4px; opacity: 0; }
  10%, 75% { opacity: 1; }
  80%, 100% { left: calc(100% + 2px); opacity: 0; }
}

.coo-shelf-counter { position: absolute; bottom: 3px; left: 4px; right: 4px; display: flex; align-items: center; justify-content: space-between; padding: 2px 5px; border-radius: 5px; background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(16, 185, 129, 0.2); z-index: 4; }

.coo-shelf-count-val { font-size: 8px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.03em; }

.coo-shelf-count-sub { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.05em; }

.coo-shelf-sync-icon { font-size: 6px; line-height: 1; color: rgb(110, 231, 183); animation: coo-shelf-sync-spin var(--sh-dur, 8s) ease-in-out infinite; }

@keyframes coo-shelf-sync-spin { 
  0%, 30% { transform: rotate(0deg); opacity: 0.5; }
  45%, 65% { transform: rotate(180deg); opacity: 1; }
  80%, 100% { transform: rotate(360deg); opacity: 0.5; }
}

