.visual-radar { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-radar[class*="theme-"] { background: linear-gradient(155deg, rgb(12, 25, 41) 0%, rgb(30, 58, 95) 48%, rgb(15, 39, 68) 100%) !important; color: rgb(240, 244, 248) !important; border: 1px solid rgba(56, 189, 248, 0.15) !important; }

.visual-radar .coo-bg-orb { display: none !important; }

.visual-radar .coo-hook { background: rgba(16, 185, 129, 0.2) !important; color: rgb(110, 231, 183) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-radar .coo-btn { box-shadow: rgba(16, 185, 129, 0.35) 0px 4px 18px; background: rgb(16, 185, 129) !important; color: rgb(4, 47, 26) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-radar-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 30% 60%, rgba(16, 185, 129, 0.12) 0%, transparent 48%), radial-gradient(circle at 75% 25%, rgba(56, 189, 248, 0.1) 0%, transparent 42%); }

.coo-radar-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-radar-console { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.45) 0%, rgba(15, 39, 68, 0.85) 100%); border: 1px solid rgba(56, 189, 248, 0.2); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-radar-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); z-index: 4; position: relative; }

.coo-radar-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }

.coo-radar-live { display: inline-flex; align-items: center; gap: 2px; font-size: 4px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: rgb(110, 231, 183); padding: 1px 4px; border-radius: 99px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.28); }

.coo-radar-live-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: 1.3s ease-in-out 0s infinite normal none running coo-radar-live-blink; }

@keyframes coo-radar-live-blink { 
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

.coo-radar-body { position: absolute; inset: 14px 4px 4px; display: grid; grid-template-columns: 1fr 1fr; gap: 3px; }

.coo-radar-scope { position: relative; border-radius: 50%; overflow: hidden; aspect-ratio: 1 / 1; max-height: 100%; margin: auto; background: radial-gradient(circle, rgba(16, 185, 129, 0.06) 0%, transparent 65%); border: 1px solid rgba(16, 185, 129, 0.25); }

.coo-radar-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(16, 185, 129, 0.15); top: 50%; left: 50%; transform: translate(-50%, -50%); }

.coo-radar-ring:nth-child(1) { width: 90%; height: 90%; }

.coo-radar-ring:nth-child(2) { width: 60%; height: 60%; }

.coo-radar-ring:nth-child(3) { width: 30%; height: 30%; }

.coo-radar-sweep { position: absolute; inset: 0px; border-radius: 50%; background: conic-gradient(transparent 0deg, rgba(16, 185, 129, 0.5) 28deg, transparent 56deg); animation: coo-radar-sweep-spin var(--rad-dur, 8s) linear infinite; }

@keyframes coo-radar-sweep-spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.coo-radar-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; z-index: 3; }

.coo-radar-val { font-size: 11px; font-weight: 800; letter-spacing: -0.04em; color: rgb(255, 255, 255); line-height: 1; }

.coo-radar-sub { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 1px; }

.coo-radar-ping { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: rgb(52, 211, 153); box-shadow: rgb(52, 211, 153) 0px 0px 8px; opacity: 0; z-index: 2; animation: coo-radar-ping var(--rad-dur, 8s) ease-out infinite; }

.coo-radar-ping::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid rgba(52, 211, 153, 0.6); animation: coo-radar-ping-ring var(--rad-dur, 8s) ease-out infinite; }

@keyframes coo-radar-ping { 
  0%, 8% { opacity: 0; transform: scale(0.4); }
  14%, 55% { opacity: 1; transform: scale(1); }
  65%, 100% { opacity: 0; transform: scale(0.6); }
}

@keyframes coo-radar-ping-ring { 
  0%, 10% { opacity: 0; transform: scale(0.5); }
  16%, 50% { opacity: 0.8; transform: scale(1.8); }
  60%, 100% { opacity: 0; transform: scale(2.2); }
}

.coo-radar-ping-1 { top: 22%; left: 62%; animation-delay: 0.4s; }

.coo-radar-ping-1::after { animation-delay: 0.4s; }

.coo-radar-ping-2 { top: 58%; left: 28%; animation-delay: 1.6s; }

.coo-radar-ping-2::after { animation-delay: 1.6s; }

.coo-radar-ping-3 { top: 35%; left: 72%; animation-delay: 2.8s; }

.coo-radar-ping-3::after { animation-delay: 2.8s; }

.coo-radar-feed { display: flex; flex-direction: column; gap: 2px; justify-content: center; min-width: 0px; overflow: hidden; }

.coo-radar-sale { padding: 2px 4px; border-radius: 4px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08); opacity: 0; transform: translateX(6px); animation: coo-radar-sale-in var(--rad-dur, 8s) ease-out infinite; }

.coo-radar-sale:nth-child(1) { animation-delay: 0.5s; }

.coo-radar-sale:nth-child(2) { animation-delay: 1.2s; }

.coo-radar-sale:nth-child(3) { animation-delay: 1.9s; }

@keyframes coo-radar-sale-in { 
  0%, 10% { opacity: 0; transform: translateX(8px); }
  18%, 62% { opacity: 1; transform: translateX(0px); }
  72%, 100% { opacity: 0.35; transform: translateX(-2px); }
}

.coo-radar-sale-amt { font-size: 6px; font-weight: 800; color: rgb(110, 231, 183); line-height: 1; }

.coo-radar-sale-lbl { font-size: 4px; font-weight: 600; color: rgba(255, 255, 255, 0.45); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-radar-pos-icon { position: absolute; bottom: 3px; left: 4px; width: 10px; height: 8px; border-radius: 2px; background: rgba(56, 189, 248, 0.25); border: 1px solid rgba(56, 189, 248, 0.35); z-index: 4; }

.coo-radar-pos-icon::before { content: ""; position: absolute; top: 1px; left: 1px; right: 1px; height: 2px; background: rgba(255, 255, 255, 0.3); border-radius: 1px; }

.coo-radar-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-radar-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-radar-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-radar-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-radar-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-radar.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-radar.layout-banner-wide .coo-radar-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-radar.layout-banner-wide .coo-radar-console { width: 96px; height: 72px; border-radius: 8px; }

.visual-radar.layout-banner-wide .coo-radar-body { inset: 12px 3px 3px; }

.visual-radar.layout-banner-wide .coo-radar-val { font-size: 9px; }

.visual-radar.layout-banner-wide .coo-radar-feed .coo-radar-sale:nth-child(3) { display: none; }

.visual-radar.layout-banner-wide .coo-radar-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-radar.layout-banner-wide .coo-radar-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-radar.layout-banner-wide .coo-radar-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-radar.layout-banner-wide .coo-radar-btn { padding: 6px 12px; font-size: 10px; }

.visual-radar.layout-banner-wide .coo-radar-btn .coo-arrow { display: none; }

.visual-radar.layout-banner-wide .coo-brand { display: none; }

.visual-radar.layout-square, .visual-radar.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-radar.layout-square .coo-radar-square, .visual-radar.layout-desktop-square .coo-radar-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-radar.layout-square .coo-radar-square-top, .visual-radar.layout-desktop-square .coo-radar-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-radar.layout-square .coo-radar-console, .visual-radar.layout-desktop-square .coo-radar-console { width: 130px; height: 118px; border-radius: 12px; }

.visual-radar.layout-square .coo-radar-val, .visual-radar.layout-desktop-square .coo-radar-val { font-size: 14px; }

.visual-radar.layout-square .coo-radar-sale-amt, .visual-radar.layout-desktop-square .coo-radar-sale-amt { font-size: 7px; }

.visual-radar.layout-square .coo-radar-copy .coo-hook, .visual-radar.layout-desktop-square .coo-radar-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-radar.layout-square .coo-radar-title, .visual-radar.layout-desktop-square .coo-radar-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-radar.layout-square .coo-radar-desc, .visual-radar.layout-desktop-square .coo-radar-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-radar.layout-square .coo-radar-btn, .visual-radar.layout-desktop-square .coo-radar-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-radar.layout-square .coo-brand, .visual-radar.layout-desktop-square .coo-brand { display: none; }

.visual-radar.layout-compact, .visual-radar.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-radar.layout-compact .coo-radar-compact, .visual-radar.layout-mobile .coo-radar-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-radar.layout-compact .coo-radar-compact-top, .visual-radar.layout-mobile .coo-radar-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-radar.layout-compact .coo-radar-console, .visual-radar.layout-mobile .coo-radar-console { width: 72px; height: 62px; border-radius: 8px; }

.visual-radar.layout-compact .coo-radar-body, .visual-radar.layout-mobile .coo-radar-body { inset: 11px 2px 2px; gap: 2px; }

.visual-radar.layout-compact .coo-radar-val, .visual-radar.layout-mobile .coo-radar-val { font-size: 8px; }

.visual-radar.layout-compact .coo-radar-feed .coo-radar-sale:nth-child(n+2), .visual-radar.layout-mobile .coo-radar-feed .coo-radar-sale:nth-child(n+2) { display: none; }

.visual-radar.layout-compact .coo-radar-head-label, .visual-radar.layout-mobile .coo-radar-head-label { display: none; }

.visual-radar.layout-compact .coo-radar-copy .coo-hook, .visual-radar.layout-mobile .coo-radar-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-radar.layout-compact .coo-radar-title, .visual-radar.layout-mobile .coo-radar-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-radar.layout-compact .coo-radar-desc, .visual-radar.layout-mobile .coo-radar-desc { display: none; }

.visual-radar.layout-compact .coo-radar-compact-foot, .visual-radar.layout-mobile .coo-radar-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-radar.layout-compact .coo-radar-btn, .visual-radar.layout-mobile .coo-radar-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-radar.layout-compact .coo-radar-btn .coo-arrow, .visual-radar.layout-mobile .coo-radar-btn .coo-arrow { display: none; }

.visual-radar.layout-compact .coo-brand, .visual-radar.layout-mobile .coo-brand { display: none; }

.visual-tap { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-tap[class*="theme-"] { background: linear-gradient(155deg, rgb(12, 25, 41) 0%, rgb(30, 58, 95) 50%, rgb(15, 39, 68) 100%) !important; color: rgb(240, 244, 248) !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; }

.visual-tap .coo-bg-orb { display: none !important; }

.visual-tap .coo-hook { background: rgba(255, 255, 255, 0.12) !important; color: rgb(226, 232, 240) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-tap .coo-btn { box-shadow: rgba(255, 255, 255, 0.2) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(12, 25, 41) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-tap-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 25% 70%, rgba(52, 199, 89, 0.15) 0%, transparent 48%), radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.08) 0%, transparent 42%); }

.coo-tap-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-tap-stand { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }

.coo-tap-tablet { position: relative; width: 78%; flex: 1 1 0%; min-height: 0px; max-height: 72%; border-radius: 6px 6px 2px 2px; background: linear-gradient(rgb(248, 250, 252) 0%, rgb(226, 232, 240) 100%); border: 1.5px solid rgba(255, 255, 255, 0.5); box-shadow: rgba(0, 0, 0, 0.35) 0px 6px 20px, rgb(255, 255, 255) 0px 1px 0px inset; overflow: hidden; z-index: 2; }

.coo-tap-screen { position: absolute; inset: 3px; border-radius: 4px; background: rgb(255, 255, 255); overflow: hidden; }

.coo-tap-screen-head { padding: 2px 4px; background: rgb(12, 25, 41); color: rgb(255, 255, 255); font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; text-align: center; }

.coo-tap-barcode { position: relative; margin: 4px auto 2px; width: 70%; height: 10px; background: repeating-linear-gradient(90deg, rgb(30, 41, 59) 0px, rgb(30, 41, 59) 2px, rgb(255, 255, 255) 2px, rgb(255, 255, 255) 4px); border-radius: 1px; opacity: 0; animation: coo-tap-barcode-in var(--tap-dur, 7s) ease-out infinite; }

@keyframes coo-tap-barcode-in { 
  0%, 5% { opacity: 0; transform: scaleX(0.6); }
  12%, 35% { opacity: 1; transform: scaleX(1); }
  42%, 100% { opacity: 0.4; transform: scaleX(1); }
}

.coo-tap-scan { position: absolute; top: 0px; bottom: 0px; width: 2px; left: 0px; background: rgb(239, 68, 68); box-shadow: rgb(239, 68, 68) 0px 0px 6px; animation: coo-tap-scan-sweep var(--tap-dur, 7s) ease-in-out infinite; }

@keyframes coo-tap-scan-sweep { 
  0%, 8% { left: 0px; opacity: 0; }
  12%, 28% { opacity: 1; }
  32%, 100% { left: 100%; opacity: 0; }
}

.coo-tap-cart-line { display: flex; justify-content: space-between; padding: 1px 4px; font-size: 4px; font-weight: 600; color: rgb(51, 65, 85); opacity: 0; transform: translateX(-6px); animation: coo-tap-line-in var(--tap-dur, 7s) ease-out infinite; }

.coo-tap-cart-line:nth-child(1) { animation-delay: 0.15s; }

.coo-tap-cart-line:nth-child(2) { animation-delay: 0.3s; }

@keyframes coo-tap-line-in { 
  0%, 18% { opacity: 0; transform: translateX(-8px); }
  26%, 55% { opacity: 1; transform: translateX(0px); }
  65%, 100% { opacity: 0.5; }
}

.coo-tap-nfc-zone { position: absolute; bottom: 8%; left: 50%; transform: translateX(-50%); width: 44%; height: 28%; border-radius: 6px; border: 1px dashed rgba(12, 25, 41, 0.2); display: flex; align-items: center; justify-content: center; opacity: 0; animation: coo-tap-nfc-show var(--tap-dur, 7s) ease-out infinite; }

@keyframes coo-tap-nfc-show { 
  0%, 30% { opacity: 0; }
  38%, 70% { opacity: 1; }
  78%, 100% { opacity: 0; }
}

.coo-tap-nfc-icon { font-size: 6px; font-weight: 800; color: rgb(100, 116, 139); letter-spacing: 0.04em; }

.coo-tap-ring { position: absolute; top: 50%; left: 50%; width: 16px; height: 16px; margin: -8px 0px 0px -8px; border-radius: 50%; border: 2px solid rgba(52, 199, 89, 0.6); opacity: 0; animation: coo-tap-ring-pulse var(--tap-dur, 7s) ease-out infinite; }

.coo-tap-ring:nth-child(2) { animation-delay: 0.35s; }

@keyframes coo-tap-ring-pulse { 
  0%, 34% { opacity: 0; transform: scale(0.4); }
  42%, 58% { opacity: 0.9; transform: scale(1.4); }
  68%, 100% { opacity: 0; transform: scale(2); }
}

.coo-tap-success { position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.95); z-index: 5; opacity: 0; pointer-events: none; animation: coo-tap-success-in var(--tap-dur, 7s) ease-out infinite; }

@keyframes coo-tap-success-in { 
  0%, 52% { opacity: 0; transform: scale(0.92); }
  58%, 82% { opacity: 1; transform: scale(1); }
  90%, 100% { opacity: 0; transform: scale(1.02); }
}

.coo-tap-check { width: 18px; height: 18px; border-radius: 50%; background: rgb(34, 197, 94); color: rgb(255, 255, 255); font-size: 10px; font-weight: 800; line-height: 18px; text-align: center; box-shadow: rgba(34, 197, 94, 0.5) 0px 0px 12px; animation: coo-tap-check-pop var(--tap-dur, 7s) ease-out infinite; }

@keyframes coo-tap-check-pop { 
  0%, 54% { transform: scale(0); }
  60%, 78% { transform: scale(1); }
  86%, 100% { transform: scale(0.9); }
}

.coo-tap-success-amt { font-size: 9px; font-weight: 800; color: rgb(12, 25, 41); letter-spacing: -0.03em; margin-top: 2px; }

.coo-tap-success-sub { font-size: 4px; font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; letter-spacing: 0.06em; }

.coo-tap-base { width: 36%; height: 8%; flex-shrink: 0; background: linear-gradient(rgb(203, 213, 225), rgb(148, 163, 184)); border-radius: 0px 0px 4px 4px; box-shadow: rgba(0, 0, 0, 0.3) 0px 2px 6px; z-index: 1; }

.coo-tap-reader { position: absolute; bottom: 2px; right: 8%; width: 22%; height: 14%; border-radius: 4px; background: linear-gradient(145deg, rgb(241, 245, 249), rgb(203, 213, 225)); border: 1px solid rgba(255, 255, 255, 0.4); box-shadow: rgba(0, 0, 0, 0.25) 0px 2px 8px; z-index: 3; }

.coo-tap-reader-led { position: absolute; top: 2px; right: 2px; width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: coo-tap-led var(--tap-dur, 7s) step-end infinite; }

@keyframes coo-tap-led { 
  0%, 55% { background: rgb(148, 163, 184); box-shadow: none; }
  58%, 85% { background: rgb(34, 197, 94); box-shadow: rgb(34, 197, 94) 0px 0px 4px; }
  90%, 100% { background: rgb(148, 163, 184); }
}

