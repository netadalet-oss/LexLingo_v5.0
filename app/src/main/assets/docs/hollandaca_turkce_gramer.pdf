            <label class="native-login-label" for="login_name">E-Mail:</label>
            <input class="native-login-input" type="text" name="login_name" id="login_name" placeholder="E-Mail: girin" autocomplete="username" required="">
          </div>
        </div>

        <!-- Password Input -->
        <div class="native-login-input-group">
          <div class="native-login-input-icon">
            <i class="fas fa-lock"></i>
          </div>
          <div class="native-login-input-wrapper">
            <label class="native-login-label" for="login_password">Åžifre</label>
            <input class="native-login-input" type="password" name="login_password" id="login_password" placeholder="Åžifre girin" autocomplete="current-password" required="">
          </div>
          <button type="button" class="native-login-toggle-password" aria-label="Show password">
            <i class="fas fa-eye"></i>
          </button>
        </div>

        <!-- Forgot Password Link -->
        <a class="native-login-forgot" href="https://mir.az/index.php?do=lostpassword&amp;lang=tr">
          <i class="fas fa-question-circle"></i>
          ParolanÄ±zÄ± mÄ± unuttunuz?
        </a>

        

        <!-- Submit Buttons -->
        <button class="native-login-btn native-login-btn-primary" type="submit">
          <i class="fas fa-sign-in-alt"></i>
          <span>Siteye giriÅŸ</span>
        </button>

        <a href="https://mir.az/index.php?do=register&amp;lang=tr" class="native-login-btn native-login-btn-secondary">
          <i class="fas fa-user-plus"></i>
          <span>KayÄ±t</span>
        </a>
      </form>

      <!-- Social Login Section -->
      <div class="native-menu-divider"></div>
      
      <div class="native-social-section">
        <div class="native-section-title">
          <i class="fas fa-share-alt"></i>
          Sosyal aÄŸlarla
        </div>
        
        <div class="native-social-grid">
          
          
          <a class="native-profile-item" href="https://accounts.google.com/o/oauth2/auth?client_id=373278090624-od6bdmpr721hv22o3tpcmpvr16fo874b.apps.googleusercontent.com&amp;redirect_uri=https%3A%2F%2Fmir.az%2Findex.php%3Fdo%3Dauth-social%26provider%3Dgoogle&amp;scope=https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fuserinfo.email+https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fuserinfo.profile&amp;state=c8776f8951a875c6834ec57fcb63467d&amp;response_type=code" target="_blank" rel="nofollow noopener">
