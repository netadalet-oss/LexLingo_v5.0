.visual-inbox.layout-square .coo-brand, .visual-inbox.layout-desktop-square .coo-brand { display: none; }

.visual-inbox.layout-compact, .visual-inbox.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

