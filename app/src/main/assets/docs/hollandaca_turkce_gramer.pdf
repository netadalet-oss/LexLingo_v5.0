.visual-autoshop { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-autoshop[class*="theme-"] { background: linear-gradient(155deg, rgb(30, 27, 75) 0%, rgb(49, 46, 129) 38%, rgb(67, 56, 202) 62%, rgb(55, 48, 163) 100%) !important; color: rgb(224, 231, 255) !important; border: 1px solid rgba(129, 140, 248, 0.28) !important; }

.visual-autoshop .coo-bg-orb { display: none !important; }

.visual-autoshop .coo-hook { background: rgba(99, 102, 241, 0.25) !important; color: rgb(199, 210, 254) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-autoshop .coo-btn { box-shadow: rgba(251, 191, 36, 0.35) 0px 4px 18px; background: rgb(251, 191, 36) !important; color: rgb(30, 27, 75) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-as-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 35% 45%, rgba(251, 191, 36, 0.1) 0%, transparent 48%), radial-gradient(circle at 78% 35%, rgba(129, 140, 248, 0.14) 0%, transparent 42%); }

.coo-as-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-as-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgb(15, 23, 42) 0%, rgb(30, 27, 75) 55%, rgb(49, 46, 129) 100%); border: 1px solid rgba(129, 140, 248, 0.3); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-as-chrome { display: flex; align-items: center; gap: 3px; padding: 3px 5px 2px; background: rgba(15, 23, 42, 0.85); border-bottom: 1px solid rgba(129, 140, 248, 0.15); z-index: 4; }

.coo-as-dot { width: 3px; height: 3px; border-radius: 50%; background: rgba(255, 255, 255, 0.25); flex-shrink: 0; }

.coo-as-dot:first-child { background: rgb(248, 113, 113); }

.coo-as-dot:nth-child(2) { background: rgb(251, 191, 36); }

.coo-as-dot:nth-child(3) { background: rgb(52, 211, 153); }

.coo-as-url { flex: 1 1 0%; min-width: 0px; font-size: 4px; font-weight: 700; color: rgb(165, 180, 252); background: rgba(255, 255, 255, 0.06); padding: 2px 4px; border-radius: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0px 2px; }

.coo-as-cart { position: relative; font-size: 5px; line-height: 1; flex-shrink: 0; }

.coo-as-cart-badge { position: absolute; top: -3px; right: -4px; min-width: 6px; height: 6px; border-radius: 99px; background: rgb(251, 191, 36); color: rgb(30, 27, 75); font-size: 4px; font-weight: 800; display: flex; align-items: center; justify-content: center; animation: coo-as-cart-pop var(--as-dur, 8s) ease-in-out infinite; }

@keyframes coo-as-cart-pop { 
  0%, 35% { transform: scale(1); content: "1"; }
  42%, 100% { transform: scale(1.15); }
}

.coo-as-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; padding: 4px 5px 14px; position: relative; z-index: 2; }

.coo-as-prod { border-radius: 4px; padding: 3px 2px; text-align: center; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(129, 140, 248, 0.12); }

.coo-as-prod-hot { border-color: rgba(251, 191, 36, 0.5); animation: coo-as-prod-pulse var(--as-dur, 8s) ease-in-out infinite; }

@keyframes coo-as-prod-pulse { 
  0%, 30% { box-shadow: none; transform: scale(1); }
  38%, 55% { box-shadow: rgba(251, 191, 36, 0.45) 0px 0px 10px; transform: scale(1.04); background: rgba(251, 191, 36, 0.12); }
  65%, 100% { box-shadow: none; transform: scale(1); }
}

.coo-as-prod-icon { font-size: 6px; line-height: 1; margin-bottom: 1px; }

.coo-as-prod-code { font-size: 3px; font-weight: 800; color: rgb(199, 210, 254); letter-spacing: 0.02em; }

.coo-as-prod-name { font-size: 2.5px; color: rgba(199, 210, 254, 0.65); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-as-prod-price { font-size: 4px; font-weight: 800; color: rgb(251, 191, 36); margin-top: 1px; }

.coo-as-add { position: absolute; bottom: 22%; left: 50%; transform: translateX(-50%); font-size: 3px; font-weight: 800; color: rgb(30, 27, 75); background: rgb(251, 191, 36); padding: 1px 4px; border-radius: 99px; opacity: 0; z-index: 5; animation: coo-as-add-flash var(--as-dur, 8s) ease-out infinite; }

@keyframes coo-as-add-flash { 
  0%, 36% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  42%, 52% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  58%, 100% { opacity: 0; transform: translateX(-50%) translateY(-2px); }
}

.coo-as-order { position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); font-size: 3.5px; font-weight: 700; color: rgb(236, 253, 245); white-space: nowrap; background: rgba(16, 185, 129, 0.9); padding: 2px 5px; border-radius: 99px; border: 1px solid rgba(52, 211, 153, 0.4); z-index: 6; opacity: 0; animation: coo-as-order-in var(--as-dur, 8s) ease-out infinite; }

@keyframes coo-as-order-in { 
  0%, 48% { opacity: 0; transform: translateX(-50%) translateY(6px); }
  55%, 82% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  90%, 100% { opacity: 0; transform: translateX(-50%) translateY(-3px); }
}

.coo-as-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-as-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-as-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-as-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

