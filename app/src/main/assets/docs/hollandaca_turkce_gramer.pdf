.visual-bridge.layout-square .coo-bridge-title, .visual-bridge.layout-desktop-square .coo-bridge-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-bridge.layout-square .coo-bridge-desc, .visual-bridge.layout-desktop-square .coo-bridge-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-bridge.layout-square .coo-bridge-btn, .visual-bridge.layout-desktop-square .coo-bridge-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-bridge.layout-square .coo-brand, .visual-bridge.layout-desktop-square .coo-brand { display: none; }

