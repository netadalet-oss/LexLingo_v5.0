  50% { transform: scale(1.08); opacity: 1; box-shadow: rgba(74, 222, 128, 0.35) 0px 0px 12px; }
}

.coo-live-icon-tile { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255, 255, 255, 0.16); color: rgb(255, 255, 255); }

.coo-live-badge { position: absolute; top: -4px; right: -4px; z-index: 3; display: inline-flex; align-items: center; gap: 3px; font-size: 6px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 5px; border-radius: 999px; background: rgb(34, 197, 94); color: rgb(255, 255, 255); line-height: 1; box-shadow: rgba(34, 197, 94, 0.55) 0px 0px 8px; }

.coo-live-badge-dot { width: 4px; height: 4px; border-radius: 50%; background: rgb(255, 255, 255); animation: 1.2s ease-in-out 0s infinite normal none running coo-live-dot-blink; }

@keyframes coo-live-dot-blink { 
