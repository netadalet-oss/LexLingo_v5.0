.coo-live-bar-1 { height: 40%; animation-delay: 0s; }

.coo-live-bar-2 { height: 70%; animation-delay: 0.15s; }

.coo-live-bar-3 { height: 55%; animation-delay: 0.3s; }

.coo-live-bar-4 { height: 90%; animation-delay: 0.45s; }

.coo-live-bar-5 { height: 60%; animation-delay: 0.6s; }

@keyframes coo-live-bar-dance { 
  0%, 100% { transform: scaleY(1); opacity: 0.65; }
  50% { transform: scaleY(1.25); opacity: 1; }
}

.coo-live-btn { position: relative; overflow: hidden; z-index: 2; }

.coo-live-shine { position: absolute; top: 0px; left: -100%; width: 55%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent); animation: 2.6s ease-in-out 0s infinite normal none running coo-live-shine; }

