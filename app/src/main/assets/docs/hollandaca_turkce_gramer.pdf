.visual-scan.layout-compact .coo-scan-compact, .visual-scan.layout-mobile .coo-scan-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-scan.layout-compact .coo-scan-compact-top, .visual-scan.layout-mobile .coo-scan-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-scan.layout-compact .coo-scan-phone, .visual-scan.layout-mobile .coo-scan-phone { width: 72px; height: 62px; border-radius: 8px; }

.visual-scan.layout-compact .coo-scan-toast, .visual-scan.layout-mobile .coo-scan-toast { display: none; }

.visual-scan.layout-compact .coo-scan-copy .coo-hook, .visual-scan.layout-mobile .coo-scan-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-scan.layout-compact .coo-scan-title, .visual-scan.layout-mobile .coo-scan-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-scan.layout-compact .coo-scan-desc, .visual-scan.layout-mobile .coo-scan-desc { display: none; }

.visual-scan.layout-compact .coo-scan-compact-foot, .visual-scan.layout-mobile .coo-scan-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-scan.layout-compact .coo-scan-btn, .visual-scan.layout-mobile .coo-scan-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-scan.layout-compact .coo-scan-btn .coo-arrow, .visual-scan.layout-mobile .coo-scan-btn .coo-arrow { display: none; }

.visual-scan.layout-compact .coo-brand, .visual-scan.layout-mobile .coo-brand { display: none; }

.visual-alert { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-alert[class*="theme-"] { background: linear-gradient(155deg, rgb(67, 20, 7) 0%, rgb(194, 65, 12) 38%, rgb(180, 83, 9) 100%) !important; color: rgb(255, 247, 237) !important; border: 1px solid rgba(251, 191, 36, 0.25) !important; }

.visual-alert .coo-bg-orb { display: none !important; }

.visual-alert .coo-hook { background: rgba(0, 0, 0, 0.2) !important; color: rgb(253, 230, 138) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-alert .coo-btn { box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(194, 65, 12) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-alert-glow { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 30% 50%, rgba(239, 68, 68, 0.2) 0%, transparent 48%), radial-gradient(circle at 75% 30%, rgba(251, 191, 36, 0.15) 0%, transparent 42%); animation: coo-alert-glow-pulse var(--al-dur, 8s) ease-in-out infinite; }

@keyframes coo-alert-glow-pulse { 
  0%, 100% { opacity: 0.6; }
  45%, 55% { opacity: 1; }
}

.coo-alert-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-alert-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(0, 0, 0, 0.35) 0%, rgba(67, 20, 7, 0.55) 100%); border: 1px solid rgba(251, 191, 36, 0.28); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-alert-hazard { position: absolute; top: 6px; right: 6px; width: 14px; height: 14px; border-radius: 50%; z-index: 6; background: radial-gradient(circle, rgb(239, 68, 68) 0%, rgb(220, 38, 38) 70%); box-shadow: rgba(239, 68, 68, 0.6) 0px 0px 0px 0px; animation: coo-alert-hazard-ring var(--al-dur, 8s) ease-out infinite; }

.coo-alert-hazard::after { content: "!"; position: absolute; inset: 0px; display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: 900; color: rgb(255, 255, 255); line-height: 1; }

@keyframes coo-alert-hazard-ring { 
  0%, 20% { box-shadow: rgba(239, 68, 68, 0.55) 0px 0px 0px 0px; transform: scale(1); }
  35%, 55% { box-shadow: rgba(239, 68, 68, 0) 0px 0px 0px 6px; transform: scale(1.08); }
  70%, 100% { box-shadow: rgba(239, 68, 68, 0) 0px 0px 0px 0px; transform: scale(1); }
}

.coo-alert-push { position: absolute; top: -120%; left: 4px; right: 4px; z-index: 7; display: flex; align-items: flex-start; gap: 4px; padding: 4px 5px; border-radius: 8px; background: rgba(255, 255, 255, 0.95); border: 1px solid rgba(239, 68, 68, 0.35); box-shadow: rgba(0, 0, 0, 0.3) 0px 6px 16px; animation: coo-alert-push-drop var(--al-dur, 8s) cubic-bezier(0.22, 1, 0.36, 1) infinite; }

@keyframes coo-alert-push-drop { 
  0%, 8% { top: -120%; opacity: 0; }
  16%, 58% { top: 4px; opacity: 1; }
  68%, 100% { top: 4px; opacity: 0.92; }
}

.coo-alert-push-icon { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; background: linear-gradient(135deg, rgb(239, 68, 68), rgb(220, 38, 38)); display: flex; align-items: center; justify-content: center; font-size: 6px; font-weight: 900; color: rgb(255, 255, 255); line-height: 1; }

.coo-alert-push-body { min-width: 0px; flex: 1 1 0%; }

.coo-alert-push-title { font-size: 4px; font-weight: 800; color: rgb(15, 23, 42); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-alert-push-msg { font-size: 3px; font-weight: 600; color: rgb(100, 116, 139); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-alert-push-now { font-size: 3px; font-weight: 700; color: rgb(148, 163, 184); flex-shrink: 0; }

.coo-alert-strip { position: absolute; top: 0px; left: 0px; right: 0px; z-index: 4; padding: 3px 6px; display: flex; align-items: center; gap: 3px; background: linear-gradient(90deg, rgba(239, 68, 68, 0.85), rgba(245, 158, 11, 0.75)); animation: coo-alert-strip-flash var(--al-dur, 8s) ease-in-out infinite; }

@keyframes coo-alert-strip-flash { 
  0%, 100% { opacity: 0.85; }
  50% { opacity: 1; }
}

.coo-alert-strip-icon { font-size: 5px; line-height: 1; }

.coo-alert-strip-text { font-size: 4px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(255, 255, 255); }

.coo-alert-list { position: absolute; inset: 22px 4px 20px; z-index: 3; display: flex; flex-direction: column; gap: 2px; }

.coo-alert-row { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 3px; padding: 2px 4px; border-radius: 4px; background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.08); opacity: 0.55; animation-duration: ; animation-timing-function: ; animation-iteration-count: ; animation-direction: ; animation-fill-mode: ; animation-play-state: ; animation-name: ; animation-timeline: ; animation-range-start: ; animation-range-end: ; animation-delay: calc(var(--al-i, 0) * 0.4s); }

@keyframes coo-alert-row-hit { 
  0%, 18% { opacity: 0.45; border-color: rgba(255, 255, 255, 0.08); transform: translateX(0px); }
  28%, 52% { opacity: 1; transform: translateX(0px); }
  30%, 50% { border-color: rgba(239, 68, 68, 0.6); background: rgba(239, 68, 68, 0.15); }
  58%, 100% { opacity: 0.7; }
}

.coo-alert-row-out { animation-name: coo-alert-row-out; }

@keyframes coo-alert-row-out { 
  0%, 22% { opacity: 0.5; }
  32%, 55% { opacity: 1; border-color: rgba(239, 68, 68, 0.75); background: rgba(239, 68, 68, 0.22); transform: translateX(2px); }
  62%, 100% { opacity: 0.65; text-decoration: line-through; }
}

.coo-alert-row-name { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.9); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-alert-row-qty { font-size: 4px; font-weight: 800; color: rgb(253, 230, 138); font-variant-numeric: tabular-nums; }

.coo-alert-badge { font-size: 3px; font-weight: 800; padding: 1px 3px; border-radius: 99px; background: rgba(34, 197, 94, 0.25); color: rgb(187, 247, 208); }

.coo-alert-badge-low { background: rgba(245, 158, 11, 0.3); color: rgb(253, 230, 138); }

.coo-alert-badge-out { background: rgba(239, 68, 68, 0.35); color: rgb(254, 202, 202); }

.coo-alert-footer { position: absolute; bottom: 2px; left: 4px; right: 4px; display: flex; align-items: center; justify-content: space-between; padding: 2px 5px; border-radius: 5px; background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(251, 191, 36, 0.25); z-index: 4; }

.coo-alert-count-val { font-size: 8px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.03em; animation: coo-alert-count-shake var(--al-dur, 8s) ease-in-out infinite; }

@keyframes coo-alert-count-shake { 
  0%, 25% { transform: translateX(0px); color: rgb(255, 255, 255); }
  30%, 32% { transform: translateX(-1px); color: rgb(254, 202, 202); }
  34%, 36% { transform: translateX(1px); }
  38%, 100% { transform: translateX(0px); color: rgb(253, 230, 138); }
}

.coo-alert-count-sub { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.05em; }

.coo-alert-loss { font-size: 4px; font-weight: 800; color: rgb(252, 165, 165); opacity: 0; animation: coo-alert-loss-in var(--al-dur, 8s) ease-out infinite; }

@keyframes coo-alert-loss-in { 
  0%, 40% { opacity: 0; transform: translateY(2px); }
  48%, 72% { opacity: 1; transform: translateY(0px); }
  82%, 100% { opacity: 0.7; }
}

.coo-alert-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-alert-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-alert-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-alert-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-alert-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-alert.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-alert.layout-banner-wide .coo-alert-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-alert.layout-banner-wide .coo-alert-panel { width: 96px; height: 72px; border-radius: 8px; }

.visual-alert.layout-banner-wide .coo-alert-row:nth-child(n+3) { display: none; }

.visual-alert.layout-banner-wide .coo-alert-loss { display: none; }

.visual-alert.layout-banner-wide .coo-alert-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-alert.layout-banner-wide .coo-alert-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-alert.layout-banner-wide .coo-alert-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-alert.layout-banner-wide .coo-alert-btn { padding: 6px 12px; font-size: 10px; }

.visual-alert.layout-banner-wide .coo-alert-btn .coo-arrow { display: none; }

.visual-alert.layout-banner-wide .coo-brand { display: none; }

.visual-alert.layout-square, .visual-alert.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-alert.layout-square .coo-alert-square, .visual-alert.layout-desktop-square .coo-alert-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-alert.layout-square .coo-alert-square-top, .visual-alert.layout-desktop-square .coo-alert-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-alert.layout-square .coo-alert-panel, .visual-alert.layout-desktop-square .coo-alert-panel { width: 140px; height: 118px; border-radius: 12px; }

.visual-alert.layout-square .coo-alert-count-val, .visual-alert.layout-desktop-square .coo-alert-count-val { font-size: 10px; }

.visual-alert.layout-square .coo-alert-copy .coo-hook, .visual-alert.layout-desktop-square .coo-alert-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-alert.layout-square .coo-alert-title, .visual-alert.layout-desktop-square .coo-alert-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-alert.layout-square .coo-alert-desc, .visual-alert.layout-desktop-square .coo-alert-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-alert.layout-square .coo-alert-btn, .visual-alert.layout-desktop-square .coo-alert-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-alert.layout-square .coo-brand, .visual-alert.layout-desktop-square .coo-brand { display: none; }

.visual-alert.layout-compact, .visual-alert.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-alert.layout-compact .coo-alert-compact, .visual-alert.layout-mobile .coo-alert-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-alert.layout-compact .coo-alert-compact-top, .visual-alert.layout-mobile .coo-alert-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-alert.layout-compact .coo-alert-panel, .visual-alert.layout-mobile .coo-alert-panel { width: 72px; height: 62px; border-radius: 8px; }

.visual-alert.layout-compact .coo-alert-list, .visual-alert.layout-mobile .coo-alert-list { display: none; }

.visual-alert.layout-compact .coo-alert-push, .visual-alert.layout-mobile .coo-alert-push { top: 18px !important; animation-name: coo-alert-push-compact !important; }

@keyframes coo-alert-push-compact { 
  0%, 10% { opacity: 0; transform: translateY(-4px); }
  18%, 70% { opacity: 1; transform: translateY(0px); top: 18px; }
  80%, 100% { opacity: 0.9; }
}

.visual-alert.layout-compact .coo-alert-copy .coo-hook, .visual-alert.layout-mobile .coo-alert-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-alert.layout-compact .coo-alert-title, .visual-alert.layout-mobile .coo-alert-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-alert.layout-compact .coo-alert-desc, .visual-alert.layout-mobile .coo-alert-desc { display: none; }

.visual-alert.layout-compact .coo-alert-compact-foot, .visual-alert.layout-mobile .coo-alert-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-alert.layout-compact .coo-alert-btn, .visual-alert.layout-mobile .coo-alert-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-alert.layout-compact .coo-alert-btn .coo-arrow, .visual-alert.layout-mobile .coo-alert-btn .coo-arrow { display: none; }

.visual-alert.layout-compact .coo-brand, .visual-alert.layout-mobile .coo-brand { display: none; }

.visual-pipeline { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-pipeline[class*="theme-"] { background: linear-gradient(155deg, rgb(30, 27, 75) 0%, rgb(76, 29, 149) 42%, rgb(91, 33, 182) 100%) !important; color: rgb(245, 243, 255) !important; border: 1px solid rgba(167, 139, 250, 0.22) !important; }

.visual-pipeline .coo-bg-orb { display: none !important; }

.visual-pipeline .coo-hook { background: rgba(167, 139, 250, 0.2) !important; color: rgb(221, 214, 254) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-pipeline .coo-btn { box-shadow: rgba(139, 92, 246, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(91, 33, 182) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-pipe-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 40% 60%, rgba(139, 92, 246, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 25%, rgba(59, 130, 246, 0.1) 0%, transparent 42%); }

.coo-pipe-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-pipe-board { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(255, 255, 255, 0.08) 0%, rgba(0, 0, 0, 0.25) 100%); border: 1px solid rgba(167, 139, 250, 0.25); box-shadow: rgba(0, 0, 0, 0.35) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; }

.coo-pipe-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 4; }

.coo-pipe-head-label { font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-pipe-head-val { font-size: 4px; font-weight: 800; color: rgb(196, 181, 253); }

.coo-pipe-kanban { position: absolute; inset: 14px 3px 18px; z-index: 2; display: flex; gap: 2px; align-items: stretch; }

.coo-pipe-col { flex: 1 1 0%; min-width: 0px; display: flex; flex-direction: column; gap: 2px; background: rgba(255, 255, 255, 0.06); border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.08); padding: 2px 1px; }

.coo-pipe-col-head { display: flex; align-items: center; gap: 2px; padding: 0px 2px 1px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); }

.coo-pipe-col-dot { width: 3px; height: 3px; border-radius: 50%; flex-shrink: 0; }

.coo-pipe-col-label { font-size: 3px; font-weight: 800; color: rgba(255, 255, 255, 0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-transform: uppercase; letter-spacing: 0.03em; }

.coo-pipe-col-count { margin-left: auto; font-size: 3px; font-weight: 800; color: rgba(255, 255, 255, 0.35); font-variant-numeric: tabular-nums; }

.coo-pipe-col-body { flex: 1 1 0%; position: relative; min-height: 0px; }

.coo-pipe-card { position: absolute; left: 1px; right: 1px; padding: 2px; border-radius: 3px; background: rgba(255, 255, 255, 0.92); border: 1px solid rgba(0, 0, 0, 0.06); box-shadow: rgba(0, 0, 0, 0.15) 0px 1px 3px; }

.coo-pipe-card-name { font-size: 3px; font-weight: 800; color: rgb(30, 41, 59); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-pipe-card-amt { font-size: 3px; font-weight: 700; color: rgb(100, 116, 139); }

.coo-pipe-card-static { top: 2px; opacity: 0.65; }

.coo-pipe-card-static:nth-child(2) { top: 14px; opacity: 0.45; display: none; }

.coo-pipe-deal-flow { position: absolute; top: 18px; left: 1px; width: calc((100% - 6px) / var(--pip-cols, 4)); z-index: 5; padding: 2px; border-radius: 3px; background: rgb(255, 255, 255); border: 1px solid rgba(139, 92, 246, 0.45); box-shadow: rgba(139, 92, 246, 0.35) 0px 2px 8px; animation: coo-pipe-deal-move var(--pip-dur, 8s) ease-in-out infinite; }

@keyframes coo-pipe-deal-move { 
  0%, 8% { transform: translateX(0px); opacity: 0; }
  12%, 22% { transform: translateX(0px); opacity: 1; border-color: rgb(59, 130, 246); }
  28%, 38% { transform: translateX(calc(100% + 2px)); opacity: 1; border-color: rgb(139, 92, 246); }
  44%, 54% { transform: translateX(calc(200% + 4px)); opacity: 1; border-color: rgb(245, 158, 11); }
  60%, 72% { transform: translateX(calc(300% + 6px)); opacity: 1; border-color: rgb(34, 197, 94); background: rgb(236, 253, 245); }
  78%, 100% { transform: translateX(calc(300% + 6px)); opacity: 0; }
}

.coo-pipe-footer { position: absolute; bottom: 2px; left: 4px; right: 4px; display: flex; align-items: center; justify-content: space-between; padding: 2px 5px; border-radius: 5px; background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(167, 139, 250, 0.2); z-index: 4; }

.coo-pipe-count-val { font-size: 8px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.03em; }

.coo-pipe-count-sub { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.05em; }

.coo-pipe-pipeline-val { font-size: 5px; font-weight: 800; color: rgb(167, 243, 208); }

.coo-pipe-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-pipe-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-pipe-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-pipe-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-pipe-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-pipeline.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-pipeline.layout-banner-wide .coo-pipe-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-pipeline.layout-banner-wide .coo-pipe-board { width: 96px; height: 72px; border-radius: 8px; }

.visual-pipeline.layout-banner-wide .coo-pipe-col:nth-child(n+4) { display: none; }

.visual-pipeline.layout-banner-wide .coo-pipe-kanban { --pip-cols: 3; }

.visual-pipeline.layout-banner-wide .coo-pipe-deal-flow { animation-name: coo-pipe-deal-move-wide; }

@keyframes coo-pipe-deal-move-wide { 
  0%, 10% { transform: translateX(0px); opacity: 0; }
  15%, 30% { transform: translateX(0px); opacity: 1; }
  38%, 52% { transform: translateX(calc(100% + 2px)); opacity: 1; }
  60%, 74% { transform: translateX(calc(200% + 4px)); opacity: 1; background: rgb(236, 253, 245); border-color: rgb(34, 197, 94); }
  82%, 100% { opacity: 0; }
}

.visual-pipeline.layout-banner-wide .coo-pipe-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-pipeline.layout-banner-wide .coo-pipe-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-pipeline.layout-banner-wide .coo-pipe-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-pipeline.layout-banner-wide .coo-pipe-btn { padding: 6px 12px; font-size: 10px; }

.visual-pipeline.layout-banner-wide .coo-pipe-btn .coo-arrow { display: none; }

.visual-pipeline.layout-banner-wide .coo-brand { display: none; }

.visual-pipeline.layout-square, .visual-pipeline.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-pipeline.layout-square .coo-pipe-square, .visual-pipeline.layout-desktop-square .coo-pipe-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-pipeline.layout-square .coo-pipe-square-top, .visual-pipeline.layout-desktop-square .coo-pipe-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-pipeline.layout-square .coo-pipe-board, .visual-pipeline.layout-desktop-square .coo-pipe-board { width: 140px; height: 118px; border-radius: 12px; }

.visual-pipeline.layout-square .coo-pipe-col-label, .visual-pipeline.layout-desktop-square .coo-pipe-col-label { font-size: 4px; }

.visual-pipeline.layout-square .coo-pipe-card-name, .visual-pipeline.layout-desktop-square .coo-pipe-card-name { font-size: 4px; }

.visual-pipeline.layout-square .coo-pipe-count-val, .visual-pipeline.layout-desktop-square .coo-pipe-count-val { font-size: 10px; }

.visual-pipeline.layout-square .coo-pipe-copy .coo-hook, .visual-pipeline.layout-desktop-square .coo-pipe-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-pipeline.layout-square .coo-pipe-title, .visual-pipeline.layout-desktop-square .coo-pipe-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-pipeline.layout-square .coo-pipe-desc, .visual-pipeline.layout-desktop-square .coo-pipe-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-pipeline.layout-square .coo-pipe-btn, .visual-pipeline.layout-desktop-square .coo-pipe-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-pipeline.layout-square .coo-brand, .visual-pipeline.layout-desktop-square .coo-brand { display: none; }

.visual-pipeline.layout-compact, .visual-pipeline.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-pipeline.layout-compact .coo-pipe-compact, .visual-pipeline.layout-mobile .coo-pipe-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-pipeline.layout-compact .coo-pipe-compact-top, .visual-pipeline.layout-mobile .coo-pipe-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-pipeline.layout-compact .coo-pipe-board, .visual-pipeline.layout-mobile .coo-pipe-board { width: 72px; height: 62px; border-radius: 8px; }

.visual-pipeline.layout-compact .coo-pipe-col:nth-child(n+3), .visual-pipeline.layout-mobile .coo-pipe-col:nth-child(n+3) { display: none; }

.visual-pipeline.layout-compact .coo-pipe-kanban, .visual-pipeline.layout-mobile .coo-pipe-kanban { --pip-cols: 2; }

.visual-pipeline.layout-compact .coo-pipe-deal-flow, .visual-pipeline.layout-mobile .coo-pipe-deal-flow { animation-name: coo-pipe-deal-move-compact; }

@keyframes coo-pipe-deal-move-compact { 
  0%, 12% { transform: translateX(0px); opacity: 0; }
  18%, 40% { transform: translateX(0px); opacity: 1; }
  48%, 70% { transform: translateX(calc(100% + 2px)); opacity: 1; border-color: rgb(34, 197, 94); background: rgb(236, 253, 245); }
  78%, 100% { opacity: 0; }
}

