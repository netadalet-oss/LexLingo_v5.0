@charset "utf-8";

.section-personalized .section-title { display: flex; align-items: center; gap: 10px; }

.recommendation-reason { font-size: 11px; color: var(--coms-meta, #999); margin-top: 6px; padding: 4px 8px; background: var(--block-bg, #f5f5f5); border-radius: 4px; display: flex; align-items: center; gap: 4px; line-height: 1.3; }

.recommendation-reason i { font-size: 9px; flex-shrink: 0; }

html.darktheme .recommendation-reason { background: var(--line, #2a2d3a); color: var(--coms-meta, #888); }

.b-continue-reading { background: var(--block-bg); border-radius: 12px; padding: 20px; margin-bottom: 20px; }

.b-continue-reading .b-head { margin-bottom: 15px; }

.b-continue-reading .section-title { font-size: 18px; display: flex; align-items: center; gap: 10px; }

.continue-reading-item { margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid var(--line, #e0e0e0); }

.continue-reading-item:last-child { margin-bottom: 0px; padding-bottom: 0px; border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.continue-reading-link { display: flex; gap: 12px; text-decoration: none; color: inherit; transition: opacity 0.2s; }

.continue-reading-link:hover { opacity: 0.8; }

.continue-reading-cover { flex-shrink: 0; width: 60px; height: 90px; border-radius: 6px; overflow: hidden; }

.continue-reading-cover img { width: 100%; height: 100%; object-fit: cover; }

.continue-reading-info { flex: 1 1 0%; display: flex; flex-direction: column; gap: 4px; }

.continue-reading-info h4 { font-size: 14px; font-weight: 600; margin: 0px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.continue-reading-info .author { font-size: 12px; color: var(--coms-meta, #999); margin: 0px; }

.continue-reading-info .view-count { font-size: 11px; color: var(--lcolor, #667eea); font-weight: 500; }

html.darktheme .continue-reading-item { border-bottom-color: var(--line, #2a2d3a); }

@media (max-width: 768px) {
  .section-personalized { margin: 20px 0px; }
  .b-continue-reading { padding: 15px; }
  .continue-reading-cover { width: 50px; height: 75px; }
  .continue-reading-info h4 { font-size: 13px; }
}

.section-personalized, .b-continue-reading { animation: 0.5s ease-in-out 0s 1 normal none running fadeIn; }

@keyframes fadeIn { 
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}
