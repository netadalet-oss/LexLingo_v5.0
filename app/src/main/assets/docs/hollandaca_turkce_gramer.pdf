.visual-hot-booking .coo-btn, .visual-hot-flash .coo-btn, .visual-hot-drive .coo-btn, .visual-hot-boutique .coo-btn, .visual-hot-sparkle .coo-btn, .visual-hot-pipeline .coo-btn { box-shadow: rgba(251, 191, 36, 0.4) 0px 4px 18px; background: rgb(251, 191, 36) !important; color: rgb(30, 27, 75) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-hot-glow { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 70% 30%, rgba(251, 191, 36, 0.2) 0%, transparent 45%), radial-gradient(circle at 20% 80%, rgba(225, 29, 72, 0.15) 0%, transparent 40%); }

.coo-hot-stage { position: relative; flex-shrink: 0; overflow: hidden; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(0, 0, 0, 0.32); box-shadow: rgba(0, 0, 0, 0.35) 0px 6px 20px; }

.coo-hot-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-hot-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-hot-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-hot-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-hot-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-hot-booking .coo-hot-stage { background: linear-gradient(160deg, rgb(12, 74, 110), rgb(3, 105, 161)); }

.coo-hot-booking-card { position: absolute; inset: 4px; border-radius: 6px; overflow: hidden; }

.coo-hot-booking-banner { background: rgb(220, 38, 38); color: rgb(255, 255, 255); font-size: 5px; font-weight: 800; text-align: center; padding: 2px; letter-spacing: 0.08em; text-transform: uppercase; animation: coo-hot-booking-flash var(--hot-dur, 7s) step-end infinite; }

@keyframes coo-hot-booking-flash { 
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0.85; }
}

.coo-hot-booking-timer { text-align: center; padding: 4px 2px; font-size: 13px; font-weight: 800; letter-spacing: 0.06em; color: rgb(255, 255, 255); line-height: 1; font-variant-numeric: tabular-nums; animation: coo-hot-timer-tick var(--hot-dur, 7s) step-end infinite; }

@keyframes coo-hot-timer-tick { 
  0%, 20% { content: ""; }
}

.coo-hot-booking-slots { font-size: 5px; font-weight: 700; color: rgb(253, 230, 138); text-align: center; padding: 2px; background: rgba(0, 0, 0, 0.25); }

.coo-hot-booking-dots { display: flex; justify-content: center; gap: 3px; padding: 2px; }

.coo-hot-booking-dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(255, 255, 255, 0.25); }

.coo-hot-booking-dot-filled { background: rgb(251, 191, 36); animation: coo-hot-dot-pop var(--hot-dur, 7s) ease infinite; }

.coo-hot-booking-dot-filled:nth-child(1) { animation-delay: 0s; }

.coo-hot-booking-dot-filled:nth-child(2) { animation-delay: 0.3s; }

.coo-hot-booking-dot-filled:nth-child(3) { animation-delay: 0.6s; }

@keyframes coo-hot-dot-pop { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.coo-hot-booking-icons { display: flex; justify-content: center; gap: 5px; padding: 2px 4px 4px; font-size: 11px; line-height: 1; }

.coo-hot-booking-ic-wrap { display: flex; flex-direction: column; align-items: center; gap: 1px; animation: coo-hot-icon-bounce var(--hot-dur, 7s) ease-in-out infinite; }

.coo-hot-booking-ic-wrap:nth-child(1) { animation-delay: 0s; }

.coo-hot-booking-ic-wrap:nth-child(2) { animation-delay: 0.25s; }

.coo-hot-booking-ic-wrap:nth-child(3) { animation-delay: 0.5s; }

.coo-hot-booking-ic { font-size: inherit; line-height: 1; }

.coo-hot-booking-ic-lbl { font-size: 3.5px; font-weight: 700; color: rgb(253, 230, 138); opacity: 0.9; letter-spacing: 0.02em; line-height: 1; }

@keyframes coo-hot-icon-bounce { 
  0%, 100% { transform: translateY(0px); opacity: 0.85; }
  50% { transform: translateY(-2px); opacity: 1; }
}

.visual-hot-flash .coo-hot-stage { background: linear-gradient(145deg, rgb(26, 26, 46), rgb(22, 33, 62)); }

.coo-hot-flash-bolt { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -55%); font-size: 28px; line-height: 1; color: rgb(251, 191, 36); filter: drop-shadow(rgba(251, 191, 36, 0.8) 0px 0px 8px); animation: coo-hot-bolt-strike var(--hot-dur, 7s) ease-in-out infinite; }

@keyframes coo-hot-bolt-strike { 
  0%, 15% { opacity: 0; transform: translate(-50%, -55%) scale(0.5); }
  22%, 65% { opacity: 1; transform: translate(-50%, -55%) scale(1); }
  75%, 100% { opacity: 0.3; transform: translate(-50%, -55%) scale(0.9); }
}

.coo-hot-flash-badge { position: absolute; top: 6px; right: 6px; background: rgb(251, 191, 36); color: rgb(26, 26, 46); font-size: 5px; font-weight: 900; padding: 2px 5px; border-radius: 4px; letter-spacing: 0.05em; animation: 1.2s ease-in-out 0s infinite normal none running coo-hot-badge-pulse; }

@keyframes coo-hot-badge-pulse { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.coo-hot-flash-deal { position: absolute; bottom: 6px; left: 0px; right: 0px; text-align: center; font-size: 9px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.02em; }

.coo-hot-flash-sub { font-size: 5px; font-weight: 700; color: rgba(255, 255, 255, 0.55); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 1px; }

.visual-hot-drive .coo-hot-stage { background: linear-gradient(160deg, rgb(15, 23, 42) 0%, rgb(30, 58, 138) 52%, rgb(51, 65, 85) 100%); display: flex; flex-direction: column; overflow: hidden; }

.coo-hot-drive-inner { display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 0px; }

.coo-hot-drive-label { flex-shrink: 0; padding: 4px 4px 2px; text-align: center; font-size: 5.5px; font-weight: 800; color: rgb(147, 197, 253); letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.2; }

.coo-hot-drive-grid { flex: 1 1 0%; min-height: 0px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; padding: 2px 5px 5px; align-content: end; }

.coo-hot-drive-part { border-radius: 4px; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(96, 165, 250, 0.22); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; padding: 3px 2px 2px; box-sizing: border-box; min-height: 0px; animation: coo-hot-drive-part-pulse var(--hot-dur, 7s) ease-in-out infinite; }

.coo-hot-drive-part:nth-child(1) { animation-delay: 0s; }

.coo-hot-drive-part:nth-child(2) { animation-delay: 0.35s; }

.coo-hot-drive-part:nth-child(3) { animation-delay: 0.7s; }

@keyframes coo-hot-drive-part-pulse { 
  0%, 25% { border-color: rgba(96, 165, 250, 0.22); box-shadow: none; }
  35%, 55% { border-color: rgba(251, 191, 36, 0.55); box-shadow: rgba(251, 191, 36, 0.2) 0px 0px 8px; }
  65%, 100% { border-color: rgba(96, 165, 250, 0.22); box-shadow: none; }
}

.coo-hot-drive-ic { font-size: 11px; line-height: 1; flex-shrink: 0; }

.coo-hot-drive-code { font-size: 4px; font-weight: 800; color: rgb(147, 197, 253); letter-spacing: 0.03em; line-height: 1.1; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.coo-hot-drive-name { font-size: 3.5px; font-weight: 700; color: rgba(255, 255, 255, 0.45); line-height: 1; }

.coo-hot-drive-foot { flex-shrink: 0; text-align: center; font-size: 4px; font-weight: 800; color: rgb(251, 191, 36); letter-spacing: 0.06em; text-transform: uppercase; padding: 0px 4px 3px; line-height: 1.2; }

