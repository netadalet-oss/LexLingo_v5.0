.visual-pitscan { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-pitscan[class*="theme-"] { background: linear-gradient(155deg, rgb(28, 25, 23) 0%, rgb(41, 37, 36) 40%, rgb(68, 64, 60) 70%, rgb(28, 25, 23) 100%) !important; color: rgb(250, 250, 249) !important; border: 1px solid rgba(251, 146, 60, 0.22) !important; }

.visual-pitscan .coo-bg-orb { display: none !important; }

.visual-pitscan .coo-hook { background: rgba(251, 146, 60, 0.18) !important; color: rgb(253, 186, 116) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-pitscan .coo-btn { box-shadow: rgba(251, 146, 60, 0.35) 0px 4px 18px; background: rgb(251, 146, 60) !important; color: rgb(28, 25, 23) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-pit-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 40% 50%, rgba(251, 146, 60, 0.12) 0%, transparent 48%), radial-gradient(circle at 75% 30%, rgba(239, 68, 68, 0.08) 0%, transparent 42%); }

.coo-pit-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-pit-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgb(12, 10, 9) 0%, rgb(41, 37, 36) 50%, rgb(28, 25, 23) 100%); border: 1px solid rgba(251, 146, 60, 0.25); box-shadow: rgba(0, 0, 0, 0.5) 0px 8px 24px, rgba(255, 255, 255, 0.05) 0px 1px 0px inset; }

.coo-pit-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px 2px; font-size: 4px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(250, 250, 249, 0.45); border-bottom: 1px solid rgba(251, 146, 60, 0.12); z-index: 4; }

.coo-pit-live { display: inline-flex; align-items: center; gap: 2px; color: rgb(251, 146, 60); font-size: 3.5px; }

.coo-pit-live-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(239, 68, 68); animation: 1.2s ease-in-out 0s infinite normal none running coo-pit-live-blink; }

@keyframes coo-pit-live-blink { 
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

.coo-pit-scene { position: absolute; inset: 12px 3px 15px; display: flex; align-items: flex-end; justify-content: center; gap: 2px; z-index: 2; }

.coo-pit-shelf { width: 44%; height: 72%; position: relative; flex-shrink: 0; background: linear-gradient(rgba(68, 64, 60, 0.5) 0%, rgba(41, 37, 36, 0.8) 100%); border: 1px solid rgba(120, 113, 108, 0.4); border-radius: 4px 4px 0px 0px; }

.coo-pit-shelf::after { content: ""; position: absolute; bottom: 28%; left: 0px; right: 0px; height: 1px; background: rgba(120, 113, 108, 0.5); }

.coo-pit-box { position: absolute; bottom: 32%; left: 50%; width: 76%; height: 38%; transform: translateX(-50%); background: linear-gradient(rgb(120, 113, 108) 0%, rgb(87, 83, 78) 100%); border-radius: 2px; border: 1px solid rgba(251, 146, 60, 0.35); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1px 2px 2px; box-sizing: border-box; animation: coo-pit-box-hit var(--pit-dur, 7s) ease-in-out infinite; }

@keyframes coo-pit-box-hit { 
  0%, 40% { box-shadow: none; border-color: rgba(251, 146, 60, 0.35); transform: translateX(-50%); }
  46%, 58% { box-shadow: rgba(239, 68, 68, 0.5) 0px 0px 12px; border-color: rgba(239, 68, 68, 0.7); transform: translateX(-50%); }
  65%, 100% { box-shadow: none; border-color: rgba(251, 146, 60, 0.35); transform: translateX(-50%); }
}

.coo-pit-box-code { font-size: 4px; font-weight: 800; color: rgb(250, 250, 249); letter-spacing: 0.04em; width: 100%; text-align: center; line-height: 1.1; flex-shrink: 0; }

.coo-pit-bars { width: auto; max-width: calc(100% - 2px); height: 5px; margin: 2px auto 0px; display: inline-flex; gap: 0.5px; align-items: stretch; justify-content: center; flex-shrink: 0; overflow: hidden; }

.coo-pit-bar { background: rgb(250, 250, 249); border-radius: 0.5px; flex: 0 0 auto; height: 100%; }

.coo-pit-laser { position: absolute; left: 32%; right: 32%; top: 45%; height: 1px; z-index: 5; background: linear-gradient(90deg, transparent, rgb(239, 68, 68) 20%, rgb(239, 68, 68) 80%, transparent); box-shadow: rgba(239, 68, 68, 0.8) 0px 0px 6px; opacity: 0; animation: coo-pit-laser-fire var(--pit-dur, 7s) ease-out infinite; }

@keyframes coo-pit-laser-fire { 
  0%, 42% { opacity: 0; }
  45%, 56% { opacity: 1; }
  60%, 100% { opacity: 0; }
}

.coo-pit-gun { width: 34%; height: 55%; position: relative; align-self: flex-end; flex-shrink: 0; z-index: 6; transform-origin: 70% 100%; animation: coo-pit-gun-tilt var(--pit-dur, 7s) ease-in-out infinite; }

@keyframes coo-pit-gun-tilt { 
  0%, 38% { transform: rotate(-6deg) translateY(2px); }
  44%, 58% { transform: rotate(-1deg) translateY(0px); }
  65%, 100% { transform: rotate(-6deg) translateY(2px); }
}

.coo-pit-gun-body { position: absolute; bottom: 0px; left: 14%; right: 2%; height: 55%; background: linear-gradient(rgb(251, 191, 36) 0%, rgb(217, 119, 6) 45%, rgb(146, 64, 14) 100%); border-radius: 4px 8px 2px 2px; border: 1px solid rgba(0, 0, 0, 0.3); box-shadow: rgba(255, 255, 255, 0.25) 0px 1px 0px inset; }

.coo-pit-gun-body::before { content: ""; position: absolute; top: 20%; left: -14%; width: 18%; height: 18%; background: rgb(68, 64, 60); border-radius: 2px 0px 0px 2px; }

.coo-pit-gun-display { position: absolute; top: 8%; left: 12%; right: 12%; height: 28%; background: rgb(12, 10, 9); border: 1px solid rgba(251, 146, 60, 0.4); border-radius: 2px; display: flex; align-items: center; justify-content: center; font-size: 7px; font-weight: 800; color: rgb(74, 222, 128); font-variant-numeric: tabular-nums; overflow: hidden; }

.coo-pit-count-prev, .coo-pit-count-next { position: absolute; inset: 0px; display: flex; align-items: center; justify-content: center; }

.coo-pit-count-prev { animation: coo-pit-count-prev var(--pit-dur, 7s) steps(1) infinite; }

.coo-pit-count-next { opacity: 0; animation: coo-pit-count-next var(--pit-dur, 7s) steps(1) infinite; }

@keyframes coo-pit-count-prev { 
  0%, 48% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

@keyframes coo-pit-count-next { 
  0%, 48% { opacity: 0; }
  50%, 100% { opacity: 1; }
}

.coo-pit-beep { position: absolute; top: 8%; right: 8%; font-size: 3px; font-weight: 800; color: rgb(251, 146, 60); opacity: 0; animation: coo-pit-beep-flash var(--pit-dur, 7s) ease-out infinite; }

@keyframes coo-pit-beep-flash { 
  0%, 44% { opacity: 0; transform: scale(0.8); }
  48%, 54% { opacity: 1; transform: scale(1.1); }
  60%, 100% { opacity: 0; }
}

.coo-pit-toast { position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); font-size: 3px; font-weight: 700; color: rgb(250, 250, 249); white-space: nowrap; background: rgba(251, 146, 60, 0.92); padding: 2px 5px; border-radius: 99px; z-index: 7; opacity: 0; animation: coo-pit-toast-in var(--pit-dur, 7s) ease-out infinite; }

@keyframes coo-pit-toast-in { 
  0%, 50% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  56%, 80% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  88%, 100% { opacity: 0; }
}

