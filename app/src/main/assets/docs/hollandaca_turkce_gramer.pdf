.visual-plate.layout-compact .coo-brand, .visual-plate.layout-mobile .coo-brand { display: none; }

.visual-mirror { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-mirror[class*="theme-"] { background: linear-gradient(155deg, rgb(255, 241, 242) 0%, rgb(252, 231, 243) 42%, rgb(251, 207, 232) 72%, rgb(249, 168, 212) 100%) !important; color: rgb(131, 24, 67) !important; border: 1px solid rgba(244, 63, 94, 0.15) !important; }

.visual-mirror .coo-bg-orb { display: none !important; }

.visual-mirror .coo-hook { background: rgba(255, 255, 255, 0.55) !important; color: rgb(190, 24, 93) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-mirror .coo-btn { box-shadow: rgba(0, 0, 0, 0.15) 0px 4px 16px; background: rgb(29, 29, 31) !important; color: rgb(255, 255, 255) !important; border-radius: 999px !important; font-weight: 600 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-mrr-glow { position: absolute; inset: -30%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.35) 0%, transparent 50%); }

.coo-mrr-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-mrr-frame { position: relative; width: 100%; height: 100%; border-radius: 14px; padding: 3px; background: linear-gradient(145deg, rgb(253, 230, 138), rgb(244, 114, 182), rgb(253, 164, 175)); box-shadow: rgba(190, 24, 93, 0.2) 0px 8px 24px; }

.coo-mrr-panel { position: relative; width: 100%; height: 100%; border-radius: 11px; overflow: hidden; background: rgba(255, 255, 255, 0.92); border: 1px solid rgba(255, 255, 255, 0.95); }

.coo-mrr-shine { position: absolute; inset: 0px; z-index: 1; pointer-events: none; background: linear-gradient(115deg, transparent 40%, rgba(255, 255, 255, 0.45) 50%, transparent 60%); animation: coo-mrr-shine var(--mrr-dur, 8s) ease-in-out infinite; }

@keyframes coo-mrr-shine { 
  0%, 30% { transform: translateX(-100%); opacity: 0; }
  45%, 55% { opacity: 0.6; }
  70%, 100% { transform: translateX(100%); opacity: 0; }
}

.coo-mrr-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px 2px; border-bottom: 1px solid rgba(244, 63, 94, 0.08); z-index: 3; }

.coo-mrr-head-label { font-size: 3px; font-weight: 800; color: rgb(157, 23, 77); text-transform: uppercase; letter-spacing: 0.06em; }

.coo-mrr-day-badge { font-size: 3px; font-weight: 800; padding: 1px 4px; border-radius: 99px; background: rgba(244, 63, 94, 0.1); color: rgb(190, 24, 93); }

.coo-mrr-slots { position: absolute; inset: 14px 4px 4px; z-index: 2; display: flex; flex-direction: column; gap: 2px; }

.coo-mrr-slot { display: flex; align-items: center; gap: 3px; padding: 2px 4px; border-radius: 4px; min-height: 8px; position: relative; }

.coo-mrr-slot-time { font-size: 4px; font-weight: 800; color: rgb(120, 113, 108); width: 14px; flex-shrink: 0; font-variant-numeric: tabular-nums; }

.coo-mrr-slot-bar { flex: 1 1 0%; height: 3px; border-radius: 99px; background: rgba(0, 0, 0, 0.06); }

.coo-mrr-slot-busy .coo-mrr-slot-bar { background: rgba(190, 24, 93, 0.15); }

.coo-mrr-slot-busy .coo-mrr-slot-time { color: rgb(168, 162, 158); }

.coo-mrr-slot-active { flex-direction: column; align-items: stretch; gap: 2px; padding: 3px 4px; min-height: auto; background: linear-gradient(135deg, rgba(244, 63, 94, 0.12), rgba(251, 207, 232, 0.5)); border: 1px solid rgba(244, 63, 94, 0.25); box-shadow: rgba(244, 63, 94, 0.15) 0px 2px 10px; animation: coo-mrr-slot-pop var(--mrr-dur, 8s) ease-out infinite; }

@keyframes coo-mrr-slot-pop { 
  0%, 22% { transform: scale(0.96); opacity: 0.7; }
  32%, 78% { transform: scale(1); opacity: 1; }
  88%, 100% { opacity: 0.95; }
}

.coo-mrr-slot-active .coo-mrr-slot-time { color: rgb(190, 24, 93); font-size: 5px; width: auto; }

.coo-mrr-slot-active .coo-mrr-slot-bar { display: none; }

.coo-mrr-client-row { display: flex; align-items: center; gap: 3px; opacity: 0; animation: coo-mrr-client-in var(--mrr-dur, 8s) ease-out infinite; }

@keyframes coo-mrr-client-in { 
  0%, 30% { opacity: 0; transform: translateY(3px); }
  38%, 82% { opacity: 1; transform: translateY(0px); }
  92%, 100% { opacity: 0.9; }
}

.coo-mrr-avatar { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; background: linear-gradient(135deg, rgb(244, 114, 182), rgb(236, 72, 153)); display: flex; align-items: center; justify-content: center; font-size: 4px; font-weight: 800; color: rgb(255, 255, 255); border: 1px solid rgba(255, 255, 255, 0.6); }

.coo-mrr-client-info { min-width: 0px; flex: 1 1 0%; }

.coo-mrr-client-name { font-size: 3px; font-weight: 800; color: rgb(131, 24, 67); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-mrr-client-svc { font-size: 2px; font-weight: 600; color: rgb(157, 23, 77); opacity: 0.75; }

.coo-mrr-slot-free .coo-mrr-slot-bar { background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.04) 0px, rgba(0, 0, 0, 0.04) 3px, transparent 3px, transparent 6px); }

.coo-mrr-pulse { position: absolute; top: 50%; right: 3px; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; border: 1px solid rgba(244, 63, 94, 0.5); opacity: 0; animation: coo-mrr-pulse-ring var(--mrr-dur, 8s) ease-out infinite; }

@keyframes coo-mrr-pulse-ring { 
  0%, 28% { opacity: 0; transform: scale(0.6); }
  36%, 70% { opacity: 1; transform: scale(1); }
  78%, 100% { opacity: 0; transform: scale(1.4); }
}

.coo-mrr-hero-time { position: absolute; top: 3px; left: 50%; transform: translateX(-50%); z-index: 5; text-align: center; opacity: 0; animation: coo-mrr-hero-in var(--mrr-dur, 8s) ease-out infinite; }

@keyframes coo-mrr-hero-in { 
  0%, 52% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  60%, 82% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  92%, 100% { opacity: 0; }
}

.coo-mrr-hero-val { font-size: 6px; font-weight: 900; color: rgb(190, 24, 93); letter-spacing: -0.03em; line-height: 1; }

.coo-mrr-hero-sub { font-size: 2px; font-weight: 800; color: rgb(157, 23, 77); text-transform: uppercase; letter-spacing: 0.06em; }

.coo-mrr-toast { position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 2px; padding: 2px 5px; border-radius: 99px; z-index: 6; background: rgb(29, 29, 31); color: rgb(255, 255, 255); font-size: 3px; font-weight: 700; white-space: nowrap; opacity: 0; animation: coo-mrr-toast-in var(--mrr-dur, 8s) ease-out infinite; }

.coo-mrr-toast-check { width: 5px; height: 5px; border-radius: 50%; background: rgb(52, 199, 89); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 3px; font-weight: 900; }

@keyframes coo-mrr-toast-in { 
  0%, 62% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  70%, 88% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  96%, 100% { opacity: 0.9; }
}

