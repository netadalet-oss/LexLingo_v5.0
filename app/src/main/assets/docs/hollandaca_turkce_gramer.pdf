#dle-comments-list { margin-top: -0.25rem; }

.comment { margin-top: 0.25rem; padding: 1.5rem; background-color: var(--spoiler); position: relative; }

.comment-head { position: relative; font-size: 0.875rem; min-height: 2.5rem; padding-left: 3.25rem; margin-top: -0.25rem; margin-bottom: 1rem; display: flex; flex-direction: column; }

@media (min-width: 640px) {
  #dle-comments-list { margin-top: -0.5rem; }
  .comment { margin-top: 0.5rem; border-radius: 0.75rem; }
  .comment-head { padding-bottom: 1.25rem; padding-right: 9.25rem; margin-bottom: 1.25rem; }
  .comment-head::after { content: ""; position: absolute; left: 0px; right: 0px; top: 100%; margin: 0px -1.5rem; height: 0px; border-bottom: 1px solid var(--line); }
}

.comment-head .name { font-weight: 700; margin-top: -0.25rem; margin-bottom: 0.125rem; }

.comment-head .name a { color: inherit; }

.comment-head .name a:hover { color: rgb(76, 203, 112); }

.comment-meta { display: flex; align-items: center; font-size: 0.75rem; }

.comment-meta .group-label { margin-right: 0.75rem; }

.group-label { background-color: rgb(23, 43, 61); font-size: 0.625rem; font-weight: 700; height: 1.25rem; line-height: 1rem; padding: 0.125rem 0.5rem; border-radius: 1rem; color: rgb(255, 255, 255) !important; }

.group-label span { color: inherit !important; }

.group-label.g-adm { background-color: rgb(48, 167, 218); }

.group-label.g-vip { background-color: rgb(248, 118, 98); }

.group-label.yorumcu { background-color: rgb(255, 152, 0); }

.group-label.g-guest { background-color: rgba(23, 43, 61, 0.5); }

.com-likes { display: flex; text-align: center; font-size: 0.75rem; font-weight: 700; }

.com-likes a, .comment-tools a { color: var(--coms-meta); }

.com-like-plus i { color: rgb(76, 203, 112); }

.com-like-minus i { color: rgb(249, 86, 61); }

.comment-foot { margin-top: 1rem; }

.comment-tools { display: flex; font-size: 0.875rem; font-weight: 700; margin: -0.25rem; }

.comment-tools a { display: flex; align-items: center; padding: 0.25rem; }

.comment-title { font-size: 1.125rem; line-height: 1.3; }

.comment-title a { color: inherit; }

.comment-text { overflow-wrap: break-word; }

@media (max-width: 639px) {
  .com__reply > a > span { display: none; }
  .com-like-plus, .com-like-minus, .comment-foot { display: flex; align-items: center; }
  .comment-tools { margin-right: auto; }
  .com-likes a { margin-left: 1rem; }
  .com-like-plus, .com-like-minus { padding: 0.25rem; margin: -0.25rem; }
  .com-likes i { margin-right: 0.25rem; display: block; font-size: 20px; }
}

@media (min-width: 640px) {
  .com__reply { margin-right: auto; }
  .com-likes { position: absolute; right: 0px; top: 0px; margin-top: 0.5rem; margin-right: 0.25rem; }
  .com-likes i { display: block; margin: 0px auto 0.25rem; opacity: 0.8; transition: opacity 0.2s; font-size: 24px; }
  .com-likes a { padding: 0.5rem 0.25rem; width: 4.5rem; }
}

@media (min-width: 992px) {
  .com-likes a:hover i { opacity: 1; }
  .comment-tools a:hover, .com-likes a:hover { color: var(--coms-meta-h); }
  .comment-title a:hover { color: rgb(76, 203, 112); }
}

.comment-head .avatar-status { position: absolute; left: 0px; }

.avatar-status::after { position: absolute; left: 0px; top: 0px; z-index: 1; pointer-events: none; background-color: rgb(23, 43, 61); width: 0.375rem; height: 0.375rem; border-radius: 50%; margin: 0.1875rem; }

.avatar-status.online::after { background-color: rgb(76, 203, 112); content: ""; }

.avatar-status { position: relative; width: 2.5rem; height: 2.5rem; }

.avatar-status > label, .avatar-status > label i { width: 100%; height: 100%; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

.avatar-status > label { position: absolute; left: 0px; top: 0px; cursor: pointer; z-index: 1; margin: 0px; }

.avatar-status > label + i > a { pointer-events: none; }

.avatar-status > label input { position: absolute; opacity: 0; visibility: hidden; }

.avatar-status > label i { color: rgb(255, 255, 255); opacity: 0; background-color: rgba(76, 203, 112, 0.8); transition: opacity 0.2s; }

.avatar-status > label i i { display: block; transform: translateY(0.25rem); transition: transform 0.2s; }

.avatar-status > label input:checked ~ i { opacity: 1; }

.avatar-status > label input:checked ~ i i { transform: translateY(0px); }

.avatar-status .avatar.fit-cover { width: 100%; height: 100%; }

.avatar-status .avatar.fit-cover img[src*="noavatar.png"] { background-color: rgb(234, 234, 234); }

.comment.pos-comm { background-color: rgba(76, 203, 112, 0.1); }

.comment.pos-comm .comment-head::after { border-bottom-color: rgba(76, 203, 112, 0.12); }

.comment.pos-comm .avatar-status .avatar.fit-cover img[src*="noavatar.png"] { background-color: rgb(220, 240, 225); }

.comment.neg-comm { background-color: rgba(249, 86, 61, 0.1); }

.comment.neg-comm .comment-head::after { border-bottom-color: rgba(249, 86, 61, 0.12); }

.comment.neg-comm .avatar-status .avatar.fit-cover img[src*="noavatar.png"] { background-color: rgb(242, 210, 205); }

.comments-tree-list .comment { margin-top: 0px; }

.comments-tree-list .comments-tree-list { padding-left: 0.75rem; }

.comments-tree-list .comments-tree-list .comments-tree-item:first-child .comment { border-top-left-radius: 0px; }

.comments-tree-item { margin-top: 0.25rem; }

.comments-tree-list .comments-tree-list .comments-tree-item { margin-top: 0.25rem; }

.mass_comments_action { display: flex; font-size: 0.75rem; align-items: center; margin-top: 2rem; }

.mass_comments_action select { margin: 0px 0.5rem; }

@media (min-width: 640px) {
  .comments-tree-item { margin-top: 0.5rem; }
  .comments-tree-list .comments-tree-list { padding-left: 1.5rem; }
  .comments-tree-list .comments-tree-list .comment-head::after { display: none; }
  .comments-tree-list .comments-tree-list .comment-head { margin-bottom: 0px; }
}

.comments-tree-list .bb-editor { padding: 5px !important; }

.bb-editor textarea { height: 100px !important; margin-bottom: 4px; }

.comments-tree-list #dlefastreplycomments { padding: 18px !important; }

.group-icon img { padding: 2px; width: 28px; }

.comment-text ul { padding-left: 40px; list-style: outside disc; margin-top: 1em; margin-bottom: 1em; }

.comment-text ol { padding-left: 40px; list-style: outside decimal; margin-top: 1em; margin-bottom: 1em; }

.comment-text strong, b { font-weight: 700; }

.comment-text em, cite, i { font-style: italic; }

.comment-text caption { text-align: left; }

.comment-text th, td { vertical-align: middle; }

.comment-text small, .small { font-size: 0.9em; }

.comment-text hr { height: 0px; border-width: 2px 0px 0px; border-style: solid none none; border-color: rgb(238, 238, 239) currentcolor currentcolor; border-image: initial; box-sizing: content-box; margin: 20px 0px; }

.comment-text .clr { clear: both; }

.comment-text .clrfix::after { clear: both; content: ""; display: table; }

.comment-text .instagram-media, .twitter-tweet { display: inline-block !important; }
