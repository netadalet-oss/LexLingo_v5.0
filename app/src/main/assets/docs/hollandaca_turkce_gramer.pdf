.visual-scan.layout-square .coo-scan-square-top, .visual-scan.layout-desktop-square .coo-scan-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-scan.layout-square .coo-scan-phone, .visual-scan.layout-desktop-square .coo-scan-phone { width: 130px; height: 118px; border-radius: 12px; }

.visual-scan.layout-square .coo-scan-toast-name, .visual-scan.layout-desktop-square .coo-scan-toast-name { font-size: 5px; }

.visual-scan.layout-square .coo-scan-count-val, .visual-scan.layout-desktop-square .coo-scan-count-val { font-size: 10px; }

.visual-scan.layout-square .coo-scan-copy .coo-hook, .visual-scan.layout-desktop-square .coo-scan-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

