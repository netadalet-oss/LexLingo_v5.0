.visual-orbit { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-orbit[class*="theme-"] { background: linear-gradient(155deg, rgb(5, 8, 16) 0%, rgb(12, 18, 34) 45%, rgb(8, 13, 24) 100%) !important; color: rgb(241, 245, 249) !important; border: 1px solid rgba(56, 189, 248, 0.12) !important; }

.visual-orbit .coo-bg-orb { display: none !important; }

.visual-orbit .coo-hook { background: rgba(56, 189, 248, 0.15) !important; color: rgb(125, 211, 252) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-orbit .coo-btn { box-shadow: rgba(56, 189, 248, 0.35) 0px 4px 20px; background: rgb(56, 189, 248) !important; color: rgb(4, 47, 74) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-orbit-mesh { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 70% 30%, rgba(56, 189, 248, 0.12) 0%, transparent 45%), radial-gradient(circle at 20% 80%, rgba(16, 185, 129, 0.08) 0%, transparent 40%); }

.coo-orbit-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-orbit-phone { position: relative; border-radius: 10px; background: linear-gradient(145deg, rgb(30, 41, 59), rgb(15, 23, 42)); border: 1.5px solid rgba(255, 255, 255, 0.12); box-shadow: rgba(0, 0, 0, 0.45) 0px 8px 24px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset; display: flex; align-items: center; justify-content: center; overflow: hidden; }

.coo-orbit-phone-notch { position: absolute; top: 3px; left: 50%; transform: translateX(-50%); width: 24%; height: 3px; border-radius: 99px; background: rgb(2, 6, 23); z-index: 2; }

.coo-orbit-rings { position: relative; display: flex; align-items: center; justify-content: center; }

.coo-orbit-ring-svg { display: block; transform: rotate(-90deg); }

.coo-orbit-ring-bg { fill: none; stroke: rgba(255, 255, 255, 0.08); stroke-width: 3; }

.coo-orbit-ring-fg { fill: none; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; }

.coo-orbit-ring-income { stroke: rgb(16, 185, 129); animation: coo-orbit-ring-income var(--orbit-dur, 6s) ease-in-out infinite; }

.coo-orbit-ring-expense { stroke: rgb(249, 115, 22); animation: coo-orbit-ring-expense var(--orbit-dur, 6s) ease-in-out infinite; }

.coo-orbit-ring-stock { stroke: rgb(56, 189, 248); animation: coo-orbit-ring-stock var(--orbit-dur, 6s) ease-in-out infinite; }

@keyframes coo-orbit-ring-income { 
  0%, 8% { stroke-dashoffset: 100; }
  35%, 85% { stroke-dashoffset: 22; }
  95%, 100% { stroke-dashoffset: 100; }
}

@keyframes coo-orbit-ring-expense { 
  0%, 12% { stroke-dashoffset: 100; }
  40%, 85% { stroke-dashoffset: 45; }
  95%, 100% { stroke-dashoffset: 100; }
}

@keyframes coo-orbit-ring-stock { 
  0%, 16% { stroke-dashoffset: 100; }
  45%, 85% { stroke-dashoffset: 30; }
  95%, 100% { stroke-dashoffset: 100; }
}

.coo-orbit-core { position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; z-index: 1; }

.coo-orbit-value { font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: rgb(255, 255, 255); animation: 2.4s ease-in-out 0s infinite normal none running coo-orbit-value-pulse; }

@keyframes coo-orbit-value-pulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.82; transform: scale(1.03); }
}

.coo-orbit-value-sub { font-size: 5px; font-weight: 700; color: rgba(255, 255, 255, 0.45); margin-top: 1px; text-transform: uppercase; letter-spacing: 0.06em; }

.coo-orbit-legend { display: flex; flex-wrap: wrap; gap: 4px; justify-content: center; }

.coo-orbit-leg { display: inline-flex; align-items: center; gap: 3px; font-size: 5px; font-weight: 700; color: rgba(255, 255, 255, 0.65); }

.coo-orbit-leg-dot { width: 4px; height: 4px; border-radius: 50%; flex-shrink: 0; }

.coo-orbit-leg-income { background: rgb(16, 185, 129); }

.coo-orbit-leg-expense { background: rgb(249, 115, 22); }

.coo-orbit-leg-stock { background: rgb(56, 189, 248); }

.coo-orbit-live { position: absolute; top: 4px; right: 4px; z-index: 3; display: inline-flex; align-items: center; gap: 2px; font-size: 5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: rgb(110, 231, 183); padding: 2px 4px; border-radius: 99px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); }

.coo-orbit-live-dot { width: 4px; height: 4px; border-radius: 50%; background: rgb(34, 197, 94); animation: 1.4s ease-in-out 0s infinite normal none running coo-orbit-live-blink; }

@keyframes coo-orbit-live-blink { 
