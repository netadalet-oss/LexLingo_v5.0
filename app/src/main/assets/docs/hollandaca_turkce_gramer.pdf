@charset "utf-8";

.coo-banner-slot { display: block; margin: 12px auto; max-width: 100%; box-sizing: border-box; overflow: hidden; padding: 0px; border-radius: 12px; }

.coo-banner-slot { width: 728px; height: 90px; min-height: 90px; max-height: 90px; }

.coo-banner-slot > a { display: block; width: 100%; height: 100%; min-height: 90px; box-sizing: border-box; }

.coo-banner-slot > a, .coo-banner-slot > a:hover, .coo-banner-slot > a:visited { text-decoration: none !important; border-bottom-width: medium !important; border-bottom-style: none !important; border-bottom-color: currentcolor !important; }

#coo-ad.coo-banner-slot { width: 728px; height: 90px; min-height: 90px; max-height: 90px; }

@media (max-width: 480px) {
  .coo-banner-slot, #coo-ad.coo-banner-slot { width: 100%; max-width: 320px; height: 120px; min-height: 120px; max-height: 120px; }
  .coo-banner-slot > a, #coo-ad.coo-banner-slot > a { min-height: 120px; }
}

@media (min-width: 481px) and (max-width: 960px) {
  .coo-banner-slot, #coo-ad.coo-banner-slot { width: 100%; max-width: 300px; height: 250px; min-height: 250px; max-height: 250px; }
  .coo-banner-slot > a, #coo-ad.coo-banner-slot > a { min-height: 250px; }
}
