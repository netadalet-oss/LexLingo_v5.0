@charset "utf-8";

.download-notifications { position: fixed; top: 20px; right: 20px; z-index: 10000; max-width: 420px; width: 100%; pointer-events: none; }

.download-notification { background: var(--modal-bg, #fff); border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.15) 0px 8px 32px; margin-bottom: 12px; padding: 16px; border-left: 4px solid var(--lcolor, #4CCB70); transform: translateX(120%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s, box-shadow 0.3s; opacity: 0; pointer-events: auto; position: relative; overflow: hidden; }

.download-notification::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 3px; background: var(--lcolor, #4CCB70); transform: scaleX(0); transform-origin: left center; transition: transform 0.3s; }

.download-notification.show { transform: translateX(0px); opacity: 1; }

.download-notification.show::before { transform: scaleX(1); }

.download-notification.success { border-left-color: var(--lcolor, #4CCB70); }

.download-notification.success::before { background: var(--lcolor, #4CCB70); }

.download-notification.error { border-left-color: rgb(249, 86, 61); }

.download-notification.error::before { background: rgb(249, 86, 61); }

.download-notification.warning { border-left-color: rgb(254, 222, 74); }

.download-notification.warning::before { background: rgb(254, 222, 74); }

.download-notification.info { border-left-color: rgb(54, 139, 225); }

.download-notification.info::before { background: rgb(54, 139, 225); }

.notification-content { display: flex; align-items: flex-start; gap: 12px; }

.notification-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; background: var(--lcolor, #4CCB70); color: rgb(255, 255, 255); }

.download-notification.success .notification-icon { background: var(--lcolor, #4CCB70); }

.download-notification.error .notification-icon { background: rgb(249, 86, 61); }

.download-notification.warning .notification-icon { background: rgb(254, 222, 74); color: var(--tcolor, #172B3D); }

.download-notification.info .notification-icon { background: rgb(54, 139, 225); }

.notification-text { flex: 1 1 0%; min-width: 0px; }

.notification-title { font-weight: 700; font-size: 14px; margin-bottom: 4px; color: var(--tcolor, #172B3D); line-height: 1.3; }

.notification-message { font-size: 13px; color: var(--entry-info, #8B959E); line-height: 1.4; overflow-wrap: break-word; }

.notification-progress { margin-top: 8px; height: 4px; background: var(--line, #EBECED); border-radius: 2px; overflow: hidden; }

.notification-progress-bar { height: 100%; background: var(--lcolor, #4CCB70); border-radius: 2px; transition: width 0.3s; width: 0%; }

.notification-close { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; font-size: 18px; color: var(--entry-info, #8B959E); cursor: pointer; padding: 4px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 6px; transition: background 0.2s, color 0.2s; flex-shrink: 0; margin-top: -4px; margin-right: -4px; }

.notification-close:hover { background: var(--spoiler, #f7f7f7); color: var(--tcolor, #172B3D); }

@media (max-width: 768px) {
  .download-notifications { top: 10px; right: 10px; left: 10px; max-width: none; }
  .download-notification { padding: 14px; }
  .notification-icon { width: 36px; height: 36px; font-size: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  .download-notification { transition: opacity 0.2s; }
}
