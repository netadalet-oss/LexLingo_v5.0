.visual-clock.layout-compact .coo-clock-compact-top, .visual-clock.layout-mobile .coo-clock-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

