.rating_progress_bar { text-align: center; background-color: rgb(249, 86, 61); font-size: 0.6875rem; text-transform: uppercase; line-height: 1rem; padding: 0.25rem; border-radius: 7px; position: relative; z-index: 0; }

.rating_progress_bar > span { background-color: var(--lcolor); position: absolute; left: 0px; top: 0px; border-radius: 7px; height: 100%; text-indent: 9999px; white-space: nowrap; overflow: hidden; z-index: -1; box-shadow: rgba(74, 201, 110, 0.3) 0px 0px 0.5rem 0px; }

.view-app-data .btn-group { margin-top: 1.5rem; width: 100%; }

.view-app-rate .ya-share2 { margin-top: 1.5rem; height: 1.5rem; }

@media (min-width: 860px) {
  .ya-share2::before { content: attr(title); font-size: 0.75rem; opacity: 0.5; display: block; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem; }
}

.view-app-head .b-screens { margin-top: 3.5rem; }

.app-video-img { position: relative; }

.app-video-img .cover { display: block; position: relative; border-radius: 0.5rem; box-shadow: rgba(0, 0, 0, 0.25) 0px 0.5rem 1rem 0px; background-color: rgb(39, 61, 82); max-height: 100%; }

.app-video-img .cover img { display: block; margin: 0px auto; opacity: 0; visibility: hidden; }

.video_btn { position: absolute; left: 50%; top: 50%; z-index: 1; margin: -1rem 0px 0px -1rem; border: 0px; background: 0px 0px rgba(0, 0, 0, 0.4); padding: 0.25rem; width: 2rem; height: 2rem; border-radius: 50%; color: rgb(255, 255, 255); }

.video_btn svg { display: block; }

@media (max-width: 639px) {
  .view-app-head .b-screens { border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; }
}

@media (max-width: 991px) {
  .b-screens .b-icon-title + .b-cont { margin-top: -1rem; }
  .b-screens .b-cont { padding: 0px 0px 0.5rem; overflow: hidden; }
  .screenshots { margin: -1.5rem 0px; padding: 1.5rem 1rem; white-space: nowrap; text-align: center; overflow: auto hidden; }
  .screenshots > a, .app-video { display: inline-block; vertical-align: top; padding: 1rem 0.5rem; }
  .screenshots > a img { border-radius: 0.5rem; box-shadow: rgba(0, 0, 0, 0.25) 0px 0.5rem 1rem 0px; }
  .app-video-img .cover img, .screenshots > a img { height: 12rem; }
}

@media (min-width: 992px) {
  .screenshots { display: flex; justify-content: center; padding-bottom: 2.75rem; }
  .screenshots > a, .app-video { width: 100%; max-width: 25%; flex: 0 0 25%; position: relative; padding: 1.5rem; z-index: 0; text-align: center; }
  .screenshots > * { display: none; }
  .screenshots > :nth-child(-n+4) { display: block; }
  .screenshots > a::after, .app-video::after { content: ""; display: block; width: 100%; padding-top: 88%; border-radius: 50%; z-index: -1; }
  .screenshots > a::before, .app-video::before { content: ""; position: absolute; left: 50%; top: 100%; opacity: 0.3; margin-top: 0.75rem; margin-left: -0.75rem; width: 1.5rem; padding-top: 1.5rem; z-index: -1; background-size: 100% 100%; }
  .screenshots > a img { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); border-radius: 0.5rem; display: block; width: auto; height: auto; margin: 0px auto; box-shadow: rgba(0, 0, 0, 0.25) 0px 0.5rem 1rem 0px; transition: margin-top 0.2s; max-width: calc(100% - 1.5rem) !important; max-height: calc(100% - 1.5rem) !important; }
  .screenshots > a:hover img { margin-top: -0.25rem; }
  .screenshots > a::before, .app-video::before { transition: opacity 0.2s; }
  .screenshots > a:hover::before, .app-video:hover::before { opacity: 0.8; }
  .app-video { cursor: pointer; }
  .app-video-img { position: absolute; left: 0px; top: 0px; bottom: 0px; width: 100%; padding: 0.75rem; display: flex; justify-content: center; align-items: center; transition: transform 0.2s; }
  .app-video-img .cover img { max-width: 100%; max-height: 12.25rem; }
  .app-video:hover .app-video-img { transform: translateY(-0.25rem); }
}

@media (min-width: 640px) {
  .view-app-head + .block-list { margin-top: -3.5rem; position: relative; z-index: 1; }
}

.link-faq { background-color: var(--spoiler); color: inherit; font-weight: 700; display: flex; align-items: center; border-radius: 0.75rem; padding: 0.75rem 1rem; line-height: 1.5rem; }

.link-faq:not(:first-child) { margin-top: 0.5rem; }

.link-faq::after { content: ""; margin-left: auto; background-color: var(--lcolor); width: 0.5rem; height: 0.5rem; border-radius: 50%; text-align: center; opacity: 0; transform: scale(0.5); }

@media (min-width: 992px) {
  .link-faq { transition: background-color 0.7s, color 0.1s; }
  .link-faq:hover { color: var(--lcolor); background-color: var(--spoiler-h); }
  .link-faq::after { transition: transform 0.3s, opacity 0.2s; }
  .link-faq:hover::after { opacity: 1; transform: scale(1); }
}

.b-nobugs { display: flex; align-items: flex-start; padding: 1.5rem; }

.b-nobugs-icon { margin-right: 0.75rem; display: flex; place-content: center; align-items: center; }

.b-nobugs-icon .c-green { width: 2.25rem; height: 2.25rem; font-size: 20px; display: flex; border-radius: 50%; background-color: rgba(76, 203, 112, 0.1); place-content: center; align-items: center; }

.b-nobugs-icon .c-green svg { display: block; }

@media (max-width: 639px) {
  .b-nobugs-icon .img { display: none; }
}

@media (min-width: 640px) {
  .b-nobugs { padding: 1.5rem 2rem; }
  .b-nobugs-icon { display: flex; align-items: center; }
  .b-nobugs-icon .img { width: 2.75rem; height: 2.75rem; }
  .b-nobugs-icon .img img { border-radius: 0.75rem; object-fit: cover; object-position: 50% 28%; }
  .b-nobugs-icon .c-green { background-color: var(--entry-label); margin-left: -0.5rem; backdrop-filter: blur(6px); }
}

.b-nobugs-text { align-self: center; font-weight: 700; font-size: 0.875rem; }

.b-nobugs-text > span { display: block; }

.b-nobugs + .b-cont { position: relative; z-index: 0; border-top: 1px solid var(--line); }

.b-nobugs + .b-cont::before { content: ""; position: absolute; left: 0.25rem; right: 0.25rem; top: 0px; height: 3.75rem; margin-top: 0.25rem; background-size: 1rem 1rem; opacity: 0.05; z-index: -1; }

.downline-line-list { margin-top: -0.5rem; }

.download-line { display: block; min-height: 3rem; padding: 1rem; border-radius: 0.75rem; margin-top: 0.5rem; transition: box-shadow 0.2s; color: rgb(255, 255, 255) !important; }

.download-line-title { display: flex; width: 100%; min-width: 0px; flex: 1 1 auto; font-weight: 700; }

.download-line-title svg { display: block; }

.download-line-size { font-size: 0.75rem; white-space: nowrap; }

@media (max-width: 575px) {
  .download-line-title > span { order: -1; line-height: 1.4; min-width: 0px; overflow-wrap: break-word; }
  .download-line-title > i { margin-left: auto; }
  .download-line-size { opacity: 0.5; }
}

@media (min-width: 576px) {
  .download-line { display: flex; border-radius: 13px; padding: 0.5rem; }
  .download-line-title { align-items: center; padding: 0px 2rem 0px 0.5rem; }
  .download-line-title > i { margin-right: 0.5rem; opacity: 0.5; }
  .download-line-title > span { white-space: nowrap; overflow: hidden; line-height: 1.5rem; text-overflow: ellipsis; }
  .download-line-size { margin-left: auto; background-color: rgba(0, 0, 0, 0.2); font-size: 0.875rem; height: 2rem; line-height: 1.5rem; padding: 0.25rem 0.75rem; border-radius: 1rem; }
}

.mod-info { display: block; font-weight: 700; font-size: 1.125rem; }

.info-line { display: flex; align-items: flex-start; font-size: 0.875rem; margin-top: 1.5rem; }

.info-line-icon { margin-right: 0.5rem; }

.info-line-icon svg { display: block; }

.info-line > span { align-self: center; line-height: 1.4rem; flex: 1 1 auto; }

.b-comments .info-line { background-color: rgba(254, 222, 74, 0.2); border-radius: 0.75rem; padding: 0.75rem; margin-top: 0px; color: var(--nocomms); }

.downline-line-list + .spoiler { margin-top: 1.5rem; }

.view-news-head .wrp-min { padding-bottom: 20rem; }

.view-news-head.dark-head { background-image: radial-gradient(closest-side, rgba(55, 121, 157, 0.2) 0px, rgba(55, 121, 157, 0) 100%); background-size: 35rem 35rem; background-position: 50% -30%; background-repeat: no-repeat; }

.view-news-head + .block-list { margin-top: -18rem; position: relative; }

.view-news-head .meta-date { background-color: rgba(255, 255, 255, 0.1); }

.b-article .img { padding-top: 56.5%; position: relative; }

.b-article .img .fit-cover { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; border-radius: 10px; border-left: 5px solid var(--block-bg); border-right: 5px solid var(--block-bg); border-top: 5px solid var(--block-bg); }

.b-article .img .fit-cover img { border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; }

.b-article > .b-cont .read-next { margin-top: 1.5rem; }

.read-next { border-radius: 0.5rem; padding: 1.25rem 1.5rem; border: 1px solid rgba(0, 0, 0, 0.1); position: relative; box-shadow: rgba(0, 0, 0, 0.05) 0px 0.25rem 1rem 0px; }

.read-next::before { content: attr(title); display: block; margin-bottom: 0.5rem; color: rgb(76, 203, 112); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }

.read-next > a { display: block; max-width: 36rem; line-height: 1.3; font-weight: 700; color: inherit; }

.read-next > a::after { content: ""; position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; }

.b-article > .b-cont .ya-share2 { margin-top: 1.5rem; }

@media (min-width: 992px) {
  .read-next { transition: transform 0.2s, box-shadow 0.2s; }
  .read-next:hover { transform: translateY(-0.25rem); box-shadow: rgba(0, 0, 0, 0.05) 0px 0.5rem 1rem 0px; }
}

@media (min-width: 640px) {
  .view-news-head .wrp-min { display: flex; align-items: flex-start; }
  .b-article > .b-cont { padding-left: 3rem; padding-right: 3rem; }
  .view-news-head.dark-head { background-size: 50rem 50rem; background-position: 30% -20%; }
  .read-next > a { font-size: 1.25rem; }
  .b-article > .b-cont .ya-share2 { margin-top: 2rem; }
}

@media (max-width: 639px) {
  .view-news-head .wrp-min { padding-left: 1.5rem; padding-right: 1.5rem; }
  .view-news-head .likes { margin-top: 1.5rem; }
  .view-news-head .likes > a { background-color: rgb(20, 38, 54); }
  .b-article > .b-cont .ya-share2 { text-align: center; }
}

.ShareButtons { margin: 0px 0px 12px; padding: 0px; width: 100%; list-style-type: none; display: flex; }

.ShareButtons svg { display: inline-block; height: 30px; margin: 4px 0px; vertical-align: top; width: 30px; fill: rgb(255, 255, 255); color: rgb(255, 255, 255); }

.ShareButtons .gp-btn svg { margin: 2px 0px; height: 34px; width: 34px; }

.ShareButtons li { height: 38px; position: relative; -webkit-box-flex: 1; flex: 1 1 0%; margin-left: 6px; }

.ShareButtons li a { height: 38px; text-align: center; cursor: pointer; border-radius: 5px; color: rgb(215, 215, 215); display: flex; align-items: center; justify-content: center; }

.ShareButtons li.fb-btn a { background: rgb(59, 89, 152); }

.ShareButtons li.tw-btn a { background: rgb(66, 164, 245); }

.ShareButtons li.mir-btn a { background: rgb(74, 118, 168); }

.ShareButtons li.gp-btn a { background: rgb(215, 67, 20); }

.ShareButtons li.pin-btn a { background: rgb(203, 32, 39); }

.ShareButtons li.ws-btn a { background: rgb(77, 194, 71); }

.ShareButtons li.print-btn a { background: rgb(149, 149, 149); }

.ShareButtons li.mail-btn a { background: rgb(172, 172, 172); }

.ShareButtons li.ws-btn a:hover { background: rgb(67, 173, 61); }

.ShareButtons li.fb-btn a:hover { background: rgb(5, 52, 92); }

.ShareButtons li.bu-btn a:hover { background: rgb(30, 60, 95); }

.ShareButtons li.tw-btn a:hover { background: rgb(54, 120, 175); }

.ShareButtons li.gp-btn a:hover { background: rgb(121, 20, 7); }

.ShareButtons li.pin-btn a:hover { background: rgb(143, 34, 23); }

.ShareButtons li.print-btn a:hover, .ShareButtons li.mail-btn a:hover { background: rgb(121, 121, 121); }

div#app_description { font-family: sans-serif; }

ol.comments-tree-list { font-family: sans-serif; }

.fullblog { font-family: sans-serif; }

.fullblog h2 { margin-bottom: 0px; }

.spec-cont svg { border-radius: 13%; margin-left: 2px; }

a.preview { display: block; padding: 10px; border-radius: 6px; margin: 8px 10px 0px; align-items: center; text-align: center; color: rgb(255, 255, 255); background-color: rgb(69, 195, 104); background-image: linear-gradient(180deg,var(--lcolor) 0%,#3DBA60 100%); box-shadow: rgb(176, 0, 0) 0px 0.25rem 0.5rem 0px; }

.block.b-download .popup_userinfo_top { background-color: rgb(69, 195, 104); background-image: linear-gradient(180deg,var(--lcolor) 0%,#3DBA60 100%); box-shadow: rgb(176, 0, 0) 0px 0.25rem 0.5rem 0px; border-radius: 13px 13px 0px 0px; }

.foto { float: left; background: rgb(251, 198, 63); border-radius: 22%; display: flex; }

.foto img { width: 70px; height: 70px; border-radius: 22%; padding: 3px; object-fit: cover; object-position: 50% 15%; }

.melumatlar { color: rgb(255, 255, 255); font-size: 17px; font-weight: 700; padding: 0px 0px 0px 85px; margin-bottom: 20px; }

.melumat2 { padding: 0px 0px 0px 85px; }

.melumat2 span { font-weight: 700; }

.madvert-detail hr { margin: 1px; background: rgb(75, 202, 111); }

.madvert-detail { margin-top: 15px; }

.madvert-price h2.title { font-size: 38px; color: rgb(75, 202, 111); font-weight: 700; }

.madvert-detail .title { margin-bottom: 7px; border-bottom: 1px solid rgb(66, 191, 101); width: max-content; }

.madvert-detail .titleprice { margin-bottom: 7px; border-bottom: 1px solid rgb(66, 191, 101); width: max-content; }

.madvert-contact { width: 100%; margin-top: 5px; }

.madvert-details { display: flex; justify-content: flex-start; }

.madvert-left { margin-right: 30px; }

.madvert-right { margin-left: 45px; }

.madvert-info { margin: 19px 0px 0px; padding: 11px; background: rgb(33, 58, 80); font-size: 15px; border-radius: 10px; }

a.btn.btn-lg.btn-icon.s-green.anchor.elanver { margin-top: 44px; }

@media only screen and (max-width: 766px) {
  .madvert-details { display: flex; justify-content: space-around; }
  .madvert-detail { padding-bottom: 18px; }
  .madvert-detail .titleprice { margin-bottom: 5px; border-bottom: 1px solid rgb(66, 191, 101); overflow-wrap: break-word; text-align: center; max-width: 32rem; margin-left: auto; margin-right: auto; }
  .madvert-detail .title { margin-bottom: 5px; border-bottom: 1px solid rgb(66, 191, 101); width: 100%; overflow-wrap: break-word; }
}

.fayl li { background-color: rgb(55, 169, 228); background-image: linear-gradient(rgb(56, 185, 230) 0%, rgb(54, 139, 225) 100%); box-shadow: rgb(140, 0, 0) 0px 0.25rem 0.5rem 0px; color: rgb(255, 255, 255); font-variant: full-width; padding: 16px; border-radius: 10px; text-align: center; margin: 6px; }

.fayl a { color: rgb(255, 255, 255); }

.form-submit .comments-image-uploader .plupload_wrapper { background-color: var(--block-bg); border: 1px solid rgb(215, 215, 215); margin: 0px 0px 8px; }

.form-submit .comments-image-uploader .plupload_droptext::before { font-family: plupload; display: block; content: "î „"; font-size: 63px; position: absolute; top: 50%; left: 50%; margin-top: 0px; color: rgb(204, 204, 204); text-indent: 0px; font-weight: 400; transform: translate(-50%, -50%); }

#comments-image-uploader_buttons { float: left; margin-left: 4px; }

.fullreklam { display: flex; justify-content: space-around; flex-wrap: wrap; }

.donate { display: block; padding: 10px 0px; }

h4.center { display: flex; flex-direction: row; align-items: center; color: rgb(255, 87, 34); }

a.donate { top: 12px; color: rgb(255, 255, 255); background: rgb(255, 87, 34); padding: 10px; border-radius: 8px; width: 200px; text-align: center; }

a.donate:hover { top: 12px; color: rgb(255, 255, 255); background: rgb(76, 175, 80); padding: 10px; border-radius: 8px; }

@media only screen and (min-width: 992px) {
  .similar-news .row { display: flex; flex-flow: row; padding: 15px 0px; }
  .similar-news .col-md-4, .similar-news .col-sm-6 { padding: 10px; display: flex; flex-direction: column; }
  .similar-news .news-item { border-radius: 5px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px; transition: box-shadow 0.3s ease-in-out; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .similar-news .news-item:hover { box-shadow: rgba(0, 0, 0, 0.16) 0px 6px 12px; }
  .similar-news .news-item img { width: 100%; height: auto; flex-grow: 1; }
  .similar-news .news-item h3 { font-size: 16px; font-weight: 700; margin: 10px; }
  .similar-news h2 { display: flex; justify-content: space-around; }
}

@media only screen and (max-width: 991px) {
  .similar-news .row { display: flex; flex-flow: column; padding: 5px; }
  .similar-news .col-md-4, .similar-news .col-sm-6 { padding: 10px; display: flex; flex-direction: column; }
  .similar-news .news-item { border-radius: 5px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px; transition: box-shadow 0.3s ease-in-out; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 5px; }
  .similar-news .news-item:hover { box-shadow: rgba(0, 0, 0, 0.16) 0px 6px 12px; }
  .similar-news .news-item img { width: 100%; height: auto; flex-grow: 1; }
  .similar-news .news-item h3 { font-size: 16px; font-weight: 700; margin: 10px; }
  .similar-news h2 { display: flex; justify-content: space-around; }
}

.upload-limit { border: 1px solid rgb(229, 229, 229); border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 10px; margin: 30px auto; }

.upload-limit__content { padding: 30px; }

.upload-limit__header { color: rgb(247, 103, 7); font-size: 24px; font-weight: 700; margin-bottom: 20px; }

.upload-limit__body { margin-bottom: 20px; }

.upload-limit__body-item { font-size: 18px; margin-bottom: 10px; }

.upload-limit__body-item--bold { font-weight: 700; }

.upload-limit__footer { text-align: center; }

.mirbtn { background-color: rgb(247, 103, 7); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 4px; color: rgb(255, 255, 255); cursor: pointer; display: inline-block; font-size: 18px; font-weight: 700; margin-top: 20px; padding: 10px 30px; text-align: center; text-decoration: none; transition: background-color 0.3s; }

.mirbtn:hover { background-color: rgb(230, 92, 0); }

.btn--primary { background-color: rgb(0, 140, 186); }

.btn--primary:hover { background-color: rgb(0, 115, 153); }

.download-btn-group { width: 94%; display: flex; justify-content: center; background: rgb(72, 198, 107); margin: 8px 10px 2px; padding: 12px; border-radius: 8px; }

.downloadinput { background: rgb(72, 198, 107); border: rgb(64, 190, 100); color: rgb(255, 255, 255); white-space: normal; }

.emoji { border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; vertical-align: middle; width: 22px; height: 22px; }

.emoji_box { width: 100%; max-width: 390px; }

.emoji_category { padding: 7px; clear: both; }

.emoji_list { margin-top: 5px; margin-bottom: 5px; width: 100%; font-family: "apple color emoji", "segoe ui emoji", notocoloremoji, "segoe ui symbol", "android emoji", emojisymbols; font-size: 2em; }

.emoji_symbol { float: left; margin-bottom: 10px; width: 12.5%; text-align: center; }

.emoji_symbol a, .emoji_symbol a:hover { cursor: pointer; text-decoration: none; }

.native-emoji { font-size: 1.3em; font-family: "apple color emoji", "segoe ui emoji", notocoloremoji, "segoe ui symbol", "android emoji", emojisymbols; }

.infom { padding: 16px 20px; background: var(--entry-bg); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 3px solid var(--lcolor); border-radius: 6px; margin-bottom: 20px; font-family: var(--font); font-size: 14px; line-height: 1.5; color: var(--tcolor); transition: 0.15s; }

.infom:hover { background: var(--spoiler-h); border-left-color: var(--lhcolor); }

.infom .info-line-icon { color: var(--lcolor); margin-right: 12px; font-size: 16px; opacity: 0.8; vertical-align: top; }

.infom span { color: var(--tcolor); display: inline-block; vertical-align: top; line-height: 1.5; }

.black_button * { box-sizing: border-box; }

.black_button ::before, .black_button ::after { box-sizing: border-box; }

.black_button { height: 61px; width: 265px; border-width: 1px; border-style: solid; border-color: rgb(75, 75, 75) rgb(9, 9, 9) rgb(9, 9, 9); border-radius: 99px; background: linear-gradient(rgb(49, 49, 49) 0%, rgb(36, 36, 36) 100%); box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 4px; cursor: pointer; transition: 0.2s; margin: 0px auto; }

.black_button:hover { box-shadow: rgba(0, 0, 0, 0.4) 0px 2px 6px; transition: 0.2s; }

.black_button_one { color: rgb(131, 131, 131); font-family: "roboto condensed", sans-serif; font-size: 18px; height: 60px; line-height: 60px; text-shadow: rgba(0, 0, 0, 0.6) 0px 1px 2px; width: 200px; margin: 0px auto; background: url("../img/download.png") right center no-repeat; }

.left_button span { font-size: 13px; }

.black_button_progress { width: 200px; margin: 0px auto; color: rgb(131, 131, 131); font-family: "roboto condensed", sans-serif; text-shadow: rgba(0, 0, 0, 0.6) 0px 1px 2px; display: none; }

.right_button { font-size: 24px; float: left; width: 60px; text-align: right; height: 60px; line-height: 60px; }

.left_button { float: left; width: 140px; padding: 8px 0px 0px; }

.progress_bar { background: rgb(34, 34, 34); border-bottom: 1px solid rgb(57, 57, 57); height: 10px; border-radius: 99px; box-shadow: rgba(0, 0, 0, 0.5) 0px 1px 2px inset; padding: 2px 0px 0px; margin: 7px 0px 0px; }

.progress_line { background: linear-gradient(to right, rgb(44, 76, 127) 0%, rgb(201, 92, 198) 50%, rgb(247, 180, 1) 100%); height: 5px; margin: 0px 2px; border-radius: 99px; position: relative; max-width: 136px; width: 0px; }

.progress_line div { position: absolute; height: 1px; background: rgb(255, 255, 255); border-radius: 99px; opacity: 0.4; left: 1px; right: 1px; }

@keyframes loading { 
  0% { opacity: 0.4; }
  50% { opacity: 0.7; }
  100% { opacity: 0.4; }
}

.counter #load { animation: 3s linear 0s infinite normal none running load-rotate; }

@keyframes load-rotate { 
  100% { transform: rotate(360deg); }
}

.counter { position: relative; width: 5rem; height: 5rem; display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto; }

.number-wrapper { position: absolute; left: 50%; top: 50%; margin: -2rem 0px 0px -2rem; width: 4rem; height: 4rem; border-radius: 50%; border-width: 0.25rem; border-style: solid; border-color: rgb(254, 222, 74) rgb(76, 203, 112) rgb(76, 203, 112) rgb(254, 222, 74); border-image: initial; }

.number { color: rgb(76, 203, 112); font-size: 2rem; font-weight: 700; }

.mdestek { padding: 11px; }

.vip-zone { width: 100%; padding: 9px; background: rgb(68, 194, 104); border-radius: 8px; color: rgb(255, 255, 255); }

.vip-zone a { color: rgb(255, 255, 255); }

.dlepl .plyr--audio .plyr__controls { display: flex; align-items: center; justify-content: space-between; padding: 20px; border-radius: 8px 8px 0px 0px; width: 100%; color: var(--tcolor) !important; }

.sesli { display: flex; justify-content: center; margin-bottom: 24px; }

.dleplyrplayer { max-width: none !important; width: 100%; }

li.dlepl__item.dlepl__item--active { height: 45px; display: flex; align-items: center; font-weight: 500; font-size: small; background: var(--lhcolor) !important; color: rgb(255, 255, 255) !important; }

li.dlepl__item:not(.dlepl__item--active) { height: 45px; border-radius: 5px; display: flex; align-items: center; font-weight: 500; font-size: small; background: var(--bgcolor) !important; color: var(--tcolor) !important; }

ul.dlepl__playlist { border-radius: 0px 0px 8px 8px; background: var(--bgcolor) !important; color: var(--tcolor) !important; }

.plyr--full-ui input[type="range"] { color: var(--lhcolor) !important; }

.gray-theme.fr-toolbar { background: var(--bgcolor) !important; }

.gray-theme.fr-toolbar .fr-command.fr-btn, .gray-theme.fr-popup .fr-command.fr-btn { color: var(--tcolor) !important; }

.gray-theme.fr-box.fr-basic .fr-wrapper { background: var(--bgcolor) !important; }

.fr-view, .fr-popup { background: var(--bgcolor) !important; color: var(--tcolor) !important; }

.gray-theme.fr-box .fr-counter { background: var(--bgcolor) !important; color: var(--tcolor) !important; border-top: var(--tcolor) !important; border-left: var(--tcolor) !important; }

.social-media-modern { margin: 24px 0px; font-family: var(--font); }

.social-title { display: flex; align-items: center; margin-bottom: 20px; font-size: 14px; font-weight: 400; color: var(--entry-info); gap: 6px; text-transform: uppercase; letter-spacing: 0.5px; }

.social-title i { color: var(--entry-info); font-size: 14px; opacity: 0.7; }

.social-grid { display: flex; flex-direction: column; gap: 12px; }

.social-btn { display: flex; align-items: center; padding: 16px 20px; border-radius: 6px; text-decoration: none; font-weight: 400; font-size: 14px; transition: 0.15s; background: var(--entry-bg); color: var(--tcolor); border: 1px solid var(--entry-info-sep); }

.social-btn:hover { background: var(--spoiler-h); border-color: var(--entry-info-sep); }

.whatsapp-btn.featured { padding: 18px 20px; margin-bottom: 12px; justify-content: space-between; background: var(--entry-bg); border: 1px solid rgba(76, 203, 112, 0.2); }

.whatsapp-btn.featured:hover { background: rgba(76, 203, 112, 0.03); border-color: rgba(76, 203, 112, 0.3); }

.whatsapp-btn .social-icon { width: 36px; height: 36px; background: var(--lcolor); color: rgb(255, 255, 255); border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-right: 16px; }

.whatsapp-btn .social-icon i { font-size: 16px; }

.whatsapp-btn .social-content { flex: 1 1 0%; display: flex; flex-direction: column; align-items: flex-start; }

.whatsapp-btn .social-name { font-size: 15px; font-weight: 500; margin-bottom: 4px; color: var(--tcolor); }

.whatsapp-btn .social-desc { font-size: 12px; color: var(--entry-info); line-height: 1.3; }

.whatsapp-btn .social-arrow { color: var(--entry-info); opacity: 0.6; transition: opacity 0.15s; }

.whatsapp-btn:hover .social-arrow { opacity: 1; color: var(--lcolor); }

.social-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }

.social-row .social-btn { flex-direction: column; text-align: center; padding: 18px 12px; gap: 8px; }

.social-row .social-icon { width: 36px; height: 36px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: rgb(255, 255, 255); margin-bottom: 6px; opacity: 0.9; }

.social-row .social-btn:hover .social-icon { opacity: 1; }

.social-row .social-icon i { font-size: 16px; }

.social-row .social-name { font-size: 12px; font-weight: 400; color: var(--entry-info); }

.social-row .social-btn:hover .social-name { color: var(--tcolor); }

.telegram-btn .social-icon { background: rgb(90, 159, 212); }

.instagram-btn .social-icon { background: rgb(193, 53, 132); }

.twitter-btn .social-icon { background: rgb(74, 158, 234); }

@media (max-width: 768px) {
  .social-media-modern { margin: 20px 0px; }
  .social-title { margin-bottom: 16px; font-size: 13px; }
  .whatsapp-btn.featured { padding: 16px 18px; }
  .whatsapp-btn .social-icon { width: 32px; height: 32px; margin-right: 14px; }
  .whatsapp-btn .social-icon i { font-size: 15px; }
  .social-row .social-btn { padding: 16px 10px; }
  .social-row .social-icon { width: 32px; height: 32px; }
  .social-row .social-icon i { font-size: 14px; }
  .infom { padding: 14px 18px; }
}

@media (max-width: 576px) {
  .social-media-modern { margin: 16px 0px; }
  .social-grid { gap: 10px; }
  .social-row { grid-template-columns: 1fr; gap: 8px; }
  .social-row .social-btn { flex-direction: row; text-align: left; padding: 12px 16px; gap: 10px; }
  .social-row .social-icon { margin-bottom: 0px; width: 28px; height: 28px; flex-shrink: 0; }
  .social-row .social-icon i { font-size: 12px; }
  .social-row .social-name { font-size: 12px; }
  .whatsapp-btn .social-desc { display: none; }
  .whatsapp-btn.featured { padding: 14px 16px; }
  .whatsapp-btn .social-icon { width: 28px; height: 28px; margin-right: 12px; }
  .whatsapp-btn .social-icon i { font-size: 13px; }
  .infom { padding: 12px 16px; font-size: 13px; display: flex; align-items: flex-start; gap: 10px; }
  .infom .info-line-icon { font-size: 16px; margin-right: 0px; flex-shrink: 0; margin-top: 1px; }
  .infom span { flex: 1 1 0%; line-height: 1.4; }
}

.sleep-timer { display: flex; align-items: center; justify-content: space-between; background-color: var(--bgcolor); font-family: var(--font); color: var(--tcolor); padding: 10px; width: 100%; box-sizing: border-box; gap: 8px; margin-bottom: 8px; border-radius: 8px; }

.sleep-timer .timer-label { font-weight: 600; font-size: 0.9em; color: var(--tcolor); opacity: 0.8; flex-shrink: 0; }

.sleep-timer #time-remaining { font-size: 1.5em; font-weight: 700; color: var(--lcolor); margin: 0px 10px; flex-grow: 1; text-align: center; }

.sleep-timer button { background-color: var(--lcolor); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; padding: 8px 12px; cursor: pointer; transition: 0.3s; font-size: 0.9em; flex-shrink: 0; outline: none; }

.sleep-timer button:hover { background-color: var(--lhcolor); }

.sleep-timer button:active { transform: scale(0.95); }

@media (max-width: 480px) {
  .sleep-timer { flex-direction: column; width: 100%; padding: 15px 10px; }
  .sleep-timer .timer-label, .sleep-timer #time-remaining, .sleep-timer button { width: 100%; text-align: center; margin: 5px 0px; }
  .sleep-timer button { padding: 12px; }
}

table { width: 100%; border-collapse: collapse; }

table, th, td { border: 1px solid rgb(204, 204, 204); }

th, td { padding: 8px 10px; text-align: left; }

th { font-weight: 600; }

.table-strong-border, .table-strong-border th, .table-strong-border td { border: 2px solid rgb(187, 187, 187); }

table, th, td { border: 1px solid rgb(204, 204, 204) !important; border-collapse: collapse !important; }

html { scroll-behavior: smooth; }

@media (prefers-reduced-motion: no-preference) {
  * { scroll-behavior: smooth; }
}

.view-app { -webkit-tap-highlight-color: rgba(76, 203, 112, 0.1); touch-action: pan-y; }

.view-app a, .view-app button { -webkit-tap-highlight-color: rgba(76, 203, 112, 0.15); }

.view-app-data .btn-group > .btn { min-height: 44px; min-width: 44px; padding: 0.875rem 1.25rem; font-size: 0.9375rem; line-height: 1.5; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1); -webkit-tap-highlight-color: transparent; }

.view-app-data .btn-group > .btn:active { transform: scale(0.97); transition: transform 0.1s; }

@media (max-width: 639px) {
  .view-app-data .btn-group > .btn { width: 100%; min-height: 48px; padding: 1rem 1.5rem; font-size: 1rem; margin-top: 0.75rem; border-radius: 0.75rem; box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px; }
}

@media (max-width: 639px) {
  .view-app-head .wrp-min { padding-top: 1.5rem; padding-bottom: 2rem; }
  .view-app-img { margin-bottom: 1.5rem; }
  .view-app-data { margin-top: 1rem; }
  .view-app-head .title { font-size: 1.375rem; line-height: 1.4; margin-bottom: 1rem; padding: 0px 1rem; }
}

.view-app-img .img { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform; }

.view-app-img .img:active { transform: scale(0.98); }

@media (max-width: 639px) {
  .view-app-img .img { max-width: 140px; width: 140px; margin: 0px auto; }
}

@media (max-width: 639px) {
  .specs-list ul > li { padding: 0.875rem 1rem; min-height: 48px; gap: 0.75rem; }
  .spec-icon { min-width: 1.5rem; max-width: 1.5rem; font-size: 1.125rem; }
}

.b-download .b-nobugs { padding: 1.25rem 1rem; }

@media (max-width: 639px) {
  .b-download .b-nobugs { padding: 1rem; text-align: center; gap: 0.75rem; }
  .b-nobugs-icon { margin-right: 0px; margin-bottom: 0.5rem; }
  .b-nobugs-text { font-size: 0.9375rem; }
}

.download-line { min-height: 48px; padding: 0.875rem 1rem; border-radius: 0.75rem; transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1); -webkit-tap-highlight-color: transparent; }

.download-line:active { transform: scale(0.98); box-shadow: rgba(0, 0, 0, 0.2) 0px 1px 4px; }

@media (max-width: 575px) {
  .download-line { min-height: 52px; padding: 1rem; }
}

#app_description { line-height: 1.7; }

@media (max-width: 639px) {
  #app_description { font-size: 0.9375rem; line-height: 1.75; }
}

.view-app-rate .likes > a { min-height: 48px; padding: 0.875rem 1rem; border-radius: 0.75rem; transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1); }

.view-app-rate .likes > a:active { transform: scale(0.95); }

@media (max-width: 639px) {
  .view-app-rate .likes > a { min-height: 52px; padding: 1rem; }
}

@media (max-width: 991px) {
  .screenshots { padding: 1.25rem 1rem; gap: 0.75rem; }
  .screenshots > a img { height: 10rem; border-radius: 0.625rem; }
}

.info-line { padding: 1rem; border-radius: 0.75rem; min-height: 48px; display: flex; align-items: center; gap: 0.75rem; }

@media (max-width: 639px) {
  .info-line { padding: 0.875rem; font-size: 0.875rem; min-height: 44px; }
}

.b-comments .b-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem; }

.view-app, .block-list { overscroll-behavior-y: contain; }

.view-app a:focus-visible, .view-app button:focus-visible { outline: 2px solid var(--lcolor); outline-offset: 2px; border-radius: 0.25rem; }

.view-app-img .img img { will-change: transform; transform: translateZ(0px); }

.view-app-data .btn-group > .btn { will-change: transform; }

.view-app-head .title { font-weight: 700; line-height: 1.3; }

#app_description h2 { font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 1rem; line-height: 1.4; }

#app_description h3 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem; line-height: 1.4; }

@media (max-width: 639px) {
  #app_description h2 { font-size: 1.25rem; margin-top: 1.5rem; margin-bottom: 0.875rem; }
  #app_description h3 { font-size: 1.125rem; margin-top: 1.25rem; margin-bottom: 0.625rem; }
}

.view-app[itemscope] { position: relative; }

@media (max-width: 639px) {
  .view-app-main { flex-direction: column; gap: 1.5rem; }
  .view-app-img { order: -1; }
}

.section-related { margin-top: 2rem; }

@media (max-width: 639px) {
  .section-related { margin-top: 1.5rem; }
}

.b-tabs-wrapper { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--line); flex-wrap: wrap; }

.b-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; flex: 1 1 0%; min-width: 0px; }

.b-tabs .tab-item { min-height: 44px; padding: 0.75rem 1rem; display: inline-flex; align-items: center; justify-content: center; transition: 0.2s; color: var(--entry-info); text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; position: relative; font-weight: 500; cursor: pointer; -webkit-tap-highlight-color: transparent; }

.b-tabs .tab-item:hover { color: var(--tcolor); border-bottom-color: var(--lcolor); opacity: 0.8; }

.b-tabs .tab-item.active { color: var(--lcolor); border-bottom-color: var(--lcolor); font-weight: 600; }

.b-tabs .tab-item:active { transform: scale(0.98); }

.tab-pane { display: none; animation: 0.3s ease-in-out 0s 1 normal none running fadeIn; }

.tab-pane.active { display: block; }

@keyframes fadeIn { 
  0% { opacity: 0; transform: translateY(5px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (max-width: 639px) {
  .b-tabs-wrapper { flex-direction: column; align-items: stretch; gap: 0.75rem; }
  .b-tabs .tab-item { min-height: 48px; padding: 0.875rem 1.25rem; font-size: 0.9375rem; flex: 1 1 0%; min-width: 0px; text-align: center; }
  .b-tabs { overflow-x: auto; gap: 0.25rem; }
}

.extra-content { line-height: 1.7; color: var(--tcolor); }

@media (max-width: 639px) {
  .edit-btn-wrapper { width: 100%; margin-left: 0px; margin-top: 0.5rem; }
  .edit-btn { width: 100%; min-height: 48px; padding: 1rem; font-size: 0.9375rem; justify-content: center; }
}

.view-app-img .img img { aspect-ratio: 150 / 230; object-fit: cover; background: var(--block-bg); }

.view-app-data .specs-item { transition: 0.2s; border-radius: 0.5rem; padding: 0.5rem 0px; }

.view-app-data .specs-item:active { transform: scale(0.98); background-color: rgba(76, 203, 112, 0.05); }

@media (max-width: 639px) {
  .view-app-data .specs-item { padding: 0.75rem 0.875rem; min-height: 52px; gap: 0.75rem; margin-bottom: 0.25rem; border-radius: 0.625rem; }
}

.spec-icon { transition: transform 0.2s; display: flex; align-items: center; justify-content: center; }

@media (max-width: 639px) {
  .spec-icon { min-width: 1.75rem; max-width: 1.75rem; font-size: 1.25rem; padding: 0.375rem; border-radius: 0.5rem; background: rgba(76, 203, 112, 0.1); }
}

.specs-item:active .spec-icon { transform: scale(1.1); }

.spec-label { transition: color 0.2s; }

@media (max-width: 639px) {
  .spec-label { font-size: 0.875rem; font-weight: 600; margin-right: 0.75rem; flex-shrink: 0; }
}

.spec-cont { transition: color 0.2s; }

@media (max-width: 639px) {
  .spec-cont { font-size: 0.9375rem; line-height: 1.5; word-break: break-word; }
}

.spec-cont img { transition: 0.2s; border-radius: 0.375rem; box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 3px; }

@media (max-width: 639px) {
  .spec-cont img { width: 28px; height: 28px; margin: 0px 0.25rem; padding: 0.125rem; }
}

.spec-cont a:active img { transform: scale(1.15); box-shadow: rgba(76, 203, 112, 0.3) 0px 2px 6px; }

.view-app-rate { margin-top: 1.5rem; }

@media (max-width: 639px) {
  .view-app-rate { margin-top: 1.25rem; padding: 1rem; background: var(--entry-bg); border-radius: 0.75rem; border: 1px solid var(--entry-info-sep); }
}

.likes > a { transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1); -webkit-tap-highlight-color: transparent; }

.likes > a:active { transform: scale(0.95); }

@media (max-width: 639px) {
  .likes > a { min-height: 52px; padding: 1rem; border-radius: 0.75rem; gap: 0.5rem; }
}

.rate-nums { display: flex; gap: 1rem; justify-content: center; }

@media (max-width: 639px) {
  .rate-nums { flex-direction: column; gap: 0.5rem; padding: 0.75rem 0px; font-size: 0.875rem; }
}

.rate-nums li { transition: opacity 0.2s; }

@media (max-width: 639px) {
  .rate-nums li { padding: 0.5rem; text-align: center; background: rgba(76, 203, 112, 0.05); border-radius: 0.5rem; }
}

.rating_progress_bar { transition: 0.2s; }

@media (max-width: 639px) {
  .rating_progress_bar { padding: 0.5rem; border-radius: 0.625rem; font-size: 0.75rem; min-height: 2.5rem; display: flex; align-items: center; justify-content: center; }
}

.rating_progress_bar > span { transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }

.view-app-data .btn-group { gap: 0.75rem; display: flex; flex-wrap: wrap; }

@media (max-width: 639px) {
  .view-app-data .btn-group { gap: 0.625rem; margin-top: 1.25rem; }
}

.view-app-data { position: relative; }

@media (max-width: 639px) {
  .view-app-data { padding: 0.5rem 0px; }
}

.view-app-data * { transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }

.social-wrapper { padding: 0rem 1rem 1rem; margin: 0px; }

@media (min-width: 640px) {
  .social-wrapper { }
}

@media (min-width: 768px) {
  .social-wrapper { }
}

@media (min-width: 992px) {
  .social-wrapper { }
}

.social-wrapper .info-line { margin-bottom: 1rem; background: var(--entry-bg); border: 1px solid var(--entry-info-sep); }

@media (min-width: 640px) {
  .social-wrapper .info-line { }
}

@media (min-width: 768px) {
  .social-wrapper .info-line { }
}

.social-media-compact { margin: 0px; padding: 0px; }

.social-list { display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex-wrap: wrap; }

@media (min-width: 640px) {
  .social-list { gap: 0.625rem; }
}

@media (min-width: 768px) {
  .social-list { gap: 0.75rem; }
}

.social-item { display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: var(--entry-bg); border: 1px solid var(--entry-info-sep); color: var(--tcolor); text-decoration: none; transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1); -webkit-tap-highlight-color: transparent; position: relative; flex-shrink: 0; }

.social-item i { font-size: 1.125rem; color: var(--tcolor); transition: 0.2s; }

.social-item:hover { text-decoration: none; border-color: var(--lcolor); background: var(--spoiler-h); color: var(--lcolor); transform: translateY(-2px); box-shadow: rgba(76, 203, 112, 0.15) 0px 2px 6px; }

.social-item:hover i { color: var(--lcolor); transform: scale(1.1); }

.social-item:active { transform: translateY(0px) scale(0.95); box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 3px; background: var(--spoiler-h); border-color: var(--lcolor); }

.social-item:active i { color: var(--lcolor); }

@media (min-width: 640px) and (max-width: 991px) {
  .social-item { width: 2.75rem; height: 2.75rem; border-radius: 0.5625rem; }
  .social-item i { font-size: 1.1875rem; }
}

@media (min-width: 992px) {
  .social-item { width: 2.5rem; height: 2.5rem; }
  .social-item i { font-size: 1.125rem; }
}

@media (max-width: 639px) {
  .social-list { gap: 0.625rem; }
  .social-item { width: 3rem; height: 3rem; border-radius: 0.625rem; min-height: 48px; }
  .social-item i { font-size: 1.25rem; }
}

.social-item:focus-visible { outline: 2px solid var(--lcolor); outline-offset: 2px; border-radius: 0.5rem; }

.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; padding: 0px 5px; }

.section-title { font-size: 1.15rem; font-weight: 700; color: var(--tcolor); letter-spacing: -0.02em; }

.content-flow { display: flex; flex-direction: column; gap: 12px; }

.content-card { border: 1px solid var(--form-control-brd); border-radius: 0.5rem; padding: 6px 12px; display: flex; align-items: center; gap: 7px; text-decoration: none; transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1); position: relative; }

.content-card:hover { transform: translateY(-2px); border-color: var(--lcolor); box-shadow: rgba(0, 0, 0, 0.08) 0px 8px 24px; }

.card-visual { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0; background-color: var(--bgcolor); transition: 0.3s; }

.card-body { flex-grow: 1; display: flex; flex-direction: column; gap: 5px; }

.card-tag { font-size: 10px; font-weight: 700; letter-spacing: 0.05em; padding: 3px 10px; border-radius: 4px; width: fit-content; transition: background 0.3s; }

.card-title { color: var(--tcolor); }

.card-meta { font-size: 0.75rem; color: var(--entry-info); font-weight: 500; }

.tag-quiz { background-color: rgba(113, 38, 193, 0.12); color: var(--menu-hover-apps); }

.tag-blog { background-color: rgba(54, 139, 225, 0.12); color: var(--menu-hover-news); }

.tag-list { background-color: rgba(230, 126, 34, 0.12); color: var(--menu-hover-games); }

.visual-quiz { color: var(--menu-hover-apps); }

.visual-blog { color: var(--menu-hover-news); }

.visual-list { color: var(--menu-hover-games); }

.card-arrow { color: var(--form-control-brd); font-size: 0.85rem; transition: transform 0.2s, color 0.2s; }

.content-card:hover .card-arrow { color: var(--lcolor); transform: translateX(5px); }

.flow-end { margin-top: 2rem; padding-bottom: 2rem; text-align: center; position: relative; }

.flow-end::before { content: ""; position: absolute; top: 0px; left: 20%; right: 20%; height: 1px; background: linear-gradient(90deg, transparent, var(--form-control-brd), transparent); }
