.visual-vault[class*="theme-"] { background: linear-gradient(155deg, rgb(4, 18, 8) 0%, rgb(10, 31, 20) 42%, rgb(6, 21, 16) 100%) !important; color: rgb(236, 253, 245) !important; border: 1px solid rgba(16, 185, 129, 0.18) !important; }

.visual-vault .coo-bg-orb { display: none !important; }

.visual-vault .coo-hook { background: rgba(16, 185, 129, 0.18) !important; color: rgb(110, 231, 183) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-vault .coo-btn { box-shadow: rgba(16, 185, 129, 0.35) 0px 4px 18px; background: rgb(16, 185, 129) !important; color: rgb(2, 44, 34) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-vault-glow { position: absolute; inset: -30%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 25% 70%, rgba(16, 185, 129, 0.14) 0%, transparent 48%), radial-gradient(circle at 80% 20%, rgba(251, 191, 36, 0.08) 0%, transparent 42%); }

.coo-vault-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-vault-card { position: relative; width: 100%; height: 100%; border-radius: 10px; background: linear-gradient(165deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 100%); border: 1px solid rgba(16, 185, 129, 0.22); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset; overflow: hidden; display: flex; flex-direction: column; }

.coo-vault-card-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px 2px; flex-shrink: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.06); }

.coo-vault-card-label { font-size: 5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-vault-live { display: inline-flex; align-items: center; gap: 2px; font-size: 4px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: rgb(110, 231, 183); padding: 1px 4px; border-radius: 99px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.28); }

.coo-vault-live-dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: 1.4s ease-in-out 0s infinite normal none running coo-vault-live-blink; }

@keyframes coo-vault-live-blink { 
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

.coo-vault-body { flex: 1 1 0%; min-height: 0px; display: flex; flex-direction: column; padding: 3px 5px 4px; position: relative; }

.coo-vault-balance { text-align: center; flex-shrink: 0; margin-bottom: 2px; animation: coo-vault-balance-pulse var(--vault-dur, 8s) ease-in-out infinite; }

@keyframes coo-vault-balance-pulse { 
  0%, 25% { opacity: 0.75; transform: scale(0.98); }
  40%, 82% { opacity: 1; transform: scale(1); }
  92%, 100% { opacity: 0.75; transform: scale(0.98); }
}

.coo-vault-value { font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: rgb(255, 255, 255); }

.coo-vault-value-sub { font-size: 5px; font-weight: 700; color: rgba(255, 255, 255, 0.4); margin-top: 1px; text-transform: uppercase; letter-spacing: 0.06em; }

.coo-vault-ledger { flex: 1 1 0%; min-height: 0px; display: flex; flex-direction: column; gap: 2px; overflow: hidden; justify-content: flex-end; }

.coo-vault-row { display: flex; align-items: center; justify-content: space-between; padding: 2px 4px; border-radius: 5px; background: rgba(0, 0, 0, 0.22); border: 1px solid rgba(255, 255, 255, 0.05); opacity: 0; transform: translateX(-8px); animation: coo-vault-row-in var(--vault-dur, 8s) ease-out infinite; }

.coo-vault-row:nth-child(1) { animation-delay: 0.4s; }

.coo-vault-row:nth-child(2) { animation-delay: 1.1s; }

.coo-vault-row:nth-child(3) { animation-delay: 1.8s; }

@keyframes coo-vault-row-in { 
  0%, 8% { opacity: 0; transform: translateX(-10px); }
  16%, 68% { opacity: 1; transform: translateX(0px); }
  78%, 100% { opacity: 0; transform: translateX(6px); }
}

.coo-vault-row-amt { font-size: 6px; font-weight: 800; line-height: 1; }

.coo-vault-row-amt-in { color: rgb(52, 211, 153); }

.coo-vault-row-amt-out { color: rgb(252, 165, 165); }

.coo-vault-row-amt-bal { color: rgb(251, 191, 36); }

.coo-vault-row-lbl { font-size: 5px; font-weight: 600; color: rgba(255, 255, 255, 0.5); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 52%; }

.coo-vault-drawer { position: absolute; bottom: 0px; left: 8%; right: 8%; height: 28%; background: linear-gradient(rgb(55, 65, 81) 0%, rgb(31, 41, 55) 100%); border-radius: 4px 4px 0px 0px; border: 1px solid rgba(255, 255, 255, 0.08); transform: translateY(100%); overflow: hidden; animation: coo-vault-drawer var(--vault-dur, 8s) ease-in-out infinite; }

@keyframes coo-vault-drawer { 
  0%, 22% { transform: translateY(100%); }
  32%, 75% { transform: translateY(35%); }
  85%, 100% { transform: translateY(100%); }
}

.coo-vault-bill { position: absolute; bottom: 2px; width: 18%; height: 55%; border-radius: 2px; background: linear-gradient(135deg, rgb(5, 150, 105), rgb(16, 185, 129)); border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: rgba(0, 0, 0, 0.3) 0px 1px 3px; animation: coo-vault-bill-stack var(--vault-dur, 8s) ease-out infinite; }

.coo-vault-bill:nth-child(1) { left: 12%; animation-delay: 0.5s; }

.coo-vault-bill:nth-child(2) { left: 32%; animation-delay: 0.9s; }

.coo-vault-bill:nth-child(3) { left: 52%; animation-delay: 1.3s; }

.coo-vault-bill:nth-child(4) { left: 72%; animation-delay: 1.7s; }

@keyframes coo-vault-bill-stack { 
  0%, 28% { opacity: 0; transform: translateY(8px) scale(0.9); }
  36%, 72% { opacity: 1; transform: translateY(0px) scale(1); }
  82%, 100% { opacity: 0; transform: translateY(-4px); }
}

.coo-vault-coin-drop { position: absolute; top: -2px; left: 50%; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgb(253, 230, 138), rgb(245, 158, 11)); box-shadow: rgba(0, 0, 0, 0.25) 0px -1px 0px inset; opacity: 0; animation: coo-vault-coin-fall var(--vault-dur, 8s) ease-in infinite; }

.coo-vault-coin-drop:nth-child(5) { animation-delay: 0.2s; margin-left: -14px; }

.coo-vault-coin-drop:nth-child(6) { animation-delay: 0.7s; margin-left: 6px; }

.coo-vault-coin-drop:nth-child(7) { animation-delay: 1.2s; margin-left: -3px; }

@keyframes coo-vault-coin-fall { 
  0%, 18% { opacity: 0; transform: translateY(-12px); }
  26%, 58% { opacity: 1; transform: translateY(22px); }
  68%, 100% { opacity: 0; transform: translateY(32px); }
}

.coo-vault-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-vault-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-vault-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-vault-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-vault-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-vault.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-vault.layout-banner-wide .coo-vault-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-vault.layout-banner-wide .coo-vault-card { width: 96px; height: 72px; border-radius: 8px; }

.visual-vault.layout-banner-wide .coo-vault-value { font-size: 12px; }

.visual-vault.layout-banner-wide .coo-vault-row-amt { font-size: 5px; }

.visual-vault.layout-banner-wide .coo-vault-row-lbl { font-size: 4px; }

.visual-vault.layout-banner-wide .coo-vault-row:nth-child(3) { display: none; }

.visual-vault.layout-banner-wide .coo-vault-drawer { height: 22%; }

.visual-vault.layout-banner-wide .coo-vault-coin-drop { display: none; }

.visual-vault.layout-banner-wide .coo-vault-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-vault.layout-banner-wide .coo-vault-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-vault.layout-banner-wide .coo-vault-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-vault.layout-banner-wide .coo-vault-btn { padding: 6px 12px; font-size: 10px; }

.visual-vault.layout-banner-wide .coo-vault-btn .coo-arrow { display: none; }

.visual-vault.layout-banner-wide .coo-brand { display: none; }

.visual-vault.layout-square, .visual-vault.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-vault.layout-square .coo-vault-square, .visual-vault.layout-desktop-square .coo-vault-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-vault.layout-square .coo-vault-square-top, .visual-vault.layout-desktop-square .coo-vault-square-top { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }

.visual-vault.layout-square .coo-vault-card, .visual-vault.layout-desktop-square .coo-vault-card { width: 130px; height: 118px; border-radius: 12px; }

.visual-vault.layout-square .coo-vault-value, .visual-vault.layout-desktop-square .coo-vault-value { font-size: 16px; }

.visual-vault.layout-square .coo-vault-row-amt, .visual-vault.layout-desktop-square .coo-vault-row-amt { font-size: 7px; }

.visual-vault.layout-square .coo-vault-copy .coo-hook, .visual-vault.layout-desktop-square .coo-vault-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-vault.layout-square .coo-vault-title, .visual-vault.layout-desktop-square .coo-vault-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-vault.layout-square .coo-vault-desc, .visual-vault.layout-desktop-square .coo-vault-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-vault.layout-square .coo-vault-btn, .visual-vault.layout-desktop-square .coo-vault-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-vault.layout-square .coo-brand, .visual-vault.layout-desktop-square .coo-brand { display: none; }

.visual-vault.layout-compact, .visual-vault.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-vault.layout-compact .coo-vault-compact, .visual-vault.layout-mobile .coo-vault-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-vault.layout-compact .coo-vault-compact-top, .visual-vault.layout-mobile .coo-vault-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-vault.layout-compact .coo-vault-card, .visual-vault.layout-mobile .coo-vault-card { width: 72px; height: 62px; border-radius: 8px; }

.visual-vault.layout-compact .coo-vault-value, .visual-vault.layout-mobile .coo-vault-value { font-size: 10px; }

.visual-vault.layout-compact .coo-vault-value-sub, .visual-vault.layout-mobile .coo-vault-value-sub { display: none; }

.visual-vault.layout-compact .coo-vault-row:nth-child(3), .visual-vault.layout-mobile .coo-vault-row:nth-child(3) { display: none; }

.visual-vault.layout-compact .coo-vault-drawer, .visual-vault.layout-mobile .coo-vault-drawer { height: 20%; }

.visual-vault.layout-compact .coo-vault-coin-drop, .visual-vault.layout-mobile .coo-vault-coin-drop { display: none; }

.visual-vault.layout-compact .coo-vault-copy .coo-hook, .visual-vault.layout-mobile .coo-vault-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-vault.layout-compact .coo-vault-title, .visual-vault.layout-mobile .coo-vault-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-vault.layout-compact .coo-vault-desc, .visual-vault.layout-mobile .coo-vault-desc { display: none; }

.visual-vault.layout-compact .coo-vault-compact-foot, .visual-vault.layout-mobile .coo-vault-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-vault.layout-compact .coo-vault-btn, .visual-vault.layout-mobile .coo-vault-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-vault.layout-compact .coo-vault-btn .coo-arrow, .visual-vault.layout-mobile .coo-vault-btn .coo-arrow { display: none; }

.visual-vault.layout-compact .coo-brand, .visual-vault.layout-mobile .coo-brand { display: none; }

.visual-reminder { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-reminder[class*="theme-"] { background: linear-gradient(145deg, rgb(15, 10, 20) 0%, rgb(26, 16, 36) 45%, rgb(18, 8, 26) 100%) !important; color: rgb(250, 250, 250) !important; border: 1px solid rgba(255, 255, 255, 0.08) !important; }

.visual-reminder .coo-bg-orb { display: none !important; }

.visual-reminder .coo-hook { background: rgba(239, 68, 68, 0.2) !important; color: rgb(254, 202, 202) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-reminder .coo-btn { box-shadow: rgba(239, 68, 68, 0.35) 0px 4px 18px; background: rgb(239, 68, 68) !important; color: rgb(255, 255, 255) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-reminder-aurora { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(at 15% 40%, rgba(239, 68, 68, 0.18) 0%, transparent 50%), radial-gradient(at 85% 25%, rgba(168, 85, 247, 0.2) 0%, transparent 45%), radial-gradient(at 50% 90%, rgba(251, 191, 36, 0.1) 0%, transparent 40%); }

.coo-reminder-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-reminder-phone { position: relative; width: 100%; height: 100%; border-radius: 10px; background: linear-gradient(165deg, rgba(255, 255, 255, 0.06) 0%, rgba(0, 0, 0, 0.35) 100%); border: 1.5px solid rgba(255, 255, 255, 0.1); box-shadow: rgba(0, 0, 0, 0.45) 0px 8px 24px, rgba(255, 255, 255, 0.06) 0px 1px 0px inset; overflow: hidden; }

.coo-reminder-notch { position: absolute; top: 3px; left: 50%; transform: translateX(-50%); width: 28%; height: 3px; border-radius: 99px; background: rgba(0, 0, 0, 0.5); z-index: 4; }

.coo-reminder-time { position: absolute; top: 8px; left: 0px; right: 0px; text-align: center; font-size: 6px; font-weight: 700; color: rgba(255, 255, 255, 0.35); letter-spacing: 0.04em; z-index: 2; }

.coo-reminder-stack { position: absolute; inset: 14px 4px 22px; display: flex; flex-direction: column; gap: 3px; justify-content: flex-start; z-index: 3; }

.coo-reminder-notif { display: flex; align-items: flex-start; gap: 4px; padding: 3px 5px; border-radius: 8px; background: rgba(255, 255, 255, 0.14); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 12px; opacity: 0; transform: translateY(-14px) scale(0.92); animation: coo-reminder-notif-in var(--rem-dur, 8s) ease-out infinite; }

.coo-reminder-notif:nth-child(1) { animation-delay: 0s; z-index: 3; }

.coo-reminder-notif:nth-child(2) { animation-delay: 0.55s; z-index: 2; }

.coo-reminder-notif:nth-child(3) { animation-delay: 1.1s; z-index: 1; }

@keyframes coo-reminder-notif-in { 
  0%, 6% { opacity: 0; transform: translateY(-16px) scale(0.9); }
  14%, 62% { opacity: 1; transform: translateY(0px) scale(1); }
  72%, 100% { opacity: 0; transform: translateY(6px) scale(0.96); }
}

.coo-reminder-notif-urgent { border-color: rgba(239, 68, 68, 0.35); background: rgba(239, 68, 68, 0.12); }

.coo-reminder-icon { width: 14px; height: 14px; border-radius: 4px; flex-shrink: 0; background: linear-gradient(135deg, rgb(245, 158, 11), rgb(239, 68, 68)); display: flex; align-items: center; justify-content: center; font-size: 7px; font-weight: 800; color: rgb(255, 255, 255); line-height: 1; }

.coo-reminder-notif-urgent .coo-reminder-icon { background: linear-gradient(135deg, rgb(239, 68, 68), rgb(185, 28, 28)); animation: 1.2s ease-in-out 0s infinite normal none running coo-reminder-icon-pulse; }

@keyframes coo-reminder-icon-pulse { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.coo-reminder-notif-body { min-width: 0px; flex: 1 1 0%; overflow: hidden; }

.coo-reminder-notif-app { font-size: 4px; font-weight: 800; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.04em; line-height: 1; margin-bottom: 1px; }

.coo-reminder-notif-title { font-size: 6px; font-weight: 800; color: rgb(255, 255, 255); line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-reminder-notif-msg { font-size: 5px; font-weight: 600; color: rgba(255, 255, 255, 0.72); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }

.coo-reminder-notif-urgent .coo-reminder-notif-msg { color: rgb(254, 202, 202); }

.coo-reminder-total { position: absolute; bottom: 4px; left: 4px; right: 4px; display: flex; align-items: center; justify-content: space-between; padding: 2px 5px; border-radius: 6px; background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(251, 191, 36, 0.25); z-index: 5; animation: coo-reminder-total-in var(--rem-dur, 8s) ease-out infinite; }

@keyframes coo-reminder-total-in { 
  0%, 20% { opacity: 0; transform: translateY(6px); }
  28%, 75% { opacity: 1; transform: translateY(0px); }
  85%, 100% { opacity: 0; transform: translateY(4px); }
}

.coo-reminder-total-amt { font-size: 7px; font-weight: 800; color: rgb(251, 191, 36); letter-spacing: -0.02em; }

.coo-reminder-total-sub { font-size: 5px; font-weight: 700; color: rgba(255, 255, 255, 0.5); }

.coo-reminder-badge { min-width: 12px; height: 12px; padding: 0px 3px; border-radius: 99px; background: rgb(239, 68, 68); color: rgb(255, 255, 255); font-size: 5px; font-weight: 800; display: flex; align-items: center; justify-content: center; line-height: 1; box-shadow: rgba(239, 68, 68, 0.5) 0px 0px 8px; animation: coo-reminder-badge-pop var(--rem-dur, 8s) ease-out infinite; }

@keyframes coo-reminder-badge-pop { 
  0%, 24% { transform: scale(0.6); opacity: 0; }
  32%, 70% { transform: scale(1); opacity: 1; }
  80%, 100% { transform: scale(0.8); opacity: 0; }
}

.coo-reminder-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-reminder-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-reminder-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-reminder-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-reminder-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-reminder.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-reminder.layout-banner-wide .coo-reminder-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-reminder.layout-banner-wide .coo-reminder-phone { width: 96px; height: 72px; border-radius: 8px; }

.visual-reminder.layout-banner-wide .coo-reminder-stack { inset: 12px 3px 18px; gap: 2px; }

.visual-reminder.layout-banner-wide .coo-reminder-notif:nth-child(3) { display: none; }

.visual-reminder.layout-banner-wide .coo-reminder-time { display: none; }

.visual-reminder.layout-banner-wide .coo-reminder-icon { width: 11px; height: 11px; font-size: 6px; }

.visual-reminder.layout-banner-wide .coo-reminder-notif-title { font-size: 5px; }

.visual-reminder.layout-banner-wide .coo-reminder-notif-msg { font-size: 4px; }

.visual-reminder.layout-banner-wide .coo-reminder-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-reminder.layout-banner-wide .coo-reminder-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-reminder.layout-banner-wide .coo-reminder-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-reminder.layout-banner-wide .coo-reminder-btn { padding: 6px 12px; font-size: 10px; }

.visual-reminder.layout-banner-wide .coo-reminder-btn .coo-arrow { display: none; }

