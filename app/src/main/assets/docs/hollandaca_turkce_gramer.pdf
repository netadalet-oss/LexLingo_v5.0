.visual-pipeline.layout-compact .coo-pipe-title, .visual-pipeline.layout-mobile .coo-pipe-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

