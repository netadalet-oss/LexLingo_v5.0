.visual-tap[class*="theme-"] .coo-btn { background: rgb(255, 255, 255) !important; color: rgb(17, 24, 39) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-sync[class*="theme-"] { background: linear-gradient(135deg, rgb(12, 25, 41) 0%, rgb(30, 58, 95) 100%) !important; color: rgb(240, 244, 248) !important; border: 1px solid rgba(255, 255, 255, 0.08) !important; }

.visual-sync[class*="theme-"] .coo-hook { background: rgba(37, 99, 235, 0.25) !important; color: rgb(147, 197, 253) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-sync[class*="theme-"] .coo-btn { background: rgb(255, 255, 255) !important; color: rgb(12, 25, 41) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-clock[class*="theme-"] { background: linear-gradient(160deg, rgb(26, 35, 50) 0%, rgb(36, 48, 68) 55%, rgb(30, 41, 59) 100%) !important; color: rgb(248, 250, 252) !important; border: 1px solid rgba(255, 255, 255, 0.07) !important; }

.visual-clock[class*="theme-"] .coo-hook { background: rgba(244, 63, 94, 0.18) !important; color: rgb(253, 164, 175) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-clock[class*="theme-"] .coo-btn { background: rgb(248, 250, 252) !important; color: rgb(30, 41, 59) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-urgency[class*="theme-"] { background: linear-gradient(135deg, rgb(194, 65, 12) 0%, rgb(245, 158, 11) 100%) !important; color: rgb(255, 255, 255) !important; border-width: medium !important; border-style: none !important; border-color: currentcolor !important; border-image: initial !important; }

.visual-urgency[class*="theme-"] .coo-hook { background: rgba(0, 0, 0, 0.15) !important; color: rgb(255, 255, 255) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-urgency[class*="theme-"] .coo-btn { background: rgb(255, 255, 255) !important; color: rgb(194, 65, 12) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-payroll[class*="theme-"] { background: linear-gradient(135deg, rgb(76, 29, 149) 0%, rgb(124, 58, 237) 100%) !important; color: rgb(255, 255, 255) !important; }

.visual-payroll[class*="theme-"] .coo-hook { background: rgba(255, 255, 255, 0.15) !important; color: rgb(233, 213, 255) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-payroll[class*="theme-"] .coo-btn { background: rgb(255, 255, 255) !important; color: rgb(91, 33, 182) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-mod-stage { position: relative; flex-shrink: 0; overflow: hidden; border-radius: 10px; background: rgba(0, 0, 0, 0.28); border: 1px solid rgba(255, 255, 255, 0.08); }

.coo-mod-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-mod-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-mod-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-mod-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-mod-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.coo-mod-val { font-weight: 800; letter-spacing: -0.03em; line-height: 1; }

.coo-mod-sub { font-size: 5px; font-weight: 700; opacity: 0.55; text-transform: uppercase; letter-spacing: 0.06em; margin-top: 1px; }

.coo-vault-jar { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); width: 46%; height: 72%; border-radius: 8px 8px 12px 12px; background: linear-gradient(rgba(56, 189, 248, 0.25), rgba(16, 185, 129, 0.15)); border: 1px solid rgba(56, 189, 248, 0.35); overflow: hidden; }

.coo-vault-coin { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: rgb(251, 191, 36); box-shadow: rgba(0, 0, 0, 0.2) 0px -1px 0px inset; animation: coo-vault-drop var(--mod-dur, 8s) ease-in infinite; opacity: 0; }

.coo-vault-coin:nth-child(1) { left: 20%; animation-delay: 0s; }

.coo-vault-coin:nth-child(2) { left: 45%; animation-delay: 0.8s; }

.coo-vault-coin:nth-child(3) { left: 65%; animation-delay: 1.6s; }

.coo-vault-coin:nth-child(4) { left: 35%; animation-delay: 2.4s; }

@keyframes coo-vault-drop { 
  0%, 5% { opacity: 0; transform: translateY(-20px); }
  15%, 70% { opacity: 1; transform: translateY(28px); }
  85%, 100% { opacity: 0; transform: translateY(40px); }
}

.coo-vault-counter { position: absolute; top: 6px; left: 0px; right: 0px; text-align: center; z-index: 2; animation: coo-vault-pulse var(--mod-dur, 8s) ease-in-out infinite; }

@keyframes coo-vault-pulse { 
  0%, 30% { opacity: 0.6; }
  50%, 90% { opacity: 1; }
  100% { opacity: 0.6; }
}

.coo-reminder-stack { position: absolute; inset: 4px; display: flex; flex-direction: column; gap: 3px; align-items: stretch; }

.coo-reminder-card { background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(4px); border-radius: 8px; padding: 3px 5px; border: 1px solid rgba(255, 255, 255, 0.1); transform: translateY(12px) scale(0.92); opacity: 0; animation: coo-reminder-in var(--mod-dur, 8s) ease-out infinite; }

.coo-reminder-card:nth-child(1) { animation-delay: 0s; z-index: 3; }

.coo-reminder-card:nth-child(2) { animation-delay: 0.6s; z-index: 2; }

.coo-reminder-card:nth-child(3) { animation-delay: 1.2s; z-index: 1; }

@keyframes coo-reminder-in { 
  0%, 8% { opacity: 0; transform: translateY(14px) scale(0.9); }
  18%, 75% { opacity: 1; transform: translateY(0px) scale(1); }
  88%, 100% { opacity: 0; transform: translateY(-6px) scale(0.95); }
}

.coo-reminder-app { font-size: 4px; font-weight: 800; color: rgb(252, 165, 165); line-height: 1; }

.coo-reminder-msg { font-size: 5px; font-weight: 600; color: rgba(255, 255, 255, 0.9); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-sunset-blob { position: absolute; inset: -20%; background: radial-gradient(circle at 50% 80%, rgba(255, 200, 150, 0.5), transparent 55%); animation: coo-sunset-breathe var(--mod-dur, 8s) ease-in-out infinite; }

@keyframes coo-sunset-breathe { 
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.08); opacity: 1; }
}

.coo-sunset-card { position: absolute; inset: 8px; background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(6px); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.25); display: flex; flex-direction: column; align-items: center; justify-content: center; animation: coo-sunset-card-in var(--mod-dur, 8s) ease-out infinite; }

@keyframes coo-sunset-card-in { 
  0%, 20% { opacity: 0; transform: translateY(8px); }
  35%, 85% { opacity: 1; transform: translateY(0px); }
  95%, 100% { opacity: 0; }
}

.coo-radar-disc { position: absolute; inset: 6px; border-radius: 50%; border: 1px solid rgba(16, 185, 129, 0.35); background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, transparent 70%); }

.coo-radar-sweep { position: absolute; inset: 6px; border-radius: 50%; background: conic-gradient(transparent 0deg, rgba(16, 185, 129, 0.45) 30deg, transparent 60deg); animation: coo-radar-spin var(--mod-dur, 8s) linear infinite; }

@keyframes coo-radar-spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.coo-radar-blip { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: rgb(52, 211, 153); box-shadow: rgb(52, 211, 153) 0px 0px 6px; animation: coo-radar-blip var(--mod-dur, 8s) ease-in-out infinite; opacity: 0; }

.coo-radar-blip:nth-child(1) { top: 22%; left: 58%; animation-delay: 0.5s; }

.coo-radar-blip:nth-child(2) { top: 55%; left: 30%; animation-delay: 2s; }

.coo-radar-blip:nth-child(3) { top: 38%; left: 68%; animation-delay: 3.5s; }

@keyframes coo-radar-blip { 
  0%, 10% { opacity: 0; transform: scale(0.5); }
  20%, 60% { opacity: 1; transform: scale(1); }
  75%, 100% { opacity: 0; }
}

.coo-tap-card { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); width: 70%; height: 38%; border-radius: 6px; background: linear-gradient(135deg, rgb(55, 65, 81), rgb(31, 41, 55)); border: 1px solid rgba(255, 255, 255, 0.15); }

.coo-tap-ring { position: absolute; top: 28%; left: 50%; width: 20px; height: 20px; margin: -10px 0px 0px -10px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.5); animation: coo-tap-ripple var(--mod-dur, 8s) ease-out infinite; opacity: 0; }

.coo-tap-ring:nth-child(2) { animation-delay: 0.4s; }

@keyframes coo-tap-ripple { 
  0%, 15% { opacity: 0; transform: scale(0.4); }
  25%, 55% { opacity: 0.8; transform: scale(1.6); }
  70%, 100% { opacity: 0; transform: scale(2.2); }
}

.coo-tap-nfc { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); font-size: 5px; font-weight: 800; color: rgba(255, 255, 255, 0.7); letter-spacing: 0.08em; }

.coo-sync-cloud { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 52%; height: 36%; background: rgba(59, 130, 246, 0.25); border-radius: 12px 12px 16px 16px; border: 1px solid rgba(147, 197, 253, 0.4); }

.coo-sync-cloud::before, .coo-sync-cloud::after { content: ""; position: absolute; background: inherit; border: inherit; border-radius: 50%; }

.coo-sync-cloud::before { width: 40%; height: 80%; top: -35%; left: 12%; }

.coo-sync-cloud::after { width: 35%; height: 70%; top: -28%; right: 10%; }

.coo-sync-arrow { position: absolute; font-size: 10px; font-weight: 800; color: rgb(147, 197, 253); animation: coo-sync-bounce var(--mod-dur, 8s) ease-in-out infinite; }

.coo-sync-arrow-up { left: 18%; top: 30%; animation-name: coo-sync-up; }

.coo-sync-arrow-down { right: 18%; bottom: 22%; animation-name: coo-sync-down; }

@keyframes coo-sync-up { 
  0%, 20% { opacity: 0; transform: translateY(6px); }
  35%, 70% { opacity: 1; transform: translateY(-4px); }
  85%, 100% { opacity: 0; }
}

@keyframes coo-sync-down { 
  0%, 20% { opacity: 0; transform: translateY(-6px); }
  35%, 70% { opacity: 1; transform: translateY(4px); }
  85%, 100% { opacity: 0; }
}

.coo-clock-face { position: absolute; inset: 8px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.2); background: rgba(0, 0, 0, 0.2); }

.coo-clock-hand { position: absolute; bottom: 50%; left: 50%; transform-origin: center bottom; background: rgb(248, 250, 252); border-radius: 2px; }

.coo-clock-hour { width: 2px; height: 28%; margin-left: -1px; animation: coo-clock-hour var(--mod-dur, 8s) linear infinite; }

.coo-clock-min { width: 1px; height: 38%; margin-left: -0.5px; animation: coo-clock-min var(--mod-dur, 8s) linear infinite; }

@keyframes coo-clock-hour { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes coo-clock-min { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(720deg); }
}

.coo-clock-dot { position: absolute; top: 50%; left: 50%; width: 4px; height: 4px; margin: -2px 0px 0px -2px; border-radius: 50%; background: rgb(253, 164, 175); }

.coo-payroll-env { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); width: 55%; height: 45%; background: rgb(253, 230, 138); border-radius: 4px 4px 8px 8px; border: 1px solid rgb(251, 191, 36); overflow: hidden; }

.coo-payroll-flap { position: absolute; top: 0px; left: 0px; right: 0px; height: 50%; background: rgb(252, 211, 77); transform-origin: center top; animation: coo-payroll-open var(--mod-dur, 8s) ease-in-out infinite; border-bottom: 1px solid rgb(245, 158, 11); }

@keyframes coo-payroll-open { 
  0%, 20% { transform: rotateX(0deg); }
  40%, 70% { transform: rotateX(-120deg); }
  85%, 100% { transform: rotateX(0deg); }
}

.coo-payroll-bill { position: absolute; top: 30%; left: 50%; transform: translateX(-50%); font-size: 8px; font-weight: 800; color: rgb(4, 120, 87); animation: coo-payroll-rise var(--mod-dur, 8s) ease-out infinite; opacity: 0; }

@keyframes coo-payroll-rise { 
  0%, 35% { opacity: 0; transform: translate(-50%, 8px); }
  50%, 75% { opacity: 1; transform: translate(-50%, -4px); }
  90%, 100% { opacity: 0; }
}

.coo-urgency-ring { position: absolute; inset: 10px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.25); animation: coo-urgency-pulse var(--mod-dur, 8s) ease-in-out infinite; }

@keyframes coo-urgency-pulse { 
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.06); opacity: 1; border-color: rgb(255, 255, 255); }
}

.coo-urgency-timer { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; z-index: 2; }

.coo-urgency-timer .coo-mod-val { font-size: 14px; animation: coo-urgency-flash var(--mod-dur, 8s) step-end infinite; }

@keyframes coo-urgency-flash { 
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0.75; }
}

.visual-payroll.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-payroll.layout-banner-wide .coo-mod-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-payroll.layout-banner-wide .coo-mod-stage { width: 96px; height: 72px; max-height: 72px; }

.visual-payroll.layout-banner-wide .coo-mod-val { font-size: 11px; }

.visual-payroll.layout-banner-wide .coo-mod-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-payroll.layout-banner-wide .coo-mod-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-payroll.layout-banner-wide .coo-mod-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-payroll.layout-banner-wide .coo-mod-btn { padding: 6px 12px; font-size: 10px; }

.visual-payroll.layout-banner-wide .coo-mod-btn .coo-arrow { display: none; }

.visual-payroll.layout-banner-wide .coo-brand { display: none; }

.visual-payroll.layout-banner-wide .coo-mod-mode-strip .coo-reminder-card:nth-child(3), .visual-payroll.layout-banner-wide .coo-mod-mode-strip .coo-roster-av:nth-child(n+5), .visual-payroll.layout-banner-wide .coo-mod-mode-strip .coo-pipeline-col:nth-child(4) { display: none; }

.visual-payroll.layout-square, .visual-payroll.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-payroll.layout-square .coo-mod-square, .visual-payroll.layout-desktop-square .coo-mod-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-payroll.layout-square .coo-mod-stage, .visual-payroll.layout-desktop-square .coo-mod-stage { width: 100%; height: 118px; flex-shrink: 0; }

.visual-payroll.layout-square .coo-mod-val, .visual-payroll.layout-desktop-square .coo-mod-val { font-size: 16px; }

.visual-payroll.layout-square .coo-mod-copy .coo-hook, .visual-payroll.layout-desktop-square .coo-mod-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-payroll.layout-square .coo-mod-title, .visual-payroll.layout-desktop-square .coo-mod-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-payroll.layout-square .coo-mod-desc, .visual-payroll.layout-desktop-square .coo-mod-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-payroll.layout-square .coo-mod-btn, .visual-payroll.layout-desktop-square .coo-mod-btn { max-width: 68%; justify-content: center; padding: 8px 12px; font-size: 10px; margin-top: auto; width: auto !important; }

.visual-payroll.layout-square .coo-brand, .visual-payroll.layout-desktop-square .coo-brand { display: none; }

.visual-payroll.layout-compact, .visual-payroll.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-payroll.layout-compact .coo-mod-compact, .visual-payroll.layout-mobile .coo-mod-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-payroll.layout-compact .coo-mod-compact-top, .visual-payroll.layout-mobile .coo-mod-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-payroll.layout-compact .coo-mod-stage, .visual-payroll.layout-mobile .coo-mod-stage { width: 72px; height: 58px; max-height: 58px; }

.visual-payroll.layout-compact .coo-mod-val, .visual-payroll.layout-mobile .coo-mod-val { font-size: 9px; }

.visual-payroll.layout-compact .coo-mod-sub, .visual-payroll.layout-mobile .coo-mod-sub { display: none; }

.visual-payroll.layout-compact .coo-mod-copy .coo-hook, .visual-payroll.layout-mobile .coo-mod-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-payroll.layout-compact .coo-mod-title, .visual-payroll.layout-mobile .coo-mod-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-payroll.layout-compact .coo-mod-desc, .visual-payroll.layout-mobile .coo-mod-desc { display: none; }

.visual-payroll.layout-compact .coo-mod-compact-foot, .visual-payroll.layout-mobile .coo-mod-compact-foot { display: flex; flex-shrink: 0; z-index: 4; width: 100%; padding: 0px; }

.visual-payroll.layout-compact .coo-mod-btn, .visual-payroll.layout-mobile .coo-mod-btn { width: 100%; justify-content: center; padding: 6px 10px; font-size: 9px; flex-shrink: 0; }

.visual-payroll.layout-compact .coo-mod-btn .coo-arrow, .visual-payroll.layout-mobile .coo-mod-btn .coo-arrow { display: none; }

.visual-payroll.layout-compact .coo-brand, .visual-payroll.layout-mobile .coo-brand { display: none; }

.visual-payroll.layout-compact .coo-mod-mode-strip .coo-reminder-card:nth-child(n+3), .visual-payroll.layout-mobile .coo-mod-mode-strip .coo-reminder-card:nth-child(n+3), .visual-payroll.layout-compact .coo-mod-mode-strip .coo-roster-av:nth-child(n+5), .visual-payroll.layout-mobile .coo-mod-mode-strip .coo-roster-av:nth-child(n+5) { display: none; }

.visual-launch { overflow: hidden; height: 100%; align-items: stretch; padding: 0px; gap: 0px; line-height: 1.25; }

.visual-launch .coo-launch-glow { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.22) 0%, transparent 55%); animation: 4s ease-in-out 0s infinite normal none running coo-launch-glow; }

@keyframes coo-launch-glow { 
  0%, 100% { transform: translate(0px, 0px) scale(1); opacity: 0.6; }
  50% { transform: translate(6%, -4%) scale(1.08); opacity: 1; }
}

.coo-launch-spark { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: rgba(255, 255, 255, 0.85); pointer-events: none; z-index: 1; animation: 3s ease-in 0s infinite normal none running coo-spark-rise; }

.coo-launch-spark-1 { left: 14%; bottom: 18%; animation-delay: 0s; }

.coo-launch-spark-2 { left: 32%; bottom: 14%; animation-delay: 0.7s; width: 3px; height: 3px; }

.coo-launch-spark-3 { right: 20%; bottom: 22%; animation-delay: 1.2s; }

.coo-launch-spark-4 { right: 36%; bottom: 16%; animation-delay: 1.8s; width: 3px; height: 3px; }

.coo-launch-spark-5 { left: 52%; bottom: 12%; animation-delay: 2.4s; opacity: 0.6; }

@keyframes coo-spark-rise { 
  0% { transform: translateY(0px) scale(1); opacity: 0; }
  15% { opacity: 0.9; }
  100% { transform: translateY(-32px) scale(0.3); opacity: 0; }
}

.coo-launch-stat-wrap { position: relative; flex-shrink: 0; }

.coo-launch-ring { position: absolute; inset: 0px; border-radius: 50%; border: 2px dashed rgba(255, 255, 255, 0.45); animation: 8s linear 0s infinite normal none running coo-launch-spin; transform-origin: center center; }

@keyframes coo-launch-spin { 
  100% { transform: rotate(360deg); }
}

.coo-launch-stat { position: absolute; inset: 4px; border-radius: 50%; background: rgba(255, 255, 255, 0.95); color: rgb(4, 120, 87); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; line-height: 1; box-shadow: rgba(0, 0, 0, 0.12) 0px 4px 16px; animation: 2s ease-in-out 0s infinite normal none running coo-launch-pulse; transform-origin: center center; }

@keyframes coo-launch-pulse { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

.coo-launch-value { font-weight: 800; letter-spacing: -0.04em; line-height: 1; display: block; }

.coo-launch-unit { font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.75; line-height: 1; display: block; margin: 0px; }

.coo-launch-hook { animation: auto ease 0s 1 normal none running none; margin: 0px; }

.coo-launch-steps-track { overflow: hidden; z-index: 2; flex-shrink: 0; min-width: 0px; mask-image: linear-gradient(90deg, transparent, rgb(0, 0, 0) 6%, rgb(0, 0, 0) 94%, transparent); }

.coo-launch-steps { display: flex; align-items: center; gap: 5px; width: max-content; animation: 14s linear 0s infinite normal none running coo-steps-marquee; }

@keyframes coo-steps-marquee { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(-50%); }
}

.coo-launch-step { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; white-space: nowrap; padding: 2px 7px; border-radius: 999px; background: rgba(255, 255, 255, 0.16); color: rgb(255, 255, 255); animation: 2.4s ease-in-out 0s infinite normal none running coo-step-light; }

.coo-launch-step-dot { width: 4px; height: 4px; border-radius: 50%; background: rgb(187, 247, 208); flex-shrink: 0; animation: 2.4s ease-in-out 0s infinite normal none running coo-dot-blink; }

@keyframes coo-step-light { 
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; background: rgba(255, 255, 255, 0.28); }
}

@keyframes coo-dot-blink { 
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); box-shadow: rgb(187, 247, 208) 0px 0px 6px; }
}

.coo-launch-step-sep { opacity: 0.35; font-size: 9px; flex-shrink: 0; }

.coo-launch-btn { position: relative; overflow: hidden; z-index: 2; animation: 2.2s ease-in-out 0s infinite normal none running coo-launch-btn-pulse; }

@keyframes coo-launch-btn-pulse { 
  0%, 100% { box-shadow: rgba(0, 0, 0, 0.15) 0px 3px 14px; }
  50% { box-shadow: rgba(255, 255, 255, 0.35) 0px 4px 22px; }
}

.coo-launch-shine { position: absolute; top: 0px; left: -100%; width: 60%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent); animation: 2.8s ease-in-out 0s infinite normal none running coo-shine-sweep; }

@keyframes coo-shine-sweep { 
  0% { left: -100%; }
  40%, 100% { left: 140%; }
}

.visual-launch.layout-banner-wide { display: flex; flex-direction: row; align-items: center; padding: 0px 10px; height: 100%; overflow: hidden; }

.visual-launch.layout-banner-wide .coo-launch-wide { display: grid; grid-template-columns: 42px minmax(0px, 1fr) auto; grid-template-rows: 100%; align-items: center; align-content: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; z-index: 2; }

.visual-launch.layout-banner-wide .coo-launch-wide-stat { grid-column: 1; display: flex; align-items: center; justify-content: center; height: 100%; }

.visual-launch.layout-banner-wide .coo-launch-stat-wrap { width: 42px; height: 42px; }

.visual-launch.layout-banner-wide .coo-launch-stat { animation: auto ease 0s 1 normal none running none; inset: 3px; }

.visual-launch.layout-banner-wide .coo-launch-value { font-size: 19px; }

.visual-launch.layout-banner-wide .coo-launch-unit { font-size: 7px; }

.visual-launch.layout-banner-wide .coo-launch-wide-copy { grid-column: 2; min-width: 0px; display: flex; flex-direction: column; justify-content: center; align-self: center; gap: 1px; overflow: hidden; }

.visual-launch.layout-banner-wide .coo-title { -webkit-line-clamp: 2; font-size: 14px; margin: 0px; line-height: 1.15; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-launch.layout-banner-wide .coo-launch-wide-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; font-size: 10px; line-height: 1.2; opacity: 0.88; margin: 0px; overflow: hidden; }

.visual-launch.layout-banner-wide .coo-launch-wide-track { display: none; }

.visual-launch.layout-banner-wide .coo-launch-wide-cta { grid-column: 3; display: flex; align-items: center; justify-content: flex-end; align-self: center; flex-shrink: 0; }

.visual-launch.layout-banner-wide .coo-launch-btn { padding: 6px 12px; font-size: 11px; height: auto; white-space: nowrap; max-width: 130px; }

.visual-launch.layout-banner-wide .coo-launch-btn span:last-of-type { overflow: hidden; text-overflow: ellipsis; }

.visual-launch.layout-banner-wide .coo-launch-spark { display: none; }

.visual-launch.layout-banner-wide .coo-brand { display: none; }

.visual-launch.layout-square, .visual-launch.layout-desktop-square { flex-direction: column; align-items: stretch; padding: 16px 18px 14px; justify-content: flex-start; }

.visual-launch.layout-square .coo-launch-square, .visual-launch.layout-desktop-square .coo-launch-square { display: flex; flex-direction: column; align-items: stretch; width: 100%; height: 100%; min-height: 0px; z-index: 2; gap: 0px; }

.visual-launch.layout-square .coo-launch-hook, .visual-launch.layout-desktop-square .coo-launch-hook { align-self: flex-start; font-size: 9px; padding: 3px 8px; margin-bottom: 12px; flex-shrink: 0; }

.visual-launch.layout-square .coo-launch-square-hero, .visual-launch.layout-desktop-square .coo-launch-square-hero { display: flex; align-items: center; gap: 16px; flex-shrink: 0; margin-bottom: 14px; }

.visual-launch.layout-square .coo-launch-stat-wrap, .visual-launch.layout-desktop-square .coo-launch-stat-wrap { width: 76px; height: 76px; }

.visual-launch.layout-square .coo-launch-value, .visual-launch.layout-desktop-square .coo-launch-value { font-size: 32px; }

.visual-launch.layout-square .coo-launch-unit, .visual-launch.layout-desktop-square .coo-launch-unit { font-size: 8px; margin-top: 2px; }

.visual-launch.layout-square .coo-launch-square-copy, .visual-launch.layout-desktop-square .coo-launch-square-copy { flex: 1 1 0%; min-width: 0px; display: flex; flex-direction: column; justify-content: center; gap: 6px; }

.visual-launch.layout-square .coo-title, .visual-launch.layout-desktop-square .coo-title { -webkit-line-clamp: 2; font-size: 17px; margin: 0px; line-height: 1.2; }

.visual-launch.layout-square .coo-desc, .visual-launch.layout-desktop-square .coo-desc { -webkit-line-clamp: 3; font-size: 11px; line-height: 1.4; opacity: 0.85; }

.visual-launch.layout-square .coo-launch-steps-track, .visual-launch.layout-desktop-square .coo-launch-steps-track { width: 100%; height: 24px; display: flex; align-items: center; margin-bottom: 14px; flex-shrink: 0; }

.visual-launch.layout-square .coo-launch-step, .visual-launch.layout-desktop-square .coo-launch-step { font-size: 10px; }

.visual-launch.layout-square .coo-launch-btn, .visual-launch.layout-desktop-square .coo-launch-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; flex-shrink: 0; }

.visual-launch.layout-compact, .visual-launch.layout-mobile { flex-direction: column !important; align-items: stretch !important; padding: 6px 10px 5px !important; gap: 4px !important; justify-content: space-between !important; }

.visual-launch.layout-compact .coo-launch-compact, .visual-launch.layout-mobile .coo-launch-compact { display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 0px; z-index: 2; gap: 3px; }

.visual-launch.layout-compact .coo-launch-compact-main, .visual-launch.layout-mobile .coo-launch-compact-main { display: flex; align-items: center; gap: 8px; flex: 1 1 auto; min-height: 0px; padding: 0px; }

.visual-launch.layout-compact .coo-launch-stat-wrap, .visual-launch.layout-mobile .coo-launch-stat-wrap { width: 42px; height: 42px; flex-shrink: 0; }

.visual-launch.layout-compact .coo-launch-value, .visual-launch.layout-mobile .coo-launch-value { font-size: 18px; }

.visual-launch.layout-compact .coo-launch-unit, .visual-launch.layout-mobile .coo-launch-unit { font-size: 6px; }

.visual-launch.layout-compact .coo-launch-compact-copy, .visual-launch.layout-mobile .coo-launch-compact-copy { flex: 1 1 auto; min-width: 0px; display: flex; flex-direction: column; justify-content: center; gap: 2px; text-align: left; }

.visual-launch.layout-compact .coo-launch-hook, .visual-launch.layout-mobile .coo-launch-hook { font-size: 7px; padding: 2px 5px; margin: 0px; align-self: flex-start; }

.visual-launch.layout-compact .coo-title, .visual-launch.layout-mobile .coo-title { -webkit-line-clamp: 2; font-size: 11px; margin: 0px; line-height: 1.2; }

.visual-launch.layout-compact .coo-desc, .visual-launch.layout-mobile .coo-desc { display: none !important; }

.visual-launch.layout-compact .coo-launch-compact-strip, .visual-launch.layout-mobile .coo-launch-compact-strip { flex-shrink: 0; height: 18px; display: flex; align-items: center; padding: 0px; overflow: hidden; }

.visual-launch.layout-compact .coo-launch-compact-strip .coo-launch-steps-track, .visual-launch.layout-mobile .coo-launch-compact-strip .coo-launch-steps-track { width: 100%; height: 100%; display: flex; align-items: center; }

.visual-launch.layout-compact .coo-launch-step, .visual-launch.layout-mobile .coo-launch-step { font-size: 7px; padding: 2px 5px; }

.visual-launch.layout-compact .coo-launch-compact-cta, .visual-launch.layout-mobile .coo-launch-compact-cta { flex-shrink: 0; width: 100%; }

.visual-launch.layout-compact .coo-launch-btn, .visual-launch.layout-mobile .coo-launch-btn { width: 100%; justify-content: center; padding: 6px 10px; font-size: 9px; }

.visual-launch.layout-compact .coo-launch-btn .coo-arrow, .visual-launch.layout-mobile .coo-launch-btn .coo-arrow { display: none; }

.visual-launch.layout-compact .coo-launch-spark, .visual-launch.layout-mobile .coo-launch-spark { display: none; }

.visual-launch.layout-micro { gap: 8px; flex-direction: row !important; align-items: center !important; padding: 7px 10px !important; }

