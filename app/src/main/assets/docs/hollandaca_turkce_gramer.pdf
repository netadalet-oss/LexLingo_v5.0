.visual-tap.layout-compact .coo-tap-desc, .visual-tap.layout-mobile .coo-tap-desc { display: none; }

.visual-tap.layout-compact .coo-tap-compact-foot, .visual-tap.layout-mobile .coo-tap-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-tap.layout-compact .coo-tap-btn, .visual-tap.layout-mobile .coo-tap-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-tap.layout-compact .coo-tap-btn .coo-arrow, .visual-tap.layout-mobile .coo-tap-btn .coo-arrow { display: none; }

.visual-tap.layout-compact .coo-brand, .visual-tap.layout-mobile .coo-brand { display: none; }

.visual-sync { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-sync[class*="theme-"] { background: linear-gradient(155deg, rgb(46, 16, 101) 0%, rgb(76, 29, 149) 42%, rgb(49, 46, 129) 100%) !important; color: rgb(250, 245, 255) !important; border: 1px solid rgba(167, 139, 250, 0.2) !important; }

.visual-sync .coo-bg-orb { display: none !important; }

.visual-sync .coo-hook { background: rgba(167, 139, 250, 0.22) !important; color: rgb(221, 214, 254) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-sync .coo-btn { box-shadow: rgba(167, 139, 250, 0.35) 0px 4px 18px; background: rgb(255, 255, 255) !important; color: rgb(91, 33, 182) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-sync-aurora { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(at 20% 70%, rgba(59, 130, 246, 0.18) 0%, transparent 50%), radial-gradient(at 80% 30%, rgba(167, 139, 250, 0.2) 0%, transparent 45%); animation: 9s ease-in-out 0s infinite normal none running coo-sync-aurora-shift; }

@keyframes coo-sync-aurora-shift { 
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}

.coo-sync-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-sync-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(255, 255, 255, 0.08) 0%, rgba(0, 0, 0, 0.35) 100%); border: 1px solid rgba(167, 139, 250, 0.25); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px; }

.coo-sync-cloud { position: absolute; top: 4px; left: 50%; transform: translateX(-50%); width: 38%; height: 16px; z-index: 3; background: rgba(59, 130, 246, 0.35); border-radius: 10px 10px 14px 14px; border: 1px solid rgba(147, 197, 253, 0.45); opacity: 0.5; animation: coo-sync-cloud-active var(--sync-dur, 8s) ease-in-out infinite; }

.coo-sync-cloud::before, .coo-sync-cloud::after { content: ""; position: absolute; background: inherit; border: inherit; border-radius: 50%; }

.coo-sync-cloud::before { width: 42%; height: 90%; top: -42%; left: 8%; }

.coo-sync-cloud::after { width: 36%; height: 75%; top: -32%; right: 10%; }

@keyframes coo-sync-cloud-active { 
  0%, 35% { opacity: 0.35; filter: grayscale(0.6); }
  48%, 78% { opacity: 1; filter: none; box-shadow: rgba(59, 130, 246, 0.4) 0px 0px 12px; }
  88%, 100% { opacity: 0.35; }
}

.coo-sync-beam { position: absolute; top: 18px; left: 50%; width: 2px; height: 28%; margin-left: -1px; background: linear-gradient(rgba(147, 197, 253, 0.8), rgba(167, 139, 250, 0.3)); opacity: 0; z-index: 2; animation: coo-sync-beam-pulse var(--sync-dur, 8s) ease-in-out infinite; }

@keyframes coo-sync-beam-pulse { 
  0%, 40% { opacity: 0; transform: scaleY(0.3); }
  50%, 72% { opacity: 1; transform: scaleY(1); }
  82%, 100% { opacity: 0; }
}

.coo-sync-particle { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: rgb(147, 197, 253); box-shadow: rgb(147, 197, 253) 0px 0px 6px; z-index: 2; opacity: 0; animation: coo-sync-particle-up var(--sync-dur, 8s) ease-in infinite; }

.coo-sync-particle:nth-child(1) { left: 46%; animation-delay: 0.5s; }

.coo-sync-particle:nth-child(2) { left: 50%; animation-delay: 0.9s; }

.coo-sync-particle:nth-child(3) { left: 54%; animation-delay: 1.3s; }

@keyframes coo-sync-particle-up { 
  0%, 42% { opacity: 0; bottom: 38%; transform: translateY(0px); }
  50%, 65% { opacity: 1; bottom: 55%; transform: translateY(-8px); }
  72%, 100% { opacity: 0; bottom: 70%; }
}

.coo-sync-pos { position: absolute; bottom: 4px; left: 6%; width: 28%; height: 32%; border-radius: 4px; background: linear-gradient(rgb(30, 41, 59), rgb(15, 23, 42)); border: 1px solid rgba(255, 255, 255, 0.12); z-index: 4; }

.coo-sync-pos-screen { position: absolute; inset: 2px; border-radius: 2px; background: rgb(51, 65, 85); }

.coo-sync-pos-led { position: absolute; top: 1px; right: 2px; width: 3px; height: 3px; border-radius: 50%; background: rgb(34, 197, 94); animation: coo-sync-pos-led var(--sync-dur, 8s) step-end infinite; }

@keyframes coo-sync-pos-led { 
  0%, 100% { background: rgb(34, 197, 94); box-shadow: rgb(34, 197, 94) 0px 0px 4px; }
  8%, 38% { background: rgb(251, 191, 36); box-shadow: rgb(251, 191, 36) 0px 0px 4px; }
}

.coo-sync-wifi { position: absolute; top: 3px; left: 6%; z-index: 5; font-size: 7px; line-height: 1; color: rgb(251, 191, 36); animation: coo-sync-wifi-state var(--sync-dur, 8s) step-end infinite; }

@keyframes coo-sync-wifi-state { 
  0%, 10% { color: rgb(251, 191, 36); content: ""; }
  12%, 38% { color: rgb(239, 68, 68); }
  42%, 100% { color: rgb(34, 197, 94); }
}

.coo-sync-offline-badge { position: absolute; top: 12px; left: 4%; z-index: 5; font-size: 4px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; padding: 1px 3px; border-radius: 3px; background: rgba(251, 191, 36, 0.25); color: rgb(253, 230, 138); border: 1px solid rgba(251, 191, 36, 0.35); animation: coo-sync-badge-flip var(--sync-dur, 8s) step-end infinite; }

@keyframes coo-sync-badge-flip { 
  0%, 38% { opacity: 1; background: rgba(251, 191, 36, 0.25); color: rgb(253, 230, 138); }
  42%, 100% { opacity: 1; background: rgba(34, 197, 94, 0.25); color: rgb(187, 247, 208); content: "Sinxron"; }
}

.coo-sync-outbox { position: absolute; inset: 22px 6% 6px 38%; display: flex; flex-direction: column; gap: 2px; justify-content: flex-end; overflow: hidden; z-index: 3; }

.coo-sync-ticket { display: flex; align-items: center; justify-content: space-between; padding: 2px 4px; border-radius: 4px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1); font-size: 5px; font-weight: 700; color: rgba(255, 255, 255, 0.85); opacity: 0; transform: translateY(8px); animation: coo-sync-ticket-in var(--sync-dur, 8s) ease-out infinite; }

.coo-sync-ticket:nth-child(1) { animation-delay: 0.2s; }

.coo-sync-ticket:nth-child(2) { animation-delay: 0.5s; }

.coo-sync-ticket:nth-child(3) { animation-delay: 0.8s; }

@keyframes coo-sync-ticket-in { 
  0%, 8% { opacity: 0; transform: translateY(10px); }
  14%, 38% { opacity: 1; transform: translateY(0px); }
  48%, 100% { opacity: 0.4; transform: translateY(-4px) scale(0.95); }
}

.coo-sync-ticket-syncing { animation: coo-sync-ticket-upload var(--sync-dur, 8s) ease-in-out infinite; }

.coo-sync-ticket-syncing:nth-child(1) { animation-delay: 0.2s; }

.coo-sync-ticket-syncing:nth-child(2) { animation-delay: 0.5s; }

.coo-sync-ticket-syncing:nth-child(3) { animation-delay: 0.8s; }

@keyframes coo-sync-ticket-upload { 
  0%, 38% { opacity: 1; transform: translateY(0px); border-color: rgba(251, 191, 36, 0.3); }
  48%, 58% { opacity: 1; transform: translateY(-6px); border-color: rgba(147, 197, 253, 0.5); }
  65%, 100% { opacity: 0; transform: translateY(-14px) scale(0.8); }
}

.coo-sync-ticket-id { color: rgba(255, 255, 255, 0.5); font-weight: 600; }

.coo-sync-ticket-amt { color: rgb(196, 181, 253); }

.coo-sync-ring-wrap { position: absolute; top: 50%; right: 8%; transform: translateY(-50%); width: 28px; height: 28px; z-index: 4; opacity: 0; animation: coo-sync-ring-show var(--sync-dur, 8s) ease-out infinite; }

@keyframes coo-sync-ring-show { 
  0%, 44% { opacity: 0; transform: translateY(-50%) scale(0.8); }
  52%, 80% { opacity: 1; transform: translateY(-50%) scale(1); }
  90%, 100% { opacity: 0; }
}

.coo-sync-ring-bg { position: absolute; inset: 0px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.15); }

.coo-sync-ring-fg { position: absolute; inset: 0px; border-radius: 50%; border-width: 2px; border-style: solid; border-color: rgb(34, 197, 94) rgb(34, 197, 94) transparent transparent; border-image: initial; animation: coo-sync-ring-spin 1.2s linear infinite, coo-sync-ring-fill var(--sync-dur, 8s) ease-out infinite; }

@keyframes coo-sync-ring-spin { 
  100% { transform: rotate(360deg); }
}

@keyframes coo-sync-ring-fill { 
  0%, 48% { clip-path: inset(0px 100% 0px 0px); }
  65%, 78% { clip-path: inset(0px); }
  88%, 100% { clip-path: inset(0px); }
}

.coo-sync-ring-val { position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }

.coo-sync-ring-num { font-size: 7px; font-weight: 800; color: rgb(255, 255, 255); line-height: 1; }

.coo-sync-ring-lbl { font-size: 3px; font-weight: 700; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 1px; }

.coo-sync-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-sync-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-sync-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-sync-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-sync-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-sync.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-sync.layout-banner-wide .coo-sync-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-sync.layout-banner-wide .coo-sync-panel { width: 96px; height: 72px; border-radius: 8px; }

.visual-sync.layout-banner-wide .coo-sync-ring-wrap { width: 22px; height: 22px; right: 4%; }

.visual-sync.layout-banner-wide .coo-sync-ring-num { font-size: 6px; }

.visual-sync.layout-banner-wide .coo-sync-outbox .coo-sync-ticket:nth-child(3) { display: none; }

.visual-sync.layout-banner-wide .coo-sync-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-sync.layout-banner-wide .coo-sync-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-sync.layout-banner-wide .coo-sync-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-sync.layout-banner-wide .coo-sync-btn { padding: 6px 12px; font-size: 10px; }

.visual-sync.layout-banner-wide .coo-sync-btn .coo-arrow { display: none; }

.visual-sync.layout-banner-wide .coo-brand { display: none; }

.visual-sync.layout-square, .visual-sync.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-sync.layout-square .coo-sync-square, .visual-sync.layout-desktop-square .coo-sync-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-sync.layout-square .coo-sync-square-top, .visual-sync.layout-desktop-square .coo-sync-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-sync.layout-square .coo-sync-panel, .visual-sync.layout-desktop-square .coo-sync-panel { width: 130px; height: 118px; border-radius: 12px; }

.visual-sync.layout-square .coo-sync-ring-wrap, .visual-sync.layout-desktop-square .coo-sync-ring-wrap { width: 32px; height: 32px; }

.visual-sync.layout-square .coo-sync-copy .coo-hook, .visual-sync.layout-desktop-square .coo-sync-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

.visual-sync.layout-square .coo-sync-title, .visual-sync.layout-desktop-square .coo-sync-title { font-size: 17px; margin-bottom: 4px; text-align: center; }

.visual-sync.layout-square .coo-sync-desc, .visual-sync.layout-desktop-square .coo-sync-desc { font-size: 11px; text-align: center; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-sync.layout-square .coo-sync-btn, .visual-sync.layout-desktop-square .coo-sync-btn { width: 100%; justify-content: center; padding: 10px 14px; font-size: 11px; margin-top: auto; }

.visual-sync.layout-square .coo-brand, .visual-sync.layout-desktop-square .coo-brand { display: none; }

.visual-sync.layout-compact, .visual-sync.layout-mobile { flex-direction: column !important; padding: 6px 10px 5px !important; box-sizing: border-box !important; }

.visual-sync.layout-compact .coo-sync-compact, .visual-sync.layout-mobile .coo-sync-compact { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 4px; z-index: 2; min-height: 0px; }

.visual-sync.layout-compact .coo-sync-compact-top, .visual-sync.layout-mobile .coo-sync-compact-top { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; min-height: 0px; gap: 8px; padding: 2px 0px; overflow: hidden; }

.visual-sync.layout-compact .coo-sync-panel, .visual-sync.layout-mobile .coo-sync-panel { width: 72px; height: 62px; border-radius: 8px; }

.visual-sync.layout-compact .coo-sync-ring-wrap, .visual-sync.layout-mobile .coo-sync-ring-wrap { width: 18px; height: 18px; right: 2%; }

.visual-sync.layout-compact .coo-sync-outbox .coo-sync-ticket:nth-child(n+2), .visual-sync.layout-mobile .coo-sync-outbox .coo-sync-ticket:nth-child(n+2) { display: none; }

.visual-sync.layout-compact .coo-sync-particle, .visual-sync.layout-mobile .coo-sync-particle { display: none; }

.visual-sync.layout-compact .coo-sync-copy .coo-hook, .visual-sync.layout-mobile .coo-sync-copy .coo-hook { font-size: 7px; padding: 1px 4px; margin-bottom: 2px; display: inline-block; }

.visual-sync.layout-compact .coo-sync-title, .visual-sync.layout-mobile .coo-sync-title { font-size: 11px; -webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

.visual-sync.layout-compact .coo-sync-desc, .visual-sync.layout-mobile .coo-sync-desc { display: none; }

.visual-sync.layout-compact .coo-sync-compact-foot, .visual-sync.layout-mobile .coo-sync-compact-foot { display: flex; width: 100%; padding: 0px; flex-shrink: 0; z-index: 4; }

.visual-sync.layout-compact .coo-sync-btn, .visual-sync.layout-mobile .coo-sync-btn { width: 100%; justify-content: center; padding: 5px 10px; font-size: 9px; }

.visual-sync.layout-compact .coo-sync-btn .coo-arrow, .visual-sync.layout-mobile .coo-sync-btn .coo-arrow { display: none; }

.visual-sync.layout-compact .coo-brand, .visual-sync.layout-mobile .coo-brand { display: none; }

.visual-clock { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-clock[class*="theme-"] { background: linear-gradient(155deg, rgb(12, 25, 41) 0%, rgb(30, 58, 95) 50%, rgb(15, 39, 68) 100%) !important; color: rgb(240, 244, 248) !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; }

.visual-clock .coo-bg-orb { display: none !important; }

.visual-clock .coo-hook { background: rgba(244, 63, 94, 0.18) !important; color: rgb(253, 164, 175) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-clock .coo-btn { box-shadow: rgba(255, 255, 255, 0.15) 0px 4px 18px; background: rgb(248, 250, 252) !important; color: rgb(30, 41, 59) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-clock-shimmer { position: absolute; inset: -40%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 50% 40%, rgba(251, 191, 36, 0.12) 0%, transparent 45%), radial-gradient(circle at 30% 80%, rgba(255, 255, 255, 0.06) 0%, transparent 40%); }

.coo-clock-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-clock-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(255, 255, 255, 0.06) 0%, rgba(0, 0, 0, 0.4) 100%); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 24px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset; }

.coo-clock-shift-pill { position: absolute; top: 4px; left: 50%; transform: translateX(-50%); z-index: 5; padding: 2px 6px; border-radius: 99px; font-size: 4px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; animation: coo-clock-pill-flip var(--clk-dur, 8s) step-end infinite; }

@keyframes coo-clock-pill-flip { 
  0%, 48% { background: rgba(34, 197, 94, 0.25); color: rgb(187, 247, 208); border: 1px solid rgba(34, 197, 94, 0.4); }
  52%, 100% { background: rgba(251, 191, 36, 0.25); color: rgb(253, 230, 138); border: 1px solid rgba(251, 191, 36, 0.4); }
}

.coo-clock-face-wrap { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); width: 52%; aspect-ratio: 1 / 1; z-index: 3; }

.coo-clock-bezel { position: absolute; inset: 0px; border-radius: 50%; background: linear-gradient(145deg, rgb(55, 65, 81), rgb(31, 41, 55)); border: 2px solid rgba(251, 191, 36, 0.35); box-shadow: rgba(0, 0, 0, 0.5) 0px 2px 8px inset, rgba(0, 0, 0, 0.35) 0px 2px 12px; }

.coo-clock-dial { position: absolute; inset: 8%; border-radius: 50%; background: radial-gradient(circle at 40% 35%, rgb(30, 41, 59), rgb(15, 23, 42)); border: 1px solid rgba(255, 255, 255, 0.08); }

.coo-clock-tick { position: absolute; top: 50%; left: 50%; width: 1px; height: 42%; margin-left: -0.5px; transform-origin: center top; background: linear-gradient(rgba(251, 191, 36, 0.7) 0%, transparent 18%); }

.coo-clock-tick:nth-child(1) { transform: rotate(0deg); }

.coo-clock-tick:nth-child(2) { transform: rotate(30deg); height: 38%; opacity: 0.5; }

.coo-clock-tick:nth-child(3) { transform: rotate(60deg); }

.coo-clock-tick:nth-child(4) { transform: rotate(90deg); height: 38%; opacity: 0.5; }

.coo-clock-tick:nth-child(5) { transform: rotate(120deg); }

.coo-clock-tick:nth-child(6) { transform: rotate(150deg); height: 38%; opacity: 0.5; }

.coo-clock-tick:nth-child(7) { transform: rotate(180deg); }

.coo-clock-tick:nth-child(8) { transform: rotate(210deg); height: 38%; opacity: 0.5; }

.coo-clock-tick:nth-child(9) { transform: rotate(240deg); }

.coo-clock-tick:nth-child(10) { transform: rotate(270deg); height: 38%; opacity: 0.5; }

.coo-clock-tick:nth-child(11) { transform: rotate(300deg); }

.coo-clock-tick:nth-child(12) { transform: rotate(330deg); height: 38%; opacity: 0.5; }

.coo-clock-hand { position: absolute; bottom: 50%; left: 50%; transform-origin: center bottom; border-radius: 2px; z-index: 2; }

.coo-clock-hour-hand { width: 2px; height: 22%; margin-left: -1px; background: linear-gradient(rgb(248, 250, 252), rgb(203, 213, 225)); animation: coo-clock-hour-sweep var(--clk-dur, 8s) ease-in-out infinite; }

.coo-clock-min-hand { width: 1px; height: 30%; margin-left: -0.5px; background: linear-gradient(rgb(251, 191, 36), rgb(245, 158, 11)); animation: coo-clock-min-sweep var(--clk-dur, 8s) ease-in-out infinite; }

@keyframes coo-clock-hour-sweep { 
  0%, 15% { transform: rotate(40deg); }
  45%, 55% { transform: rotate(180deg); }
  75%, 100% { transform: rotate(180deg); }
}

@keyframes coo-clock-min-sweep { 
  0%, 15% { transform: rotate(120deg); }
  45%, 55% { transform: rotate(360deg); }
  75%, 100% { transform: rotate(360deg); }
}

.coo-clock-hub { position: absolute; top: 50%; left: 50%; width: 5px; height: 5px; margin: -2.5px 0px 0px -2.5px; border-radius: 50%; background: rgb(251, 191, 36); box-shadow: rgba(251, 191, 36, 0.6) 0px 0px 4px; z-index: 3; }

.coo-clock-digital { position: absolute; bottom: 22%; left: 0px; right: 0px; text-align: center; font-size: 7px; font-weight: 800; letter-spacing: 0.08em; color: rgb(251, 191, 36); font-variant-numeric: tabular-nums; animation: coo-clock-digital-tick var(--clk-dur, 8s) step-end infinite; }

@keyframes coo-clock-digital-tick { 
  0%, 44% { content: ""; opacity: 0.7; }
  48%, 100% { opacity: 1; text-shadow: rgba(251, 191, 36, 0.5) 0px 0px 8px; }
}

.coo-clock-report { position: absolute; bottom: 3px; left: 4px; right: 4px; padding: 3px 5px; border-radius: 6px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.12); display: flex; align-items: center; justify-content: space-between; opacity: 0; transform: translateY(8px); animation: coo-clock-report-in var(--clk-dur, 8s) ease-out infinite; z-index: 4; }

@keyframes coo-clock-report-in { 
  0%, 50% { opacity: 0; transform: translateY(10px); }
  58%, 82% { opacity: 1; transform: translateY(0px); }
  92%, 100% { opacity: 0; transform: translateY(4px); }
}

.coo-clock-report-lbl { font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.5); text-transform: uppercase; letter-spacing: 0.04em; }

.coo-clock-report-val { font-size: 7px; font-weight: 800; color: rgb(255, 255, 255); letter-spacing: -0.02em; }

.coo-clock-report-check { width: 10px; height: 10px; border-radius: 50%; background: rgb(34, 197, 94); color: rgb(255, 255, 255); font-size: 6px; font-weight: 800; display: flex; align-items: center; justify-content: center; line-height: 1; animation: coo-clock-check-pop var(--clk-dur, 8s) ease-out infinite; }

@keyframes coo-clock-check-pop { 
  0%, 54% { transform: scale(0); opacity: 0; }
  60%, 78% { transform: scale(1); opacity: 1; }
  88%, 100% { transform: scale(0.8); opacity: 0; }
}

.coo-clock-copy { min-width: 0px; overflow: hidden; z-index: 2; }

