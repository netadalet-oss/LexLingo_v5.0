.visual-inbox.layout-banner-wide .coo-inbox-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-inbox.layout-banner-wide .coo-inbox-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

