.visual-hot-sparkle .coo-hot-stage { background: linear-gradient(160deg, rgb(236, 253, 245) 0%, rgb(209, 250, 229) 45%, rgb(110, 231, 183) 100%); border-color: rgba(16, 185, 129, 0.25); }

.coo-hot-sparkle-bubble { position: absolute; border-radius: 50%; background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.9), rgba(16, 185, 129, 0.35)); border: 1px solid rgba(255, 255, 255, 0.5); animation: coo-hot-bubble-rise var(--hot-dur, 7s) ease-in infinite; opacity: 0; }

.coo-hot-sparkle-bubble:nth-child(1) { width: 10px; height: 10px; left: 15%; bottom: 10%; animation-delay: 0s; }

.coo-hot-sparkle-bubble:nth-child(2) { width: 8px; height: 8px; left: 45%; bottom: 8%; animation-delay: 0.6s; }

.coo-hot-sparkle-bubble:nth-child(3) { width: 12px; height: 12px; left: 70%; bottom: 12%; animation-delay: 1.2s; }

.coo-hot-sparkle-bubble:nth-child(4) { width: 6px; height: 6px; left: 30%; bottom: 6%; animation-delay: 1.8s; }

@keyframes coo-hot-bubble-rise { 
  0%, 10% { opacity: 0; transform: translateY(0px) scale(0.6); }
  25%, 60% { opacity: 0.85; transform: translateY(-28px) scale(1); }
  75%, 100% { opacity: 0; transform: translateY(-40px) scale(0.4); }
}

.coo-hot-sparkle-bottle { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); width: 18%; height: 48%; border-radius: 4px 4px 2px 2px; background: linear-gradient(rgb(52, 211, 153), rgb(5, 150, 105)); box-shadow: rgba(5, 150, 105, 0.35) 0px 4px 12px; }

.coo-hot-sparkle-bottle::before { content: ""; position: absolute; top: -18%; left: 25%; width: 50%; height: 20%; background: rgb(4, 120, 87); border-radius: 2px 2px 0px 0px; }

.coo-hot-sparkle-star { position: absolute; font-size: 8px; color: rgb(255, 255, 255); animation: 1.5s ease-in-out 0s infinite normal none running coo-hot-star-twinkle; }

.coo-hot-sparkle-star:nth-child(6) { top: 20%; left: 25%; animation-delay: 0s; }

.coo-hot-sparkle-star:nth-child(7) { top: 35%; right: 20%; animation-delay: 0.5s; }

@keyframes coo-hot-star-twinkle { 
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.1); }
}

.coo-hot-sparkle-label { position: absolute; top: 6px; left: 0px; right: 0px; text-align: center; font-size: 6px; font-weight: 800; color: rgb(4, 120, 87); letter-spacing: 0.08em; text-transform: uppercase; }

.coo-hot-sparkle-val { position: absolute; top: 18px; left: 0px; right: 0px; text-align: center; font-size: 9px; font-weight: 800; color: rgb(6, 95, 70); }

.coo-hot-sparkle-icons { position: absolute; bottom: 8px; left: 0px; right: 0px; display: flex; justify-content: center; gap: 6px; font-size: 12px; line-height: 1; z-index: 2; }

.coo-hot-sparkle-icons span { animation: coo-hot-icon-bounce var(--hot-dur, 7s) ease-in-out infinite; }

.coo-hot-sparkle-icons span:nth-child(1) { animation-delay: 0s; }

.coo-hot-sparkle-icons span:nth-child(2) { animation-delay: 0.35s; }

.coo-hot-sparkle-icons span:nth-child(3) { animation-delay: 0.7s; }

.coo-hot-sparkle-bottle.coo-hot-sparkle-bottle-alt { left: 28%; width: 14%; height: 40%; opacity: 0.75; }

.coo-hot-sparkle-bottle.coo-hot-sparkle-bottle-alt2 { left: 58%; width: 14%; height: 36%; opacity: 0.65; background: linear-gradient(rgb(110, 231, 183), rgb(16, 185, 129)); }

.visual-hot-pipeline .coo-hot-stage { background: linear-gradient(145deg, rgb(12, 74, 110), rgb(3, 105, 161)); }

.coo-hot-pipe-cols { position: absolute; inset: 8px 6px 22px; display: flex; gap: 3px; align-items: flex-end; }

.coo-hot-pipe-col { flex: 1 1 0%; background: rgba(255, 255, 255, 0.08); border-radius: 4px 4px 0px 0px; border: 1px solid rgba(255, 255, 255, 0.1); position: relative; min-height: 20%; }

.coo-hot-pipe-col:nth-child(1) { height: 35%; }

.coo-hot-pipe-col:nth-child(2) { height: 55%; }

.coo-hot-pipe-col:nth-child(3) { height: 75%; }

.coo-hot-pipe-col:nth-child(4) { height: 100%; background: rgba(16, 185, 129, 0.2); border-color: rgba(16, 185, 129, 0.4); }

.coo-hot-pipe-dot { position: absolute; top: 4px; left: 50%; transform: translateX(-50%); width: 6px; height: 6px; border-radius: 50%; background: rgba(255, 255, 255, 0.3); animation: coo-hot-pipe-dot-move var(--hot-dur, 7s) ease-in-out infinite; }

.coo-hot-pipe-col:nth-child(1) .coo-hot-pipe-dot { animation-delay: 0s; }

.coo-hot-pipe-col:nth-child(2) .coo-hot-pipe-dot { animation-delay: 0.5s; }

.coo-hot-pipe-col:nth-child(3) .coo-hot-pipe-dot { animation-delay: 1s; }

.coo-hot-pipe-col:nth-child(4) .coo-hot-pipe-dot { background: rgb(52, 211, 153); box-shadow: rgb(52, 211, 153) 0px 0px 6px; animation-delay: 1.5s; }

@keyframes coo-hot-pipe-dot-move { 
  0%, 15% { opacity: 0.3; transform: translateX(-50%) scale(0.8); }
  30%, 70% { opacity: 1; transform: translateX(-50%) scale(1.2); background: rgb(56, 189, 248); box-shadow: rgb(56, 189, 248) 0px 0px 6px; }
  85%, 100% { opacity: 0.3; }
}

.coo-hot-pipe-won { position: absolute; bottom: 4px; left: 0px; right: 0px; text-align: center; font-size: 5px; font-weight: 800; color: rgb(110, 231, 183); letter-spacing: 0.06em; text-transform: uppercase; animation: coo-hot-won-pop var(--hot-dur, 7s) ease-out infinite; }

@keyframes coo-hot-won-pop { 
  0%, 40% { opacity: 0; transform: scale(0.8); }
  50%, 75% { opacity: 1; transform: scale(1); }
  85%, 100% { opacity: 0; }
}

.coo-hot-pipe-check { position: absolute; top: 6px; right: 6px; width: 14px; height: 14px; border-radius: 50%; background: rgb(16, 185, 129); color: rgb(255, 255, 255); font-size: 8px; font-weight: 800; display: flex; align-items: center; justify-content: center; opacity: 0; animation: coo-hot-check-in var(--hot-dur, 7s) ease-out infinite; }

.coo-hot-pipe-labels { position: absolute; bottom: 14px; left: 6px; right: 6px; display: flex; gap: 3px; pointer-events: none; }

.coo-hot-pipe-label { flex: 1 1 0%; text-align: center; font-size: 4px; font-weight: 700; color: rgba(255, 255, 255, 0.55); letter-spacing: 0.02em; line-height: 1.1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.coo-hot-pipe-label:last-child { color: rgb(110, 231, 183); }

@keyframes coo-hot-check-in { 
  0%, 45% { opacity: 0; transform: scale(0); }
  55%, 75% { opacity: 1; transform: scale(1); }
  85%, 100% { opacity: 0; transform: scale(0.8); }
}

.visual-hot-booking.layout-banner-wide, .visual-hot-flash.layout-banner-wide, .visual-hot-drive.layout-banner-wide, .visual-hot-boutique.layout-banner-wide, .visual-hot-sparkle.layout-banner-wide, .visual-hot-pipeline.layout-banner-wide { display: flex; align-items: center; padding: 3px 10px 3px 8px; box-sizing: border-box; min-height: 100%; }

