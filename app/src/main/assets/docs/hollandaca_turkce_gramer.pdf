.layout-square .coo-eyebrow { font-size: 8px; margin: 0px; flex: 1 1 0%; min-width: 0px; }

.layout-square .coo-square-body { flex: 1 1 auto; min-height: 0px; overflow: hidden; display: flex; flex-direction: column; gap: 4px; margin-bottom: 0px; }

.layout-square .coo-hook { font-size: 8px; align-self: flex-start; }

.layout-square .coo-title { -webkit-line-clamp: 2; font-size: 16px; line-height: 1.2; }

.layout-square .coo-desc { -webkit-line-clamp: 3; font-size: 11px; line-height: 1.35; }

.layout-square .coo-btn { width: 100%; padding: 9px 12px; font-size: 11px; flex-shrink: 0; margin-top: auto; justify-content: center; }

.layout-desktop-square { flex-direction: column; padding: 14px 16px; justify-content: space-between; gap: 10px; min-height: 0px; }

