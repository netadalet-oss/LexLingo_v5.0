.visual-inbox.layout-compact .coo-inbox-compact-top, .visual-inbox.layout-mobile .coo-inbox-compact-top { display: grid; grid-template-columns: 78px minmax(0px, 1fr); column-gap: 8px; flex: 1 1 0%; min-height: 0px; max-height: calc(100% - 26px); align-items: center; overflow: hidden; }

