.visual-showcase { overflow: hidden; height: 100%; line-height: 1.3; padding: 0px; gap: 0px; align-items: stretch; font-family: Inter, -apple-system, sans-serif; }

.visual-showcase[class*="theme-"] { background: linear-gradient(168deg, rgb(250, 246, 240) 0%, rgb(240, 230, 216) 55%, rgb(232, 220, 200) 100%) !important; color: rgb(61, 41, 20) !important; border: 1px solid rgba(120, 80, 40, 0.22) !important; box-shadow: rgba(255, 255, 255, 0.85) 0px 1px 0px inset, rgba(61, 41, 20, 0.07) 0px 6px 24px !important; }

.visual-showcase .coo-bg-orb { display: none !important; }

.visual-showcase .coo-brand { color: rgba(61, 41, 20, 0.38); font-weight: 600; letter-spacing: 0.04em; }

.visual-showcase .coo-hook { font-weight: 600; letter-spacing: 0.06em; background: rgba(120, 53, 15, 0.08) !important; color: rgb(120, 53, 15) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-showcase .coo-btn { letter-spacing: 0.02em; box-shadow: rgba(26, 77, 46, 0.25) 0px 2px 8px; background: rgb(26, 77, 46) !important; color: rgb(250, 246, 240) !important; border-radius: 8px !important; font-weight: 600 !important; animation: auto ease 0s 1 normal none running none !important; }

@media (hover: hover) {
  .visual-showcase:hover .coo-btn { background: rgb(35, 107, 61) !important; }
}

.coo-showcase-serif { font-family: "Playfair Display", Georgia, "Times New Roman", serif; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }

.coo-showcase-grain { position: absolute; inset: 0px; z-index: 0; pointer-events: none; opacity: 0.35; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.08'/%3E%3C/svg%3E"); }

.coo-showcase-vignette { position: absolute; inset: 0px; z-index: 0; pointer-events: none; background: radial-gradient(at 30% 20%, rgba(255, 248, 235, 0.5) 0%, transparent 55%), radial-gradient(at 85% 90%, rgba(120, 80, 40, 0.08) 0%, transparent 50%); }

.coo-showcase-window { position: relative; flex-shrink: 0; display: flex; flex-direction: column; }

.coo-showcase-awning { height: 7px; border-radius: 3px 3px 0px 0px; flex-shrink: 0; background: repeating-linear-gradient(90deg, rgb(124, 45, 18) 0px, rgb(124, 45, 18) 6px, rgb(250, 246, 240) 6px, rgb(250, 246, 240) 12px); box-shadow: rgba(0, 0, 0, 0.12) 0px 1px 2px; }

.coo-showcase-frame { position: relative; border-width: medium 2px 2px; border-style: none solid solid; border-color: currentcolor rgb(139, 90, 43) rgb(139, 90, 43); border-image: initial; background: linear-gradient(rgb(107, 68, 35) 0%, rgb(139, 90, 43) 8%, rgb(160, 113, 79) 100%); padding: 3px; box-shadow: rgba(255, 255, 255, 0.15) 0px 0px 0px 1px inset, rgba(61, 41, 20, 0.2) 0px 3px 10px; }

.coo-showcase-frame::before, .coo-showcase-frame::after { content: ""; position: absolute; top: 50%; width: 5px; height: 5px; margin-top: -2px; border-radius: 50%; background: radial-gradient(circle, rgb(212, 175, 55) 0%, rgb(154, 123, 47) 100%); box-shadow: rgba(255, 255, 255, 0.5) 0px 1px 1px inset; z-index: 3; }

.coo-showcase-frame::before { left: 4px; }

.coo-showcase-frame::after { right: 4px; }

.coo-showcase-glass { position: relative; overflow: hidden; background: linear-gradient(175deg, rgb(255, 249, 240) 0%, rgb(245, 235, 224) 100%); min-height: 0px; }

.coo-showcase-glass::after { content: ""; position: absolute; inset: 0px; pointer-events: none; background: linear-gradient(125deg, rgba(255, 255, 255, 0.55) 0%, transparent 40%, transparent 70%, rgba(255, 255, 255, 0.2) 100%); }

.coo-showcase-curtain { position: absolute; left: 0px; right: 0px; top: 0px; height: 55%; z-index: 2; background: linear-gradient(rgb(107, 58, 42) 0%, rgb(139, 69, 19) 100%); transform-origin: center top; animation: 6s ease-in-out 0s infinite normal none running coo-showcase-curtain; box-shadow: rgba(0, 0, 0, 0.15) 0px 4px 12px; }

.coo-showcase-curtain::after { content: ""; position: absolute; bottom: 0px; left: 0px; right: 0px; height: 4px; background: repeating-linear-gradient(90deg, rgb(212, 175, 55) 0px, rgb(212, 175, 55) 4px, rgb(184, 134, 11) 4px, rgb(184, 134, 11) 8px); }

@keyframes coo-showcase-curtain { 
  0%, 18% { transform: scaleY(1); opacity: 1; }
  28%, 72% { transform: scaleY(0.08); opacity: 0.95; }
  82%, 100% { transform: scaleY(1); opacity: 1; }
}

.coo-showcase-shelf { display: flex; align-items: flex-end; justify-content: center; gap: 4px; padding: 6px 4px 4px; position: relative; z-index: 1; }

.coo-showcase-item { border-radius: 2px 2px 0px 0px; background: linear-gradient(rgb(196, 168, 130) 0%, rgb(139, 115, 85) 100%); box-shadow: rgba(0, 0, 0, 0.15) 0px 1px 2px; }

.coo-showcase-item-1 { width: 10px; height: 14px; }

.coo-showcase-item-2 { width: 8px; height: 18px; animation: 4s ease-in-out 0s infinite normal none running coo-showcase-item-glow; }

.coo-showcase-item-3 { width: 11px; height: 12px; }

@keyframes coo-showcase-item-glow { 
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.15); }
}

.coo-showcase-domain { position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); font-size: 5px; font-weight: 700; letter-spacing: 0.04em; color: rgb(26, 77, 46); background: rgba(255, 255, 255, 0.85); padding: 1px 4px; border-radius: 3px; white-space: nowrap; z-index: 4; opacity: 0; animation: 6s ease-in-out 0s infinite normal none running coo-showcase-domain; border: 1px solid rgba(26, 77, 46, 0.2); }

@keyframes coo-showcase-domain { 
  0%, 25% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  35%, 65% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  75%, 100% { opacity: 0; transform: translateX(-50%) translateY(4px); }
}

.coo-showcase-sign-wrap { position: absolute; top: -2px; left: 50%; transform: translateX(-50%); z-index: 5; transform-origin: center top; animation: 3.5s ease-in-out 0s infinite normal none running coo-showcase-sign-swing; }

@keyframes coo-showcase-sign-swing { 
  0%, 100% { transform: translateX(-50%) rotate(-2deg); }
  50% { transform: translateX(-50%) rotate(2deg); }
}

.coo-showcase-sign-chain { width: 1px; height: 5px; background: rgb(139, 115, 85); margin: 0px auto; }

.coo-showcase-sign { display: block; font-size: 6px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 5px; border-radius: 3px; background: linear-gradient(rgb(26, 77, 46) 0%, rgb(15, 51, 32) 100%); color: rgb(250, 246, 240); border: 1px solid rgb(212, 175, 55); box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 6px; white-space: nowrap; line-height: 1.2; }

.coo-showcase-lamp { position: absolute; top: 8px; right: 6px; width: 8px; height: 8px; border-radius: 50%; background: radial-gradient(circle, rgb(253, 230, 138) 0%, rgb(245, 158, 11) 60%, transparent 70%); animation: 2.8s ease-in-out 0s infinite normal none running coo-showcase-lamp; z-index: 2; }

@keyframes coo-showcase-lamp { 
  0%, 100% { opacity: 0.5; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}

.coo-showcase-trust { font-size: 8px; font-weight: 500; color: rgba(61, 41, 20, 0.62); letter-spacing: 0.01em; line-height: 1.35; }

