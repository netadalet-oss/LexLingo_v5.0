@charset "utf-8";

.skeleton-wrapper { width: 100%; padding: 20px 0px; }

.skeleton-loading-message { text-align: center; font-size: 14px; color: var(--coms-meta, #999); margin-bottom: 20px; animation: 1.5s ease-in-out 0s infinite normal none running skeleton-pulse; }

.skeleton-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 0px; }

@media (max-width: 1200px) {
  .skeleton-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 768px) {
  .skeleton-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
}

@media (max-width: 480px) {
  .skeleton-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}

.skeleton-book-card { background: var(--block-bg, #fff); border-radius: 8px; padding: 12px; overflow: hidden; }

.skeleton-cover { width: 100%; padding-bottom: 150%; border-radius: 6px; margin-bottom: 12px; position: relative; overflow: hidden; }

.skeleton-title { height: 18px; border-radius: 4px; margin-bottom: 8px; width: 90%; }

.skeleton-author { height: 14px; border-radius: 4px; margin-bottom: 8px; width: 70%; }

.skeleton-meta { height: 12px; border-radius: 4px; width: 50%; }

.skeleton-list-item { display: flex; align-items: center; gap: 15px; padding: 15px; background: var(--block-bg, #fff); border-radius: 8px; margin-bottom: 10px; }

.skeleton-avatar { width: 50px; height: 50px; border-radius: 50%; flex-shrink: 0; }

.skeleton-text-block { flex: 1 1 0%; }

.skeleton-text { height: 14px; border-radius: 4px; margin-bottom: 8px; width: 100%; }

.skeleton-text.short { width: 60%; }

.skeleton-detail { background: var(--block-bg, #fff); border-radius: 8px; padding: 20px; }

.skeleton-hero { width: 100%; height: 300px; border-radius: 8px; margin-bottom: 20px; }

.skeleton-content { padding: 20px 0px; }

.skeleton-cover, .skeleton-title, .skeleton-author, .skeleton-meta, .skeleton-avatar, .skeleton-text, .skeleton-hero { background-image: ; background-position-x: ; background-position-y: ; background-repeat: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; background-size: 200% 100%; animation: 2s ease-in-out 0s infinite normal none running skeleton-shimmer; }

html.darktheme .skeleton-cover, html.darktheme .skeleton-title, html.darktheme .skeleton-author, html.darktheme .skeleton-meta, html.darktheme .skeleton-avatar, html.darktheme .skeleton-text, html.darktheme .skeleton-hero { --skeleton-base: #2a2d3a; --skeleton-highlight: #363a4f; background: linear-gradient(
    90deg,
    var(--skeleton-base) 0%,
    var(--skeleton-highlight) 50%,
    var(--skeleton-base) 100%
  ); }

html:not(.darktheme) .skeleton-cover, html:not(.darktheme) .skeleton-title, html:not(.darktheme) .skeleton-author, html:not(.darktheme) .skeleton-meta, html:not(.darktheme) .skeleton-avatar, html:not(.darktheme) .skeleton-text, html:not(.darktheme) .skeleton-hero { --skeleton-base: #e0e0e0; --skeleton-highlight: #f5f5f5; }

@keyframes skeleton-shimmer { 
  0% { background-position: 200% 0px; }
  100% { background-position: -200% 0px; }
}

@keyframes skeleton-pulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.skeleton-append-wrapper { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 20px; }

@media (max-width: 1200px) {
  .skeleton-append-wrapper { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 768px) {
  .skeleton-append-wrapper { grid-template-columns: repeat(2, 1fr); gap: 15px; }
}

.skeleton-loading { animation: 0.3s ease-in-out 0s 1 normal none running skeleton-fade-in; }

@keyframes skeleton-fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.skeleton-wrapper[aria-busy="true"] { pointer-events: none; }

.skeleton-cover, .skeleton-title, .skeleton-author, .skeleton-meta, .skeleton-avatar, .skeleton-text, .skeleton-hero { will-change: background-position; }
