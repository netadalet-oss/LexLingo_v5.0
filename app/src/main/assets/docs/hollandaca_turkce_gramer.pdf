Content-Location: cid:css-fd580560-29f9-4bd6-a77e-32d30fca986a@mhtml.blink

@charset "utf-8";

.epub-read-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 12px 20px; background: linear-gradient(135deg, rgb(255, 107, 107) 0%, rgb(238, 90, 82) 100%); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; box-shadow: rgba(255, 107, 107, 0.35) 0px 4px 15px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; position: relative; overflow: hidden; width: 100%; margin-top: 10px; margin-bottom: 10px; }

.epub-read-btn::before { content: ""; position: absolute; top: 50%; left: 50%; width: 0px; height: 0px; border-radius: 50%; background: rgba(255, 255, 255, 0.15); transform: translate(-50%, -50%); transition: width 0.6s, height 0.6s; }

.epub-read-btn:hover::before { width: 300px; height: 300px; }

.epub-read-btn:hover { background: linear-gradient(135deg, rgb(238, 90, 82) 0%, rgb(220, 75, 67) 100%); box-shadow: rgba(255, 107, 107, 0.45) 0px 6px 20px; transform: translateY(-3px); color: white; }

.epub-read-btn:active { transform: translateY(-1px); box-shadow: rgba(255, 107, 107, 0.35) 0px 3px 10px; }

.epub-read-btn i { font-size: 16px; position: relative; z-index: 1; }

.epub-read-btn span { position: relative; z-index: 1; }

@media (max-width: 600px) {
  .epub-read-btn { padding: 12px 24px; font-size: 15px; }
}
