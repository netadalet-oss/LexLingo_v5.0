.visual-insight { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.coo-insight-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 70% 30%, rgba(167, 139, 250, 0.35) 0%, transparent 50%), radial-gradient(circle at 15% 80%, rgba(124, 58, 237, 0.2) 0%, transparent 45%); animation: 5s ease-in-out 0s infinite normal none running coo-insight-glow-shift; }

@keyframes coo-insight-glow-shift { 
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; transform: rotate(2deg) scale(1.04); }
}

.coo-insight-neural { position: absolute; inset: 0px; z-index: 0; pointer-events: none; opacity: 0.15; background-image: radial-gradient(circle at 20% 30%, rgb(255, 255, 255) 1px, transparent 1px), radial-gradient(circle at 60% 70%, rgb(255, 255, 255) 1px, transparent 1px), radial-gradient(circle at 80% 20%, rgb(255, 255, 255) 1px, transparent 1px), radial-gradient(circle at 40% 80%, rgb(255, 255, 255) 1px, transparent 1px); background-size: 100% 100%; animation: 8s linear 0s infinite normal none running coo-insight-neural-drift; }

@keyframes coo-insight-neural-drift { 
  100% { transform: translate(-8px, -6px); }
}

.coo-insight-scan { position: absolute; left: 0px; right: 0px; height: 2px; z-index: 1; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent); animation: 3.5s ease-in-out 0s infinite normal none running coo-insight-scan; }

@keyframes coo-insight-scan { 
  0% { top: 8%; opacity: 0; }
  15% { opacity: 0.8; }
  100% { top: 92%; opacity: 0; }
}

.coo-insight-ai-icon { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-insight-ai-ring { position: absolute; inset: -2px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.25); animation: 10s linear 0s infinite normal none running coo-insight-ai-spin; }

@keyframes coo-insight-ai-spin { 
  100% { transform: rotate(360deg); }
}

.coo-insight-ai-tile { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255, 255, 255, 0.14); color: rgb(233, 213, 255); }

.coo-insight-ai-label { position: absolute; bottom: -3px; left: 50%; transform: translateX(-50%); font-size: 6px; font-weight: 800; letter-spacing: 0.12em; color: rgb(196, 181, 253); white-space: nowrap; }

.coo-insight-rotator { position: relative; overflow: hidden; flex: 1 1 0%; min-width: 0px; min-height: 0px; border-radius: 10px; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1); }

.coo-insight-rotator::after { content: ""; position: absolute; inset: 0px; pointer-events: none; z-index: 2; background: linear-gradient(rgba(0, 0, 0, 0.35) 0%, transparent 25%, transparent 75%, rgba(0, 0, 0, 0.35) 100%); }

.coo-insight-track { display: flex; flex-direction: column; width: 100%; height: 400%; animation: coo-insight-roll var(--insight-dur, 14s) cubic-bezier(0.45, 0, 0.55, 1) infinite; }

@keyframes coo-insight-roll { 
  0%, 20% { transform: translateY(0px); }
  25%, 45% { transform: translateY(-25%); }
  50%, 70% { transform: translateY(-50%); }
  75%, 95% { transform: translateY(-75%); }
  100% { transform: translateY(0px); }
}

.coo-insight-slide { flex: 0 0 25%; height: 25%; min-height: 0px; display: flex; align-items: center; gap: 8px; padding: 0px 10px; box-sizing: border-box; }

.coo-insight-tag { flex-shrink: 0; font-size: 8px; font-weight: 800; letter-spacing: 0.06em; padding: 2px 6px; border-radius: 5px; line-height: 1; background: rgba(255, 255, 255, 0.2); color: rgb(253, 230, 138); }

.coo-insight-line { flex: 1 1 0%; min-width: 0px; font-weight: 600; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coo-insight-cursor { position: absolute; right: 8px; bottom: 4px; z-index: 3; font-size: 10px; font-weight: 300; opacity: 0.7; color: rgb(196, 181, 253); animation: 0.9s step-end 0s infinite normal none running coo-insight-cursor-blink; }

@keyframes coo-insight-cursor-blink { 
  0%, 100% { opacity: 0; }
  50% { opacity: 1; }
}

.coo-insight-spark { flex-shrink: 0; display: block; overflow: visible; }

.coo-insight-spark-path { fill: none; stroke: rgba(255, 255, 255, 0.85); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 80; stroke-dashoffset: 80; animation: 2.5s ease-in-out 0s infinite normal none running coo-insight-spark-draw; }

@keyframes coo-insight-spark-draw { 
  0% { stroke-dashoffset: 80; opacity: 0.4; }
  40%, 70% { stroke-dashoffset: 0; opacity: 1; }
  100% { stroke-dashoffset: -20; opacity: 0.5; }
}

