.visual-oemrack { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-oemrack[class*="theme-"] { background: linear-gradient(155deg, rgb(15, 23, 42) 0%, rgb(30, 58, 138) 38%, rgb(30, 64, 175) 62%, rgb(51, 65, 85) 100%) !important; color: rgb(226, 232, 240) !important; border: 1px solid rgba(96, 165, 250, 0.22) !important; }

.visual-oemrack .coo-bg-orb { display: none !important; }

.visual-oemrack .coo-hook { background: rgba(59, 130, 246, 0.2) !important; color: rgb(147, 197, 253) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-oemrack .coo-btn { box-shadow: rgba(245, 158, 11, 0.35) 0px 4px 18px; background: rgb(245, 158, 11) !important; color: rgb(30, 41, 59) !important; border-radius: 999px !important; font-weight: 700 !important; animation: auto ease 0s 1 normal none running none !important; }

.coo-oem-glow { position: absolute; inset: -35%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 30% 50%, rgba(245, 158, 11, 0.1) 0%, transparent 48%), radial-gradient(circle at 75% 40%, rgba(59, 130, 246, 0.12) 0%, transparent 42%); }

.coo-oem-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-oem-panel { position: relative; width: 100%; height: 100%; border-radius: 10px; overflow: hidden; background: linear-gradient(165deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 58, 138, 0.45) 100%); border: 1px solid rgba(96, 165, 250, 0.25); box-shadow: rgba(0, 0, 0, 0.45) 0px 8px 24px; }

.coo-oem-head { display: flex; align-items: center; justify-content: space-between; padding: 3px 5px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); z-index: 4; }

.coo-oem-head-label { font-size: 3px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }

.coo-oem-count { font-size: 4px; font-weight: 800; color: rgb(251, 191, 36); }

.coo-oem-bins { position: absolute; inset: 14px 4px 18px; display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); gap: 3px; z-index: 2; }

.coo-oem-bin { border-radius: 3px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); position: relative; overflow: hidden; padding: 2px 3px; }

.coo-oem-bin-code { font-size: 3px; font-weight: 800; color: rgb(147, 197, 253); }

.coo-oem-bin-loc { font-size: 2px; font-weight: 700; color: rgba(255, 255, 255, 0.4); margin-top: 1px; }

.coo-oem-bin-low { border-color: rgba(245, 158, 11, 0.5); background: rgba(245, 158, 11, 0.08); }

.coo-oem-bin-low .coo-oem-bin-code { color: rgb(251, 191, 36); }

.coo-oem-bin-low::after { content: "!"; position: absolute; top: 2px; right: 2px; font-size: 4px; font-weight: 900; color: rgb(245, 158, 11); }

.coo-oem-bin-found { animation: coo-oem-bin-found var(--oem-dur, 8s) ease-in-out infinite; z-index: 3; }

@keyframes coo-oem-bin-found { 
  0%, 25% { box-shadow: none; border-color: rgba(255, 255, 255, 0.1); }
  35%, 65% { border-color: rgb(34, 197, 94); box-shadow: rgba(34, 197, 94, 0.5) 0px 0px 10px; background: rgba(34, 197, 94, 0.15); }
  75%, 100% { border-color: rgba(34, 197, 94, 0.4); }
}

.coo-oem-scan { position: absolute; left: 0px; right: 0px; height: 2px; z-index: 5; background: linear-gradient(90deg, transparent, rgb(245, 158, 11), transparent); opacity: 0; animation: coo-oem-scan var(--oem-dur, 8s) ease-in-out infinite; }

@keyframes coo-oem-scan { 
  0%, 20% { opacity: 0; top: 20%; }
  30%, 40% { opacity: 1; top: 45%; }
  50%, 100% { opacity: 0; top: 70%; }
}

.coo-oem-locate { position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); padding: 2px 5px; border-radius: 99px; z-index: 6; background: rgba(34, 197, 94, 0.9); color: rgb(255, 255, 255); font-size: 3px; font-weight: 800; white-space: nowrap; opacity: 0; animation: coo-oem-locate-in var(--oem-dur, 8s) ease-out infinite; }

@keyframes coo-oem-locate-in { 
  0%, 38% { opacity: 0; transform: translateX(-50%) translateY(4px); }
  46%, 78% { opacity: 1; transform: translateX(-50%) translateY(0px); }
  88%, 100% { opacity: 0.9; }
}

