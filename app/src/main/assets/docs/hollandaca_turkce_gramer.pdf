.coo-plt-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-plt-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.coo-plt-wide-cta { display: flex; align-items: center; justify-content: flex-end; align-self: center; z-index: 3; flex-shrink: 0; }

.visual-plate.layout-banner-wide { display: flex; align-items: center; padding: 6px 14px 6px 10px; box-sizing: border-box; }

.visual-plate.layout-banner-wide .coo-plt-wide { display: grid; grid-template-columns: 96px minmax(0px, 1fr) auto; align-items: center; column-gap: 10px; width: 100%; height: 100%; min-width: 0px; max-height: 100%; z-index: 2; }

.visual-plate.layout-banner-wide .coo-plt-kds { width: 96px; height: 72px; border-radius: 8px; }

.visual-plate.layout-banner-wide .coo-plt-ticket { width: 42%; }

.visual-plate.layout-banner-wide .coo-plt-bell { display: none; }

.visual-plate.layout-banner-wide .coo-plt-copy .coo-hook { font-size: 7px; padding: 2px 5px; margin-bottom: 2px; display: inline-block; }

.visual-plate.layout-banner-wide .coo-plt-title { font-size: 13px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

.visual-plate.layout-banner-wide .coo-plt-desc { font-size: 8px; -webkit-line-clamp: 1; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; }

.visual-plate.layout-banner-wide .coo-plt-btn { padding: 6px 12px; font-size: 10px; }

.visual-plate.layout-banner-wide .coo-plt-btn .coo-arrow { display: none; }

.visual-plate.layout-banner-wide .coo-brand { display: none; }

.visual-plate.layout-square, .visual-plate.layout-desktop-square { flex-direction: column; padding: 12px 14px 14px; box-sizing: border-box; }

.visual-plate.layout-square .coo-plt-square, .visual-plate.layout-desktop-square .coo-plt-square { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 10px; z-index: 2; min-height: 0px; }

.visual-plate.layout-square .coo-plt-square-top, .visual-plate.layout-desktop-square .coo-plt-square-top { display: flex; justify-content: center; flex-shrink: 0; }

.visual-plate.layout-square .coo-plt-kds, .visual-plate.layout-desktop-square .coo-plt-kds { width: 130px; height: 118px; border-radius: 12px; }

.visual-plate.layout-square .coo-plt-table-num, .visual-plate.layout-desktop-square .coo-plt-table-num { font-size: 9px; }

.visual-plate.layout-square .coo-plt-copy .coo-hook, .visual-plate.layout-desktop-square .coo-plt-copy .coo-hook { font-size: 9px; padding: 3px 8px; margin-bottom: 6px; display: inline-block; }

