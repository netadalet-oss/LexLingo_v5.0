  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

.coo-live-device { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }

.coo-live-ring { position: absolute; inset: 0px; border-radius: 14px; border: 2px solid rgba(74, 222, 128, 0.45); animation: 2s ease-in-out 0s infinite normal none running coo-live-ring-pulse; }

@keyframes coo-live-ring-pulse { 
