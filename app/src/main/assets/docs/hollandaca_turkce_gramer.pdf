@charset "utf-8";

.notification-count { position: absolute; top: -5px; right: -5px; background: rgb(255, 71, 87); color: white; border-radius: 50%; padding: 2px 6px; font-size: 11px; font-weight: bold; min-width: 18px; text-align: center; line-height: 1.2; border: 2px solid white; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 4px; z-index: 10; }

.notification-count[data-count="0"], .notification-count:empty { display: none !important; }

.dropdown.userpanel .dropdown-btn { position: relative; }

.notification-badge { background: rgb(255, 71, 87); color: white; border-radius: 12px; padding: 2px 6px; font-size: 10px; font-weight: bold; margin-left: 5px; display: inline-block; min-width: 16px; text-align: center; vertical-align: middle; }

.notification-badge:empty { display: none; }

.notification-count:hover { transform: scale(1.1); transition: transform 0.2s; }

@media (max-width: 768px) {
  .notification-count { font-size: 10px; padding: 1px 4px; min-width: 16px; }
}
