.coo-smart-wrap.theme-trust-navy, .coo-banner-slot > a.coo-smart-wrap.theme-trust-navy { background: linear-gradient(135deg, rgb(12, 25, 41) 0%, rgb(30, 58, 95) 100%); color: rgb(240, 244, 248); border: 1px solid rgba(255, 255, 255, 0.08); }

.theme-trust-navy .coo-bg-orb-1 { background: rgb(37, 99, 235); }

.theme-trust-navy .coo-bg-orb-2 { background: rgb(14, 165, 233); }

.theme-trust-navy .coo-hook { background: rgba(37, 99, 235, 0.25); color: rgb(147, 197, 253); }

.theme-trust-navy .coo-btn { background: rgb(255, 255, 255); color: rgb(12, 25, 41); }

.coo-smart-wrap.theme-action-amber, .coo-banner-slot > a.coo-smart-wrap.theme-action-amber { background: linear-gradient(135deg, rgb(194, 65, 12) 0%, rgb(245, 158, 11) 100%); color: rgb(255, 255, 255); }

.theme-action-amber .coo-bg-orb-1 { background: rgb(254, 243, 199); }

.theme-action-amber .coo-hook { background: rgba(0, 0, 0, 0.15); color: rgb(255, 255, 255); }

.theme-action-amber .coo-btn { background: rgb(255, 255, 255); color: rgb(194, 65, 12); }

.theme-action-amber .coo-icon-tile { background: rgba(255, 255, 255, 0.2) !important; color: rgb(255, 255, 255) !important; }

.coo-smart-wrap.theme-growth-emerald, .coo-banner-slot > a.coo-smart-wrap.theme-growth-emerald { background: linear-gradient(135deg, rgb(4, 120, 87) 0%, rgb(16, 185, 129) 100%); color: rgb(255, 255, 255); }

.theme-growth-emerald .coo-bg-orb-1 { background: rgb(209, 250, 229); }

.theme-growth-emerald .coo-hook { background: rgba(255, 255, 255, 0.18); color: rgb(255, 255, 255); }

.theme-growth-emerald .coo-btn { background: rgb(255, 255, 255); color: rgb(4, 120, 87); }

.theme-growth-emerald .coo-icon-tile { background: rgba(255, 255, 255, 0.2) !important; color: rgb(255, 255, 255) !important; }

.coo-smart-wrap.theme-premium-violet, .coo-banner-slot > a.coo-smart-wrap.theme-premium-violet { background: linear-gradient(135deg, rgb(76, 29, 149) 0%, rgb(124, 58, 237) 100%); color: rgb(255, 255, 255); }

.theme-premium-violet .coo-bg-orb-1 { background: rgb(233, 213, 255); }

.theme-premium-violet .coo-hook { background: rgba(255, 255, 255, 0.15); color: rgb(233, 213, 255); }

.theme-premium-violet .coo-btn { background: rgb(255, 255, 255); color: rgb(91, 33, 182); }

.theme-premium-violet .coo-icon-tile { background: rgba(255, 255, 255, 0.18) !important; color: rgb(255, 255, 255) !important; }

.coo-smart-wrap.theme-pulse-coral, .coo-banner-slot > a.coo-smart-wrap.theme-pulse-coral { background: linear-gradient(135deg, rgb(225, 29, 72) 0%, rgb(249, 115, 22) 100%); color: rgb(255, 255, 255); }

.theme-pulse-coral .coo-bg-orb-1 { background: rgb(254, 205, 211); }

.theme-pulse-coral .coo-hook { background: rgba(0, 0, 0, 0.12); color: rgb(255, 255, 255); animation: 2.5s ease-in-out 0s infinite normal none running coo-shimmer; }

.theme-pulse-coral .coo-btn { background: rgb(255, 255, 255); color: rgb(225, 29, 72); }

.theme-pulse-coral .coo-icon-tile { background: rgba(255, 255, 255, 0.2) !important; color: rgb(255, 255, 255) !important; }

.coo-smart-wrap.theme-clean-slate, .coo-banner-slot > a.coo-smart-wrap.theme-clean-slate { background: rgb(255, 255, 255); color: rgb(17, 24, 39); border: 1px solid rgb(229, 231, 235); box-shadow: rgba(0, 0, 0, 0.04) 0px 1px 8px; }

.theme-clean-slate .coo-bg-orb { display: none; }

.theme-clean-slate .coo-hook { background: rgb(236, 253, 245); color: rgb(5, 150, 105); animation: auto ease 0s 1 normal none running none; }

.theme-clean-slate .coo-btn { background: rgb(5, 150, 105); color: rgb(255, 255, 255); animation: auto ease 0s 1 normal none running none; }

.theme-clean-slate .coo-eyebrow { color: rgb(5, 150, 105); }

.coo-smart-wrap.theme-classic-warm, .coo-banner-slot > a.coo-smart-wrap.theme-classic-warm { background: linear-gradient(168deg, rgb(250, 246, 240) 0%, rgb(240, 230, 216) 55%, rgb(232, 220, 200) 100%); color: rgb(61, 41, 20); border: 1px solid rgba(120, 80, 40, 0.22); box-shadow: rgba(255, 255, 255, 0.85) 0px 1px 0px inset, rgba(61, 41, 20, 0.07) 0px 6px 24px; }

.theme-classic-warm .coo-bg-orb { display: none; }

.theme-classic-warm .coo-hook { background: rgba(120, 53, 15, 0.08); color: rgb(120, 53, 15); animation: auto ease 0s 1 normal none running none; }

.theme-classic-warm .coo-btn { background: rgb(26, 77, 46); color: rgb(250, 246, 240); animation: auto ease 0s 1 normal none running none; }

.theme-classic-warm .coo-eyebrow { color: rgb(120, 53, 15); }

.coo-smart-wrap.theme-cinema-slate, .coo-banner-slot > a.coo-smart-wrap.theme-cinema-slate { background: linear-gradient(145deg, rgb(12, 15, 20) 0%, rgb(21, 27, 36) 50%, rgb(15, 20, 25) 100%); color: rgb(241, 245, 249); border: 1px solid rgba(255, 255, 255, 0.06); }

.theme-cinema-slate .coo-bg-orb { display: none; }

.theme-cinema-slate .coo-hook { background: rgba(33, 115, 70, 0.25); color: rgb(134, 239, 172); animation: auto ease 0s 1 normal none running none; }

.theme-cinema-slate .coo-btn { background: rgb(16, 185, 129); color: rgb(4, 47, 26); animation: auto ease 0s 1 normal none running none; }

.theme-cinema-slate .coo-eyebrow { color: rgb(110, 231, 183); }

.coo-smart-wrap.theme-thermal-mono, .coo-banner-slot > a.coo-smart-wrap.theme-thermal-mono { background: linear-gradient(160deg, rgb(26, 35, 50) 0%, rgb(36, 48, 68) 55%, rgb(30, 41, 59) 100%); color: rgb(248, 250, 252); border: 1px solid rgba(255, 255, 255, 0.07); }

.theme-thermal-mono .coo-bg-orb { display: none; }

.theme-thermal-mono .coo-hook { background: rgba(244, 63, 94, 0.18); color: rgb(253, 164, 175); animation: auto ease 0s 1 normal none running none; }

.theme-thermal-mono .coo-btn { background: rgb(248, 250, 252); color: rgb(30, 41, 59); animation: auto ease 0s 1 normal none running none; }

.theme-thermal-mono .coo-eyebrow { color: rgb(148, 163, 184); }

.coo-smart-wrap.theme-social-aurora, .coo-banner-slot > a.coo-smart-wrap.theme-social-aurora { background: linear-gradient(145deg, rgb(15, 10, 20) 0%, rgb(26, 16, 36) 40%, rgb(18, 8, 26) 100%); color: rgb(250, 250, 250); border: 1px solid rgba(255, 255, 255, 0.08); }

.theme-social-aurora .coo-bg-orb { display: none; }

.theme-social-aurora .coo-hook { background: rgba(236, 72, 153, 0.2); color: rgb(251, 207, 232); animation: auto ease 0s 1 normal none running none; }

.theme-social-aurora .coo-btn { background: linear-gradient(135deg, rgb(247, 119, 55), rgb(253, 29, 29), rgb(131, 58, 180)); color: rgb(255, 255, 255); animation: auto ease 0s 1 normal none running none; }

.theme-social-aurora .coo-eyebrow { color: rgb(232, 121, 249); }

.coo-smart-wrap.theme-fintech-noir, .coo-banner-slot > a.coo-smart-wrap.theme-fintech-noir { background: linear-gradient(155deg, rgb(5, 8, 16) 0%, rgb(12, 18, 34) 45%, rgb(8, 13, 24) 100%); color: rgb(241, 245, 249); border: 1px solid rgba(56, 189, 248, 0.12); }

.theme-fintech-noir .coo-bg-orb { display: none; }

.theme-fintech-noir .coo-hook { background: rgba(56, 189, 248, 0.15); color: rgb(125, 211, 252); animation: auto ease 0s 1 normal none running none; }

.theme-fintech-noir .coo-btn { background: rgb(56, 189, 248); color: rgb(4, 47, 74); animation: auto ease 0s 1 normal none running none; }

.theme-fintech-noir .coo-eyebrow { color: rgb(125, 211, 252); }

.coo-smart-wrap.theme-hot-pulse, .coo-banner-slot > a.coo-smart-wrap.theme-hot-pulse { background: linear-gradient(135deg, rgb(30, 27, 75) 0%, rgb(124, 58, 237) 45%, rgb(225, 29, 72) 100%) 0% 0% / 200% 200%; animation: 6s ease 0s infinite normal none running coo-gradient-shift; color: rgb(255, 255, 255); border: 1px solid rgba(255, 255, 255, 0.12); }

@keyframes coo-gradient-shift { 
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.theme-hot-pulse .coo-bg-orb-1 { background: rgb(251, 191, 36); animation: 4s ease-in-out 0s infinite normal none running coo-float; }

.theme-hot-pulse .coo-hook { background: rgba(251, 191, 36, 0.25); color: rgb(253, 230, 138); animation: 2s ease-in-out 0s infinite normal none running coo-shimmer; }

.theme-hot-pulse .coo-btn { background: rgb(251, 191, 36); color: rgb(30, 27, 75); font-weight: 700; }

.theme-hot-pulse .coo-icon-tile { background: rgba(255, 255, 255, 0.15) !important; color: rgb(253, 230, 138) !important; }

@keyframes coo-shimmer { 
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.85; transform: scale(1.02); }
}

.theme-apple-dark { background: linear-gradient(135deg, rgb(12, 25, 41) 0%, rgb(30, 58, 95) 100%); color: rgb(240, 244, 248); }

.theme-apple-dark .coo-btn { background: rgb(255, 255, 255); color: rgb(12, 25, 41); }

.theme-apple-light { background: rgb(255, 255, 255); color: rgb(17, 24, 39); border: 1px solid rgb(229, 231, 235); }

.theme-apple-light .coo-btn { background: rgb(5, 150, 105); color: rgb(255, 255, 255); }

.theme-apple-blue { background: linear-gradient(135deg, rgb(30, 58, 95), rgb(37, 99, 235)); color: rgb(255, 255, 255); }

.theme-apple-blue .coo-btn { background: rgb(255, 255, 255); color: rgb(30, 58, 95); }

.theme-apple-emerald { background: linear-gradient(135deg, rgb(4, 120, 87), rgb(16, 185, 129)); color: rgb(255, 255, 255); }

.theme-apple-emerald .coo-btn { background: rgb(255, 255, 255); color: rgb(4, 120, 87); }

.theme-apple-indigo { background: linear-gradient(135deg, rgb(76, 29, 149), rgb(124, 58, 237)); color: rgb(255, 255, 255); }

.theme-apple-indigo .coo-btn { background: rgb(255, 255, 255); color: rgb(91, 33, 182); }

.theme-apple-warm { background: linear-gradient(135deg, rgb(225, 29, 72), rgb(249, 115, 22)); color: rgb(255, 255, 255); }

.theme-apple-warm .coo-btn { background: rgb(255, 255, 255); color: rgb(225, 29, 72); }

.theme-apple-hot { background: linear-gradient(135deg, rgb(30, 27, 75), rgb(225, 29, 72)); color: rgb(255, 255, 255); }

.theme-apple-hot .coo-btn { background: rgb(251, 191, 36); color: rgb(30, 27, 75); }

.visual-minimal[class*="theme-"] { background: rgb(255, 255, 255) !important; color: rgb(17, 24, 39) !important; border: 1px solid rgba(5, 150, 105, 0.18) !important; box-shadow: rgba(5, 150, 105, 0.06) 0px 2px 10px !important; }

.visual-minimal .coo-bg-orb { display: none; }

.visual-minimal .coo-hook { background: rgb(236, 253, 245) !important; color: rgb(5, 150, 105) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-minimal .coo-btn { background: rgb(5, 150, 105) !important; color: rgb(255, 255, 255) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-reel { overflow: hidden; height: 100%; line-height: 1.25; padding: 0px; gap: 0px; align-items: stretch; }

.visual-reel[class*="theme-"] { background: linear-gradient(145deg, rgb(12, 15, 20) 0%, rgb(21, 27, 36) 50%, rgb(15, 20, 25) 100%) !important; color: rgb(241, 245, 249) !important; border: 1px solid rgba(255, 255, 255, 0.06) !important; }

.visual-reel .coo-bg-orb { display: none !important; }

.visual-reel .coo-hook { background: rgba(33, 115, 70, 0.25) !important; color: rgb(134, 239, 172) !important; animation: auto ease 0s 1 normal none running none !important; }

.visual-reel .coo-btn { background: rgb(16, 185, 129) !important; color: rgb(4, 47, 26) !important; animation: auto ease 0s 1 normal none running none !important; border-radius: 8px !important; font-weight: 700 !important; }

.visual-reel .coo-brand { color: rgba(255, 255, 255, 0.25); }

.coo-reel-vignette { position: absolute; inset: 0px; z-index: 0; pointer-events: none; background: radial-gradient(at 50% 40%, transparent 30%, rgba(0, 0, 0, 0.45) 100%); }

.coo-reel-glow { position: absolute; inset: -20%; z-index: 0; pointer-events: none; background: radial-gradient(circle at 30% 50%, rgba(16, 185, 129, 0.12) 0%, transparent 45%); animation: 8s ease-in-out 0s infinite normal none running coo-reel-glow-pulse; }

@keyframes coo-reel-glow-pulse { 
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.coo-reel-viewport { position: relative; overflow: hidden; flex-shrink: 0; background: rgb(6, 8, 12); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: rgba(0, 0, 0, 0.6) 0px 0px 24px inset, rgba(0, 0, 0, 0.35) 0px 4px 16px; }

.coo-reel-letterbox-t, .coo-reel-letterbox-b { position: absolute; left: 0px; right: 0px; z-index: 4; pointer-events: none; background: rgba(0, 0, 0, 0.85); }

.coo-reel-letterbox-t { top: 0px; }

.coo-reel-letterbox-b { bottom: 0px; }

.coo-reel-grain { position: absolute; inset: 0px; z-index: 5; pointer-events: none; opacity: 0.12; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E"); animation: 0.5s steps(2) 0s infinite normal none running coo-reel-grain-shift; }

@keyframes coo-reel-grain-shift { 
  100% { transform: translate(-2px, 1px); }
}

.coo-reel-scan { position: absolute; left: 0px; right: 0px; height: 30%; z-index: 4; pointer-events: none; background: linear-gradient(rgba(255, 255, 255, 0.04) 0%, transparent 100%); animation: 4s linear 0s infinite normal none running coo-reel-scan; }

@keyframes coo-reel-scan { 
  0% { top: -30%; }
  100% { top: 100%; }
}

.coo-reel-scene { position: absolute; inset: 0px; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8%; opacity: 0; visibility: hidden; }

.coo-reel-scene-1 { animation: coo-reel-cut-1 var(--reel-dur, 12s) ease-in-out infinite; }

.coo-reel-scene-2 { animation: coo-reel-cut-2 var(--reel-dur, 12s) ease-in-out infinite; }

.coo-reel-scene-3 { animation: coo-reel-cut-3 var(--reel-dur, 12s) ease-in-out infinite; }

.coo-reel-scene-4 { animation: coo-reel-cut-4 var(--reel-dur, 12s) ease-in-out infinite; }

@keyframes coo-reel-cut-1 { 
  0%, 22% { opacity: 1; visibility: visible; transform: scale(1); }
  24%, 100% { opacity: 0; visibility: hidden; transform: scale(1.04); }
}

@keyframes coo-reel-cut-2 { 
  0%, 23% { opacity: 0; visibility: hidden; }
  25%, 47% { opacity: 1; visibility: visible; transform: scale(1); }
  49%, 100% { opacity: 0; visibility: hidden; transform: scale(1.03); }
}

@keyframes coo-reel-cut-3 { 
  0%, 48% { opacity: 0; visibility: hidden; }
  50%, 72% { opacity: 1; visibility: visible; transform: scale(1); }
  74%, 100% { opacity: 0; visibility: hidden; }
}

@keyframes coo-reel-cut-4 { 
  0%, 73% { opacity: 0; visibility: hidden; }
  75%, 97% { opacity: 1; visibility: visible; transform: scale(1); }
  100% { opacity: 0; visibility: hidden; }
}

.coo-reel-wipe { position: absolute; inset: 0px; z-index: 3; pointer-events: none; background: linear-gradient(90deg, rgb(16, 185, 129) 0%, rgb(5, 150, 105) 100%); transform: translateX(-101%); animation: coo-reel-wipe var(--reel-dur, 12s) ease-in-out infinite; }

@keyframes coo-reel-wipe { 
  0%, 47% { transform: translateX(-101%); opacity: 0.9; }
  50% { transform: translateX(0px); }
  52%, 100% { transform: translateX(101%); opacity: 0; }
}

.coo-reel-excel-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; width: 100%; max-width: 90px; margin-top: 6px; }

.coo-reel-cell { aspect-ratio: 1.2 / 1; border-radius: 2px; font-size: 5px; font-weight: 700; display: flex; align-items: center; justify-content: center; background: rgba(33, 115, 70, 0.35); color: rgba(255, 255, 255, 0.7); border: 1px solid rgba(33, 115, 70, 0.5); animation: 1.2s ease-in-out 0s infinite normal none running coo-reel-cell-pop; }

.coo-reel-cell:nth-child(2) { animation-delay: 0.1s; }

.coo-reel-cell:nth-child(3) { animation-delay: 0.2s; background: rgba(220, 38, 38, 0.35); border-color: rgba(220, 38, 38, 0.5); color: rgb(254, 202, 202); }

.coo-reel-cell:nth-child(4) { animation-delay: 0.15s; }

.coo-reel-cell:nth-child(5) { animation-delay: 0.25s; }

.coo-reel-cell:nth-child(6) { animation-delay: 0.05s; background: rgba(220, 38, 38, 0.35); border-color: rgba(220, 38, 38, 0.5); }

@keyframes coo-reel-cell-pop { 
  0%, 100% { opacity: 0.6; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1); }
}

.coo-reel-scene-line { font-size: 8px; font-weight: 700; text-align: center; line-height: 1.2; color: rgb(248, 250, 252); text-shadow: rgba(0, 0, 0, 0.8) 0px 1px 8px; }

.coo-reel-scene-sub { font-size: 6px; opacity: 0.65; margin-top: 3px; font-weight: 600; }

.coo-reel-tabs-wrap { width: 100%; overflow: hidden; mask-image: linear-gradient(90deg, transparent, rgb(0, 0, 0) 12%, rgb(0, 0, 0) 88%, transparent); }

.coo-reel-tabs { display: flex; gap: 4px; width: max-content; animation: 2s linear 0s infinite normal none running coo-reel-tabs-scroll; }

@keyframes coo-reel-tabs-scroll { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(-50%); }
}

.coo-reel-tab { flex-shrink: 0; font-size: 5px; font-weight: 700; padding: 2px 5px; border-radius: 3px 3px 0px 0px; background: rgb(55, 65, 81); color: rgb(156, 163, 175); white-space: nowrap; }

.coo-reel-tab-active { background: rgb(33, 115, 70); color: rgb(255, 255, 255); }

.coo-reel-tab-err { background: rgb(127, 29, 29); color: rgb(254, 202, 202); animation: 0.8s ease-in-out 0s infinite normal none running coo-reel-tab-flash; }

@keyframes coo-reel-tab-flash { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.coo-reel-chaos-rows { width: 100%; margin-top: 5px; display: flex; flex-direction: column; gap: 2px; }

.coo-reel-chaos-row { height: 4px; border-radius: 1px; background: rgba(255, 255, 255, 0.08); animation: 0.4s ease-in-out 0s infinite alternate none running coo-reel-row-jitter; }

.coo-reel-chaos-row:nth-child(1) { width: 95%; animation-delay: 0s; }

.coo-reel-chaos-row:nth-child(2) { width: 70%; background: rgba(220, 38, 38, 0.25); animation-delay: 0.1s; }

.coo-reel-chaos-row:nth-child(3) { width: 88%; animation-delay: 0.05s; }

.coo-reel-chaos-row:nth-child(4) { width: 60%; animation-delay: 0.15s; }

@keyframes coo-reel-row-jitter { 
  0% { transform: translateX(-2px); }
  100% { transform: translateX(2px); }
}

.coo-reel-cards { display: flex; gap: 4px; width: 100%; justify-content: center; }

.coo-reel-card { flex: 1 1 0%; max-width: 36px; padding: 4px 2px; border-radius: 4px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); text-align: center; animation: 0.6s ease-out 0s 1 normal both running coo-reel-card-rise; }

.coo-reel-card:nth-child(2) { animation-delay: 0.12s; }

.coo-reel-card:nth-child(3) { animation-delay: 0.24s; }

@keyframes coo-reel-card-rise { 
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.coo-reel-card-icon { font-size: 8px; line-height: 1; margin-bottom: 2px; }

.coo-reel-card-label { font-size: 4px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: rgb(110, 231, 183); }

.coo-reel-card-val { font-size: 7px; font-weight: 800; color: rgb(255, 255, 255); margin-top: 1px; }

.coo-reel-check { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, rgb(16, 185, 129), rgb(5, 150, 105)); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; color: rgb(255, 255, 255); box-shadow: rgba(16, 185, 129, 0.5) 0px 0px 20px; animation: 0.5s ease-out 0s infinite alternate none running coo-reel-check-pop; }

@keyframes coo-reel-check-pop { 
  0% { transform: scale(1); }
  100% { transform: scale(1.06); }
}

.coo-reel-chrome { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }

.coo-reel-rec { display: inline-flex; align-items: center; gap: 3px; font-size: 6px; font-weight: 800; letter-spacing: 0.06em; color: rgb(248, 113, 113); text-transform: uppercase; flex-shrink: 0; }

.coo-reel-rec-dot { width: 5px; height: 5px; border-radius: 50%; background: rgb(239, 68, 68); animation: 1.2s ease-in-out 0s infinite normal none running coo-reel-rec-blink; }

@keyframes coo-reel-rec-blink { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

.coo-reel-progress { flex: 1 1 0%; height: 3px; border-radius: 99px; background: rgba(255, 255, 255, 0.12); overflow: hidden; min-width: 0px; }

.coo-reel-playhead { height: 100%; width: 0px; border-radius: 99px; background: linear-gradient(90deg, rgb(16, 185, 129), rgb(52, 211, 153)); animation: coo-reel-playhead var(--reel-dur, 12s) linear infinite; }

@keyframes coo-reel-playhead { 
  0% { width: 0px; }
  100% { width: 100%; }
}

.coo-reel-time { font-size: 6px; font-weight: 700; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, 0.45); flex-shrink: 0; min-width: 22px; text-align: right; }

.coo-reel-copy { min-width: 0px; overflow: hidden; z-index: 2; }

.coo-reel-title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0px; }

.coo-reel-desc { font-size: 10px; opacity: 0.75; margin: 0px; line-height: 1.3; }

.coo-reel-btn { flex-shrink: 0; z-index: 2; max-width: 100%; }

.visual-reel.layout-banner-wide { display: flex; align-items: center; padding: 8px 14px 8px 12px; box-sizing: border-box; }

